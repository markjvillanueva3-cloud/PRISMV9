+/**
+ * Fusion360FAIBridge — First Article Inspection Integration for Fusion 360
+ *
+ * Generates AS9102 Rev C compliant FAI reports from Fusion 360 setups:
+ *   - Form 1: Part Number Accountability
+ *   - Form 2: Product Accountability (materials, special processes, tests)
+ *   - Form 3: Characteristic Accountability (ballooned features)
+ *   - Balloon drawing data
+ *   - Measurement data integration & PASS/FAIL evaluation
+ *
+ * Feature ingestion is shaped to Fusion's setup→operation→toolpath hierarchy
+ * with optional Fusion Team document URN provenance. Math + classification
+ * mirror MastercamFAIBridge for consistency across CAMs.
+ *
+ * @module engines/Fusion360FAIBridge
+ * @milestone CAM-EXHAUST-MS0/U-CAM-FUSION-FAI-01
+ */
+
+import { log } from "../utils/Logger.js";
+
+// ============================================================================
+// TYPES
+// ============================================================================
+
+export type FAICharacteristicType = "dimension" | "tolerance" | "surface" | "position" | "note";
+export type FAIResult = "PASS" | "FAIL" | "PENDING";
+export type FAIComplianceStandard = "AS9102_Rev_C" | "AS9102_Rev_B";
+
+export interface FAICharacteristic {
+  balloon_number: number;
+  characteristic_designator: string;
+  characteristic_type: FAICharacteristicType;
+  nominal: string;
+  tolerance_plus: string;
+  tolerance_minus: string;
+  measured_value?: string;
+  deviation?: string;
+  result?: FAIResult;
+  method?: string;
+  equipment?: string;
+  notes?: string;
+}
+
+export interface FAIForm1 {
+  part_number: string;
+  part_name: string;
+  revision: string;
+  drawing_number: string;
+  serial_number?: string;
+  organization_name: string;
+  supplier_code?: string;
+  purchase_order?: string;
+  detail_fab?: boolean;
+  complete?: boolean;
+  reason_for_fai: "new_part" | "design_change" | "process_change" | "production_break";
+  inspection_date: string;
+  fai_report_number: string;
+  signature?: string;
+}
+
+export interface FAIForm2 {
+  materials: Array<{
+    material_spec: string;
+    material_type: string;
+    supplier: string;
+    cert_number?: string;
+    lot_number?: string;
+  }>;
+  special_processes: Array<{
+    process_name: string;
+    specification: string;
+    supplier?: string;
+    approval_number?: string;
+  }>;
+  functional_tests: Array<{
+    test_name: string;
+    specification: string;
+    result: "PASS" | "FAIL";
+    date: string;
+  }>;
+}
+
+export interface FAIForm3 {
+  characteristics: FAICharacteristic[];
+  total_characteristics: number;
+  passed: number;
+  failed: number;
+  pending: number;
+  all_passed: boolean;
+}
+
+export interface FAIReport {
+  form1: FAIForm1;
+  form2: FAIForm2;
+  form3: FAIForm3;
+  created_date: string;
+  status: "draft" | "complete" | "approved" | "rejected";
+  compliance: FAIComplianceStandard;
+}
+
+/**
+ * Feature data extracted from a Fusion 360 setup. Provenance fields
+ * (setup_name / operation_name / fusion_doc_id) are optional but help link
+ * Form 3 entries back to the originating Fusion document.
+ */
+export interface FusionFeatureExtraction {
+  feature_id: string;
+  feature_type: string;
+  x: number;
+  y: number;
+  z: number;
+  nominal: number;
+  tolerance?: { plus: number; minus: number };
+  tool_used?: string;
+  operation?: string;
+  setup_name?: string;
+  fusion_doc_id?: string;
+}
+
+// ============================================================================
+// CONSTANTS — measurement-equipment selection thresholds (inches)
+// ============================================================================
+
+const TOL_THRESHOLD_CMM_IN = 0.0001;
+const TOL_THRESHOLD_MIC_HIRES_IN = 0.0005;
+const TOL_THRESHOLD_MIC_STD_IN = 0.001;
+const TOL_THRESHOLD_CALIPER_IN = 0.005;
+const DIAMETER_MIC_VS_PIN_BREAK_MM = 25;
+const DEFAULT_TOLERANCE_IN = 0.005;
+
+// ============================================================================
+// ENGINE
+// ============================================================================
+
+export class Fusion360FAIBridge {
+  /**
+   * Convert Fusion feature extractions into ballooned FAI characteristics.
+   * Balloon numbers are assigned sequentially in input order.
+   */
+  extractCharacteristics(features: FusionFeatureExtraction[]): FAICharacteristic[] {
+    const characteristics: FAICharacteristic[] = [];
+    let balloonNumber = 1;
+
+    for (const feature of features) {
+      const tolPlus = feature.tolerance?.plus ?? DEFAULT_TOLERANCE_IN;
+      const tolMinus = feature.tolerance?.minus ?? DEFAULT_TOLERANCE_IN;
+      const charType = this.classifyCharacteristic(feature.feature_type);
+
+      characteristics.push({
+        balloon_number: balloonNumber++,
+        characteristic_designator: feature.feature_id,
+        characteristic_type: charType,
+        nominal: feature.nominal.toFixed(4),
+        tolerance_plus: `+${tolPlus.toFixed(4)}`,
+        tolerance_minus: `-${tolMinus.toFixed(4)}`,
+        result: "PENDING",
+        method: this.suggestMeasurementMethod(feature),
+        equipment: this.suggestEquipment(feature),
+      });
+    }
+
+    return characteristics;
+  }
+
+  /**
+   * Map a Fusion feature_type string to the AS9102 characteristic type bucket.
+   */
+  private classifyCharacteristic(featureType: string): FAICharacteristicType {
+    const t = featureType.toLowerCase();
+    if (t.includes("position") || t.includes("hole")) return "position";
+    if (t.includes("surface") || t.includes("finish")) return "surface";
+    return "dimension";
+  }
+
+  private suggestMeasurementMethod(feature: FusionFeatureExtraction): string {
+    const t = feature.feature_type.toLowerCase();
+    if (t.includes("diameter")) {
+      return feature.nominal > DIAMETER_MIC_VS_PIN_BREAK_MM ? "Micrometer" : "Pin Gauge";
+    }
+    if (t.includes("depth")) return "Depth Micrometer";
+    if (t.includes("position")) return "CMM";
+    if (t.includes("surface")) return "Profilometer";
+    if (t.includes("thread")) return "Thread Gauge (Go/No-Go)";
+    return "Caliper";
+  }
+
+  private suggestEquipment(feature: FusionFeatureExtraction): string {
+    const tol = feature.tolerance?.plus ?? DEFAULT_TOLERANCE_IN;
+    if (tol <= TOL_THRESHOLD_CMM_IN) return "CMM (Zeiss/Hexagon)";
+    if (tol <= TOL_THRESHOLD_MIC_HIRES_IN) return "Digital Micrometer 0.0001\"";
+    if (tol <= TOL_THRESHOLD_MIC_STD_IN) return "Digital Micrometer 0.0005\"";
+    if (tol <= TOL_THRESHOLD_CALIPER_IN) return "Digital Caliper 0.001\"";
+    return "Tape Measure";
+  }
+
+  /**
+   * Build Form 1 (part-number accountability).
+   */
+  createForm1(
+    partNumber: string,
+    partName: string,
+    revision: string,
+    drawingNumber: string,
+    organization: string,
+    reason: FAIForm1["reason_for_fai"] = "new_part",
+  ): FAIForm1 {
+    return {
+      part_number: partNumber,
+      part_name: partName,
+      revision,
+      drawing_number: drawingNumber,
+      organization_name: organization,
+      reason_for_fai: reason,
+      inspection_date: new Date().toISOString().split("T")[0],
+      fai_report_number: `FAI-${partNumber}-${Date.now().toString(36).toUpperCase()}`,
+    };
+  }
+
+  /**
+   * Build Form 2 (product accountability — materials, special processes, tests).
+   */
+  createForm2(
+    materials: FAIForm2["materials"] = [],
+    processes: FAIForm2["special_processes"] = [],
+    tests: FAIForm2["functional_tests"] = [],
+  ): FAIForm2 {
+    return {
+      materials,
+      special_processes: processes,
+      functional_tests: tests,
+    };
+  }
+
+  /**
+   * Build Form 3 (characteristic accountability — counts pass/fail/pending).
+   */
+  createForm3(characteristics: FAICharacteristic[]): FAIForm3 {
+    const passed = characteristics.filter((c) => c.result === "PASS").length;
+    const failed = characteristics.filter((c) => c.result === "FAIL").length;
+    const pending = characteristics.filter((c) => c.result === "PENDING").length;
+
+    return {
+      characteristics,
+      total_characteristics: characteristics.length,
+      passed,
+      failed,
+      pending,
+      all_passed: failed === 0 && pending === 0,
+    };
+  }
+
+  /**
+   * Compose the full report. Status: 'draft' if any pending, 'rejected' if any failed,
+   * else 'complete'. (Approval requires human signature — left to caller.)
+   */
+  generateReport(form1: FAIForm1, form2: FAIForm2, characteristics: FAICharacteristic[]): FAIReport {
+    const form3 = this.createForm3(characteristics);
+    const status: FAIReport["status"] =
+      form3.pending > 0 ? "draft" : form3.failed > 0 ? "rejected" : "complete";
+
+    log.info(
+      `[Fusion360FAIBridge] Report ${form1.fai_report_number}: ${form3.passed}/${form3.total_characteristics} passed`,
+    );
+
+    return {
+      form1,
+      form2,
+      form3,
+      created_date: new Date().toISOString(),
+      status,
+      compliance: "AS9102_Rev_C",
+    };
+  }
+
+  /**
+   * Apply measurements to characteristics, assigning PASS/FAIL by tolerance band.
+   * Unmeasured balloons are returned untouched (PENDING).
+   */
+  applyMeasurements(
+    characteristics: FAICharacteristic[],
+    measurements: Array<{ balloon_number: number; measured_value: number }>,
+  ): FAICharacteristic[] {
+    return characteristics.map((char) => {
+      const measurement = measurements.find((m) => m.balloon_number === char.balloon_number);
+      if (!measurement) return char;
+
+      const nominal = parseFloat(char.nominal);
+      const tolPlus = parseFloat(char.tolerance_plus);
+      const tolMinus = parseFloat(char.tolerance_minus);
+      const measured = measurement.measured_value;
+      const deviation = measured - nominal;
+      const pass = deviation >= tolMinus && deviation <= tolPlus;
+
+      return {
+        ...char,
+        measured_value: measured.toFixed(4),
+        deviation: deviation >= 0 ? `+${deviation.toFixed(4)}` : deviation.toFixed(4),
+        result: pass ? "PASS" : "FAIL",
+      };
+    });
+  }
+
+  /**
+   * Export the report to JSON for downstream consumers (Net-Inspect, QualityOne, etc.)
+   */
+  exportJSON(report: FAIReport): string {
+    return JSON.stringify(report, null, 2);
+  }
+
+  /**
+   * Generate balloon placement coordinates. This is a deterministic 10-column
+   * grid layout — caller can replace with drawing-view positions when integrated
+   * with Fusion drawing API.
+   */
+  generateBalloonData(
+    characteristics: FAICharacteristic[],
+  ): Array<{ balloon_number: number; x: number; y: number; text: string }> {
+    const COL_COUNT = 10;
+    const COL_PITCH = 50;
+    const ROW_PITCH = 50;
+    const ORIGIN_X = 100;
+    const ORIGIN_Y = 100;
+    return characteristics.map((c, i) => ({
+      balloon_number: c.balloon_number,
+      x: ORIGIN_X + (i % COL_COUNT) * COL_PITCH,
+      y: ORIGIN_Y + Math.floor(i / COL_COUNT) * ROW_PITCH,
+      text: c.balloon_number.toString(),
+    }));
+  }
+
+  /**
+   * Bridge capability stats (telemetry / dispatcher introspection).
+   */
+  getStats(): {
+    forms_supported: number;
+    compliance_standards: FAIComplianceStandard[];
+    characteristic_types: number;
+  } {
+    return {
+      forms_supported: 3,
+      compliance_standards: ["AS9102_Rev_C", "AS9102_Rev_B"],
+      characteristic_types: 5,
+    };
+  }
+}
+
+// Singleton export — matches Mastercam/hyperMILL convention
+export const fusion360FAIBridge = new Fusion360FAIBridge();
