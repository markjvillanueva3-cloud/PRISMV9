{
  "mcpServers": {
    "prism": {
      "command": "node",
      "args": ["H:\\prism\\mcp-server\\dist\\index.js"],
      "env": {
        "CADENCE_VERBOSITY": "critical",
        "NODE_ENV": "production"
      }
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node H:\\prism\\mcp-server\\scripts\\hooks\\cross-session-duplication-guard.mjs",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "node H:\\prism\\mcp-server\\scripts\\hooks\\ai-reasoning-session-start.mjs",
            "timeout": 3000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node H:\\prism\\mcp-server\\scripts\\hooks\\ai-integration-stop-check.mjs",
            "timeout": 3000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node H:\\prism\\mcp-server\\scripts\\hooks\\engine-duplication-blocker.mjs",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "node H:\\prism\\mcp-server\\scripts\\hooks\\code-integrity-prewrite.mjs",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "powershell -File H:\\prism\\mcp-server\\scripts\\hooks\\pre-edit-safety-gate.ps1"
          },
          {
            "type": "command",
            "command": "powershell -NoProfile -File H:\\prism\\mcp-server\\scripts\\hooks\\anti-regression-gate.ps1 -FilePath \"$TOOL_INPUT_file_path\"",
            "timeout": 3000,
            "continueOnError": true
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"$TOOL_INPUT_command\" | grep -q 'git commit' && { STAGED=$(cd /h/prism/mcp-server && git diff --cached --stat 2>/dev/null); [ -n \"$STAGED\" ] && node -e \"console.log(JSON.stringify({hookSpecificOutput:{hookEventName:'PreToolUse',additionalContext:'STAGED FILES: '+process.argv[1]}}))\" \"$STAGED\" || true; } || true",
            "timeout": 3000,
            "continueOnError": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -File H:\\prism\\mcp-server\\scripts\\hooks\\post-build-verify.ps1"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node H:\\prism\\mcp-server\\scripts\\hooks\\agent-auto-update-hook.mjs",
            "timeout": 3000,
            "continueOnError": true
          },
          {
            "type": "command",
            "command": "fp=\"$TOOL_INPUT_file_path\"; echo \"$fp\" | grep -qE 'mcp-server/src/.*\\.ts$' && ! echo \"$fp\" | grep -qE '\\.(test|spec)\\.ts$' && { TSC_LAST=/tmp/prism-tsc-lastrun; [ -f \"$TSC_LAST\" ] && AGE=$(node -e \"const fs=require('fs'); try{console.log(Math.floor((Date.now()-fs.statSync('$TSC_LAST').mtimeMs)/1000))}catch{console.log(999)}\" 2>/dev/null) && [ \"$AGE\" -lt 30 ] 2>/dev/null && exit 0; touch \"$TSC_LAST\"; ERR=$(cd /h/prism/mcp-server && npx tsc --noEmit --pretty false 2>&1 | grep 'error TS' | head -3); [ -n \"$ERR\" ] && node -e \"console.log(JSON.stringify({hookSpecificOutput:{hookEventName:'PostToolUse',additionalContext:'TSC ERRORS: '+process.argv[1].slice(0,300)+' — Fix type errors.'}}))\" \"$ERR\"; } || true",
            "timeout": 15000,
            "continueOnError": true
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -File H:\\prism\\mcp-server\\scripts\\hooks\\teammate-quality-gate.ps1"
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -File H:\\prism\\mcp-server\\scripts\\hooks\\teammate-reassign.ps1"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npm run build)",
      "Bash(npm run build:fast)",
      "Bash(npm run test:*)",
      "Bash(powershell*verify-build*)",
      "Bash(powershell*scripts/hooks*)",
      "Bash(git *)",
      "Read(H:\\prism\\**)",
      "Write(H:\\prism\\mcp-server\\src\\**)",
      "Write(H:\\prism\\mcp-server\\data\\**)",
      "Write(H:\\prism\\mcp-server\\scripts\\**)",
      "Write(H:\\prism\\mcp-server\\tests\\**)",
      "Write(H:\\prism\\state\\**)"
    ],
    "deny": [
      "Write(H:\\prism\\mcp-server\\src\\data\\goldenBenchmarks.json)"
    ]
  }
}
