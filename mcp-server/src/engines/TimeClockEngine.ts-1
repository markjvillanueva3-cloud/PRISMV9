/**
 * TimeClockEngine — Employee shift clock in/out, job clock in/out,
 * pause/resume, break tracking, overtime calculation, attendance reporting.
 *
 * This is the central engine that links employees to jobs and generates
 * the labor data that PayrollEngine and ActualCostEngine consume.
 */

import { employeeEngine, type Department } from "./EmployeeEngine.js";
import { persistenceBridge } from "../db/PersistenceBridge.js";

/** Strip HTML tags, reject script injection, enforce max length. */
function sanitizeText(input: string | undefined | null, maxLen = 500): string | undefined {
  if (input == null) return undefined;
  let text = String(input)
    .replace(/<[^>]*>/g, "")                              // strip HTML tags
    .replace(/on\w+\s*=/gi, "")                           // strip event handlers
    .replace(/javascript\s*:/gi, "")                      // strip javascript: URIs
    .replace(/\beval\s*\(/gi, "")                         // strip eval()
    .trim();
  if (text.length > maxLen) text = text.slice(0, maxLen);
  return text || undefined;
}

export interface ShiftEntry {
  id: string;
  employee_id: string;
  clock_in: string; // ISO datetime
  clock_out?: string;
  break_minutes: number;
  status: "active" | "completed" | "no_show";
  total_hours?: number;
  regular_hours?: number;
  overtime_hours?: number;
  double_time_hours?: number;
  handoff_notes?: string;
}

export type PauseReasonCategory =
  | "machine_down"
  | "material_shortage"
  | "setup_changeover"
  | "tool_change"
  | "break"
  | "preventive_maintenance"
  | "waiting_inspection"
  | "idle"
  | "shift_end"
  | "other";

export type ProcessType =
  | "setup"
  | "production_run"
  | "first_article"
  | "rework"
  | "inspection"
  | "deburring"
  | "secondary_ops"
  | "programming"
  | "material_handling";

export interface PausePeriod {
  start: string;
  end?: string;
  reason: string;
  reason_category?: PauseReasonCategory;
}

export interface JobTimeEntry {
  id: string;
  employee_id: string;
  shift_entry_id: string;
  job_id: string;
  operation?: string;
  machine_id?: string;
  start_time: string; // ISO datetime
  end_time?: string;
  process_type: ProcessType;
  pause_periods: PausePeriod[];
  status: "active" | "paused" | "completed";
  total_minutes?: number;
  productive_minutes?: number;
  good_parts?: number;
  scrap_count?: number;
  scrap_reason?: string;
  improvement_note?: string;
  takt_time_sec?: number;
  quality_project_id?: string;
  notes: string;
}

export interface ClockInInput {
  employee_id: string;
  timestamp?: string;
}

export interface JobStartInput {
  employee_id: string;
  job_id: string;
  operation?: string;
  machine_id?: string;
  process_type?: ProcessType;
  timestamp?: string;
}

export interface JobPauseInput {
  employee_id: string;
  job_id: string;
  operation?: string;
  reason: string;
  reason_category?: PauseReasonCategory;
  timestamp?: string;
}

export interface JobResumeInput {
  employee_id: string;
  job_id: string;
  operation?: string;
  timestamp?: string;
}

type PersistedShiftRecord = {
  id?: string;
  shift_entry_id?: string;
  employee_id?: string;
  employee_name?: string;
  shift_date?: string;
  clock_in?: string;
  clock_out?: string;
  hours_worked?: number;
  total_hours?: number;
  regular_hours?: number;
  overtime_hours?: number;
  double_time_hours?: number;
  status?: string;
  break_minutes?: number;
  notes?: string;
  handoff_notes?: string;
};

type PersistedJobTimeRecord = {
  id?: string;
  job_time_entry_id?: string;
  job_id?: string;
  employee_id?: string;
  shift_entry_id?: string;
  employee_name?: string;
  operation?: string;
  machine_id?: string;
  start_time?: string;
  end_time?: string;
  elapsed_min?: number;
  total_minutes?: number;
  productive_minutes?: number;
  quantity_completed?: number;
  scrap_count?: number;
  status?: JobTimeEntry["status"];
  notes?: string;
  process_type?: ProcessType;
  pause_periods?: PausePeriod[];
  good_parts?: number;
  scrap_reason?: string;
  improvement_note?: string;
  takt_time_sec?: number;
  quality_project_id?: string;
};

function parseJsonArray<T>(value: unknown): T[] {
  if (Array.isArray(value)) return value as T[];
  if (typeof value === "string" && value.trim()) {
    try {
      const parsed = JSON.parse(value);
      return Array.isArray(parsed) ? (parsed as T[]) : [];
    } catch {
      return [];
    }
  }
  return [];
}

function toStoreShiftStatus(entry: ShiftEntry): "present" | "no_show" {
  return entry.status === "no_show" ? "no_show" : "present";
}

function fromStoreShiftStatus(record: PersistedShiftRecord): ShiftEntry["status"] {
  if (record.status === "no_show") return "no_show";
  return record.clock_out ? "completed" : "active";
}

export interface TimecardSummary {
  employee_id: string;
  employee_name: string;
  period: string;
  period_start: string;
  period_end: string;
  shifts: number;
  total_hours: number;
  regular_hours: number;
  overtime_hours: number;
  double_time_hours: number;
  break_hours: number;
  jobs: {
    job_id: string;
    hours: number;
    cost: number;
    operations: string[];
    operation_details: {
      operation: string;
      process_type: ProcessType;
      machine_id?: string;
      hours: number;
      cost: number;
      good_parts: number;
      scrap_count: number;
    }[];
  }[];
  gross_pay: number;
}

export interface AttendanceRecord {
  employee_id: string;
  employee_name: string;
  date: string;
  status: "present" | "absent" | "late" | "left_early" | "no_show";
  clock_in?: string;
  clock_out?: string;
  hours_worked: number;
  shift_start: string;
  shift_end: string;
}

class TimeClockEngine {
  private shifts: Map<string, ShiftEntry> = new Map();
  private jobTimes: Map<string, JobTimeEntry> = new Map();
  private nextShiftId = 1;
  private nextJobTimeId = 1;

  // Secondary indexes for O(1) lookups by employee
  private activeJobsByEmployee: Map<string, Set<string>> = new Map();
  private pausedJobsByEmployee: Map<string, Set<string>> = new Map();

  /** Add entry to a secondary index. */
  private indexAdd(index: Map<string, Set<string>>, employeeId: string, entryId: string): void {
    let s = index.get(employeeId);
    if (!s) { s = new Set(); index.set(employeeId, s); }
    s.add(entryId);
  }

  /** Remove entry from a secondary index. */
  private indexRemove(index: Map<string, Set<string>>, employeeId: string, entryId: string): void {
    const s = index.get(employeeId);
    if (s) { s.delete(entryId); if (s.size === 0) index.delete(employeeId); }
  }

  // ─── Shift Clock In/Out ─────────────────────────────────

  /** Clock an employee into their shift. */
  clockIn(input: ClockInInput): ShiftEntry {
    const emp = employeeEngine.get(input.employee_id);
    if (!emp) throw new Error(`Employee ${input.employee_id} not found`);
    if (emp.status !== "active") throw new Error(`Employee ${input.employee_id} is not active`);

    // Check for existing active shift
    const active = this.getActiveShift(input.employee_id);
    if (active) throw new Error(`Employee ${input.employee_id} already clocked in (shift ${active.id})`);

    const id = `SH-${String(this.nextShiftId++).padStart(6, "0")}`;
    const entry: ShiftEntry = {
      id,
      employee_id: input.employee_id,
      clock_in: input.timestamp ?? new Date().toISOString(),
      break_minutes: 0,
      status: "active",
    };
    this.shifts.set(id, entry);
    persistenceBridge.persist("time_entries", id, entry as any);
    return entry;
  }

  /** Clock an employee out of their shift. Finalizes all active job times. */
  clockOut(employeeId: string, timestamp?: string, handoffNotes?: string): ShiftEntry {
    const active = this.getActiveShift(employeeId);
    if (!active) throw new Error(`Employee ${employeeId} is not clocked in`);

    const now = timestamp ?? new Date().toISOString();

    // End any active job time entries
    for (const jt of this.jobTimes.values()) {
      if (jt.employee_id === employeeId && jt.status !== "completed") {
        this.jobStop({
          employee_id: employeeId,
          job_id: jt.job_id,
          operation: jt.operation,
          timestamp: now,
        });
      }
    }

    active.clock_out = now;
    active.status = "completed";

    // Calculate hours
    const totalMs = new Date(now).getTime() - new Date(active.clock_in).getTime();
    const totalHours = Math.max(0, totalMs / 3600000 - active.break_minutes / 60);
    active.total_hours = Math.round(totalHours * 100) / 100;

    // Split into regular/OT/DT
    if (totalHours <= 8) {
      active.regular_hours = totalHours;
      active.overtime_hours = 0;
      active.double_time_hours = 0;
    } else if (totalHours <= 12) {
      active.regular_hours = 8;
      active.overtime_hours = totalHours - 8;
      active.double_time_hours = 0;
    } else {
      active.regular_hours = 8;
      active.overtime_hours = 4;
      active.double_time_hours = totalHours - 12;
    }

    // Round to 2 decimals
    active.regular_hours = Math.round(active.regular_hours * 100) / 100;
    active.overtime_hours = Math.round(active.overtime_hours * 100) / 100;
    active.double_time_hours = Math.round(active.double_time_hours * 100) / 100;

    if (handoffNotes) active.handoff_notes = sanitizeText(handoffNotes);

    persistenceBridge.persist("time_entries", active.id, active as any);
    return active;
  }

  /** Get the active (clocked-in) shift for an employee. */
  getActiveShift(employeeId: string): ShiftEntry | undefined {
    for (const s of this.shifts.values()) {
      if (s.employee_id === employeeId && s.status === "active") return s;
    }
    return undefined;
  }

  /** Record a break (adds to break_minutes on active shift). */
  addBreak(employeeId: string, minutes: number): ShiftEntry {
    const active = this.getActiveShift(employeeId);
    if (!active) throw new Error(`Employee ${employeeId} is not clocked in`);
    active.break_minutes += minutes;
    persistenceBridge.persist("time_entries", active.id, active as any);
    return active;
  }

  // ─── Job Time Tracking ──────────────────────────────────

  /** Start working on a job (clock into job). */
  jobStart(input: JobStartInput): JobTimeEntry {
    const shift = this.getActiveShift(input.employee_id);
    if (!shift) throw new Error(`Employee ${input.employee_id} must clock into shift first`);

    // Check for existing active job — pause it first
    const activeJob = this.getActiveJobTime(input.employee_id);
    if (
      activeJob &&
      (activeJob.job_id !== input.job_id || (activeJob.operation ?? "") !== (input.operation ?? ""))
    ) {
      this.jobPause({
        employee_id: input.employee_id,
        job_id: activeJob.job_id,
        operation: activeJob.operation,
        reason: `Switched to job ${input.job_id}`,
        timestamp: input.timestamp,
      });
    }

    // Resume if same job was paused
    const paused = this.getPausedJobTime(input.employee_id, input.job_id, input.operation);
    if (paused) {
      return this.jobResume({
        employee_id: input.employee_id,
        job_id: input.job_id,
        operation: input.operation,
        timestamp: input.timestamp,
      });
    }

    const id = `JT-${String(this.nextJobTimeId++).padStart(6, "0")}`;
    const entry: JobTimeEntry = {
      id,
      employee_id: input.employee_id,
      shift_entry_id: shift.id,
      job_id: input.job_id,
      operation: input.operation,
      machine_id: input.machine_id,
      start_time: input.timestamp ?? new Date().toISOString(),
      process_type: input.process_type ?? "production_run",
      pause_periods: [],
      status: "active",
      notes: "",
    };
    this.jobTimes.set(id, entry);
    this.indexAdd(this.activeJobsByEmployee, input.employee_id, id);
    persistenceBridge.persist("job_time_entries", id, entry as any);
    return entry;
  }

  /** Pause working on a job (with reason). */
  jobPause(input: JobPauseInput): JobTimeEntry {
    const entry = this.getActiveJobTime(input.employee_id, input.job_id, input.operation);
    if (!entry) throw new Error(`No active job time for employee ${input.employee_id} on job ${input.job_id}`);

    entry.pause_periods.push({
      start: input.timestamp ?? new Date().toISOString(),
      reason: sanitizeText(input.reason) ?? "",
      reason_category: input.reason_category,
    });
    entry.status = "paused";
    this.indexRemove(this.activeJobsByEmployee, input.employee_id, entry.id);
    this.indexAdd(this.pausedJobsByEmployee, input.employee_id, entry.id);
    persistenceBridge.persist("job_time_entries", entry.id, entry as any);
    return entry;
  }

  /** Resume a paused job. */
  jobResume(input: JobResumeInput): JobTimeEntry {
    const entry = this.getPausedJobTime(input.employee_id, input.job_id, input.operation);
    if (!entry) throw new Error(`No paused job time for employee ${input.employee_id} on job ${input.job_id}`);

    const lastPause = entry.pause_periods[entry.pause_periods.length - 1];
    if (lastPause && !lastPause.end) {
      lastPause.end = input.timestamp ?? new Date().toISOString();
    }
    entry.status = "active";
    this.indexRemove(this.pausedJobsByEmployee, input.employee_id, entry.id);
    this.indexAdd(this.activeJobsByEmployee, input.employee_id, entry.id);
    persistenceBridge.persist("job_time_entries", entry.id, entry as any);
    return entry;
  }

  /** Stop working on a job (clock out of job). */
  jobStop(input: {
    employee_id: string;
    job_id: string;
    operation?: string;
    timestamp?: string;
    notes?: string;
    good_parts?: number;
    scrap_count?: number;
    scrap_reason?: string;
    improvement_note?: string;
  }): JobTimeEntry {
    // Find active or paused entry
    let entry = this.getActiveJobTime(input.employee_id, input.job_id, input.operation);
    if (!entry) entry = this.getPausedJobTime(input.employee_id, input.job_id, input.operation);
    if (!entry) throw new Error(`No active/paused job time for employee ${input.employee_id} on job ${input.job_id}`);

    const now = input.timestamp ?? new Date().toISOString();

    // Close any open pause
    const lastPause = entry.pause_periods[entry.pause_periods.length - 1];
    if (lastPause && !lastPause.end) {
      lastPause.end = now;
    }

    entry.end_time = now;
    entry.status = "completed";
    this.indexRemove(this.activeJobsByEmployee, input.employee_id, entry.id);
    this.indexRemove(this.pausedJobsByEmployee, input.employee_id, entry.id);
    if (input.notes) entry.notes = sanitizeText(input.notes) ?? "";

    // Calculate total and productive minutes
    const totalMs = new Date(now).getTime() - new Date(entry.start_time).getTime();
    const pauseMs = entry.pause_periods.reduce((sum, p) => {
      const end = p.end ? new Date(p.end).getTime() : new Date(now).getTime();
      return sum + (end - new Date(p.start).getTime());
    }, 0);

    entry.total_minutes = Math.round(totalMs / 60000 * 100) / 100;
    entry.productive_minutes = Math.round((totalMs - pauseMs) / 60000 * 100) / 100;

    // Production data (sanitize user text)
    if (input.good_parts != null) entry.good_parts = input.good_parts;
    if (input.scrap_count != null) entry.scrap_count = input.scrap_count;
    if (input.scrap_reason) entry.scrap_reason = sanitizeText(input.scrap_reason);
    if (input.improvement_note) entry.improvement_note = sanitizeText(input.improvement_note);

    persistenceBridge.persist("job_time_entries", entry.id, entry as any);

    // SYNC-05: Scrap → auto cost adjustment (fire-and-forget)
    if ((input.scrap_count ?? 0) > 0) {
      void (async () => {
        try {
          const { actualCostEngine } = await import("./ActualCostEngine.js");
          const totalParts = (entry.good_parts ?? 0) + (entry.scrap_count ?? 0);
          const laborCost = ((entry.productive_minutes ?? 0) / 60) * 35; // approximate hourly rate
          const scrapLaborCost = totalParts > 0 ? ((entry.scrap_count ?? 0) / totalParts) * laborCost : 0;
          actualCostEngine.recordScrapCost?.({
            job_id: input.job_id,
            scrap_count: input.scrap_count!,
            material_cost: 0, // requires job material data
            labor_cost: Math.round(scrapLaborCost * 100) / 100,
            recorded_by: input.employee_id,
            recorded_at: new Date().toISOString(),
          });
        } catch {
          // ActualCostEngine may not have recordScrapCost — log silently
        }
      })();
    }

    return entry;
  }

  /** Get active job time entry for an employee (optionally filtered by job). O(1) via index. */
  getActiveJobTime(employeeId: string, jobId?: string, operation?: string): JobTimeEntry | undefined {
    const ids = this.activeJobsByEmployee.get(employeeId);
    if (!ids) return undefined;
    for (const id of ids) {
      const jt = this.jobTimes.get(id);
      if (
        jt &&
        (!jobId || jt.job_id === jobId) &&
        (operation == null || (jt.operation ?? "") === operation)
      ) return jt;
    }
    return undefined;
  }

  /** Get paused job time entry. O(1) via index. */
  getPausedJobTime(employeeId: string, jobId: string, operation?: string): JobTimeEntry | undefined {
    const ids = this.pausedJobsByEmployee.get(employeeId);
    if (!ids) return undefined;
    for (const id of ids) {
      const jt = this.jobTimes.get(id);
      if (jt && jt.job_id === jobId && (operation == null || (jt.operation ?? "") === operation)) return jt;
    }
    return undefined;
  }

  /** Get all active and paused jobs for an employee. O(1) via index. */
  getActiveAndPausedJobs(employeeId: string): JobTimeEntry[] {
    const results: JobTimeEntry[] = [];
    const activeIds = this.activeJobsByEmployee.get(employeeId);
    if (activeIds) for (const id of activeIds) {
      const jt = this.jobTimes.get(id);
      if (jt) results.push(jt);
    }
    const pausedIds = this.pausedJobsByEmployee.get(employeeId);
    if (pausedIds) for (const id of pausedIds) {
      const jt = this.jobTimes.get(id);
      if (jt) results.push(jt);
    }
    return results;
  }

  /** Get shift handoff info: previous shift's handoff_notes + active/paused jobs from last shift. */
  getShiftHandoff(employeeId: string): {
    previous_handoff_notes?: string;
    previous_shift?: ShiftEntry;
    carried_jobs: JobTimeEntry[];
  } {
    // Find the most recent completed shift for this employee
    let latestShift: ShiftEntry | undefined;
    for (const s of this.shifts.values()) {
      if (s.employee_id === employeeId && s.status === "completed") {
        if (!latestShift || s.clock_in > latestShift.clock_in) {
          latestShift = s;
        }
      }
    }

    // Find paused jobs from the previous shift
    const carriedJobs: JobTimeEntry[] = [];
    if (latestShift) {
      for (const jt of this.jobTimes.values()) {
        if (jt.shift_entry_id === latestShift.id && jt.status === "paused") {
          carriedJobs.push(jt);
        }
      }
    }

    return {
      previous_handoff_notes: latestShift?.handoff_notes,
      previous_shift: latestShift,
      carried_jobs: carriedJobs,
    };
  }

  // ─── Reporting ──────────────────────────────────────────

  /** Generate a timecard summary for an employee over a date range. */
  timecardSummary(
    employeeId: string,
    periodLabel: string,
    startDate: string,
    endDate: string,
  ): TimecardSummary {
    const emp = employeeEngine.get(employeeId);
    if (!emp) throw new Error(`Employee ${employeeId} not found`);

    const start = new Date(startDate).getTime();
    const end = new Date(endDate).getTime();

    // Gather completed shifts in range
    const shifts: ShiftEntry[] = [];
    for (const s of this.shifts.values()) {
      if (s.employee_id !== employeeId || s.status !== "completed") continue;
      const clockIn = new Date(s.clock_in).getTime();
      if (clockIn >= start && clockIn <= end) shifts.push(s);
    }

    const totalHours = shifts.reduce((s, sh) => s + (sh.total_hours ?? 0), 0);
    const regularHours = shifts.reduce((s, sh) => s + (sh.regular_hours ?? 0), 0);
    const overtimeHours = shifts.reduce((s, sh) => s + (sh.overtime_hours ?? 0), 0);
    const doubleTimeHours = shifts.reduce((s, sh) => s + (sh.double_time_hours ?? 0), 0);
    const breakHours = shifts.reduce((s, sh) => s + sh.break_minutes / 60, 0);

    // Gather job times in range with operation-level detail so the ERP UI can
    // preserve what the operator actually worked on instead of flattening it
    // back into a generic weekly total.
    const jobMap = new Map<
      string,
      {
        hours: number;
        cost: number;
        operations: Set<string>;
        operationDetails: Map<
          string,
          {
            operation: string;
            process_type: ProcessType;
            machine_id?: string;
            hours: number;
            cost: number;
            good_parts: number;
            scrap_count: number;
          }
        >;
      }
    >();
    for (const jt of this.jobTimes.values()) {
      if (jt.employee_id !== employeeId || jt.status !== "completed") continue;
      const jtStart = new Date(jt.start_time).getTime();
      if (jtStart < start || jtStart > end) continue;

      const productiveHours = (jt.productive_minutes ?? 0) / 60;
      const entryCost = productiveHours * emp.hourly_rate;
      const operationLabel = jt.operation?.trim() || "General";
      const operationKey = [
        operationLabel,
        jt.process_type ?? "production_run",
        jt.machine_id ?? "",
      ].join("|");

      const existing = jobMap.get(jt.job_id) ?? {
        hours: 0,
        cost: 0,
        operations: new Set<string>(),
        operationDetails: new Map(),
      };
      existing.hours += productiveHours;
      existing.cost += entryCost;
      if (jt.operation) existing.operations.add(jt.operation);

      const operationDetail = existing.operationDetails.get(operationKey) ?? {
        operation: operationLabel,
        process_type: jt.process_type ?? "production_run",
        machine_id: jt.machine_id,
        hours: 0,
        cost: 0,
        good_parts: 0,
        scrap_count: 0,
      };
      operationDetail.hours += productiveHours;
      operationDetail.cost += entryCost;
      operationDetail.good_parts += jt.good_parts ?? 0;
      operationDetail.scrap_count += jt.scrap_count ?? 0;
      existing.operationDetails.set(operationKey, operationDetail);
      jobMap.set(jt.job_id, existing);
    }

    const jobs = Array.from(jobMap.entries()).map(([job_id, data]) => ({
      job_id,
      hours: Math.round(data.hours * 100) / 100,
      cost: Math.round(data.cost * 100) / 100,
      operations: Array.from(data.operations),
      operation_details: Array.from(data.operationDetails.values()).map((detail) => ({
        operation: detail.operation,
        process_type: detail.process_type,
        machine_id: detail.machine_id,
        hours: Math.round(detail.hours * 100) / 100,
        cost: Math.round(detail.cost * 100) / 100,
        good_parts: detail.good_parts,
        scrap_count: detail.scrap_count,
      })),
    }));

    const grossPay =
      regularHours * emp.hourly_rate +
      overtimeHours * emp.overtime_rate +
      doubleTimeHours * emp.double_time_rate;

    return {
      employee_id: employeeId,
      employee_name: `${emp.first_name} ${emp.last_name}`,
      period: periodLabel,
      period_start: startDate,
      period_end: endDate,
      shifts: shifts.length,
      total_hours: Math.round(totalHours * 100) / 100,
      regular_hours: Math.round(regularHours * 100) / 100,
      overtime_hours: Math.round(overtimeHours * 100) / 100,
      double_time_hours: Math.round(doubleTimeHours * 100) / 100,
      break_hours: Math.round(breakHours * 100) / 100,
      jobs,
      gross_pay: Math.round(grossPay * 100) / 100,
    };
  }

  /** Get attendance records for a date range. */
  attendanceReport(
    startDate: string,
    endDate: string,
    departmentFilter?: string,
  ): AttendanceRecord[] {
    const employees = departmentFilter
      ? employeeEngine.search({ department: departmentFilter as Department, status: "active" })
      : employeeEngine.list("active");

    const start = new Date(startDate);
    const end = new Date(endDate);
    const records: AttendanceRecord[] = [];

    for (const emp of employees) {
      // Iterate each day in range
      const cursor = new Date(start);
      while (cursor <= end) {
        const dateStr = cursor.toISOString().slice(0, 10);
        const dayOfWeek = cursor.getDay();

        // Only check scheduled days
        if (emp.shift.days.includes(dayOfWeek)) {
          const dayStart = new Date(`${dateStr}T00:00:00Z`).getTime();
          const dayEnd = dayStart + 86400000;

          // Find shift for this day
          const dayShift = Array.from(this.shifts.values()).find(
            (s) =>
              s.employee_id === emp.id &&
              new Date(s.clock_in).getTime() >= dayStart &&
              new Date(s.clock_in).getTime() < dayEnd,
          );

          let status: AttendanceRecord["status"] = "absent";
          if (dayShift) {
            const clockInTime = dayShift.clock_in.slice(11, 16);
            if (clockInTime > emp.shift.start_time && this.timeDiffMinutes(emp.shift.start_time, clockInTime) > 5) {
              status = "late";
            } else if (dayShift.clock_out) {
              const clockOutTime = dayShift.clock_out.slice(11, 16);
              if (clockOutTime < emp.shift.end_time && this.timeDiffMinutes(clockOutTime, emp.shift.end_time) > 5) {
                status = "left_early";
              } else {
                status = "present";
              }
            } else {
              status = "present"; // still clocked in
            }
          }

          records.push({
            employee_id: emp.id,
            employee_name: `${emp.first_name} ${emp.last_name}`,
            date: dateStr,
            status,
            clock_in: dayShift?.clock_in,
            clock_out: dayShift?.clock_out,
            hours_worked: dayShift?.total_hours ?? 0,
            shift_start: emp.shift.start_time,
            shift_end: emp.shift.end_time,
          });
        }
        cursor.setDate(cursor.getDate() + 1);
      }
    }
    return records;
  }

  /** Get all job time entries for a specific job. */
  getJobTimeEntries(jobId: string): JobTimeEntry[] {
    const entries: JobTimeEntry[] = [];
    for (const jt of this.jobTimes.values()) {
      if (jt.job_id === jobId) entries.push(jt);
    }
    return entries;
  }

  /** Get who is currently clocked in. */
  whoClockedIn(): { employee_id: string; name: string; shift_id: string; clock_in: string; active_job?: string }[] {
    const result: { employee_id: string; name: string; shift_id: string; clock_in: string; active_job?: string }[] = [];
    for (const s of this.shifts.values()) {
      if (s.status !== "active") continue;
      const emp = employeeEngine.get(s.employee_id);
      const activeJob = this.getActiveJobTime(s.employee_id);
      result.push({
        employee_id: s.employee_id,
        name: emp ? `${emp.first_name} ${emp.last_name}` : s.employee_id,
        shift_id: s.id,
        clock_in: s.clock_in,
        active_job: activeJob?.job_id,
      });
    }
    return result;
  }

  /** Calculate labor cost for a specific job across all employees. */
  jobLaborCost(jobId: string): {
    job_id: string;
    total_hours: number;
    total_cost: number;
    by_employee: { employee_id: string; name: string; hours: number; cost: number }[];
  } {
    const entries = this.getJobTimeEntries(jobId).filter((e) => e.status === "completed");
    const byEmp = new Map<string, number>();

    for (const e of entries) {
      const hours = (e.productive_minutes ?? 0) / 60;
      byEmp.set(e.employee_id, (byEmp.get(e.employee_id) ?? 0) + hours);
    }

    const byEmployee: { employee_id: string; name: string; hours: number; cost: number }[] = [];
    let totalHours = 0;
    let totalCost = 0;

    for (const [empId, hours] of byEmp) {
      const emp = employeeEngine.get(empId);
      const rate = emp?.hourly_rate ?? 25;
      const cost = hours * rate;
      byEmployee.push({
        employee_id: empId,
        name: emp ? `${emp.first_name} ${emp.last_name}` : empId,
        hours: Math.round(hours * 100) / 100,
        cost: Math.round(cost * 100) / 100,
      });
      totalHours += hours;
      totalCost += cost;
    }

    return {
      job_id: jobId,
      total_hours: Math.round(totalHours * 100) / 100,
      total_cost: Math.round(totalCost * 100) / 100,
      by_employee: byEmployee,
    };
  }

  private timeDiffMinutes(time1: string, time2: string): number {
    const [h1, m1] = time1.split(":").map(Number);
    const [h2, m2] = time2.split(":").map(Number);
    return Math.abs((h2 * 60 + m2) - (h1 * 60 + m1));
  }
}

export const timeClockEngine = new TimeClockEngine();
export { TimeClockEngine };

// ─── Persistence Bridge Registration ────────────────────────────────────────
persistenceBridge.registerMap({
  entity: "time_entries",
  getMap: () => (timeClockEngine as any).shifts as Map<string, any>,
  keyField: "id",
  toRecord: (value) => {
    const shift = value as ShiftEntry;
    const employee = employeeEngine.get(shift.employee_id);
    const totalHours = shift.total_hours ?? 0;
    return {
      shift_entry_id: shift.id,
      employee_id: shift.employee_id,
      employee_name: employee ? `${employee.first_name} ${employee.last_name}`.trim() : shift.employee_id,
      shift_date: shift.clock_in.slice(0, 10),
      clock_in: shift.clock_in,
      clock_out: shift.clock_out,
      hours_worked: totalHours,
      total_hours: totalHours,
      regular_hours: shift.regular_hours ?? Math.max(0, totalHours - (shift.overtime_hours ?? 0) - (shift.double_time_hours ?? 0)),
      overtime_hours: shift.overtime_hours ?? 0,
      double_time_hours: shift.double_time_hours ?? 0,
      break_minutes: shift.break_minutes,
      status: toStoreShiftStatus(shift),
      handoff_notes: shift.handoff_notes,
    };
  },
  fromRecord: (record) => {
    const stored = record as PersistedShiftRecord;
    const totalHours = Number(stored.total_hours ?? stored.hours_worked ?? 0);
    const overtimeHours = Number(stored.overtime_hours ?? 0);
    const doubleTimeHours = Number(stored.double_time_hours ?? 0);
    const regularHours = Number(
      stored.regular_hours ?? Math.max(0, totalHours - overtimeHours - doubleTimeHours),
    );
    return {
      id: stored.shift_entry_id ?? String(stored.id ?? ""),
      employee_id: stored.employee_id ?? "",
      clock_in: stored.clock_in ?? new Date().toISOString(),
      clock_out: stored.clock_out,
      break_minutes: Number(stored.break_minutes ?? 0),
      status: fromStoreShiftStatus(stored),
      total_hours: totalHours,
      regular_hours: regularHours,
      overtime_hours: overtimeHours,
      double_time_hours: doubleTimeHours,
      handoff_notes: stored.handoff_notes,
    } satisfies ShiftEntry;
  },
});
persistenceBridge.registerMap({
  entity: "job_time_entries",
  getMap: () => (timeClockEngine as any).jobTimes as Map<string, any>,
  keyField: "id",
  toRecord: (value) => {
    const entry = value as JobTimeEntry;
    const employee = employeeEngine.get(entry.employee_id);
    const totalMinutes =
      entry.total_minutes ??
      (entry.end_time
        ? Math.round(((new Date(entry.end_time).getTime() - new Date(entry.start_time).getTime()) / 60000) * 100) / 100
        : undefined);
    const productiveMinutes = entry.productive_minutes ?? totalMinutes;
    return {
      job_time_entry_id: entry.id,
      job_id: entry.job_id,
      employee_id: entry.employee_id,
      shift_entry_id: entry.shift_entry_id,
      employee_name: employee ? `${employee.first_name} ${employee.last_name}`.trim() : entry.employee_id,
      operation: entry.operation,
      machine_id: entry.machine_id,
      start_time: entry.start_time,
      end_time: entry.end_time,
      elapsed_min: productiveMinutes,
      total_minutes: totalMinutes,
      productive_minutes: productiveMinutes,
      quantity_completed: entry.good_parts ?? 0,
      scrap_count: entry.scrap_count,
      status: entry.status,
      notes: entry.notes,
      process_type: entry.process_type,
      pause_periods: entry.pause_periods,
      good_parts: entry.good_parts,
      scrap_reason: entry.scrap_reason,
      improvement_note: entry.improvement_note,
      takt_time_sec: entry.takt_time_sec,
      quality_project_id: entry.quality_project_id,
    };
  },
  fromRecord: (record) => {
    const stored = record as PersistedJobTimeRecord;
    const productiveMinutes = Number(stored.productive_minutes ?? stored.elapsed_min ?? 0);
    const totalMinutes =
      stored.total_minutes != null
        ? Number(stored.total_minutes)
        : stored.start_time && stored.end_time
          ? Math.round(((new Date(stored.end_time).getTime() - new Date(stored.start_time).getTime()) / 60000) * 100) / 100
          : productiveMinutes;
    return {
      id: stored.job_time_entry_id ?? String(stored.id ?? ""),
      employee_id: stored.employee_id ?? "",
      shift_entry_id: stored.shift_entry_id ?? "",
      job_id: stored.job_id ?? "",
      operation: stored.operation,
      machine_id: stored.machine_id,
      start_time: stored.start_time ?? new Date().toISOString(),
      end_time: stored.end_time,
      process_type: stored.process_type ?? "production_run",
      pause_periods: parseJsonArray<PausePeriod>(stored.pause_periods),
      status: stored.status ?? "active",
      total_minutes: totalMinutes,
      productive_minutes: productiveMinutes,
      good_parts: stored.good_parts ?? stored.quantity_completed,
      scrap_count: stored.scrap_count,
      scrap_reason: stored.scrap_reason,
      improvement_note: stored.improvement_note,
      takt_time_sec: stored.takt_time_sec,
      quality_project_id: stored.quality_project_id,
      notes: stored.notes ?? "",
    } satisfies JobTimeEntry;
  },
});
