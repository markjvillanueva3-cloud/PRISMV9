; =============================================
; SIEMENS 840D sl — MCALL Pattern Drilling
; Material: A2 Tool Steel
; Tool: 6.8mm carbide drill (for M8 tapped holes)
; Bolt circle pattern: 8 holes, PCD 80mm
; =============================================

N10 G54 G90 G17 G64 SOFT       ; Safe start
N20 T8 D1 M6                   ; 6.8mm carbide drill
N30 S3500 M3                   ; Vc ~75 m/min for tool steel
N40 M8                         ; Coolant ON
N50 G0 Z50                     ; Clearance plane

; Position above pattern center
N60 G0 X75 Y75                 ; Pattern center

; Modal cycle call — MCALL makes the cycle repeat at every position
; CYCLE83 for peck drilling: retract=50, ref=0, safe=2, depth=-25, first peck=-8
N70 MCALL CYCLE83(50, 0, 2, -25, 0, -8, 0, 5, 0.3, 0, 1.0, 1, 0, 3, 1, 0, 0)

; 8-hole bolt circle, PCD = 80mm, center at (75, 75)
; Radius = 40mm, starting at 0 degrees, 45-degree increments
N80 G0 X115.000 Y75.000        ; Hole 1:   0 deg
N90 G0 X103.284 Y103.284       ; Hole 2:  45 deg
N100 G0 X75.000 Y115.000       ; Hole 3:  90 deg
N110 G0 X46.716 Y103.284       ; Hole 4: 135 deg
N120 G0 X35.000 Y75.000        ; Hole 5: 180 deg
N130 G0 X46.716 Y46.716        ; Hole 6: 225 deg
N140 G0 X75.000 Y35.000        ; Hole 7: 270 deg
N150 G0 X103.284 Y46.716       ; Hole 8: 315 deg

; Cancel modal cycle
N160 MCALL                     ; Deactivate MCALL

; Retract and end
N170 G0 Z50
N180 M9
N190 M5
N200 G0 X0 Y0 SUPA
N210 M30
