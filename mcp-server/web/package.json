{
  "name": "prism-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kienzle Academy manufacturing intelligence dashboard (web + Electron desktop + Capacitor mobile shells from one build).",
  "author": "Kienzle Academy",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:analyze": "vite build && node ../scripts/check-bundle-budget.mjs",
    "build:budget": "vite build && node ../scripts/check-bundle-budget.mjs --strict",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "bundle:check": "node ../scripts/check-bundle-budget.mjs",
    "bundle:baseline": "node ../scripts/check-bundle-budget.mjs --save-baseline",
    "electron:start": "electron electron/main.cjs",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron electron/main.cjs\"",
    "electron:build": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir",
    "electron:dist": "node scripts/electron-dist.mjs",
    "electron:dist:nsis": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win nsis",
    "cap:copy": "npm run build && cap copy",
    "cap:sync": "npm run build && cap sync",
    "mobile:add:android": "cap add android",
    "mobile:add:ios": "cap add ios"
  },
  "build": {
    "appId": "tools.prism.app",
    "productName": "Kienzle Academy",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "electron/**",
      {
        "from": "../dist/web",
        "to": "dist"
      }
    ],
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "KienzleAcademy-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kienzle Academy"
    }
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@capacitor/ios": "^6.2.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@monaco-editor/react": "^4.7.0",
    "@nivo/bar": "^0.99.0",
    "@nivo/heatmap": "^0.99.0",
    "@nivo/line": "^0.99.0",
    "@nivo/sankey": "^0.99.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-pdf/renderer": "^4.3.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@tanstack/react-query": "^5.96.2",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.23",
    "@uiw/react-codemirror": "^4.25.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "file-saver": "^2.0.5",
    "framer-motion": "^12.38.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^1.7.0",
    "monaco-editor": "^0.55.1",
    "qrcode": "^1.5.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-dropzone": "^15.0.0",
    "react-grid-layout": "^2.2.3",
    "react-hook-form": "^7.72.1",
    "react-hot-toast": "^2.6.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.9.0",
    "react-router-dom": "7.1.1",
    "react-syntax-highlighter": "^16.1.1",
    "recharts": "2.15.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "three": "^0.183.2",
    "use-debounce": "^10.1.1",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "~4.11.1",
    "@capacitor/cli": "^6.2.1",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/file-saver": "^2.0.7",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "@types/react-grid-layout": "^1.3.6",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "axe-core": "~4.11.1",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^31.7.7",
    "electron-builder": "^25.1.8",
    "jsdom": "^28.1.0",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "5.7.3",
    "vite": "6.0.7",
    "vitest": "^4.0.18",
    "wait-on": "^9.0.10"
  }
}
