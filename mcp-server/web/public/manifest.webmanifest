{
  "name": "Kienzle Manufacturing Academy",
  "short_name": "Kienzle Academy",
  "description": "Shop-floor training, formula cards, and quizzes for CNC machinists. Speed/feed, blueprint reading, GD&T, milling, turning, wire-EDM.",
  "id": "/?source=pwa",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#020617",
  "theme_color": "#06b6d4",
  "categories": ["education", "productivity", "business"],
  "lang": "en-US",
  "dir": "ltr",
  "prefer_related_applications": false,
  "icons": [
