VARIABLES


$W38031018.MIN%

#1= 1.0625(STOCK SIZE PLUS .0625 FOR CLEARANCE)
#2= 0.9(MAJOR OD MINUS OD RADIUS)
#3= 0.9(MAJOR OD)
#4= 0(OD RADIUS)
#5= -0.2555(PART LENGTH PLUS EXTRA CLEARANCE)
#6= 0.6145(MINOR ID)
#7= -0.2655(LENGTH PLUS CUT OFF TOOL WIDTH AND EXTRA MATERIAL)

NBAR
/CALL OBAR
M1
NAT01                    
T010101                  (TOOL HOLDER .032R)
