G140

(** TURN ON BLOCK SKIP TO STOP LOADING OFFSETS)

(SET VARIABLES BELOW)
TOOL=7   (WHERE TO LOAD TOOL OFFSET)
V1=1.098 (TOOL LENGTH FROM TIP OF TOOL TO COLLET)
ANGL=20 (TOOL ANGLE POSITION)

(** DO NOT CHANGE BELOW THIS POINT **)
V2=-2.94(PIVOT POINT X IN DIAMETER - CUSTOMER SPECIFIC)
V3=-1.97(CENTER OF TOOL HOLDER IN Z - CUSTOMER SPECIFIC)
V4=2.30(DIST FROM PIVOT TO COLLET - HOLDER SPECIFIC)

V5=V4+V1(HYP)
V6=SIN[ANGL](Z AXIS)
V7=COS[ANGL](X AXIS)
V8=[[V5*V7]*2]

V11=V8+V2(X OFFSET)
V12=V3+[V5*V6](Z OFFSET)


/VTOFX[TOOL]=V11
/VTOFZ[TOOL]=V12

M30
