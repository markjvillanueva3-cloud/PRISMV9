  "rationale": "Initial snapshot — locks the R5-identified 'cleanest vertical' (WireEdmStudio 6-step wizard stack) against silent drift. Any file-content change or semantic-API drift must be accompanied by a snapshotVersion bump + rationale update in this file.",

  "wizard_schema": {
    "total_steps": 6,
    "step_sequence": ["import", "review", "wcs", "toolpath", "optimize", "program"],
    "step_ids": {
      "import":   { "order": 1, "component": "StepImport.tsx",   "purpose": "CAD intake (DXF/DWG/STEP/PDF) + geometry parse" },
      "review":   { "order": 2, "component": "StepReview.tsx",   "purpose": "Geometry validation + feature review" },
      "wcs":      { "order": 3, "component": "StepWcs.tsx",      "purpose": "Work coordinate system + start-hole selection" },
      "toolpath": { "order": 4, "component": "StepToolpath.tsx", "purpose": "Wire path strategy + rough/skim pass planning" },
      "optimize": { "order": 5, "component": "StepOptimize.tsx", "purpose": "Physics-optimized parameter selection (Ra / MRR / surface)" },
      "program":  { "order": 6, "component": "StepProgram.tsx",  "purpose": "G-code emission via post-processor" }
    },
    "forward_navigation": [
      "advanceToReview", "advanceToWcs", "advanceToToolpath",
      "advanceToOptimize", "advanceToProgram"
    ],
    "backward_navigation": [
      "backToImport", "backToReview", "backToWcs", "backToToolpath", "backToOptimize"
    ]
  },

  "wedm_studio_context": {
    "file": "mcp-server/web/src/contexts/WedmStudioContext.tsx",
    "provider_export": "WedmStudioProvider",
    "hook_exports": ["useWedmNavigation", "useWedmData"],
    "public_types": ["QualityEvent", "WedmJobRecord"],
    "required_navigation_surface": {
      "setCurrentStep": "(step: StepId) => void",
      "currentStep": "StepId",
      "steps": "ReadonlyArray<StepId>"
    },
    "required_data_surface": {
      "markStepComplete": "(step: StepId) => void",
      "markStepError": "(step: StepId, error: string) => void",
      "markStale": "(step: StepId) => void",
      "setStepData": "(step: StepId, data: unknown) => void",
      "setFileInfo": "(info: FileInfo) => void"
    }
  },

  "use_wedm_pipeline": {
    "file": "mcp-server/web/src/hooks/useWedmPipeline.ts",
    "exports": [
      "useWedmStep",
      "useParseGeometry",
      "useValidateGeometry",
      "useSelection",
      "useMultipass",
      "useGcode",
      "useQuickGenerate"
    ]
  },

  "wizard_shell": {
    "file": "mcp-server/web/src/components/wedm-studio/WizardShell.tsx",
    "exported_props_interface": "WizardStepProps"
