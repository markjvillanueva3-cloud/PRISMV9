+  /**
+   * Standing credit review for ONE customer (no pending order). Computes the posture the credit desk
+   * uses to decide whether to release/hold a customer: available credit, utilization, and a risk tier.
+   * Reuses the same credit_limit/current_balance arithmetic as checkCredit (single source).
+   * @param customer_id - the customer to review.
+   * @returns the credit review row.
+   * @throws if the customer is unknown (fail-loud).
+   */
+  reviewCredit(customer_id: string): CreditReview {
+    const cust = this.customers.get(customer_id);
+    if (!cust) throw new Error(`Customer ${customer_id} not found`);
+    return this.buildCreditReview(cust);
+  }
+
+  /**
+   * Batch credit review across ALL customers (the CreditManagementPage desk view). Sorted worst-first
+   * (highest utilization) so the operator sees release-risk customers at the top.
+   * @returns { reviews, summary } -- reviews is the per-customer array the FE renders.
+   */
+  reviewAllCredit(): { reviews: CreditReview[]; summary: { total: number; over_limit: number; on_hold: number; at_risk: number } } {
+    const reviews = [...this.customers.values()]
+      .map((c) => this.buildCreditReview(c))
+      .sort((a, b) => b.utilization_pct - a.utilization_pct);
+    return {
+      reviews,
+      summary: {
+        total: reviews.length,
+        over_limit: reviews.filter((r) => r.over_limit).length,
+        on_hold: reviews.filter((r) => r.risk === "on_hold").length,
+        at_risk: reviews.filter((r) => r.risk === "at_risk" || r.risk === "over_limit").length,
+      },
+    };
+  }
+
+  /** Shared credit-review row builder (single source for reviewCredit + reviewAllCredit). */
+  private buildCreditReview(cust: Customer): CreditReview {
+    const available = cust.credit_limit - cust.current_balance;
+    const over_limit = available < 0;
+    // Utilization as a % of the limit (0 when no limit set, to avoid divide-by-zero).
+    const utilization_pct = cust.credit_limit > 0
+      ? Math.round((cust.current_balance / cust.credit_limit) * 1000) / 10
+      : 0;
+    // Risk tier: an on_hold status dominates; else over-limit; else >=90% utilization is at-risk.
+    const risk: CreditReview["risk"] =
+      cust.status === "on_hold" ? "on_hold"
+        : over_limit ? "over_limit"
+          : utilization_pct >= 90 ? "at_risk"
+            : "ok";
+    return {
+      customer_id: cust.id,
+      customer_name: cust.name,
+      status: cust.status,
+      credit_limit: cust.credit_limit,
+      current_balance: cust.current_balance,
+      available_credit: available,
+      utilization_pct,
+      over_limit,
+      payment_terms: cust.payment_terms,
+      risk,
+    };
+  }
