+/**
+ * A standing credit-review row for the CreditManagementPage desk. Reflects the SHOP's view of a
+ * CUSTOMER's credit posture (limit/balance/utilization) -- not the shop's own cost/margin. Operator-only
+ * (the credit routes are verifyToken-gated), so this carries no anon-leak concern.
+ */
+export interface CreditReview {
+  customer_id: string;
+  customer_name: string;
+  status: Customer['status'];
+  credit_limit: number;
+  current_balance: number;
+  available_credit: number;
+  /** current_balance as a % of credit_limit (0 when no limit). */
+  utilization_pct: number;
+  over_limit: boolean;
+  payment_terms: string;
+  /** Release-risk tier: on_hold (status) > over_limit > at_risk (>=90% util) > ok. */
+  risk: 'ok' | 'at_risk' | 'over_limit' | 'on_hold';
+}
