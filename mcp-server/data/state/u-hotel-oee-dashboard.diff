+  name: string;
+  category: "availability" | "performance" | "quality";
+  minutes_lost: number;
+  description: string;
+}
+
+/** One day of OEE history. Shape mirrors the OEEDashboardPage `TrendDay` FE contract exactly. */
+export interface OEETrendDay {
