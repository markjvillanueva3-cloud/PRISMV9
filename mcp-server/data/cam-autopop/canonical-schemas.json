{
  "schemaVersion": "1.0.0",
  "metadata": {
    "title": "PRISM CAM Auto-Population — Canonical Entity Schemas",
    "description": "Universal canonical schemas for the five CAM autopop entity types — Tool, Holder, Fixture, Machine, CAD Part. These schemas are the contract every per-CAM mapping (Fusion 360, hyperMILL, Mastercam, Inventor HSM, Esprit, SolidCAM) translates to and from. Every field has unit, range, and source-citation metadata so a PRISM canonical record can be losslessly written to or read from any of the six CAM systems. Foundation for Phase 2 (CAM-AUTOPOP-CORE) of L2-CAMX-EXHAUST roadmap; unblocks Phases 3-8 per-CAM rollouts.",
    "version": "2026.04",
    "extractedDate": "2026-04-30",
    "milestone": "CAM-AUTOPOP-CORE-MS0",
    "source": "ISO 13399 (cutting tool data representation) + ISO 26623 (modular tool interfaces, Capto) + DIN 69893 (HSK tool holders) + DIN 69871 + JIS B 6339 (BT taper) + ANSI/ASME B5.50 (CAT taper) + ISO 230-1 / 230-2 (machine kinematics, axis acceptance) + ASME B5.54 (machine accuracy) + STEP AP242 (CAD model exchange) + Autodesk Fusion 360 Tool Library JSON schema + Mastercam .tools-9 reference + hyperMILL Virtual Tool Library (VTL) reference + Autodesk Inventor HSM Tool Library schema + DP Technology Esprit tool DB + SolidCAM Tool Manager schema",
    "entityCount": 5,
    "totalFieldCount": 156,
    "physics_links": [
      "TOOL_GEOMETRY_KIENZLE_MAPPING",
      "HOLDER_TAPER_RUNOUT_BUDGET",
      "FIXTURE_GRIP_FORCE_VS_PART_GEOMETRY",
      "MACHINE_ENVELOPE_REACHABILITY",
      "CAD_MODEL_INERTIA_FROM_GEOMETRY",
      "ISO13399_FIELD_NORMALIZATION",
      "TAPER_INTERFACE_INTERCHANGEABILITY",
      "BALANCE_GRADE_VS_RPM_LIMIT"
    ]
  },
