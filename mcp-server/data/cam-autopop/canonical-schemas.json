            {"name": "taper_angle_deg", "type": "numeric", "description": "Half-angle for taper / chamfer cutters", "min": 0, "max": 90, "unit": "deg"},
            {"name": "tip_geometry", "type": "enum", "values": ["flat", "ball", "bullnose", "tapered_flat", "tapered_ball", "drill_118deg", "drill_135deg", "drill_140deg", "split_point"]}
