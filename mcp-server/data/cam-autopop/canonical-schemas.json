            {"name": "diameter_mm", "type": "numeric", "description": "Cutting diameter — major for taper, OD for endmill", "required": true, "min": 0.05, "max": 200, "unit": "mm"},
            {"name": "length_overall_mm", "type": "numeric", "description": "Total physical length", "required": true, "min": 1, "max": 500, "unit": "mm"},
            {"name": "length_cutting_mm", "type": "numeric", "description": "Flute/cutting-edge engaged length", "min": 0.5, "max": 300, "unit": "mm"},
            {"name": "length_gauge_mm", "type": "numeric", "description": "Distance from holder gauge line to tool tip", "min": 1, "max": 500, "unit": "mm"},
