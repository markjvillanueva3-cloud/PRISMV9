    "quick_electrode": {
      "display_name": "Quick Electrode",
      "category": "quick_electrode",
      "description": "Cimatron's flagship electrode automation — picks burn faces from cavity model, assigns blank, generates EDM program, exports to wire/die-sinker.",
      "dialog_tabs": ["BurnFaces", "Blank", "Reference", "Output"],
      "parameter_count": 16,
      "parameters": {
        "burnFaces": {
          "cavityFaces": { "type": "selection", "tab": "BurnFaces", "required": true },
          "extractionDirection": { "type": "enum", "values": ["+Z", "-Z", "+X", "-X", "+Y", "-Y", "auto"], "default": "+Z", "tab": "BurnFaces", "required": true },
          "burnTolerance": { "type": "number", "unit": "mm", "default": 0.005, "tab": "BurnFaces" },
          "extendFaces": { "type": "boolean", "default": true, "description": "Extend burn faces beyond cavity edge to safe-zone", "tab": "BurnFaces" },
          "extensionLength": { "type": "number", "unit": "mm", "default": 2.0, "tab": "BurnFaces" }
        },
        "blank": {
          "blankShape": { "type": "enum", "values": ["square", "round", "hex", "rectangular", "custom"], "default": "square", "tab": "Blank", "required": true },
          "blankMaterial": { "type": "enum", "values": ["copper", "graphite_EDM3", "graphite_POCO_AF5", "graphite_POCO_EDM200", "tungsten", "tellurium_copper"], "default": "graphite_EDM3", "tab": "Blank" },
          "blankSize": { "type": "number", "unit": "mm", "default": 25, "tab": "Blank" },
          "blankHeight": { "type": "number", "unit": "mm", "default": 30, "tab": "Blank" },
          "shankAttachment": { "type": "enum", "values": ["EROWA", "3R", "MecaTool", "weld", "thread"], "default": "EROWA", "tab": "Blank" }
        },
        "reference": {
          "burnDepth": { "type": "number", "unit": "mm", "default": 0, "description": "0 = auto from cavity depth", "tab": "Reference" },
          "spark_undersizing": { "type": "number", "unit": "mm", "default": 0.1, "description": "Roughing electrode under-size", "tab": "Reference" },
          "finishUndersize": { "type": "number", "unit": "mm", "default": 0.025, "tab": "Reference" }
        },
        "output": {
          "generateBlueprint": { "type": "boolean", "default": true, "tab": "Output" },
          "generateBOM": { "type": "boolean", "default": true, "tab": "Output" },
          "exportFormat": { "type": "enum", "values": ["dxf_2D", "step_3D", "iges_3D", "native"], "default": "step_3D", "tab": "Output" }
        }
      }
