      {"id": "tt_ded_preheat", "text": "Always preheat substrate to 250-400C before DED repair on H13 die steel — prevents thermal-shock cracking at boundary.", "source": "shop_floor", "confidence": 0.92},
      {"id": "tt_ded_argon_purity", "text": "DED on Ti-6Al-4V requires Argon shielding gas at >= 99.998% purity to prevent oxide inclusions; even brief atmospheric exposure ruins the part.", "source": "fusion_help", "confidence": 0.95},
      {"id": "tt_pbf_orientation", "text": "Orient parts with critical surfaces facing +Z (up-skin) — down-skin surfaces are always rougher (Ra 8-15 um) due to support interface.", "source": "open_mind_docs", "confidence": 0.9},
      {"id": "tt_pbf_powder_drainage", "text": "Hollow PBF parts MUST have powder drainage holes (>= 3mm) at lowest points — trapped powder = scrap part + cleaning headache.", "source": "shop_floor", "confidence": 0.93},
      {"id": "tt_hybrid_cooling", "text": "Hybrid DED+mill: wait at least 30s + probe before milling — thermal growth in build can be 0.2-0.5mm; milling hot causes scrap.", "source": "shop_floor", "confidence": 0.88},
      {"id": "tt_fdm_layer_orientation", "text": "FDM tensile strength is 30-50% weaker in Z direction than X/Y — orient parts so principal stress is in print plane.", "source": "fusion_help", "confidence": 0.9}
    ]
