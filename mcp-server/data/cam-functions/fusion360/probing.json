  "toolpaths": {
    "PROBE_WCS_SINGLE_SURFACE": {
      "description": "Probe a single surface to set the Z origin (typically stock top). Most common WCS-setup probe.",
      "category": "Probe_WCS",
      "parameterCount": 14,
      "tabs": {
        "Tool": {
          "parameters": [
            {"name": "Probe Tool", "type": "selection", "description": "Spindle-mounted probe (Renishaw OMP60/RMP60/MP250)", "required": true},
            {"name": "Tool Number", "type": "numeric", "description": "Probe tool number in magazine", "default": 99, "unit": "count"},
            {"name": "Probe Feedrate", "type": "numeric", "description": "Slow approach feedrate", "default": 100, "unit": "mm/min", "min": 10, "max": 500}
          ]
        },
        "Geometry": {
          "parameters": [
            {"name": "Probe Surface", "type": "selection", "description": "Surface to probe (top of stock or feature)", "required": true},
            {"name": "WCS Index", "type": "dropdown", "description": "Work coordinate to update", "options": ["G54", "G55", "G56", "G57", "G58", "G59", "G54.1_P1", "G54.1_P2"], "default": "G54"},
            {"name": "Axis to Update", "type": "dropdown", "description": "Which axis offset to set", "options": ["X", "Y", "Z"], "default": "Z"}
          ]
        },
        "Probe": {
          "parameters": [
            {"name": "Approach Distance", "type": "numeric", "description": "Distance to retract before probe move", "default": 5, "unit": "mm", "min": 0.5, "max": 50},
            {"name": "Overtravel", "type": "numeric", "description": "Max distance past expected surface before fail", "default": 1, "unit": "mm", "min": 0.1, "max": 10},
            {"name": "Probe Feedrate Slow", "type": "numeric", "description": "Final slow approach for accuracy", "default": 50, "unit": "mm/min"},
            {"name": "Probe Feedrate Fast", "type": "numeric", "description": "Initial fast approach", "default": 500, "unit": "mm/min"}
          ]
        },
        "Action": {
          "parameters": [
            {"name": "Update WCS Offset", "type": "checkbox", "description": "Write measured value to WCS register", "default": true},
            {"name": "Print Result", "type": "checkbox", "description": "Echo measurement to console / DPRNT", "default": true}
          ]
        },
        "Output": {
          "parameters": [
            {"name": "Output Variable Number", "type": "numeric", "description": "Macro variable for measured value (e.g. #500)", "default": 500, "min": 100, "max": 999},
            {"name": "Tolerance Window", "type": "numeric", "description": "Max deviation from nominal before alarm", "default": 0.5, "unit": "mm"}
          ]
        }
      }
    },
    "PROBE_WCS_2_AXIS_CORNER": {
      "description": "Probe a 2-axis corner (X+Y) to set both X and Y origins from a stock corner.",
      "category": "Probe_WCS",
      "parameterCount": 16,
      "tabs": {
        "Geometry": {
          "parameters": [
            {"name": "Corner Edge X", "type": "selection", "description": "Edge defining X reference", "required": true},
            {"name": "Corner Edge Y", "type": "selection", "description": "Edge defining Y reference", "required": true},
            {"name": "WCS Index", "type": "dropdown", "options": ["G54", "G55", "G56", "G57", "G58", "G59"], "default": "G54"},
            {"name": "Corner Direction", "type": "dropdown", "description": "Which corner of stock", "options": ["X+Y+", "X+Y-", "X-Y+", "X-Y-"], "default": "X-Y-"}
          ]
        },
        "Probe": {
          "parameters": [
            {"name": "Probe X First", "type": "checkbox", "description": "Probe X axis before Y axis", "default": true},
            {"name": "Edge Offset From Corner", "type": "numeric", "description": "How far in from corner along edge to probe", "default": 10, "unit": "mm"},
            {"name": "Approach Distance", "type": "numeric", "default": 5, "unit": "mm"},
            {"name": "Overtravel", "type": "numeric", "default": 1, "unit": "mm"},
            {"name": "Probe Feedrate Slow", "type": "numeric", "default": 50, "unit": "mm/min"},
            {"name": "Probe Feedrate Fast", "type": "numeric", "default": 500, "unit": "mm/min"},
            {"name": "Z Probe Depth Below Corner", "type": "numeric", "description": "Drop probe below stock-top before X/Y probe", "default": 5, "unit": "mm"}
          ]
        },
        "Action": {
          "parameters": [
            {"name": "Update WCS Offset", "type": "checkbox", "default": true},
            {"name": "Print Result", "type": "checkbox", "default": true},
            {"name": "Avoid Burr at Corner", "type": "checkbox", "description": "Add safe approach to avoid corner burr", "default": true}
          ]
        },
        "Output": {
          "parameters": [
            {"name": "Output Variable X", "type": "numeric", "default": 500},
            {"name": "Output Variable Y", "type": "numeric", "default": 501}
          ]
        }
      }
    },
    "PROBE_WCS_3_AXIS_CORNER": {
      "description": "Probe a 3-axis corner (X+Y+Z) to set all three origins from a stock corner.",
      "category": "Probe_WCS",
      "parameterCount": 16,
      "tabs": {
        "Geometry": {
          "parameters": [
            {"name": "Corner Edge X", "type": "selection", "required": true},
            {"name": "Corner Edge Y", "type": "selection", "required": true},
            {"name": "Top Surface", "type": "selection", "description": "Surface for Z reference", "required": true},
            {"name": "WCS Index", "type": "dropdown", "options": ["G54", "G55", "G56", "G57", "G58", "G59"], "default": "G54"}
          ]
        },
        "Probe": {
          "parameters": [
            {"name": "Probe Sequence", "type": "dropdown", "description": "Order of axis probes", "options": ["Z_then_X_then_Y", "X_then_Y_then_Z", "Z_first_quick"], "default": "Z_then_X_then_Y"},
            {"name": "Edge Offset From Corner", "type": "numeric", "default": 10, "unit": "mm"},
            {"name": "Approach Distance", "type": "numeric", "default": 5, "unit": "mm"},
            {"name": "Overtravel", "type": "numeric", "default": 1, "unit": "mm"},
            {"name": "Z Probe Depth Below Top", "type": "numeric", "default": 3, "unit": "mm"},
            {"name": "Probe Feedrate Slow", "type": "numeric", "default": 50, "unit": "mm/min"},
            {"name": "Probe Feedrate Fast", "type": "numeric", "default": 500, "unit": "mm/min"}
          ]
        },
        "Action": {
          "parameters": [
            {"name": "Update WCS Offset", "type": "checkbox", "default": true},
            {"name": "Print Result", "type": "checkbox", "default": true},
            {"name": "Pre-Position Above Stock", "type": "checkbox", "description": "Rapid to stock-top + clearance before cycle", "default": true}
          ]
        },
        "Output": {
          "parameters": [
            {"name": "Output Variable X", "type": "numeric", "default": 500},
            {"name": "Output Variable Y", "type": "numeric", "default": 501},
            {"name": "Output Variable Z", "type": "numeric", "default": 502}
          ]
        }
      }
    },
    "PROBE_WCS_WEB": {
      "description": "Probe both sides of a web (raised feature) and set WCS to the midpoint.",
      "category": "Probe_WCS",
      "parameterCount": 14,
      "tabs": {
        "Geometry": {
          "parameters": [
            {"name": "Web Feature", "type": "selection", "description": "The raised feature to probe", "required": true},
            {"name": "Probe Axis", "type": "dropdown", "description": "Axis along which to probe", "options": ["X", "Y"], "default": "X"},
            {"name": "Approximate Width", "type": "numeric", "description": "Nominal web width for travel calc", "required": true, "unit": "mm"},
            {"name": "WCS Index", "type": "dropdown", "options": ["G54", "G55", "G56", "G57", "G58", "G59"], "default": "G54"}
          ]
        },
        "Probe": {
          "parameters": [
            {"name": "Approach Distance", "type": "numeric", "default": 5, "unit": "mm"},
            {"name": "Overtravel", "type": "numeric", "default": 1, "unit": "mm"},
            {"name": "Probe Feedrate Slow", "type": "numeric", "default": 50, "unit": "mm/min"},
            {"name": "Probe Feedrate Fast", "type": "numeric", "default": 500, "unit": "mm/min"},
            {"name": "Z Probe Depth", "type": "numeric", "description": "How far below web-top to probe sides", "default": 2, "unit": "mm"}
          ]
        },
        "Action": {
          "parameters": [
            {"name": "Update WCS to Midpoint", "type": "checkbox", "default": true},
            {"name": "Output Width", "type": "checkbox", "description": "Capture measured width for size verify", "default": true}
          ]
        },
        "Output": {
          "parameters": [
            {"name": "Output Variable Center", "type": "numeric", "default": 500},
            {"name": "Output Variable Width", "type": "numeric", "default": 501},
            {"name": "Width Tolerance", "type": "numeric", "default": 0.05, "unit": "mm"}
          ]
        }
      }
    },
