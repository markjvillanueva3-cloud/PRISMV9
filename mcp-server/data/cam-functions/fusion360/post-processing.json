    "POST_SECTION_HEADERS": {
      "description": "onSection() emission — fires at the start of each toolpath operation. Emits operation comment, tool-change block, WCS selection (G54..G59 / G54.1 Pn), spindle / coolant start, work-plane / TCP activation, safe-Z retract, and pre-positioning rapid. Owns the boundary between operations.",
      "category": "Section",
      "parameterCount": 22,
      "tabs": {
        "Output": {
          "parameters": [
            {"name": "Show Operation Notes", "type": "checkbox", "default": true},
            {"name": "Show Tool Description", "type": "checkbox", "description": "Emit '(T## D=12 R=0.5 FLUTES=4 CR=0)' style banner", "default": true},
            {"name": "Show Coolant Comment", "type": "checkbox", "default": false},
            {"name": "Use Operation Comment", "type": "checkbox", "default": true},
            {"name": "Operation Comment Template", "type": "text", "description": "printf template, %s = strategy, %s = comment", "default": "(%s : %s)"},
            {"name": "Show Section Header", "type": "checkbox", "description": "Emit boxed section banner '(========)'", "default": true},
            {"name": "Header Banner Char", "type": "text", "default": "="},
            {"name": "Show Multiple Tool Comment", "type": "checkbox", "description": "Warn when re-using same tool number", "default": true}
          ]
        },
        "Grammar": {
          "parameters": [
            {"name": "Force Spindle On Tool Change", "type": "checkbox", "description": "Always re-emit M03 even if modal", "default": true},
            {"name": "Force Coolant On Tool Change", "type": "checkbox", "default": true},
            {"name": "Force WCS On Tool Change", "type": "checkbox", "default": true},
            {"name": "Force Plane On Section", "type": "checkbox", "description": "Re-emit G17/G18/G19", "default": false},
            {"name": "Stop Spindle On Tool Change", "type": "checkbox", "description": "Insert M05 before T## M06", "default": true},
            {"name": "Use M01 Between Sections", "type": "checkbox", "description": "Optional-stop between operations for prove-out", "default": false}
          ]
        },
        "Controller": {
          "parameters": [
            {"name": "Pre Tool Change Sequence", "type": "text", "description": "Lines emitted before T## M06 (e.g. 'M09\\nG28 G91 Z0')", "default": "M09\nG91 G28 Z0"},
            {"name": "Post Tool Change Sequence", "type": "text", "description": "Lines emitted after T## M06"},
            {"name": "Tool Length Compensation Code", "type": "dropdown", "options": ["G43", "G44", "G43_negative", "no_comp_inline_offset"], "default": "G43"},
            {"name": "Length Comp Register Format", "type": "text", "description": "H#### offset register format", "default": "H%02d"},
            {"name": "Cutter Comp G Code", "type": "dropdown", "options": ["G40", "G41", "G42"], "default": "G40", "description": "Cutter-compensation default off-state per section"},
            {"name": "First Section Force Header", "type": "checkbox", "description": "Always emit full preamble on first section", "default": true},
            {"name": "Section End Retract Mode", "type": "dropdown", "options": ["clearance_height", "safe_z_g53", "machine_home", "tool_change_height"], "default": "safe_z_g53"},
            {"name": "Emit Work Offset On Section", "type": "checkbox", "description": "Re-emit G54..G59 each section", "default": true}
          ]
        }
      }
    },
    "POST_LINEAR_MOTION": {
      "description": "Linear motion emission — onLinear (G01), onLinearRapid / onRapid (G00), onLinear5D (with rotary axes). Owns axis word ordering (X then Y then Z then ABC), feed-rate emission, modal preservation, and rapid-vs-feed boundary detection. Includes 5-axis simultaneous moves with TCP/RTCP compensation when enabled.",
