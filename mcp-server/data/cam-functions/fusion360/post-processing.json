          "parameters": [
            {"name": "Controller Family", "type": "dropdown", "options": ["fanuc_0i", "fanuc_30i", "fanuc_31i", "fanuc_15i", "mazak_smooth_g", "mazak_smooth_x", "mazatrol", "okuma_osp_p200", "okuma_osp_p300", "heidenhain_tnc640", "heidenhain_itnc530", "siemens_840d_sl", "siemens_828d", "haas_ngc", "haas_classic", "doosan_fanuc", "hurco_winmax", "centroid_acorn", "linuxcnc", "mach3", "mach4"], "default": "fanuc_30i", "required": true},
            {"name": "Controller Sub Variant", "type": "text", "description": "Free-form sub-variant identifier (e.g. 'mazak_integrex_i200s_smooth_g')"},
