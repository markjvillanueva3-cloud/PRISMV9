  "toolpaths": {
    "POST_KERNEL_DEFINE": {
      "description": "Top-level post.cps kernel definition — declares the post processor identity, capabilities, supported operations, and entry-point handler functions (onOpen, onSection, onClose, onParameter, onCommand). Sets the contract every controller variant inherits.",
      "category": "Kernel",
      "parameterCount": 23,
      "tabs": {
        "Grammar": {
          "parameters": [
            {"name": "Post Description", "type": "text", "description": "Human-readable post name (e.g. 'Generic Fanuc 30i Mill')", "required": true},
            {"name": "Vendor", "type": "text", "description": "Vendor brand (Autodesk, machine builder, third party)", "required": true},
            {"name": "Legal Notice", "type": "text", "description": "Copyright / licence string emitted in NC header"},
            {"name": "Certification Level", "type": "dropdown", "options": ["uncertified", "verified", "certified", "production"], "default": "verified"},
            {"name": "Long Description", "type": "text", "description": "Multi-line description of capabilities and limits"},
            {"name": "Extension", "type": "text", "description": "Default NC file extension (nc, mpf, h, ngc, eia)", "default": "nc"},
            {"name": "Set Code Page", "type": "dropdown", "options": ["ascii", "ansi", "utf-8", "utf-16-le"], "default": "ansi"},
            {"name": "Capabilities Bitmask", "type": "dropdown", "options": ["CAPABILITY_MILLING", "CAPABILITY_TURNING", "CAPABILITY_JET", "CAPABILITY_INTERMEDIATE", "CAPABILITY_PROBING", "CAPABILITY_ADDITIVE", "CAPABILITY_INSPECTION"], "multi": true, "required": true},
            {"name": "Tolerance Default", "type": "numeric", "description": "Internal arc-fit linearisation tolerance", "default": 0.002, "unit": "mm"},
            {"name": "Minimum Chord Length", "type": "numeric", "description": "Below this length a linear move is collapsed", "default": 0.001, "unit": "mm"},
            {"name": "Minimum Circular Radius", "type": "numeric", "default": 0.01, "unit": "mm"},
            {"name": "Maximum Circular Radius", "type": "numeric", "default": 1000, "unit": "mm"},
            {"name": "Minimum Circular Sweep", "type": "numeric", "default": 0.01, "unit": "deg"},
            {"name": "Maximum Circular Sweep", "type": "numeric", "default": 180, "unit": "deg"}
          ]
        },
        "Format": {
          "parameters": [
            {"name": "Allow Helical Moves", "type": "checkbox", "default": true},
            {"name": "Allow Spiral Moves", "type": "checkbox", "default": false},
            {"name": "Allow Full Circular Moves", "type": "checkbox", "description": "G2/G3 with sweep=360°", "default": false}
          ]
        },
        "Controller": {
          "parameters": [
            {"name": "Highfeed Mapping", "type": "dropdown", "options": ["highfeed_no_mapping", "highfeed_mapping_all", "highfeed_mapping_only_g00"], "default": "highfeed_no_mapping"},
            {"name": "Highfeed Rate", "type": "numeric", "description": "Mapped highfeed value when mapping enabled", "default": 5000, "unit": "mm/min"}
          ]
        },
        "Simulation": {
          "parameters": [
            {"name": "Probe Generates Machine Coordinates", "type": "checkbox", "default": true},
            {"name": "Probe Use Machine WCS", "type": "checkbox", "default": false},
            {"name": "Generate XML Document Reference", "type": "checkbox", "description": "Emit doc.xml alongside NC file", "default": false}
          ]
        },
        "Output": {
          "parameters": [
            {"name": "Allow Machine Change Position", "type": "checkbox", "default": true}
          ]
        }
      }
    },
    "POST_FORMATS_AND_OUTPUT": {
      "description": "Number-format and output emission rules — decimal precision per quantity (XYZ, IJK, F, S, A/B/C, R, P, Q), unit system (mm/inch), feed mode (per-minute / per-rev / inverse-time / FRN), modal vs non-modal G-codes, block numbering, comment style. Drives every numeric token written to the NC file.",
      "category": "Format",
      "parameterCount": 24,
      "tabs": {
        "Format": {
          "parameters": [
            {"name": "Unit", "type": "dropdown", "options": ["MM", "IN"], "default": "MM"},
            {"name": "XYZ Decimals", "type": "numeric", "default": 3, "min": 0, "max": 6},
            {"name": "ABC Decimals", "type": "numeric", "default": 3, "min": 0, "max": 6, "description": "Rotary axis decimal digits"},
            {"name": "IJK Decimals", "type": "numeric", "default": 4, "min": 0, "max": 6, "description": "Arc-centre incremental decimal digits"},
            {"name": "Feedrate Decimals", "type": "numeric", "default": 0, "min": 0, "max": 4},
            {"name": "Spindle Decimals", "type": "numeric", "default": 0, "min": 0, "max": 4},
            {"name": "Tool Number Format", "type": "text", "description": "T## / T#### printf-style", "default": "%02d"},
            {"name": "Decimal Separator", "type": "dropdown", "options": [".", ","], "default": "."},
            {"name": "Force Sign on Positive", "type": "checkbox", "default": false},
            {"name": "Strip Trailing Zeros", "type": "checkbox", "default": true},
            {"name": "Strip Leading Zero on Decimal", "type": "checkbox", "description": "0.5 → .5", "default": false}
          ]
        },
        "Output": {
          "parameters": [
            {"name": "Feed Output Mode", "type": "dropdown", "options": ["per_minute", "per_rev", "inverse_time", "FRN"], "default": "per_minute"},
            {"name": "Show Sequence Numbers", "type": "checkbox", "default": true},
            {"name": "Sequence Number Start", "type": "numeric", "default": 10, "min": 1, "max": 99999},
            {"name": "Sequence Number Increment", "type": "numeric", "default": 5, "min": 1, "max": 99},
            {"name": "Restart Sequence Numbers Per Section", "type": "checkbox", "default": false},
            {"name": "Comment Open", "type": "text", "description": "Block-comment opener (e.g. '(' or ';')", "default": "("},
            {"name": "Comment Close", "type": "text", "default": ")"},
            {"name": "Use Block Skip", "type": "checkbox", "description": "Emit '/' on optional blocks", "default": false},
            {"name": "Use M03 / M04 Direction", "type": "checkbox", "default": true},
            {"name": "Always Output Modal", "type": "checkbox", "description": "Re-emit even when state unchanged", "default": false}
          ]
        },
        "Grammar": {
          "parameters": [
            {"name": "Maximum Line Length", "type": "numeric", "description": "NC controller line buffer cap", "default": 80, "min": 40, "max": 256, "unit": "chars"},
            {"name": "Use Parentheses In Comments", "type": "checkbox", "default": true},
            {"name": "Show Notes", "type": "checkbox", "description": "Emit user-authored note comments", "default": true}
          ]
        }
      }
    },
    "POST_CONTROLLER_VARIANT": {
      "description": "Controller-dialect variant table — Fanuc 0i / 30i / 31i, Mazak Smooth-G + EIA-Mazatrol, Okuma OSP-P200 / OSP-P300, Heidenhain TNC 640 / iTNC 530, Siemens 840D / Sinumerik, Haas NGC, Doosan, Hurco. Resolves vendor-specific G/M code overrides, axis letter mapping, WCS schedule format (G54-G59 vs G54.1 P1..P48 vs G500), spindle command syntax, and tool-change ritual.",
      "category": "Controller",
      "parameterCount": 24,
      "tabs": {
