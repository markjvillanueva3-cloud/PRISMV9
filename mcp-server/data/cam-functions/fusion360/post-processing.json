            {"name": "Tool Change Style", "type": "dropdown", "options": ["fanuc_M06", "mazak_M06_with_T", "okuma_M06_with_TC", "heidenhain_TOOL_CALL", "siemens_T_then_M06", "haas_M06_after_T"], "default": "fanuc_M06"},
            {"name": "Axis Letter A", "type": "text", "description": "Override rotary letter (A, B, C, U, V, W)", "default": "A"},
