          "parameters": [
            {"name": "Axis Output Order", "type": "text", "description": "Axis word emit order (XYZABCUVW)", "default": "XYZABC"},
            {"name": "Allow Rapid Diagonal", "type": "checkbox", "description": "Allow G00 with multi-axis (false = decompose to single-axis sequence)", "default": true},
            {"name": "Maximum Rapid Block", "type": "numeric", "description": "Cap rapid distance per block (chunked beyond)", "default": 0, "unit": "mm", "description_extra": "0 = no cap"},
            {"name": "Force Linear Mode On First Move", "type": "checkbox", "description": "Always emit G01 on first cutting move", "default": true},
            {"name": "Force XYZ Output On Move", "type": "checkbox", "description": "Re-emit unchanged axis word", "default": false}
