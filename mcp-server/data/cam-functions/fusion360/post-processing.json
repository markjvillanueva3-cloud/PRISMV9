            {"name": "Conversational Mode", "type": "dropdown", "options": ["iso_g_code", "mazatrol", "tnc_klartext", "winmax_conversational"], "default": "iso_g_code"},
            {"name": "Use Extended WCS", "type": "checkbox", "description": "Enable G54.1 P1..P48 (Fanuc) / G500-G599 (Siemens)", "default": false},
            {"name": "Extended WCS Count", "type": "numeric", "default": 48, "min": 6, "max": 300},
