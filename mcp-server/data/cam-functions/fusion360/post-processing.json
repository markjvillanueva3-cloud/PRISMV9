            {"name": "G95 Code", "type": "text", "description": "Feed/rev", "default": "G95"},
            {"name": "Rapid Override Cap", "type": "numeric", "description": "Cap rapid traverse rate (machine-specific)", "default": 0, "unit": "mm/min", "description_extra": "0 = controller default"}
          ]
        },
        "Output": {
          "parameters": [
