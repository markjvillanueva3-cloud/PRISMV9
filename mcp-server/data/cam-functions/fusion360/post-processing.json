            {"name": "Coolant Off Code", "type": "text", "default": "M09"},
            {"name": "End Of Program Code", "type": "text", "description": "M02 vs M30 vs M99 (subprogram)", "default": "M30"},
            {"name": "Optional Stop Code", "type": "text", "default": "M01"},
            {"name": "Use TCP Compensation", "type": "checkbox", "description": "Enable G43.4 / TCPM / TRAORI / RTCP", "default": false},
            {"name": "TCP Code Variant", "type": "dropdown", "options": ["fanuc_G43_4", "fanuc_G43_5", "heidenhain_M128", "heidenhain_FUNCTION_TCPM", "siemens_TRAORI", "siemens_TRAFOOF", "okuma_G169"], "default": "fanuc_G43_4"},
            {"name": "Safe Retract Code", "type": "text", "description": "Safe-Z retract on tool change / E-stop recovery", "default": "G53 G00 Z0"},
            {"name": "Program Number Format", "type": "text", "description": "O#### vs %#### vs N#### header", "default": "O%04d"}
