            {"name": "Feed Word", "type": "text", "default": "F"}
          ]
        },
        "Controller": {
          "parameters": [
            {"name": "Use Inverse Time Feed In 5D", "type": "checkbox", "description": "Switch to FRN (G93) for 5-axis simultaneous", "default": false},
            {"name": "G93 Code", "type": "text", "default": "G93"},
