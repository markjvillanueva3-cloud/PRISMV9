    "CMM_PLAN_GENERATE": {
      "description": "Auto-generate a CMM inspection path from a GD&T-tagged CAD model. Plans probe approach order, sampling density, collision-aware retracts, and writes a portable inspection plan (DMIS / QIF). Used to convert an Inspect-tab feature list into a deterministic measurement program.",
      "category": "Planning",
      "parameterCount": 22,
      "tabs": {
        "Process": {
          "parameters": [
            {"name": "Probe Selection", "type": "selection", "description": "CMM probe head + tip from probe library", "required": true},
            {"name": "Contact Mode", "type": "dropdown", "options": ["touch_trigger", "scanning", "non_contact_optical"], "default": "touch_trigger"},
            {"name": "Approach Mode", "type": "dropdown", "options": ["normal_to_surface", "axis_aligned", "polar"], "default": "normal_to_surface"},
            {"name": "Retract Distance", "type": "numeric", "description": "Standard retract clearance after each probe hit", "default": 5, "unit": "mm", "min": 1, "max": 50}
          ]
        },
        "Geometry": {
          "parameters": [
            {"name": "Part Geometry Input", "type": "selection", "description": "STEP / Fusion design body to inspect", "required": true},
            {"name": "Datum Features", "type": "selection", "description": "Datums A/B/C from drawing", "required": true},
            {"name": "GDT Features To Inspect", "type": "selection", "description": "Feature control frames to validate", "required": true},
            {"name": "Exclusion Zones", "type": "selection", "description": "Fixture / clamp / no-probe areas"},
            {"name": "Fixture Geometry", "type": "selection", "description": "Fixture solid for collision check"}
          ]
        },
        "Inspection": {
          "parameters": [
            {"name": "Sampling Density", "type": "dropdown", "options": ["coarse_5pt", "standard_uniform", "fine_grid", "adaptive_curvature"], "default": "standard_uniform"},
            {"name": "Path Optimization Method", "type": "dropdown", "options": ["nearest_neighbor", "tsp_2opt", "axis_priority", "manual_sequence"], "default": "tsp_2opt"},
            {"name": "Collision Check", "type": "checkbox", "description": "Voxel-based collision check against fixture + part", "default": true},
            {"name": "Retract Strategy", "type": "dropdown", "options": ["minimum_clearance", "safe_plane", "feature_local"], "default": "feature_local"},
            {"name": "Simulation Mode", "type": "dropdown", "options": ["off", "kinematic_only", "full_collision"], "default": "kinematic_only"},
            {"name": "Plan Uncertainty Budget", "type": "numeric", "description": "Max allowable plan-level measurement uncertainty (ISO 15530-3)", "default": 5, "unit": "um"}
          ]
        },
        "Analysis": {
          "parameters": [
            {"name": "Plan Quality Score", "type": "numeric", "description": "Computed score 0-100 for coverage + path efficiency + uncertainty", "default": 0, "min": 0, "max": 100},
            {"name": "Time Estimate Seconds", "type": "numeric", "description": "Predicted total cycle time including all probe approaches + retracts", "default": 0, "unit": "s"},
            {"name": "Point Count Total", "type": "numeric", "description": "Sum of probe contacts across all features", "default": 0},
            {"name": "Deviation Threshold", "type": "numeric", "description": "Plan flags features whose nominal sits within this band of GDT zone edge", "default": 0.5, "unit": "frac_zone"}
          ]
        },
        "Report": {
          "parameters": [
            {"name": "Plan Format", "type": "dropdown", "options": ["DMIS_5_2", "QIF_3_0", "I++_DME", "Native_Fusion"], "default": "QIF_3_0"},
            {"name": "Output Path", "type": "text", "description": "File path for generated plan"},
            {"name": "Plan ID", "type": "text", "description": "Unique plan identifier for traceability"}
          ]
        }
      }
    },
    "CMM_SAMPLING_STRATEGY": {
      "description": "Define point-density, scan-pattern, and datum-sequence sampling strategy for a single feature or feature group. Drives how many points, where they land, and the order of measurement to satisfy gauge capability requirements (typically Cg ≥ 1.33).",
      "category": "Planning",
      "parameterCount": 18,
      "tabs": {
        "Process": {
          "parameters": [
            {"name": "Probe Type", "type": "dropdown", "options": ["touch_trigger", "scanning_analog", "laser_line", "optical_camera"], "default": "touch_trigger"},
            {"name": "Contact Mode", "type": "dropdown", "options": ["single_point", "continuous_scan", "patch_scan"], "default": "single_point"},
            {"name": "Scan Speed", "type": "numeric", "description": "Path velocity during scanning", "default": 5, "unit": "mm/s", "min": 0.5, "max": 100}
          ]
        },
        "Geometry": {
          "parameters": [
            {"name": "Feature Type", "type": "dropdown", "options": ["plane", "cylinder", "sphere", "cone", "torus", "freeform_surface", "edge"], "default": "plane"},
            {"name": "Feature Size mm", "type": "numeric", "description": "Characteristic size — diameter for cylinder, side length for plane", "default": 25, "unit": "mm"},
            {"name": "Datum Reference", "type": "dropdown", "options": ["primary_only", "primary_secondary", "ABC_full"], "default": "ABC_full"}
          ]
        },
        "Inspection": {
          "parameters": [
            {"name": "Sampling Method", "type": "dropdown", "options": ["uniform_grid", "spiral_helix", "stratified_random", "adaptive_curvature", "feature_aware"], "default": "uniform_grid"},
            {"name": "Point Count", "type": "numeric", "description": "Total measured points for this feature", "default": 25, "min": 4, "max": 10000},
            {"name": "Point Distribution", "type": "dropdown", "options": ["uniform", "clustered_at_edges", "clustered_at_features", "high_curvature_weighted"], "default": "uniform"},
            {"name": "Scan Pattern", "type": "dropdown", "options": ["raster", "zigzag", "spiral_in_out", "boustrophedon", "morphed"], "default": "raster"},
            {"name": "Density Per Area", "type": "numeric", "description": "Points per square millimeter (overrides Point Count when > 0)", "default": 0, "unit": "pt/mm2"},
            {"name": "Edge Buffer", "type": "numeric", "description": "Distance from feature edge to first probe point", "default": 0.5, "unit": "mm", "min": 0.05, "max": 5}
          ]
        },
        "Analysis": {
          "parameters": [
            {"name": "Coverage Percent", "type": "numeric", "description": "Predicted coverage of feature surface area (%)", "default": 0, "unit": "pct", "min": 0, "max": 100},
            {"name": "Uniformity Index", "type": "numeric", "description": "0-1 score of how uniform actual sampling will be vs ideal", "default": 0, "min": 0, "max": 1},
            {"name": "Gauge Capability Index", "type": "numeric", "description": "Predicted Cg from sampling plan + tolerance band", "default": 0, "min": 0}
          ]
        },
        "Report": {
          "parameters": [
            {"name": "Output Format", "type": "dropdown", "options": ["DMIS", "QIF", "I++_DME", "csv"], "default": "QIF"},
            {"name": "Report Fields", "type": "selection", "description": "Which sampling-strategy fields to include in the inspection report"},
            {"name": "Sample Log", "type": "checkbox", "description": "Write per-point log to CSV for traceability", "default": true}
          ]
        }
      }
    },
    "TOLERANCE_STACK_ANALYZE": {
      "description": "Closed-form tolerance stack-up analysis (root-sum-square + worst-case) of a dimensional chain. Computes the resultant tolerance on a target dimension given individual contributor tolerances and their fit assumptions. Used during DFM and inspection-budget allocation.",
      "category": "Analysis",
      "parameterCount": 16,
      "tabs": {
        "Process": {
          "parameters": [
            {"name": "Analysis Method", "type": "dropdown", "options": ["worst_case_arithmetic", "rss_root_sum_square", "modified_rss_benderized", "six_sigma_motorola"], "default": "rss_root_sum_square"},
            {"name": "Contributor Basis", "type": "dropdown", "description": "Whether to interpret contributor values as ±range or as Cpk-derived 6σ", "options": ["nominal_plus_minus", "six_sigma_3sigma_each_side", "two_sigma", "one_sigma"], "default": "nominal_plus_minus"}
          ]
        },
        "Geometry": {
          "parameters": [
            {"name": "Assembly Definition", "type": "selection", "description": "Assembly or part containing the dimensional chain", "required": true},
            {"name": "Feature Chain", "type": "selection", "description": "Ordered list of features forming the chain", "required": true},
            {"name": "Datum Sequence", "type": "selection", "description": "Datum reference frame defining chain origin"},
            {"name": "Target Dimension", "type": "numeric", "description": "Resultant nominal dimension being analyzed", "unit": "mm"}
          ]
        },
        "Inspection": {
          "parameters": [
            {"name": "Contributor Count", "type": "numeric", "description": "Number of dimensional contributors in the chain", "default": 0, "min": 1, "max": 200},
            {"name": "Contributor Tolerances", "type": "selection", "description": "Per-contributor tolerance values (manual or auto-extracted)"},
            {"name": "Fit Assumption", "type": "dropdown", "options": ["independent_contributors", "correlated_pairs", "fully_correlated"], "default": "independent_contributors"}
          ]
        },
        "Analysis": {
          "parameters": [
            {"name": "Stack Type RSS Or Worstcase", "type": "dropdown", "options": ["rss", "worst_case", "report_both"], "default": "report_both"},
            {"name": "Output Units", "type": "dropdown", "options": ["mm", "inch", "um"], "default": "mm"},
            {"name": "Confidence Level", "type": "numeric", "description": "Statistical confidence for RSS interval", "default": 99.73, "unit": "pct", "min": 50, "max": 99.9999},
            {"name": "Sigma Target", "type": "numeric", "description": "Target sigma level for resultant", "default": 3, "min": 1, "max": 6}
          ]
        },
        "Report": {
          "parameters": [
            {"name": "Output Table", "type": "checkbox", "description": "Emit contributor-by-contributor table", "default": true},
            {"name": "Sensitivity Chart", "type": "checkbox", "description": "Emit per-contributor sensitivity / Pareto chart", "default": true},
            {"name": "Contributor Ranking", "type": "checkbox", "description": "Rank contributors by impact for design-improvement focus", "default": true}
          ]
        }
      }
    },
    "TOLERANCE_STACK_MONTE_CARLO": {
      "description": "Monte Carlo statistical tolerance stack-up using per-contributor probability distributions (Normal, Uniform, Triangular, Lognormal, empirical). Outputs full result distribution including Cpk estimate, percentile bounds, and contributor-sensitivity indices (Sobol). Supersedes RSS when contributors are non-Gaussian or correlated.",
      "category": "Analysis",
      "parameterCount": 18,
      "tabs": {
        "Process": {
          "parameters": [
            {"name": "Sampling Method", "type": "dropdown", "options": ["pseudo_random_mt19937", "latin_hypercube", "sobol_quasi_random", "halton"], "default": "latin_hypercube"},
            {"name": "Distribution Default", "type": "dropdown", "options": ["normal", "uniform", "triangular", "lognormal", "empirical_from_csv"], "default": "normal"},
            {"name": "MC Seed", "type": "numeric", "description": "Random seed for reproducibility (0 = system time)", "default": 0}
          ]
        },
        "Geometry": {
          "parameters": [
            {"name": "Assembly Definition", "type": "selection", "required": true},
            {"name": "Feature Chain", "type": "selection", "required": true},
            {"name": "Datum Sequence", "type": "selection"}
          ]
        },
        "Inspection": {
          "parameters": [
            {"name": "Contributor Distributions", "type": "selection", "description": "Per-contributor distribution type + parameters"},
            {"name": "Sample Count", "type": "numeric", "description": "Number of Monte Carlo samples", "default": 100000, "min": 1000, "max": 10000000},
            {"name": "Batch Size", "type": "numeric", "description": "Samples per batch for memory bounding", "default": 10000, "min": 100},
            {"name": "Parallel Streams", "type": "numeric", "description": "Concurrent MC streams (0 = auto-detect cores)", "default": 0, "min": 0, "max": 64}
          ]
        },
        "Analysis": {
          "parameters": [
            {"name": "Result Metric", "type": "dropdown", "options": ["mean_only", "mean_stddev", "full_histogram", "tail_percentiles"], "default": "full_histogram"},
            {"name": "Percentile Target", "type": "numeric", "description": "Tail percentile for spec-limit comparison", "default": 99.865, "unit": "pct", "min": 50, "max": 99.9999},
            {"name": "Cpk Estimate", "type": "numeric", "description": "Computed process capability against spec limits", "default": 0, "min": 0},
            {"name": "Mean Estimate", "type": "numeric", "description": "Computed mean of resultant distribution", "default": 0, "unit": "mm"},
            {"name": "Stddev Estimate", "type": "numeric", "description": "Computed standard deviation of resultant", "default": 0, "unit": "mm"}
          ]
        },
        "Report": {
          "parameters": [
            {"name": "Histogram Output", "type": "checkbox", "description": "Emit histogram + density-fit overlay", "default": true},
            {"name": "Sensitivity Indices", "type": "dropdown", "options": ["none", "first_order_sobol", "first_and_total_sobol", "morris_screening"], "default": "first_and_total_sobol"},
            {"name": "Run Log", "type": "checkbox", "description": "Per-batch RNG seed + summary log for reproducibility", "default": true}
          ]
        }
      }
    },
    "SURFACE_FORM_ANALYZE": {
      "description": "Surface form-control analysis (flatness, cylindricity, roundness, straightness) from a measured point cloud. Fits ideal geometry by least-squares (or minimum-zone), computes peak-to-valley deviation against the ideal, and reports against the GD&T zone tolerance.",
