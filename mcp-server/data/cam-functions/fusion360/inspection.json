        "Inspection": {
          "parameters": [
            {"name": "Point Cloud Input", "type": "selection", "description": "Measured points (CSV / PTS / E57 / MEA)", "required": true},
            {"name": "Point Count Min", "type": "numeric", "description": "Minimum points for valid fit", "default": 25, "min": 3},
            {"name": "Sampling Uniformity", "type": "numeric", "description": "Required uniformity index 0-1; below this, fit is flagged unreliable", "default": 0.6, "min": 0, "max": 1},
            {"name": "Outlier Filtering", "type": "dropdown", "options": ["off", "z_score_3sigma", "iqr_1_5", "ransac"], "default": "z_score_3sigma"}
          ]
        },
        "Analysis": {
          "parameters": [
            {"name": "Form Value Calculated", "type": "numeric", "description": "Peak-to-valley deviation against ideal", "default": 0, "unit": "mm"},
            {"name": "Peak Deviation", "type": "numeric", "description": "Max above-ideal deviation", "default": 0, "unit": "mm"},
            {"name": "Valley Deviation", "type": "numeric", "description": "Max below-ideal deviation", "default": 0, "unit": "mm"},
            {"name": "Form Uncertainty", "type": "numeric", "description": "Form measurement uncertainty per ISO 15530", "default": 0, "unit": "um"}
