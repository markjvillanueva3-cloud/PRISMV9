      "parameterCount": 16,
      "tabs": {
        "Process": {
          "parameters": [
            {"name": "Form Type", "type": "dropdown", "options": ["flatness", "cylindricity", "roundness_circularity", "straightness", "profile_of_a_line", "profile_of_a_surface"], "default": "flatness"},
            {"name": "Fitting Algorithm", "type": "dropdown", "options": ["least_squares_lsq", "minimum_zone_mz", "maximum_inscribed_mi", "minimum_circumscribed_mc"], "default": "least_squares_lsq"}
          ]
        },
        "Geometry": {
          "parameters": [
            {"name": "Surface To Analyze", "type": "selection", "description": "Feature ID (face / surface) under analysis", "required": true},
            {"name": "Ideal Geometry Reference", "type": "selection", "description": "Nominal CAD surface used as reference"},
            {"name": "Datum Alignment", "type": "selection", "description": "How to align point cloud to ideal (datum-locked or best-fit)"}
