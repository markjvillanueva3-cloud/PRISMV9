    "TURNING_TRANSFER": {
      "description": "Synchronous part transfer from main to sub-spindle (or sub→main) on a dual-spindle mill-turn. Matches RPMs, aligns phase, advances sub-spindle into pickup position, clamps, and parts off. Used at the main↔second-op handoff on Integrex/CTX/NTX-class machines.",
      "category": "Synchronization",
      "parameterCount": 22,
      "tabs": {
        "Process": {
          "parameters": [
            {"name": "Main Spindle ID", "type": "selection", "description": "Source spindle (S1/main)", "required": true},
            {"name": "Sub Spindle ID", "type": "selection", "description": "Destination spindle (S2/sub)", "required": true},
            {"name": "Transfer Mode", "type": "dropdown", "options": ["pickup_running", "pickup_stopped", "phase_synced_running"], "default": "phase_synced_running"},
            {"name": "Sync Method", "type": "dropdown", "options": ["g847_g847", "spindle_sync_macro", "controller_native"], "default": "controller_native"}
          ]
        },
        "Geometry": {
          "parameters": [
            {"name": "Part Position Z", "type": "numeric", "description": "Z-position of part nose at transfer", "default": 0, "unit": "mm"},
            {"name": "Gripping Length", "type": "numeric", "description": "Length of stock to grip in sub-spindle", "default": 15, "unit": "mm", "min": 3, "max": 200},
            {"name": "Push Out Distance", "type": "numeric", "description": "Stock advance from main chuck before pickup", "default": 5, "unit": "mm", "min": 0, "max": 100},
            {"name": "Fixture Clearance", "type": "numeric", "description": "Min radial clearance to fixtures during transfer", "default": 10, "unit": "mm"},
            {"name": "Datum Frame", "type": "selection", "description": "WCS used for transfer geometry"}
          ]
        },
        "Synchronization": {
          "parameters": [
            {"name": "RPM Match Tolerance", "type": "numeric", "description": "Max delta RPM between spindles before pickup proceeds", "default": 5, "unit": "rpm", "min": 0, "max": 50},
            {"name": "Phase Angle", "type": "numeric", "description": "Target phase offset between spindles (0 = aligned)", "default": 0, "unit": "deg", "min": 0, "max": 360},
            {"name": "Dwell Time", "type": "numeric", "description": "Hold time after clamp before parting off", "default": 0.5, "unit": "s", "min": 0, "max": 5},
            {"name": "Retract On Fail", "type": "checkbox", "description": "Auto-retract sub-spindle if sync fails", "default": true},
            {"name": "Pickup Chuck Pressure", "type": "numeric", "description": "Sub-spindle clamp pressure (low for thin walls)", "default": 25, "unit": "bar", "min": 5, "max": 80},
            {"name": "Retention Force", "type": "numeric", "description": "Min holding force after grip-confirm", "default": 1500, "unit": "N", "min": 100, "max": 20000}
          ]
        },
        "Strategy": {
          "parameters": [
            {"name": "Clamp Sequence", "type": "dropdown", "options": ["sub_grip_then_main_release", "simultaneous", "main_release_then_sub_grip"], "default": "sub_grip_then_main_release"},
            {"name": "Cutoff Dwell", "type": "numeric", "description": "Dwell after parting before sub-spindle retract", "default": 0.2, "unit": "s"},
            {"name": "Transfer Feedrate", "type": "numeric", "description": "Sub-spindle approach feedrate during pickup", "default": 200, "unit": "mm/min", "min": 10, "max": 5000},
            {"name": "Retry Count", "type": "numeric", "description": "Attempts before abort on failed sync", "default": 2, "min": 0, "max": 5}
          ]
        },
        "Output": {
          "parameters": [
            {"name": "Post Block Label", "type": "text", "description": "Post-processor block name for transfer macro"},
            {"name": "M-Code Map", "type": "selection", "description": "Controller M-code mapping (Mazak / Fanuc / Siemens)"},
            {"name": "NC Variable File", "type": "text", "description": "Common variables file written for transfer parameters"}
          ]
        }
      }
    },
