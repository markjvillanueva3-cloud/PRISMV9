            {"name": "Sync Code", "type": "text", "description": "Controller sync directive (G117/M101)", "default": "G117"},
            {"name": "Mark Resume", "type": "checkbox", "description": "Insert resume mark after sync point", "default": true},
            {"name": "Queue Depth", "type": "numeric", "description": "Max queued operations per channel", "default": 4, "min": 1, "max": 32},
            {"name": "Deadlock Timeout", "type": "numeric", "description": "Abort sync if no progress within this", "default": 30, "unit": "s", "min": 1, "max": 600}
          ]
        },
        "Strategy": {
          "parameters": [
