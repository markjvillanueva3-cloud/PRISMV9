{
  "schemaVersion": "1.0.0",
  "metadata": {
    "title": "Fusion 360 CAM Cloud Rendering + Manufacturing Extension + Vault PLM + Generative Design Surface",
    "description": "Comprehensive parameter catalog for the Fusion 360 cloud / extension surface — finishes Phase 1 of L2-CAMX-EXHAUST. Covers (a) cloud-side toolpath generation and rendering pipeline (submit / status / retrieve, region selection, token-based auth, telemetry), (b) Manufacturing Extension premium toolpaths (Simultaneous 5-Axis Adaptive, Steep-and-Shallow, Swarf machining, Port machining, Blade machining — turbine / impeller / blisk), (c) Autodesk Vault data exchange (check-in / check-out / revision lock / lifecycle), and (d) Generative Design study → CAM model bind. These operations gate the licensed / cloud-only surface that the desktop catalogues (MS0 + MS1-01..11) cannot describe alone.",
    "version": "2026.04",
    "extractedDate": "2026-04-30",
    "milestone": "CAM-EXHAUST-MS1-12",
    "source": "Autodesk Fusion 360 Manufacturing Extension Help + Cloud Generative Compute API + Autodesk Vault Server / Vault Pro REST API + Fusion 360 Generative Design Help + AS9100D (aerospace blade / impeller machining specs) + ISO 14649 (STEP-NC for cloud-portable toolpaths) + AWS / Azure region documentation for Forge-backed cloud rendering",
    "totalParameters": 211,
    "toolpathCount": 10,
    "physics_links": [
      "CLOUD_RENDER_TIME_ESTIMATE",
      "CLOUD_TOOLPATH_COMPUTE_OFFLOAD",
      "ADAPTIVE_5AX_TOOL_AXIS_SMOOTHING",
      "STEEP_SHALLOW_DETECTION_THRESHOLD",
      "SWARF_FLANK_CONTACT_VECTOR",
      "PORT_HELIX_AXIS_INTERPOLATION",
      "BLADE_LEADING_TRAILING_EDGE_BLEND",
      "VAULT_REVISION_LOCK",
      "GENERATIVE_DESIGN_OUTCOME_BIND",
      "MULTI_REGION_FAILOVER_LATENCY"
    ]
  },
  "commonTabs": {
    "description": "Standard tabs across cloud + ME + Vault + Generative Design ops. Cloud = auth/region/license. Render = job settings + telemetry. Strategy = ME-specific surface. Linking = transitions/ramps/leads. Output = NC delivery + simulation.",
    "tabs": ["Cloud", "Render", "Strategy", "Linking", "Output"]
  },
  "toolpaths": {
    "CLOUD_RENDER_SUBMIT": {
      "description": "Submit a Fusion 360 setup or operation to the cloud renderer for off-machine toolpath generation. Used when local compute is insufficient (large adaptive clears, dense-mesh 5-axis, multi-million-poly STL). Authenticates with Autodesk identity, picks an Autodesk Forge region, queues the job, and returns a cloud-job handle for async polling. Full-rate seat consumption is billed by job duration.",
      "category": "Cloud",
      "parameterCount": 21,
      "tabs": {
        "Cloud": {
          "parameters": [
            {"name": "Account ID", "type": "text", "description": "Autodesk identity / forge account", "required": true},
            {"name": "Project ID", "type": "text", "description": "Autodesk Construction Cloud project", "required": true},
            {"name": "Region", "type": "dropdown", "options": ["us_east", "us_west", "eu_west", "eu_central", "ap_southeast", "ap_northeast", "auto_select_nearest"], "default": "auto_select_nearest"},
            {"name": "Auth Token", "type": "text", "description": "OAuth bearer token (auto-refresh enabled)"},
            {"name": "Token Refresh Mode", "type": "dropdown", "options": ["manual", "auto", "preflight_only"], "default": "auto"},
            {"name": "License Tier", "type": "dropdown", "options": ["fusion_team", "fusion_machining_extension", "fusion_extension_bundle", "byon", "trial"], "default": "fusion_machining_extension"},
            {"name": "Cloud Compute Tokens", "type": "numeric", "description": "Pre-purchased compute-token budget (0 = pay-as-you-go)", "default": 0, "min": 0, "max": 10000}
          ]
        },
        "Render": {
          "parameters": [
            {"name": "Job Name", "type": "text", "required": true},
            {"name": "Job Priority", "type": "dropdown", "options": ["interactive", "batch", "overnight"], "default": "batch"},
            {"name": "Notify On Complete", "type": "checkbox", "default": true},
            {"name": "Notification Email", "type": "text"},
            {"name": "Allow Auto Retry", "type": "checkbox", "default": true},
            {"name": "Maximum Retry Count", "type": "numeric", "default": 2, "min": 0, "max": 5},
            {"name": "Failover To Region", "type": "dropdown", "options": ["none", "us_east", "us_west", "eu_west", "eu_central", "ap_southeast", "ap_northeast"], "default": "none"}
          ]
        },
        "Strategy": {
          "parameters": [
            {"name": "Setup Reference", "type": "selection", "description": "Setup or operation to send", "required": true},
            {"name": "Include Stock Geometry", "type": "checkbox", "default": true},
            {"name": "Include Fixture Geometry", "type": "checkbox", "default": false},
            {"name": "Strategy Override", "type": "dropdown", "options": ["use_existing", "force_adaptive", "force_steep_shallow", "force_swarf", "force_port", "force_blade"], "default": "use_existing"}
          ]
        },
        "Output": {
          "parameters": [
            {"name": "Result Format", "type": "dropdown", "options": ["fusion_native", "step_nc_iso14649", "f3z_with_nc", "preview_image_only"], "default": "fusion_native"},
            {"name": "Compress Result", "type": "checkbox", "default": true},
            {"name": "Encrypt Result At Rest", "type": "checkbox", "default": true}
          ]
        }
      }
    },
    "CLOUD_RENDER_STATUS": {
      "description": "Poll a cloud-render job for status and retrieve the result. States: queued / running / paused / cancelled / done / failed. Implements exponential-backoff polling, optional webhook delivery, and download verification (sha256 checksum + size). Aligns with Forge job-tracking API.",
      "category": "Cloud",
      "parameterCount": 16,
      "tabs": {
        "Cloud": {
          "parameters": [
            {"name": "Job Handle", "type": "text", "description": "Returned by CLOUD_RENDER_SUBMIT", "required": true},
            {"name": "Polling Mode", "type": "dropdown", "options": ["once", "exponential_backoff", "fixed_interval", "webhook_only"], "default": "exponential_backoff"},
            {"name": "Initial Poll Delay", "type": "numeric", "default": 2, "unit": "s"},
            {"name": "Maximum Poll Delay", "type": "numeric", "default": 60, "unit": "s"},
            {"name": "Poll Backoff Factor", "type": "numeric", "default": 1.5, "min": 1.0, "max": 4.0},
            {"name": "Total Timeout", "type": "numeric", "description": "0 = no cap", "default": 3600, "unit": "s"},
            {"name": "Webhook URL", "type": "text", "description": "POST destination on state change"},
            {"name": "Webhook Auth", "type": "dropdown", "options": ["none", "basic", "bearer", "signed_hmac"], "default": "signed_hmac"}
          ]
        },
        "Render": {
          "parameters": [
            {"name": "Cancel If Queued Beyond", "type": "numeric", "default": 600, "unit": "s"},
            {"name": "Auto Download On Done", "type": "checkbox", "default": true},
            {"name": "Verify Checksum", "type": "checkbox", "default": true},
            {"name": "Verify Size", "type": "checkbox", "default": true}
          ]
        },
        "Output": {
          "parameters": [
            {"name": "Result Local Path", "type": "text", "description": "Where to drop downloaded artefact"},
            {"name": "Overwrite Local", "type": "dropdown", "options": ["overwrite", "fail_if_exists", "auto_increment"], "default": "auto_increment"},
            {"name": "Emit Telemetry CSV", "type": "checkbox", "description": "Per-poll latency / state log", "default": false},
            {"name": "Emit Cycle Time Estimate", "type": "checkbox", "description": "Forge-side toolpath cycle-time prediction", "default": true}
          ]
        }
      }
    },
    "CLOUD_GENERATE_TOOLPATH": {
      "description": "Server-side toolpath generation — offloads heavy compute (multi-million-poly adaptive, simultaneous 5-axis, micro-tolerance scallop) from the desktop. Wraps Forge Manufacturing Cloud API. Required for impeller / blisk / blade strategies on machines without local Manufacturing Extension license. Falls back to local compute if cloud is unreachable.",
      "category": "Cloud",
      "parameterCount": 22,
      "tabs": {
        "Cloud": {
          "parameters": [
            {"name": "Compute Profile", "type": "dropdown", "options": ["balanced", "high_quality", "fast_preview", "battery_friendly"], "default": "balanced"},
            {"name": "Maximum Cores Hint", "type": "numeric", "description": "Soft cap on cloud-side core count", "default": 16, "min": 1, "max": 128},
            {"name": "Memory Budget GB", "type": "numeric", "default": 16, "min": 4, "max": 256, "unit": "GB"},
            {"name": "GPU Acceleration", "type": "dropdown", "options": ["off", "preview_only", "always_when_available"], "default": "preview_only"}
          ]
        },
        "Render": {
          "parameters": [
            {"name": "Tolerance Override", "type": "numeric", "description": "Cloud-only tighter tolerance", "default": 0.001, "unit": "mm"},
            {"name": "Maximum Surface Refinement Iterations", "type": "numeric", "default": 4, "min": 1, "max": 16},
            {"name": "Quality Score Floor", "type": "numeric", "description": "Reject result if internal QS below this", "default": 0.85, "min": 0, "max": 1},
            {"name": "Allow Surface Reconstruction", "type": "checkbox", "description": "Server may re-mesh STL/STEP for stable strategy compute", "default": true}
          ]
        },
        "Strategy": {
          "parameters": [
            {"name": "Strategy Family", "type": "dropdown", "options": ["adaptive_clear", "horizontal_clear", "scallop", "morphed_spiral", "parallel_3d", "swarf", "port", "blade", "steep_and_shallow", "rest_machining"], "required": true},
            {"name": "Strategy Override Map", "type": "text", "description": "JSON dict of per-feature strategy overrides"},
            {"name": "Stock To Leave", "type": "numeric", "default": 0.2, "unit": "mm"},
            {"name": "Maximum Stepover", "type": "numeric", "default": 0.5, "unit": "mm"},
            {"name": "Maximum Stepdown", "type": "numeric", "default": 1.5, "unit": "mm"}
          ]
        },
        "Linking": {
          "parameters": [
            {"name": "Allow Cloud Optimised Links", "type": "checkbox", "description": "Use Forge link-optimisation algorithm", "default": true},
            {"name": "Lead-In Mode", "type": "dropdown", "options": ["arc", "ramp", "vertical_plunge", "helix", "auto_pick_per_feature"], "default": "auto_pick_per_feature"},
            {"name": "Maximum Stay Down Time", "type": "numeric", "description": "Cloud algorithm bias toward staying engaged", "default": 0, "unit": "s"}
          ]
        },
        "Output": {
          "parameters": [
            {"name": "Return Format", "type": "dropdown", "options": ["fusion_native", "step_nc_iso14649", "apt_cl", "vendor_neutral_xml"], "default": "fusion_native"},
            {"name": "Include Verify Trace", "type": "checkbox", "description": "Embed cloud verification log", "default": true},
            {"name": "Include Setup Sheet", "type": "checkbox", "default": true},
            {"name": "Bind To Local Operation", "type": "checkbox", "description": "Replace local op with cloud result on success", "default": true},
            {"name": "Local Compute Fallback", "type": "checkbox", "description": "Run desktop compute if cloud fails or times out", "default": true},
            {"name": "Fallback Quality Floor", "type": "numeric", "description": "Accept local fallback only if QS ≥ this", "default": 0.7}
          ]
        }
      }
    },
