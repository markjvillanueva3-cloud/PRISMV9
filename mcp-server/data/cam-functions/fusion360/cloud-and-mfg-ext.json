            {"name": "Shallow Strategy", "type": "dropdown", "options": ["parallel_3d", "scallop", "spiral"], "default": "parallel_3d"},
            {"name": "Shallow Direction", "type": "numeric", "description": "Tool path direction for shallow region", "default": 0, "unit": "deg"},
