            {"name": "Allow Region Subdivision", "type": "checkbox", "description": "Split each region by curvature", "default": false},
            {"name": "Maximum Surface Roughness Target", "type": "numeric", "description": "Used to back-derive stepover when aggressive_finish", "default": 0.8, "unit": "Ra μm"}
