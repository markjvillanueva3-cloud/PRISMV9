  "physics_formulas_linked": [
    {
      "formula_id": "LASER_BEAM_ABLATION",
      "description": "Material removal rate per pulse: V = (alpha * I_avg * t_pulse) / (rho * h_v) where alpha = absorption coeff, I_avg = avg intensity, h_v = vaporization enthalpy.",
      "engines_linked": ["LaserAblationEngine", "LaserCuttingEngine"]
    },
    {
      "formula_id": "LASER_KERF_GEOMETRY",
      "description": "Kerf width = focused beam diameter + (HAZ width). Bottom kerf > top kerf (positive taper) due to beam divergence below focus.",
      "engines_linked": ["LaserCuttingEngine"]
    },
    {
      "formula_id": "WATERJET_KERF_TAPER",
      "description": "Kerf taper t = (D_top - D_bottom) / 2. Decreases with: lower speed, higher pressure, larger orifice. Active 5-axis comp eliminates taper for perpendicular walls.",
      "engines_linked": ["WaterjetCuttingEngine"]
    },
    {
      "formula_id": "WATERJET_PIERCE_TIME",
      "description": "Pierce time t_p ~ k * (thickness)^n where n = 1.5-2.0 depending on material brittleness; ductile metals require longer pierce due to rebound.",
      "engines_linked": ["WaterjetCuttingEngine"]
    },
    {
      "formula_id": "PLASMA_ARC_VOLTAGE_HEIGHT",
      "description": "Arc voltage rises ~6-10 V per mm increase in standoff. THC (Torch Height Control) feeds voltage back to maintain constant cut height.",
      "engines_linked": ["PlasmaCuttingEngine"]
    },
    {
      "formula_id": "PLASMA_PIERCE_DELAY",
      "description": "Pierce delay t_d = a + b*thickness; typical 0.3 + 0.05*t (s). Too short = blow-through molten on lens; too long = consumable wear.",
      "engines_linked": ["PlasmaCuttingEngine"]
    }
  ],
  "tribal_knowledge_summary": {
    "tip_count": 6,
    "sources": ["jm_die", "shop_floor", "fusion_help", "hypertherm_app_notes"],
    "highlights": [
      {"id": "tt_laser_n2_ss", "text": "Cut stainless with Nitrogen, not Oxygen — N2 prevents oxidation (clean shiny edge); O2 leaves dross + oxide layer requiring secondary clean.", "source": "fusion_help", "confidence": 0.95},
      {"id": "tt_laser_pierce_thick", "text": "For >12mm carbon steel use ramp pierce or center-drill before cut — fast pierce blows back into nozzle and damages optics.", "source": "shop_floor", "confidence": 0.92},
      {"id": "tt_waterjet_garnet_grit", "text": "80-mesh garnet for general work; 120-mesh for finish quality (Q5); 50-mesh for thick (>50mm) cutting where speed matters more than finish.", "source": "shop_floor", "confidence": 0.9},
      {"id": "tt_waterjet_taper_perpend", "text": "Pure waterjet at low speed gives least taper; for tight perpendicularity use 5-axis dynamic comp; static taper trick only works ±0.5° tilt.", "source": "fusion_help", "confidence": 0.88},
      {"id": "tt_plasma_thc", "text": "Always run THC on arc-voltage feedback for warped plate; fixed-height THC fails on >2mm bow and torches dive into the plate.", "source": "hypertherm_app_notes", "confidence": 0.94},
      {"id": "tt_plasma_consumables", "text": "Pierce extracts 2-4x more wear from electrode than steady cut — minimize pierces (bridge cuts, common-line cuts, chain piercing).", "source": "hypertherm_app_notes", "confidence": 0.93}
    ]
  }
