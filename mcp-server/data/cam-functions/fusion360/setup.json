  "toolpaths": {
    "STOCK_FROM_MODEL": {
      "description": "Default stock mode in Fusion — use the model itself as the stock silhouette with directional offsets. The most common workpiece definition for first-op machining when starting from a near-net or pre-formed billet that closely matches the part. Applies offsets uniformly or per-direction, supports multi-body and assembly setups. Drives stock model for adaptive clearing remaining-material logic.",
      "category": "Workpiece",
      "parameterCount": 14,
      "tabs": {
        "Setup": {
          "parameters": [
            {"name": "Setup Name", "type": "text", "required": true},
            {"name": "Mode", "type": "dropdown", "options": ["from_model", "from_model_offset"], "default": "from_model"},
            {"name": "Stock Material", "type": "selection", "description": "Material library entry"}
          ]
        },
        "Stock": {
          "parameters": [
            {"name": "Model Source", "type": "dropdown", "options": ["single_body", "selected_bodies", "all_bodies", "active_component"], "default": "all_bodies"},
            {"name": "Uniform Offset", "type": "numeric", "description": "Per-face offset added to model silhouette", "default": 0, "unit": "mm", "min": 0, "max": 25},
            {"name": "Offset Mode", "type": "dropdown", "options": ["uniform", "per_face_directional"], "default": "uniform"},
            {"name": "Axial Offset", "type": "numeric", "description": "Z-direction offset (overrides uniform when directional)", "default": 0, "unit": "mm"},
            {"name": "Radial Offset", "type": "numeric", "description": "Radial offset for cylindrical-ish parts", "default": 0, "unit": "mm"},
            {"name": "Treat As Final Shape", "type": "checkbox", "description": "Stock equals model exactly (no machining allowance)", "default": false}
          ]
        },
        "Fixture": {
          "parameters": [
            {"name": "Fixture Bodies", "type": "selection_multi", "description": "Bodies treated as fixtures"}
          ]
        },
        "Coordinates": {
          "parameters": [
            {"name": "WCS Origin", "type": "selection", "description": "Setup origin point", "required": true},
            {"name": "Z Orientation", "type": "dropdown", "options": ["+Z_up", "-Z_up", "+X_up", "-X_up", "+Y_up", "-Y_up"], "default": "+Z_up"}
          ]
        },
        "Output": {
          "parameters": [
            {"name": "Setup Sheet Photo", "type": "checkbox", "default": true},
            {"name": "Stock Volume Report", "type": "checkbox", "default": true}
          ]
        }
      }
    },
    "STOCK_FROM_PREVIOUS_SETUP": {
      "description": "Inherit the post-machining stock model from the preceding setup in the operation chain (Op1 → Op2). Critical for accurate Op2 toolpath planning on flip / refixture / sub-spindle-transfer parts — Fusion carries the leftover stock state forward so adaptive clearing sees only the un-machined material. Pairs with SETUP_GROUP for op-chain management.",
      "category": "Workpiece",
      "parameterCount": 14,
      "tabs": {
        "Setup": {
          "parameters": [
            {"name": "Setup Name", "type": "text", "required": true},
            {"name": "Parent Setup", "type": "selection", "description": "Source setup whose post-machining stock is inherited", "required": true},
            {"name": "Mode", "type": "dropdown", "options": ["from_previous_setup", "from_setup_chain"], "default": "from_previous_setup"}
          ]
        },
        "Stock": {
          "parameters": [
            {"name": "Stock Source", "type": "dropdown", "options": ["post_machining_state", "pre_machining_state", "snapshot_id"], "default": "post_machining_state"},
            {"name": "Additional Offset", "type": "numeric", "description": "Extra offset added on top of inherited stock", "default": 0, "unit": "mm", "min": 0, "max": 10},
            {"name": "Propagate Cleared Regions", "type": "checkbox", "description": "Carry already-machined regions forward (no re-cut)", "default": true},
            {"name": "Snapshot ID", "type": "text", "description": "Specific intermediate snapshot to inherit (advanced)"}
          ]
        },
        "Fixture": {
          "parameters": [
            {"name": "Fixture Mode", "type": "dropdown", "options": ["new_fixture_this_op", "inherit_fixture", "fixture_from_group"], "default": "new_fixture_this_op"}
          ]
        },
        "Coordinates": {
          "parameters": [
            {"name": "WCS Mode", "type": "dropdown", "options": ["new_wcs_this_op", "inherit_with_transform", "re_probe_per_op"], "default": "new_wcs_this_op", "required": true},
            {"name": "Inherited Transform", "type": "text", "description": "4x4 transform applied from parent WCS (read-only when inherited)"},
            {"name": "Datum Frame Continuity", "type": "checkbox", "description": "Enforce datum frame from parent setup", "default": true},
            {"name": "Flip Compensation", "type": "checkbox", "description": "Auto-flip stock when parent setup flipped part", "default": true}
          ]
        },
        "Output": {
          "parameters": [
            {"name": "Delta Volume Report", "type": "checkbox", "description": "Report material removed in this setup vs inherited stock", "default": true},
            {"name": "Setup Sheet Photo", "type": "checkbox", "default": true}
          ]
        }
      }
    },
