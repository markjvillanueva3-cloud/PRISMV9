{
  "schemaVersion": "1.0.0",
  "metadata": {
    "title": "Fusion 360 CAM Manufacturing Model / Setup Parameters - Complete Enumeration",
    "description": "Comprehensive parameter catalog for Fusion 360 manufacturing-model and setup operations: stock/workpiece definition (body, box, cylinder), fixture binding (vise, chuck), work coordinate systems (single + multi-WCS schedules), machine kinematics binding, multi-setup management (Op1/Op2 flips), and setup-sheet documentation. Anchors every downstream toolpath module (2D/3D/multiaxis/turning/probing/additive/cutting/inspection/mill-turn) to a concrete machine + workpiece + datum frame. Required precursor for any closed-loop CAM-to-shop-floor workflow.",
    "version": "2026.04",
    "extractedDate": "2026-04-29",
    "milestone": "CAM-EXHAUST-MS1-06",
    "source": "Autodesk Fusion 360 Help — Setup + Stock + Fixture + Manufacturing Model reference + ISO 6983-1 (G54-G59 WCS) + ISO 230-1/2 (machine kinematics + axis acceptance) + ASME B5.54 (machine accuracy) + Fanuc 30i/31i G54.1 P1..P48 extended offsets manual + Mazak Smooth control kinematics manual",
    "totalParameters": 193,
    "toolpathCount": 12,
    "physics_links": [
      "WCS_OFFSET_TRANSFORM",
      "KINEMATICS_REACHABILITY",
      "FIXTURE_GRIP_FORCE_BUDGET",
