          "window_size_ms": { "type": "number", "unit": "ms", "default": 100, "tab": "MRR" },
          "voxel_resolution_mm": { "type": "number", "unit": "mm", "default": 0.1, "tab": "MRR" }
        },
        "strategy": {
          "increase_feed_in_air": { "type": "boolean", "default": true, "tab": "Strategy" },
          "decrease_feed_at_corners": { "type": "boolean", "default": true, "tab": "Strategy" },
          "preserve_finish_pass": { "type": "boolean", "default": true, "tab": "Strategy" },
          "preserve_threading": { "type": "boolean", "default": true, "description": "Never modify G76 threads", "tab": "Strategy" }
        },
        "limits": {
          "min_feed_mm_per_min": { "type": "number", "unit": "mm_per_min", "default": 100, "tab": "Limits" },
          "max_feed_mm_per_min": { "type": "number", "unit": "mm_per_min", "default": 5000, "tab": "Limits" },
          "min_chip_load_mm_per_tooth": { "type": "number", "unit": "mm_per_tooth", "default": 0.02, "description": "Avoid rubbing/work-hardening", "tab": "Limits" }
        },
        "output": {
          "report_mrr_curve": { "type": "boolean", "default": true, "tab": "Output" },
          "report_cycle_time_savings_pct": { "type": "boolean", "default": true, "tab": "Output" },
          "warn_on_excessive_modification": { "type": "boolean", "default": true, "description": "Flag if feed modified > 50%", "tab": "Output" },
          "feed_modification_threshold_pct": { "type": "number", "unit": "pct", "default": 50.0, "tab": "Output" }
        }
      }
    },
    "surface_finish_optimize": {
      "display_name": "Surface Finish Optimization",
      "category": "surface_finish_optimize",
      "description": "Tune feed/speed for target Ra. Uses theoretical Ra = f²/(8r) plus material/coating correction factors.",
      "dialog_tabs": ["Target", "Tool", "Strategy", "Output"],
      "parameter_count": 15,
      "parameters": {
        "target": {
          "ra_target_um": { "type": "number", "unit": "um", "default": 1.6, "tab": "Target" },
          "rz_target_um": { "type": "number", "unit": "um", "default": 6.3, "tab": "Target" },
          "consistency_tolerance_pct": { "type": "number", "unit": "pct", "default": 20.0, "description": "Allow ±20% Ra variation across part", "tab": "Target" },
          "critical_feature_zones": { "type": "selection", "tab": "Target", "description": "Faces requiring strict Ra" }
        },
        "tool": {
          "nose_radius_mm": { "type": "number", "unit": "mm", "default": 0.4, "tab": "Tool" },
          "tool_grade": { "type": "string", "default": "carbide_PVD", "tab": "Tool" },
          "wiper_geometry": { "type": "boolean", "default": false, "description": "Wiper allows 2x feed for same Ra", "tab": "Tool" },
          "edge_prep_um": { "type": "number", "unit": "um", "default": 25, "description": "Hone radius affects min Ra achievable", "tab": "Tool" }
        },
        "strategy": {
          "use_formula_ra_f2_8r": { "type": "boolean", "default": true, "tab": "Strategy" },
          "apply_material_correction": { "type": "boolean", "default": true, "description": "Factor for material grade", "tab": "Strategy" },
          "auto_select_speed_for_BUE": { "type": "boolean", "default": true, "description": "Avoid built-up-edge speed range", "tab": "Strategy" }
        },
        "output": {
          "predicted_ra_per_zone": { "type": "boolean", "default": true, "tab": "Output" },
          "warn_if_exceeds_tolerance": { "type": "boolean", "default": true, "tab": "Output" },
          "highlight_zones_in_3d": { "type": "boolean", "default": true, "tab": "Output" },
          "report_correction_factors_used": { "type": "boolean", "default": true, "tab": "Output" }
        }
