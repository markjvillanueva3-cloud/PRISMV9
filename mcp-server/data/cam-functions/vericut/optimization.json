    "optipath": {
      "display_name": "OptiPath Optimization",
      "category": "optipath",
      "description": "VERICUT flagship — automatic feedrate optimization based on real chip load and material removal rate. Reduces cycle time 10-50%.",
      "dialog_tabs": ["Material", "Limits", "Strategy", "Output"],
      "parameter_count": 16,
      "parameters": {
        "material": {
          "material_db_ref": { "type": "selection", "tab": "Material", "required": true, "description": "VERICUT material database with kc1.1 etc." },
          "stock_material_grade": { "type": "string", "default": "STEEL_4140", "tab": "Material" },
          "use_local_chip_load": { "type": "boolean", "default": true, "description": "Compute per-step chip load from voxel removal", "tab": "Material" },
          "chip_load_smoothing_ms": { "type": "number", "unit": "ms", "default": 50, "description": "Avoid feed flicker", "tab": "Material" }
        },
        "limits": {
          "max_chip_load_mm_per_tooth": { "type": "number", "unit": "mm_per_tooth", "default": 0.15, "tab": "Limits" },
          "min_feed_pct_of_original": { "type": "number", "unit": "pct", "default": 30.0, "description": "Don't go below 30% of programmed", "tab": "Limits" },
          "max_feed_pct_of_original": { "type": "number", "unit": "pct", "default": 200.0, "description": "Don't exceed 200% of programmed", "tab": "Limits" },
          "max_spindle_load_pct": { "type": "number", "unit": "pct", "default": 85.0, "description": "Spindle motor utilisation cap", "tab": "Limits" }
        },
        "strategy": {
          "optimize_in_air": { "type": "boolean", "default": true, "description": "Slam rapid feeds in non-cutting moves", "tab": "Strategy" },
          "optimize_finish_passes": { "type": "boolean", "default": false, "description": "Off — preserve programmed finish feeds", "tab": "Strategy" },
          "respect_corner_slowdown": { "type": "boolean", "default": true, "description": "Slow at sharp corners for accuracy", "tab": "Strategy" },
          "look_ahead_distance_mm": { "type": "number", "unit": "mm", "default": 50, "tab": "Strategy" }
        },
        "output": {
          "output_format": { "type": "enum", "values": ["modified_NC", "OPL_overlay", "side_by_side"], "default": "modified_NC", "tab": "Output" },
          "report_cycle_time_savings_pct": { "type": "boolean", "default": true, "tab": "Output" },
          "preserve_program_structure": { "type": "boolean", "default": true, "description": "Keep subroutines and modal codes intact", "tab": "Output" },
          "auto_apply_post_simulation": { "type": "boolean", "default": false, "tab": "Output" }
        }
      }
    },
    "force_optimize": {
      "display_name": "Force-Based Optimization",
      "category": "force_optimize",
      "description": "Adjust feeds based on calculated cutting force using Kienzle model. Maintains constant force across varying engagement.",
      "dialog_tabs": ["Force_Model", "Limits", "Strategy", "Output"],
      "parameter_count": 14,
      "parameters": {
        "force_model": {
          "force_model": { "type": "enum", "values": ["kienzle", "altintas", "merchant", "experimental_fit"], "default": "kienzle", "description": "Kienzle Fc = kc1.1 × ap × fz^(1-mc)", "tab": "Force_Model" },
          "kc1_1_lookup": { "type": "boolean", "default": true, "description": "Pull from VERICUT material DB", "tab": "Force_Model" },
          "mc_lookup": { "type": "boolean", "default": true, "tab": "Force_Model" },
          "force_check_resolution_ms": { "type": "number", "unit": "ms", "default": 5, "tab": "Force_Model" }
        },
        "limits": {
          "target_force_N": { "type": "number", "unit": "N", "default": 800, "description": "Setpoint cutting force", "tab": "Limits" },
          "max_force_N": { "type": "number", "unit": "N", "default": 1500, "description": "Hard ceiling", "tab": "Limits" },
          "max_torque_Nm": { "type": "number", "unit": "Nm", "default": 50, "description": "Spindle torque limit", "tab": "Limits" },
          "max_axial_force_N": { "type": "number", "unit": "N", "default": 1200, "tab": "Limits" }
        },
        "strategy": {
          "feed_response_mode": { "type": "enum", "values": ["linear", "PI_controller", "model_predictive"], "default": "PI_controller", "tab": "Strategy" },
          "PI_kp": { "type": "number", "default": 0.5, "tab": "Strategy" },
          "PI_ki": { "type": "number", "default": 0.1, "tab": "Strategy" }
        },
        "output": {
          "log_force_per_segment": { "type": "boolean", "default": true, "tab": "Output" },
          "warn_if_target_unreachable": { "type": "boolean", "default": true, "tab": "Output" },
          "auto_increase_doc_for_low_force": { "type": "boolean", "default": false, "description": "Be careful — can violate stock allowance", "tab": "Output" }
        }
      }
    },
