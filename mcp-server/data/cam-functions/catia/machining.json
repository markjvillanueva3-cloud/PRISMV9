  "training_topics": [
    {
      "topic": "Prismatic 2.5D Pocket Pattern Selection",
      "key_concepts": [
        "outward_helical = chip-load-friendly, smoothest tool wear",
        "zigzag = fastest cycle but uneven chip load on corners",
        "concentric = best for tight-tolerance pockets (matches walls last)"
      ],
      "best_practices": [
        "Default outward_helical for production; switch to zigzag only when cycle time is dominant",
        "Always enable wall_finish_pass for IT8 or tighter walls",
        "Use draft_angle_deg = 0 unless the part actually has draft — non-zero on flat walls causes residue"
      ]
    },
    {
      "topic": "Drilling Cycle Selection (G81 / G83 / G73)",
      "key_concepts": [
        "G81 = simple drill (depth ≤ 3×D)",
        "G82 = drill with dwell (for flat-bottom counterbore feel)",
        "G83 = full-retract deep peck (depth > 5×D, brittle materials)",
        "G73 = high-speed peck (depth 3-5×D, ductile materials)"
      ],
      "best_practices": [
        "G73 is faster than G83 — only use G83 when chip evacuation is the limit",
        "G84 (rigid tap) requires synchronized spindle; verify machine has the option before assigning",
        "G99 retract-to-clearance is faster between holes; G98 retract-to-initial-Z is safer over fixtures"
      ]
    },
    {
      "topic": "Surface Sweep Stepover Modes",
      "key_concepts": [
        "constant_3d = stepover measured in 3D distance (cusp varies with slope)",
        "constant_planar = stepover measured in XY plane (uniform on flats, denser on slopes)",
        "constant_scallop = solves stepover from target cusp (truly uniform finish)"
      ],
      "best_practices": [
        "constant_scallop for cosmetic surfaces (uniform Ra)",
        "constant_3d for general production — well understood, predictable cycle time",
        "constant_planar only for nearly-flat surfaces (slope < 15°)"
      ]
    },
    {
      "topic": "5-Axis Tool Axis Modes (Advanced Machining)",
      "key_concepts": [
        "normal_to_part = tool axis follows surface normal — safest, but can collide with holder",
        "lead_lag = tilt forward (lead) and sideways (lag) — best surface finish",
        "fixed_vector = constant orientation in machine frame — used for indexed-style machining",
        "swarf = flank-cut on ruled surface — fastest finish on ruled walls"
      ],
      "best_practices": [
        "lead 5° + lag 0° is a good default for impeller blades",
        "Always set max_tilt to limit holder collisions",
        "Enable smooth_axis_changes = true to avoid jerky 5-axis motion at controller"
      ]
    },
    {
      "topic": "DELMIA Stock Model Mode Tradeoffs",
      "key_concepts": [
        "voxel = fastest, lower accuracy (good for cycle time + air-cut detection)",
        "mesh = balanced (good for residual stock visualization)",
        "boundary_rep = highest accuracy (slow; use for final-pass collision verification)"
      ],
      "best_practices": [
        "Use voxel for development; switch to mesh for pre-release; boundary_rep only for the final cert run",
        "Set tolerance ≥ 0.05mm for voxel/mesh; 0.01mm for boundary_rep",
        "Always show_air_cut_pct to catch over-clearance issues that waste cycle time"
      ]
    },
    {
      "topic": "Clash Check Coverage (Static vs Swept Volume)",
      "key_concepts": [
        "static = checks the tool assembly at each path point against the fixture (sample-driven)",
        "swept_volume = sweeps the tool envelope along the path and intersects with fixtures (continuous)",
        "Swept is mandatory for any 5-axis path; static is acceptable for fixed-orientation 3-axis"
      ],
      "best_practices": [
        "include_holder = true always — most clashes are holder-fixture, not tool-fixture",
        "minimum_clearance_mm = 1 standard; 2-3 for new fixtures or unproven setups",
        "stop_on_first_intersection = false during development (see them all); = true for final production cert"
      ]
    }
  ]
}