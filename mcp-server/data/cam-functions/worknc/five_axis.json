    "auto5_3plus2": {
      "display_name": "Auto5 (3+2 Conversion)",
      "category": "auto5",
      "description": "WorkNC's signature feature — automatically converts an existing 3-axis program into 3+2 (indexed 5-axis) by detecting collisions between the holder/shank and stock, then choosing rotary positions that eliminate them with shorter tools.",
      "dialog_tabs": ["Source", "Holder", "Strategy", "Output"],
      "parameter_count": 14,
      "parameters": {
        "source": {
          "sourceProgram": { "type": "selection", "description": "Existing 3-axis toolpath to convert", "tab": "Source", "required": true },
          "preserveStrategy": { "type": "boolean", "default": true, "description": "Keep original toolpath logic; only adjust orientations", "tab": "Source" }
        },
        "holder": {
          "holderProfile": { "type": "tool_reference", "description": "Holder + shank geometry for clearance check", "tab": "Holder", "required": true },
          "shellThickness": { "type": "number", "unit": "mm", "default": 1.0, "description": "Clearance shell around holder", "tab": "Holder" },
          "checkShank": { "type": "boolean", "default": true, "tab": "Holder" }
        },
        "strategy": {
          "tiltMode": { "type": "enum", "values": ["min_tilt", "max_clearance", "single_orientation"], "default": "min_tilt", "description": "Min tilt = closest to original Z; max clearance = best holder clearance", "tab": "Strategy" },
          "maxTiltA": { "type": "number", "unit": "deg", "default": 30, "range": [0, 90], "tab": "Strategy" },
          "maxTiltB": { "type": "number", "unit": "deg", "default": 30, "range": [0, 90], "tab": "Strategy" },
          "groupByOrientation": { "type": "boolean", "default": true, "description": "Cluster operations into shared rotary positions", "tab": "Strategy" }
        },
        "output": {
          "outputMode": { "type": "enum", "values": ["G68_2", "G54_1_P", "rotary_then_3axis"], "default": "G68_2", "tab": "Output" },
          "rotaryAxisLimitsCheck": { "type": "boolean", "default": true, "tab": "Output" },
          "axisLimitMargin": { "type": "number", "unit": "deg", "default": 5, "tab": "Output" },
          "validateNoCollision": { "type": "boolean", "default": true, "tab": "Output" },
          "tcpcOutput": { "type": "boolean", "default": false, "description": "RTCP not required for indexed", "tab": "Output" },
          "outputAsSubprograms": { "type": "boolean", "default": false, "tab": "Output" }
        }
      }
    },
