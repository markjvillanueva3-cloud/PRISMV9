  "training_topics": [
    {
      "topic": "Fixed vs Variable Axis Selection",
      "key_concepts": [
        "Fixed (3+2): tool axis locked to one orientation per pass — simpler post, higher rigidity",
        "Variable (full 5): tool axis varies along path — needed for impellers, swarf, undercuts",
        "Adaptive milling sits inside fixed-axis category but uses constant-engagement morphing"
      ],
      "best_practices": [
        "Default to fixed-axis 3+2 unless geometry mandates simultaneous motion",
        "Variable contour with normal-to-part axis is the safest 5-axis starter",
        "Swarf drive needs ruled drive surfaces — chord deviation will gouge"
      ]
    },
    {
      "topic": "Z-Level Profile Steep-Angle Threshold",
      "key_concepts": [
        "steep_angle separates ZLEVEL (waterline) from shallow finish (e.g. fixed_contour)",
        "Typical 60-70° — surfaces steeper than threshold get waterline; shallower get area milling",
        "Merge_with_shallow_pass blends the two strategies seamlessly"
      ],
      "best_practices": [
        "Set steep_angle=65° as a default starting point",
        "Use small global_depth_per_cut (0.15-0.3mm) for hard materials and finishing"
      ]
    },
    {
      "topic": "Adaptive Milling Engagement Discipline",
      "key_concepts": [
        "max_radial_engagement_pct ≤ 12% keeps deep-DOC trochoidal stable",
        "max_axial_doc can be 1-1.5×D (vs ~1×D for conventional pocket)",
        "feed_per_tooth scales up by ~30-40% vs traditional roughing"
      ],
      "best_practices": [
        "Start with 8% radial / 1.0×D axial / 0.10mm feed/tooth — tighten as confidence grows",
        "Use long-flute LOC tool to take full advantage of deep axial DOC",
        "Smooth path on — sharp corners cause spike loads even at low engagement"
      ]
    },
    {
      "topic": "Variable Contour Tool Axis Modes",
      "key_concepts": [
        "normal_to_part: tool axis tracks part normal — safest, rigid",
        "lead_lag: tilts tool ahead/behind motion direction — improves surface finish",
        "swarf: flank-cut along ruled surface — used on impeller/blisk blades",
        "interpolate: smooth blend between specified axis vectors at points"
      ],
      "best_practices": [
        "lead 5° + lag 0° gives a good compromise for most freeform finishing",
        "Normal-to-drive on impeller hubs; swarf on the blade flanks",
        "Always set max_tilt — uncontrolled tilt mid-path can crash holder"
      ]
    },
    {
      "topic": "Cavity Mill IPW (In-Process Workpiece)",
      "key_concepts": [
        "IPW tracks remaining stock between operations — drives rest-machining",
        "use_3d: maintains true 3D solid model (slow, accurate)",
        "use_level: maintains 2.5D level slices (faster, less precise)"
      ],
      "best_practices": [
        "Use IPW=use_3d on roughing → finish flows so rest machining is exact",
        "Refresh IPW at every setup change to avoid air cuts after re-fixturing"
      ]
    },
    {
      "topic": "FBM Template Selection",
      "key_concepts": [
        "Templates encapsulate 'how' to machine each feature class (pocket, hole, boss)",
        "AUTO_3D applies templates after feature recognition — smallest_fit picks the smallest tool that reaches",
        "Override per-feature when a non-standard recipe is needed"
      ],
      "best_practices": [
        "Maintain a vetted template library — bad templates propagate",
        "Always review FBM-generated ops before posting; auto-recognition can mis-classify"
      ]
    }
  ]
}