  "training_topics": [
    {
      "topic": "Feature Recognition Accuracy Heuristics",
      "key_concepts": [
        "Pocket classification: floor must be planar/contoured and walls closed or single-side-open",
        "Hole classification: aspect ratio ≤ 10 for simple; above requires deep-hole template",
        "Slots must have length-to-width ≥ 3 to avoid mis-classification as pocket"
      ],
      "best_practices": [
        "Set min_feature_size_mm generously (0.5mm+) — tiny features clutter the recognition result",
        "Use ignore_open_sides=true if the stock model already removes those edges",
        "Always report unrecognized to surface coverage gaps — they are future manual features"
      ]
    },
    {
      "topic": "Smallest-Fit Tool Selection Rule",
      "key_concepts": [
        "AUTO_3D picks the smallest available tool whose radius ≤ feature_min_radius",
        "A pocket with 5mm corner radius needs a tool with radius ≤ 5mm to finish corners",
        "Using a smaller tool than required adds cycle time (more passes) but is safer"
      ],
      "best_practices": [
        "Maintain a magazine with a geometric progression (2, 4, 6, 8, 10mm) so smallest-fit has granularity",
        "Enable prefer_existing_magazine to avoid tool changes",
        "Flag features whose min_radius < magazine's smallest tool — they need manual rework"
      ]
    },
    {
      "topic": "Machining Knowledge Editor (MKE) Structure",
      "key_concepts": [
        "Rules are ordered by priority (ascending); first matching rule wins",
        "Match conditions: feature_type + material + dimension envelope + machine class",
        "Libraries are scoped per shop/cell/job/user and can inherit from parents"
      ],
      "best_practices": [
        "Separate libraries per material family (aluminum, steel, titanium, stainless)",
        "Always use priority with gaps (10, 20, 30…) — leaves room for inserts",
        "Turn on conflict detection; a priority tie between rules means non-determinism"
      ]
    },
    {
      "topic": "AUTO_3D vs Manual Path Tradeoffs",
      "key_concepts": [
        "AUTO_3D: rough cavity → rest mill → zlevel finish → surface finish chain",
        "Auto-recognition misses: undercuts, features split by tangent boundaries, tiny geometry",
        "Manual features override auto output and lock from re-recognition"
      ],
      "best_practices": [
        "Review FBM output in simulation before posting — recognition errors propagate downstream",
        "Use manual_feature_create for anything auto misses",
        "Lock critical manual features to prevent auto re-recognition from wiping them"
      ]
    },
    {
      "topic": "Batching Economics / Feature-to-Tool Ratio",
      "key_concepts": [
        "Group efficiency = (feature_count / tool_count) — higher is better",
        "Below 1.0 = more tool changes than features (waste)",
        "Above 3.0 = good amortization of tool-change time"
      ],
      "best_practices": [
        "Use spatial_tsp ordering inside a tool batch to minimize rapids",
        "Set minimum_feature_count_per_tool = 3 as a sanity gate",
        "Respect clamp zones — TSP will happily route through a fixture otherwise"
      ]
    },
    {
      "topic": "CAD Associativity (Synchronous Modeling Link)",
      "key_concepts": [
        "synchronous: features track CAD topology exactly; changes propagate automatically",
        "parametric: features driven by CAD parameters; edits invalidate paths",
        "snapshot: frozen at recognition time; best for archival"
      ],
      "best_practices": [
        "Use synchronous during active development; lock to snapshot before release",
        "Always preserve_manual_painting=true — manual work should survive CAD edits",
        "Require user ack before auto-regen on topology change to avoid silent path corruption"
      ]
    }
  ]
}
