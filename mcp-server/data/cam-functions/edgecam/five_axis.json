        },
        "output": {
          "outputMode": { "type": "enum", "values": ["G68_2_per_group", "G54_1_P", "long_form"], "default": "G68_2_per_group", "tab": "Output" },
          "rotaryAxisLimitsCheck": { "type": "boolean", "default": true, "tab": "Output" },
          "axisLimitMargin": { "type": "number", "unit": "deg", "default": 5, "tab": "Output" },
          "tableTableHead": { "type": "enum", "values": ["table_table", "head_table", "head_head"], "default": "table_table", "description": "Machine kinematic config", "tab": "Output" },
          "rtcpRequired": { "type": "boolean", "default": false, "description": "Some controls require RTCP for non-axial drilling", "tab": "Output" }
        }
      }
