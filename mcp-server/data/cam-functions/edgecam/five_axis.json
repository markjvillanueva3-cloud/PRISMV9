    "five_axis_indexed": {
      "display_name": "5-Axis Indexed (3+2)",
      "category": "indexed",
      "description": "Position rotary axes to a tilted plane, then run a 3-axis toolpath in that plane. Most common 5-axis use — all 3-axis strategies become available at any orientation.",
      "dialog_tabs": ["Tool", "Plane", "Strategy", "Output"],
      "parameter_count": 13,
      "parameters": {
        "plane": {
          "tiltAxisA": { "type": "number", "unit": "deg", "range": [-180, 180], "tab": "Plane", "required": true },
          "tiltAxisB": { "type": "number", "unit": "deg", "range": [-180, 180], "tab": "Plane" },
          "tiltAxisC": { "type": "number", "unit": "deg", "range": [-360, 360], "tab": "Plane" },
          "originX": { "type": "number", "unit": "mm", "default": 0, "tab": "Plane" },
          "originY": { "type": "number", "unit": "mm", "default": 0, "tab": "Plane" },
          "originZ": { "type": "number", "unit": "mm", "default": 0, "tab": "Plane" }
        },
        "strategy": {
          "underlyingStrategy": { "type": "selection", "description": "Embedded 3-axis strategy", "tab": "Strategy", "required": true },
          "rapidApproachZ": { "type": "number", "unit": "mm", "default": 50, "description": "Z above tilted plane to rapid in", "tab": "Strategy" }
        },
        "output": {
          "outputMode": { "type": "enum", "values": ["G68_2", "G54_1_P", "rotary_then_3axis"], "default": "G68_2", "description": "G68.2 tilted plane preferred", "tab": "Output" },
          "tcpc": { "type": "boolean", "default": false, "description": "G43.4/G43.5 tool tip programming (rarely needed for indexed)", "tab": "Output" },
          "rotaryRetractMode": { "type": "enum", "values": ["unwind", "shortest", "always_unwind"], "default": "shortest", "tab": "Output" },
          "rotaryAxisLimitsCheck": { "type": "boolean", "default": true, "tab": "Output" },
          "axisLimitMargin": { "type": "number", "unit": "deg", "default": 5, "description": "Stay this far from axis limits", "tab": "Output" }
        }
      }
    },
    "five_axis_swarf": {
      "display_name": "5-Axis Swarf Milling",
      "category": "simultaneous",
      "description": "Side-edge of an end mill rides along a ruled surface. Single pass produces full-height wall. Common on impeller blades, turbine vanes, dovetail walls.",
      "dialog_tabs": ["Tool", "Surface", "Tool Axis", "Strategy"],
      "parameter_count": 14,
      "parameters": {
        "surface": {
          "guideSurfaces": { "type": "selection", "description": "Drive surfaces (side wall to swarf)", "tab": "Surface", "required": true },
          "checkSurfaces": { "type": "selection", "description": "Surfaces to avoid", "tab": "Surface" },
          "stockToLeave": { "type": "number", "unit": "mm", "default": 0, "tab": "Surface" }
        },
        "tool_axis": {
          "tiltMode": { "type": "enum", "values": ["surface_normal", "fixed_lead", "auto_lead"], "default": "surface_normal", "tab": "Tool Axis" },
          "leadAngle": { "type": "number", "unit": "deg", "default": 0, "range": [-15, 15], "description": "Cutter lead angle", "tab": "Tool Axis" },
          "tiltAngle": { "type": "number", "unit": "deg", "default": 0, "range": [-15, 15], "description": "Cutter tilt angle (avoid centerline cut)", "tab": "Tool Axis" }
        },
        "strategy": {
          "passDirection": { "type": "enum", "values": ["U", "V", "spiral"], "default": "U", "tab": "Strategy" },
          "passType": { "type": "enum", "values": ["zigzag", "oneway"], "default": "oneway", "tab": "Strategy" },
          "stepdown": { "type": "number", "unit": "mm", "default": 1.0, "tab": "Strategy" },
          "leadInType": { "type": "enum", "values": ["arc", "linear", "none"], "default": "arc", "tab": "Strategy" },
          "leadInRadius": { "type": "number", "unit": "mm", "default": 2, "tab": "Strategy" },
          "axisSmoothing": { "type": "boolean", "default": true, "description": "Smooth rotary motion to avoid jerks", "tab": "Strategy" },
          "smoothingTolerance": { "type": "number", "unit": "deg", "default": 0.5, "tab": "Strategy" },
          "collisionAvoidance": { "type": "boolean", "default": true, "description": "Auto-tilt to clear holder/shank", "tab": "Strategy" }
        }
      }
    },
    "five_axis_contour": {
      "display_name": "5-Axis Contour",
      "category": "simultaneous",
      "description": "Continuous 5-axis contour following a 3D curve or surface ridge. Tool axis sweeps to maintain contact normal. Used for trim edges, ports, blends.",
