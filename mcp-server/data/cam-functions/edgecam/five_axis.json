          "leadAngle": { "type": "number", "unit": "deg", "default": 0, "tab": "Tool Axis" },
          "tiltAngle": { "type": "number", "unit": "deg", "default": 0, "tab": "Tool Axis" }
        },
        "strategy": {
          "passes": { "type": "integer", "default": 1, "range": [1, 100], "tab": "Strategy" },
          "stepover": { "type": "number", "unit": "mm", "default": 0.5, "tab": "Strategy" },
          "leadInType": { "type": "enum", "values": ["tangent", "perpendicular", "none"], "default": "tangent", "tab": "Strategy" },
          "linkingMode": { "type": "enum", "values": ["safe", "smart", "minimum"], "default": "smart", "tab": "Strategy" },
          "axisSmoothing": { "type": "boolean", "default": true, "tab": "Strategy" },
          "singularityAvoidance": { "type": "boolean", "default": true, "description": "Detour near gimbal lock", "tab": "Strategy" },
          "tcpcOutput": { "type": "boolean", "default": true, "description": "G43.4/G43.5 emission", "tab": "Strategy" }
        }
      }
