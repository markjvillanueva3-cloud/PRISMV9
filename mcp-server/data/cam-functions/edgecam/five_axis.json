    "five_axis_drill": {
      "display_name": "5-Axis Hole Drill",
      "category": "indexed",
      "description": "Drill holes whose axes are not parallel to Z. Auto-orients spindle to each hole's axis. Outputs G68.2 + G81/G83 per group.",
      "dialog_tabs": ["Tool", "Holes", "Strategy", "Output"],
      "parameter_count": 11,
      "parameters": {
