      "dialog_tabs": ["Geometry", "Tool", "Strategy", "Output"],
      "parameter_count": 16,
      "parameters": {
        "geometry": {
          "drivingSurface": { "type": "selection", "tab": "Geometry", "required": true },
          "stockOrigin": { "type": "enum", "values": ["fromCAD", "computed", "measured"], "default": "fromCAD", "tab": "Geometry" },
          "topZ": { "type": "number", "unit": "mm", "tab": "Geometry", "required": true },
          "bottomZ": { "type": "number", "unit": "mm", "tab": "Geometry", "required": true }
        },
        "strategy": {
          "stepoverPct": { "type": "number", "unit": "percent", "default": 60, "range": [10, 90], "tab": "Strategy" },
          "stepdown": { "type": "number", "unit": "mm", "default": 1.5, "range": [0.05, 25], "tab": "Strategy", "required": true },
          "stockAllowance": { "type": "number", "unit": "mm", "default": 0.3, "tab": "Strategy" },
          "patternType": { "type": "enum", "values": ["zigZag", "constantOffset", "morph", "spiralFromInside"], "default": "constantOffset", "tab": "Strategy" },
          "trochoidalCorners": { "type": "boolean", "default": true, "description": "Avoid full-engagement at corners on hardened steel", "tab": "Strategy" },
          "trochoidalRadius": { "type": "number", "unit": "mm", "default": 1.0, "tab": "Strategy" },
          "feedReductionEntry": { "type": "number", "unit": "percent", "default": 30, "tab": "Strategy" }
        },
        "output": {
          "approach": { "type": "enum", "values": ["climb", "conventional"], "default": "climb", "tab": "Output" },
          "ramp": { "type": "enum", "values": ["plunge", "ramp", "helix", "preDrill"], "default": "helix", "tab": "Output" },
          "rampAngle": { "type": "number", "unit": "deg", "default": 2.5, "range": [0.5, 30], "tab": "Output" },
          "tolerance": { "type": "number", "unit": "mm", "default": 0.01, "tab": "Output" },
          "smoothLink": { "type": "boolean", "default": true, "tab": "Output" }
        }
      }
    },
