        },
        "strategy": {
          "toolType": { "type": "enum", "values": ["vBit", "ballNose", "engraveBit"], "default": "vBit", "tab": "Strategy" },
          "vBitAngle": { "type": "number", "unit": "deg", "default": 60, "values_when_vBit": ["30", "60", "90"], "tab": "Strategy" },
