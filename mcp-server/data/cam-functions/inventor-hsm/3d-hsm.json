  "training_topics": [
    {
      "topic": "3D Adaptive Clearing",
      "key_concepts": [
        "Constant engagement maintains optimal cutting conditions",
        "optimalLoad controls WOC as percentage of tool diameter (typically 40%)",
        "Helix entry avoids axial plunging stress",
        "Flat area machining option for complete pocket floors"
      ],
      "best_practices": [
        "Start with 40% optimal load for general roughing",
        "Use helix entry with 2-3 degree angle",
        "Enable flat area machining for pockets with floors",
        "Slot clearing handles narrow grooves automatically"
      ]
    },
    {
      "topic": "Z-Level Finishing (Contour 3D)",
      "key_concepts": [
        "Waterline machining maintains constant Z height",
        "Best for steep walls (>45 degrees)",
        "Stepdown controls Z-level increment",
        "Scallop height affects surface finish quality"
      ],
      "best_practices": [
        "Use for walls steeper than 45 degrees",
        "Calculate stepdown from target scallop: stepdown = 2*sqrt(scallop*(2R-scallop))",
        "Order by area reduces retracts",
        "Combine with Parallel for shallow areas"
      ]
    },
    {
      "topic": "Scallop-Constant Finishing",
      "key_concepts": [
        "Maintains uniform scallop height across varying surface angles",
        "Automatically adjusts stepover based on local curvature",
        "Spiral patterns provide continuous motion",
        "Better surface finish than constant stepover"
      ],
      "best_practices": [
        "Target scallop = surface roughness / 4",
        "Use ball end mills for best results",
        "Outward spiral for convex, inward for concave",
        "Tolerance affects path accuracy (0.01mm typical)"
      ]
    },
    {
      "topic": "Steep and Shallow Strategy",
      "key_concepts": [
        "Automatically switches between contour and parallel machining",
        "Threshold angle defines steep/shallow boundary",
        "Blend zone smooths transitions between strategies",
        "Single operation covers entire surface efficiently"
      ],
      "best_practices": [
        "Set threshold angle at 45 degrees for balanced results",
        "Increase blend zone (5-10 deg) for smoother transitions",
        "Match steep stepdown and shallow stepover for consistent scallop",
        "Use for complex molds and dies"
      ]
    },
    {
      "topic": "Pencil/Rest Finishing",
      "key_concepts": [
        "Detects and machines corners missed by larger tools",
        "Multiple depths clean fillets completely",
        "Minimum radius filter controls which corners to machine",
        "Tight tolerance (0.005mm) for accurate detection"
      ],
      "best_practices": [
        "Run after main finishing pass",
        "Use ball end mill 50% smaller than previous tool",
        "Set minimum radius to previous tool radius",
        "Enable both ways for bidirectional cleaning"
      ]
    },
    {
      "topic": "Radial and Spiral Patterns",
      "key_concepts": [
        "Radial: passes radiate from center outward",
        "Spiral: continuous spiral path around feature",
        "Best for rotationally symmetric features",
        "Angular stepover controls pass density"
      ],
      "best_practices": [
        "Use radial for impeller blades and turbine disks",
        "Use spiral for domes and hemispheres",
        "Morphed spiral adapts to irregular boundaries",
        "Outward spiral for convex surfaces"
      ]
    }
  ],
