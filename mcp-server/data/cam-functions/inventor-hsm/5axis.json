  "training_topics": [
    {
      "topic": "Swarf Cutting Fundamentals",
      "key_concepts": [
        "Tool flank contacts ruled surface for efficient material removal",
        "toolAxisMode determines how tool orientation is calculated",
        "Lead/tilt angles control tool posture relative to surface",
        "Guide curves override automatic axis calculation"
      ],
      "best_practices": [
        "Use for blade walls, airfoils, and ruled surfaces only",
        "Keep lead angle under 15° to avoid excessive tool deflection",
        "Enable rotary limits check to stay within machine envelope",
        "Verify surface is truly ruled before applying swarf strategy"
      ]
    },
    {
      "topic": "Multi-Axis Contouring",
      "key_concepts": [
        "Tool follows curves with controlled orientation",
        "Orientation can follow surface normal or be user-defined",
        "Smoothing prevents jerky axis motions at transitions",
        "Lead/tilt angles offset from base orientation"
      ],
      "best_practices": [
        "Use normal_to_surface for edge finishing on sculpted parts",
        "Enable smoothing to reduce machine wear from abrupt axis changes",
        "Multiple depths allows finishing with gradual engagement",
        "Use cutter compensation for precise dimensional control"
      ]
    },
    {
      "topic": "UV Flow Machining",
      "key_concepts": [
        "Follows natural UV parameterization of surfaces",
        "along_U/along_V controls primary toolpath direction",
        "Ideal for surfaces with well-defined flow lines",
        "Stepover measured perpendicular to flow direction"
      ],
      "best_practices": [
        "Best for sculptured automotive/aerospace surfaces",
        "Check UV direction before programming - may need surface rebuild",
        "Use point_control for complex compound curves",
        "Combine with minimum radius check for tight curvatures"
      ]
    },
    {
      "topic": "3+2 Positioning (Tilted Work Plane)",
      "key_concepts": [
        "Rotary axes position then lock for 3-axis cutting",
        "More rigid than simultaneous 5-axis for heavy cuts",
        "Work coordinate system transforms to tilted plane",
        "Multiple orientations can be chained in single setup"
      ],
      "best_practices": [
        "Prefer 3+2 over simultaneous for roughing operations",
        "Use for features that are planar but at compound angles",
        "Calculate safe clearance plane for each orientation",
        "Group features by orientation to minimize reposition moves"
      ]
    },
    {
      "topic": "Multi-Axis Drilling",
      "key_concepts": [
        "Drill holes at any compound angle",
        "Automatic tool axis alignment to hole axis",
        "All standard cycles available (peck, chip break, tap)",
        "Simultaneous repositioning between holes"
      ],
      "best_practices": [
        "Use along_hole_axis for CAD-defined angled holes",
        "Set safe distance adequate for rotary motion before tilting",
        "Group holes by similar orientations to reduce axis travel",
        "Verify each hole is accessible without collision"
      ]
    },
    {
      "topic": "Impeller and Blade Machining",
      "key_concepts": [
        "Dedicated strategy handles hub, blades, and splitters",
        "Flow strategy follows blade surface naturally",
        "Smooth transitions critical at blade leading/trailing edges",
        "Shroud clearance must be maintained for covered impellers"
      ],
      "best_practices": [
        "Rough hub first, then blades from hub to shroud",
        "Use small lead angles (3-5°) for better surface finish",
        "Enable gouge and holder collision checking always",
        "Verify minimum tool clearance between adjacent blades"
      ]
    },
    {
      "topic": "Port Machining Strategy",
      "key_concepts": [
        "Tool axis follows port centerline curve",
        "Critical for intake/exhaust port finishing",
        "Smooth axis transitions prevent witness marks",
        "Entry/exit moves require careful planning"
      ],
      "best_practices": [
        "Create accurate centerline curve through port center",
        "Limit max tilt to avoid tool shank contact",
        "Use along_guide mode for most port geometries",
        "Finish in single pass where possible to avoid witness lines"
      ]
    },
    {
      "topic": "Deburring and Edge Breaking",
      "key_concepts": [
        "Chamfers all edges with consistent size/angle",
        "Tool orientation follows edge and adjacent faces",
        "Corner handling determines transition behavior",
        "Approach/retract moves avoid edge gouging"
      ],
      "best_practices": [
        "Use bisector orientation for equal-angle edges",
        "Roll_around corners for continuous chamfer appearance",
        "Set approach distance to allow clean engagement",
        "Verify tool can reach all edges without collision"
      ]
    }
