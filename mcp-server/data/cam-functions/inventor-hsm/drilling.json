  "training_topics": [
    {
      "topic": "Drilling Cycle Selection (G81/G83/G73)",
      "key_concepts": [
        "G81: Simple drilling - no pecking, fast cycle times",
        "G83: Full retract peck - chip evacuation for deep holes",
        "G73: Chip break - minimal retract, faster than G83",
        "Hole depth / diameter ratio determines cycle choice"
      ],
      "best_practices": [
        "Use G81 for L/D < 3 in most materials",
        "Use G73 for L/D 3-5 with good chip breaking",
        "Use G83 for L/D > 5 or gummy materials",
        "Reduce peck depth progressively for very deep holes"
      ]
    },
    {
      "topic": "Thread Milling vs Tapping",
      "key_concepts": [
        "Thread milling: One tool for multiple sizes, interpolated",
        "Rigid tapping: Faster, requires synchronized spindle",
        "Thread milling: Better for hard materials and large threads",
        "Tapping: Simpler programming, faster cycle time"
      ],
      "best_practices": [
        "Use rigid tapping when machine supports it",
        "Thread mill interrupted holes or hardened materials",
        "Climb milling for thread milling gives better finish",
        "Use multi-flute thread mills for productivity"
      ]
    },
    {
      "topic": "Precision Boring Cycles",
      "key_concepts": [
        "G76: Oriented spindle stop before retract",
        "G85: Feed rate retract for finish",
        "G89: Dwell + feed rate retract",
        "Shift amount prevents drag marks on retract"
      ],
      "best_practices": [
        "Use oriented stop (G76) for tight tolerance bores",
        "Set shift amount to 0.02-0.05mm",
        "Dwell at bottom for better finish",
        "Feed rate retract prevents tool marks"
      ]
    },
    {
      "topic": "Probing for WCS Setup",
      "key_concepts": [
        "Corner probing establishes XY datum",
        "Boss/bore probing finds center position",
        "Single surface probing for Z datum",
        "Web/pocket probing for complex datums"
      ],
      "best_practices": [
        "Probe at slow feed rates (50-150 mm/min)",
        "Verify probe calibration regularly",
        "Set reasonable tolerance for pass/fail",
        "Use extended work offsets (G54.1 Pn) for multi-fixture"
      ]
    },
    {
      "topic": "Hole Sequence Optimization",
      "key_concepts": [
        "Nearest-neighbor reduces rapid travel",
        "Pattern recognition groups similar holes",
        "Tool change minimization clusters by tool",
        "Z-level sorting for deep pockets"
      ],
      "best_practices": [
        "Enable optimize order for random hole patterns",
        "Group holes by tool to minimize changes",
        "Process holes before pocketing operations",
        "Use same diameter selection for tool reuse"
      ]
    }
  ],

