  "training_topics": [
    {
      "topic": "Turning Roughing Strategies",
      "key_concepts": [
        "Constant chip load maintains consistent cutting forces",
        "Direction affects chip flow and surface quality",
        "Stock allowance balances rough speed vs finish quality",
        "Adaptive turning adjusts DOC based on engagement"
      ],
      "best_practices": [
        "Use constant chip load for interrupted cuts",
        "Leave 0.2-0.5mm radial stock for finishing",
        "Match feed direction to chip evacuation needs",
        "Reduce DOC approaching shoulders and features"
      ]
    },
    {
      "topic": "Threading Infeed Methods",
      "key_concepts": [
        "Radial infeed: Simple but high forces, good for soft materials",
        "Flank infeed: Reduces rubbing, better for hard materials",
        "Modified flank: 29.5° angle reduces both cutting edges engaging",
        "Alternating: Balances wear across both cutting edges"
      ],
      "best_practices": [
        "Use modified flank for most applications",
        "Decrease infeed depth progressively (constant chip area)",
        "Add 1-2 spring passes for thread accuracy",
        "Verify thread class tolerance requirements"
      ]
    },
    {
      "topic": "Grooving and Parting",
      "key_concepts": [
        "Tool width limits single-plunge depth",
        "Pecking prevents chip packing in deep grooves",
        "Feed reduction at center prevents tool grabbing",
        "Part catcher timing critical for automation"
      ],
      "best_practices": [
        "Use zigzag for grooves wider than tool",
        "Reduce feed 50% when approaching center",
        "Enable pecking for grooves deeper than 2x width",
        "Dwell at bottom to break chip for clean finish"
      ]
    },
    {
      "topic": "C-Axis Milling (Polar Interpolation)",
      "key_concepts": [
        "G12.1 enables XY-like programming on C+Z axes",
        "Work diameter affects actual surface speed",
        "Feed rate is linear at programmed diameter",
        "Polar distortion occurs with large diameter changes"
      ],
      "best_practices": [
        "Enable polar interpolation for complex contours",
        "Verify work diameter is accurate for feed calc",
        "Use appropriate live tool speeds (typically higher RPM)",
        "Consider Y-axis if machine has it for better accuracy"
      ]
    },
    {
      "topic": "Mill-Turn Coordination",
      "key_concepts": [
        "Stock transfer enables complete part in one setup",
        "Synchronized spindles allow cross-drilling/polygon turning",
        "Channel programming coordinates multiple turrets",
        "Collision avoidance critical with multiple tools"
      ],
      "best_practices": [
        "Verify clamp pressure adequate before transfer",
        "Synchronize spindle speeds to prevent marking",
        "Use overlap distance appropriate for part rigidity",
        "Simulate full program for collision detection"
      ]
    },
    {
      "topic": "B-Axis Angled Operations",
      "key_concepts": [
        "B-axis tilt enables angled features without special fixtures",
        "TCP (Tool Center Point) mode simplifies programming",
        "Combined B+C motion enables complex contours",
        "Tool length and diameter affect reach limits"
      ],
      "best_practices": [
        "Enable TCP mode for intuitive programming",
        "Verify B-axis range covers required angles",
        "Check tool clearance at tilted positions",
        "Use 3+2 positioning when simultaneous not needed"
      ]
    }
  ],
