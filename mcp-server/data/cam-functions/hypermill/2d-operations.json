  "training_topics": [
    {
      "topic": "Pocket Roughing — Climb Only Default",
      "key_concepts": [
        "Climb milling reduces tool wear and built-up edge",
        "Conventional only acceptable on poor-rigidity setups",
        "Helical entry safe for any pocket > tool diameter"
      ],
      "best_practices": [
        "Default climb_only=true; switch only when explicitly needed",
        "Use stock_to_leave 0.3mm to leave material for finish pass",
        "Helix entry angle 3-5° for steel, up to 8° for aluminum"
      ]
    },
    {
      "topic": "Contour Side Compensation (G41/G42)",
      "key_concepts": [
        "side=inside maps to G41 (left of motion direction) for outside-pocket contour",
        "side=outside maps to G42 (right of motion) for outside-profile contour",
        "Tangent-arc lead-in eliminates the witness mark from a sudden side comp engagement"
      ],
      "best_practices": [
        "Always tangent-arc lead-in for visible-surface contours",
        "Lead-in radius ≥ 1mm to give controller time to engage comp",
        "Spring passes (0.0mm side stock) clean up controller-induced over/undercut"
      ]
    },
    {
      "topic": "Engraving — V-bit vs End Mill",
      "key_concepts": [
        "V-bit engraves variable-width strokes from depth (single-line text)",
        "End mill engraves constant-width strokes (machined fonts)",
        "constant_width=true enables outline-trace mode for V-bits"
      ],
      "best_practices": [
        "V-bit 90° or 60° for general engraving",
        "End mill 0.5-2mm for industrial part marking",
        "Use single_pass=true for engrave depths ≤ 0.5mm"
      ]
    },
    {
      "topic": "T-Slot Cutter Safety",
      "key_concepts": [
        "T-slot cutter has a thin neck that limits side load",
        "Always plunge through a pre-milled access slot — never plunge into solid stock",
        "Side_offset advances cut wing-by-wing to avoid full-flute load"
      ],
      "best_practices": [
        "Pre-mill an access slot wider than tool diameter",
        "Side_offset 0.0mm OK only on small T-slot widths (≤1.5×D)",
        "Reduce feed by 50% when cutting both wings simultaneously"
      ]
    }
  ]
