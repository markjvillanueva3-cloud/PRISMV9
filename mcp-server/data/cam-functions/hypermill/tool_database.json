      "operation_class": "tool_life_management",
      "dialogs": [
        {
          "id": "wear_thresholds",
          "name": "Wear Thresholds",
          "type": "tabbed",
          "dialog_purpose": "Tool wear monitoring + replacement triggers — Taylor model inputs",
          "parameters": [
            {
              "id": "flank_wear_limit_vb",
              "name": "Flank Wear Limit (VBmax)",
              "category": "tool_life",
              "value": { "type": "number", "unit": "mm", "default_value": 0.3, "constraints": { "min": 0.05, "max": 1.0 } },
              "physics_links": [
                { "formula_id": "TAYLOR_TOOL_LIFE", "role": "input", "affects": ["T"] }
              ],
              "tribal_tips": [
                { "id": "tt_vb_finish", "text": "Use VBmax = 0.15mm for finishing operations to maintain Ra spec.", "source": "open_mind_docs", "confidence": 0.9 },
                { "id": "tt_vb_jmdie", "text": "JM Die replaces Sandvik R390 inserts at VBmax = 0.25mm — beyond that, surface degrades.", "source": "jm_die", "confidence": 0.92 }
              ]
            },
            {
              "id": "crater_wear_limit_kt",
              "name": "Crater Wear Depth (KT)",
              "category": "tool_life",
              "value": { "type": "number", "unit": "mm", "default_value": 0.06, "constraints": { "min": 0.01, "max": 0.5 } },
              "physics_links": [
                { "formula_id": "TAYLOR_TOOL_LIFE", "role": "input" }
              ]
            },
            {
              "id": "taylor_constant_C",
              "name": "Taylor Constant C",
              "category": "tool_life",
              "value": { "type": "number", "unit": "m_per_min", "default_value": 350 },
              "physics_links": [
                { "formula_id": "TAYLOR_TOOL_LIFE", "role": "input", "affects": ["T"] }
