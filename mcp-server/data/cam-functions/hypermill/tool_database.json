{
  "schema_version": "1.0.0",
  "system_id": "hypermill",
  "module_id": "tool_database",
  "module_name": "hyperMILL Tool Database",
  "description": "Complete tool database UI surface — holder, geometry, cutting data, wear limits, coating, metadata. Source: hyperMILL 2024 reference + JM Die shop-floor calibrations. Inputs to KIENZLE_FORCE and TAYLOR_TOOL_LIFE.",
  "parameter_count": 39,
  "menus": [
    {
      "id": "tool_holder",
      "name": "Tool Holder Assembly",
      "operation_class": "tool_setup",
      "dialogs": [
        {
          "id": "holder_geometry",
          "name": "Holder Geometry",
          "type": "tabbed",
          "dialog_purpose": "Define holder taper, length, runout for collision and deflection models",
          "parameters": [
            {
              "id": "holder_id",
              "name": "Holder Identifier",
              "category": "identifier",
              "value": { "type": "string", "default_value": "BT40-ER32-100" }
            },
            {
              "id": "taper",
              "name": "Tool Taper",
              "category": "interface",
              "value": { "type": "enum", "default_value": "BT40", "constraints": { "enum_values": ["BT30", "BT40", "BT50", "HSK-A63", "HSK-A100", "CAT40", "CAT50"] } }
            },
            {
              "id": "overhang",
              "name": "Tool Overhang from Holder Face",
              "category": "geometry",
              "value": { "type": "number", "unit": "mm", "default_value": 50, "constraints": { "min": 5, "max": 300 } },
              "physics_links": [
                { "formula_id": "DEFLECTION_BEAM", "role": "input", "affects": ["delta_max"] }
              ],
              "tribal_tips": [
                { "id": "tt_overhang_ld_4", "text": "Keep overhang/diameter ratio under 4 to avoid chatter; use stub holders when possible.", "source": "open_mind_docs", "confidence": 0.9 },
                { "id": "tt_overhang_jmdie", "text": "JM Die runs Roku-Roku finishing at L/D = 6 with 0.05mm runout — anything sloppier and surface walks.", "source": "jm_die", "confidence": 0.85 }
              ]
            },
            {
              "id": "holder_runout_tir",
              "name": "Holder Runout (TIR)",
              "category": "quality",
              "value": { "type": "number", "unit": "mm", "default_value": 0.005, "constraints": { "min": 0, "max": 0.05 } },
              "tribal_tips": [
                { "id": "tt_runout_5um", "text": "Below 0.005mm TIR is the threshold for HSM finishing on aerospace alloys.", "source": "open_mind_docs", "confidence": 0.85 }
              ]
            },
            {
              "id": "holder_pullout_force_n",
              "name": "Holder Pull-Out Force",
              "category": "interface",
              "value": { "type": "number", "unit": "N", "default_value": 8000, "constraints": { "min": 100, "max": 50000 } }
            },
            {
              "id": "holder_balance_grade_g",
              "name": "Holder Balance Grade (G-class)",
              "category": "quality",
              "value": { "type": "number", "unit": "g_mm_per_kg", "default_value": 2.5, "constraints": { "min": 0.4, "max": 16 } }
            }
          ]
        }
      ]
    },
    {
      "id": "cutting_data",
      "name": "Cutting Data",
      "operation_class": "speeds_feeds",
      "dialogs": [
        {
          "id": "primary_speeds_feeds",
          "name": "Primary Speeds & Feeds",
          "type": "tabbed",
          "dialog_purpose": "Cutting velocity, chip load, depth/width of cut — direct inputs to KIENZLE_FORCE",
          "parameters": [
            {
              "id": "cutting_speed_vc",
              "name": "Cutting Velocity (Vc)",
              "category": "kinematics",
              "value": { "type": "number", "unit": "m_per_min", "default_value": 200, "constraints": { "min": 5, "max": 3000 } },
              "physics_links": [
                { "formula_id": "KIENZLE_FORCE", "role": "input", "affects": ["F_c", "F_t"] },
                { "formula_id": "TAYLOR_TOOL_LIFE", "role": "input", "affects": ["T"] }
              ],
              "tribal_tips": [
                { "id": "tt_vc_ti6al4v", "text": "For Ti-6Al-4V keep Vc under 80 m/min with carbide and trochoidal toolpath.", "source": "open_mind_docs", "confidence": 0.9 },
                { "id": "tt_vc_jmdie_d2", "text": "JM Die D2 hard-die work: 60 m/min finishing, 90 m/min roughing with TiAlN coating.", "source": "jm_die", "confidence": 0.88 }
              ],
              "ai_actions": [
                { "dispatcher": "prism_cam", "action": "auto_speed_feed_optimize", "parameter_mapping": { "input": "cutting_speed_vc" } },
                { "dispatcher": "prism_calc", "action": "kienzle_force", "parameter_mapping": { "vc_m_per_min": "cutting_speed_vc" } }
              ]
            },
            {
              "id": "feed_per_tooth_fz",
              "name": "Feed per Tooth (fz)",
              "category": "kinematics",
              "value": { "type": "number", "unit": "mm_per_tooth", "default_value": 0.1, "constraints": { "min": 0.001, "max": 1.0 } },
              "physics_links": [
                { "formula_id": "KIENZLE_FORCE", "role": "input", "affects": ["F_c"] }
              ],
              "ai_actions": [
                { "dispatcher": "prism_cam", "action": "auto_speed_feed_optimize" }
              ]
            },
            {
              "id": "axial_depth_ap",
              "name": "Axial Depth of Cut (ap)",
              "category": "geometry",
              "value": { "type": "number", "unit": "mm", "default_value": 1.5, "constraints": { "min": 0.001, "max": 50 } },
              "physics_links": [
                { "formula_id": "KIENZLE_FORCE", "role": "input", "affects": ["F_c"] }
              ],
              "ai_actions": [{ "dispatcher": "prism_cam", "action": "stability_rpm_analyze" }]
            },
            {
              "id": "radial_depth_ae",
              "name": "Radial Depth (ae)",
              "category": "geometry",
              "value": { "type": "number", "unit": "mm", "default_value": 8, "constraints": { "min": 0.01, "max": 100 } },
              "physics_links": [
                { "formula_id": "KIENZLE_FORCE", "role": "input", "affects": ["F_c"] }
              ]
            },
            {
              "id": "spindle_rpm",
              "name": "Spindle RPM",
              "category": "kinematics",
              "value": { "type": "number", "unit": "rpm", "default_value": 6000, "constraints": { "min": 100, "max": 60000 } },
              "ai_actions": [{ "dispatcher": "prism_cam", "action": "stability_rpm_rewrite" }]
            },
            {
              "id": "feed_rate_vf",
              "name": "Table Feed Rate (Vf)",
              "category": "kinematics",
              "value": { "type": "number", "unit": "mm_per_min", "default_value": 1500 }
            },
            {
              "id": "chip_load_target",
              "name": "Target Chip Load",
              "category": "performance",
              "value": { "type": "number", "unit": "mm_per_tooth", "default_value": 0.08 }
            },
            {
              "id": "stepover_pct",
              "name": "Stepover (% of tool diameter)",
              "category": "geometry",
              "value": { "type": "number", "unit": "pct", "default_value": 50, "constraints": { "min": 1, "max": 100 } }
            }
          ]
        }
      ]
    },
    {
      "id": "wear_limits",
