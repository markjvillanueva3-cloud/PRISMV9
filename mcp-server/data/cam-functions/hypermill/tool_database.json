            },
            {
              "id": "taylor_exponent_n",
              "name": "Taylor Exponent n",
              "category": "tool_life",
              "value": { "type": "number", "unit": "dimensionless", "default_value": 0.25 },
              "physics_links": [
                { "formula_id": "TAYLOR_TOOL_LIFE", "role": "input" }
              ]
            },
            {
              "id": "expected_tool_life",
              "name": "Expected Tool Life",
              "category": "tool_life",
              "value": { "type": "number", "unit": "min", "default_value": 60, "constraints": { "min": 1, "max": 1000 } },
              "physics_links": [
                { "formula_id": "TAYLOR_TOOL_LIFE", "role": "output" }
              ]
            }
          ]
        }
