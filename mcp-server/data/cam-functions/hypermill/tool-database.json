        "destination": {
          "output_path": { "type": "string", "required": true },
          "overwrite_existing": { "type": "boolean", "default": false }
        }
      }
    },
    "tool_library_import": {
      "category": "library_io",
      "display_name": "Import Tool Library",
      "description": "Import tool library from ISO 13399 STEP, TDM XML, or other CAM systems with mapping rules.",
      "parameter_count": 6,
      "dialog_tabs": ["source", "mapping", "conflict"],
      "parameters": {
        "source": {
          "import_format": { "type": "enum", "values": ["iso13399_step", "tdm_xml", "mastercam_tools", "nx_tools", "catia_tools", "csv"], "required": true },
          "source_path": { "type": "string", "required": true }
        },
        "mapping": {
