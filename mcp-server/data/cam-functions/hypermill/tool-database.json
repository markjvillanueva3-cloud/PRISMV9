      "dialog_tabs": ["geometry", "cutting_data", "holder"],
      "parameters": {
        "geometry": {
          "tool_type": { "type": "enum", "values": ["endmill", "ballnose", "bullnose", "chamfer", "drill", "tap", "face_mill", "thread_mill"], "required": true },
          "diameter_mm": { "type": "number", "min": 0.1, "max": 200, "required": true },
          "corner_radius_mm": { "type": "number", "min": 0, "max": 25, "default": 0 },
          "flute_count": { "type": "number", "min": 1, "max": 12, "default": 4 },
          "flute_length_mm": { "type": "number", "min": 1, "max": 300, "required": true },
          "overall_length_mm": { "type": "number", "min": 5, "max": 500, "required": true }
        },
        "cutting_data": {
          "material_group_iso": { "type": "enum", "values": ["P", "M", "K", "N", "S", "H"], "required": true },
          "cutting_speed_m_min": { "type": "number", "min": 5, "max": 2000, "required": true },
          "feed_per_tooth_mm": { "type": "number", "min": 0.001, "max": 1, "required": true },
          "max_depth_of_cut_mm": { "type": "number", "min": 0.05, "max": 50, "required": true }
        },
        "holder": {
          "holder_id": { "type": "string", "required": true },
          "stickout_mm": { "type": "number", "min": 5, "max": 300, "required": true }
        }
      }
    },
    "tool_assembly_build": {
      "category": "tool_assembly",
      "display_name": "Build Tool Assembly (Tool + Holder + Adapter)",
      "description": "Combine tool, holder, and adapter into a complete assembly for collision and reach checks.",
      "parameter_count": 9,
      "dialog_tabs": ["tool", "holder", "adapter", "envelope"],
      "parameters": {
        "tool": {
          "tool_id": { "type": "string", "required": true }
