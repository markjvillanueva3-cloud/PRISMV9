        "adapter": {
          "adapter_type": { "type": "enum", "values": ["hsk_a63", "hsk_a100", "bt30", "bt40", "bt50", "capto_c5", "capto_c6"], "required": true },
          "adapter_id": { "type": "string", "required": true }
        },
        "envelope": {
          "stickout_mm": { "type": "number", "min": 5, "max": 300, "required": true },
          "lower_taper_dia_mm": { "type": "number", "min": 5, "max": 100, "required": true },
          "upper_taper_dia_mm": { "type": "number", "min": 5, "max": 150, "required": true },
          "collision_envelope_step_mm": { "type": "number", "min": 0.1, "max": 5, "default": 0.5 }
        }
      }
    },
    "tool_measure_presetter": {
      "category": "tool_measurement",
      "display_name": "Import Presetter Measurement (Zoller / Speroni)",
      "description": "Import measured length, diameter, runout from external presetter via TDM or DNC link.",
      "parameter_count": 8,
      "dialog_tabs": ["source", "import", "validation"],
      "parameters": {
        "source": {
          "presetter_brand": { "type": "enum", "values": ["zoller", "speroni", "haimer", "kelch", "parlec", "bigkaiser"], "required": true },
