        "validation": {
          "max_runout_threshold_um": { "type": "number", "min": 1, "max": 50, "default": 10 },
          "diameter_tolerance_um": { "type": "number", "min": 1, "max": 100, "default": 20 }
        }
      }
    },
    "tool_wear_track": {
      "category": "tool_lifecycle",
      "display_name": "Tool Wear & Life Tracking",
      "description": "Track cumulative cut time, parts machined, and remaining life per tool.",
      "parameter_count": 7,
