          "warning_threshold_pct": { "type": "number", "min": 50, "max": 95, "default": 85 }
        }
      }
    },
    "tool_library_export": {
      "category": "library_io",
      "display_name": "Export Tool Library (ISO 13399 / TDM)",
      "description": "Export tool library to ISO 13399 STEP-compliant XML, TDM XML, or CAM-system-native (Mastercam, NX, Catia).",
      "parameter_count": 6,
