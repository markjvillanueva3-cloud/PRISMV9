    },
    {
      "topic": "Heidenhain TCPM (M128/M129)",
      "key_concepts": ["M128 = enable TCPM", "M129 = disable", "Always pair correctly to prevent rotary drift"],
      "best_practices": ["Wrap each tilt operation in M128…M129"]
    },
    {
      "topic": "Subprogram Threshold",
      "key_concepts": ["Repeating ≥15% of program → use subprogram", "Reduces program size, improves controller load times"],
