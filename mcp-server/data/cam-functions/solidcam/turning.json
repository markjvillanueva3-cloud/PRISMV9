  "training_topics": [
    {
      "topic": "Constant Surface Speed (CSS) vs Constant RPM",
      "key_concepts": [
        "G96 holds vc constant by varying RPM as diameter changes",
        "G97 holds RPM constant — required for threading and parting near center",
        "spindle_max_rpm clamps the upper bound on G96 to protect chuck/spindle"
      ],
      "best_practices": [
        "Use G96 for facing and OD turning, switch to G97 within 2-3mm of center",
        "Always declare spindle_max_rpm — runaway spindle on small diameters destroys parts and chucks"
      ]
    },
    {
      "topic": "Boring Bar L/D Ratio",
      "key_concepts": [
        "L/D = overhang_mm / bar_diameter_mm — primary indicator of vibration risk",
        "Steel bar tolerable to ~4×D; carbide ~6×D; damped ~10×D",
        "Deflection scales with L^3 and inversely with D^4 — small diameter changes are huge"
      ],
      "best_practices": [
        "Reduce DOC and feed by 30-50% beyond 4×D ratio",
        "Switch to anti-vibration (damped) bars before chasing parameters",
        "Use TSC coolant to clear chips that compound chatter at high L/D"
      ]
    },
    {
      "topic": "Threading Infeed Strategies",
      "key_concepts": [
        "Radial: chip thickens each pass; cuts on both flanks — short tool life on coarse pitches",
        "Modified flank (~29°): cuts on leading flank only; rubs trailing — longest tool life, best surface",
        "Alternating flank: switches sides each pass — best chip control, used on large pitches"
      ],
      "best_practices": [
        "Use modified flank for most general threads (M ≥ 1.5, UNC ≥ 1/4-20)",
        "Alternating flank for pitch ≥ 3mm or trapezoidal/ACME forms",
        "Always include 1+ spring passes to stabilize the flank profile"
      ]
    },
    {
      "topic": "Constant Chip Area Pass Scheduling",
      "key_concepts": [
        "First pass cuts the deepest, subsequent passes cut progressively less",
        "Doc_n = first_doc × √(1/n) keeps chip cross-section roughly constant",
        "Prevents tool overload on later passes (chip cross-section grows with depth)"
      ],
      "best_practices": [
        "Use Sandvik formula doc_n = doc_1 × sqrt((n-1+1)/n) variant in production",
        "Clamp min_doc to keep tool from rubbing — final passes should still cut, not burnish"
      ]
    },
    {
      "topic": "Part-Off Strategy & Sub-Spindle Catch",
      "key_concepts": [
        "Feed reduction near break (typ. 1-2mm before center) prevents spike load",
        "Pull-back retract distance protects blade tip from stub kick-out",
        "Sub-spindle catch enables continuous bar work without operator intervention"
      ],
      "best_practices": [
        "Always reduce feed at break — full feed at center fractures inserts",
        "Sub-spindle pickup pressure must match part rigidity (low for thin, high for slugs)",
        "Add 0.3mm chamfer at break for clean edge with no burr"
      ]
    },
    {
      "topic": "Stock-Following Recursive Roughing (G71-style)",
      "key_concepts": [
        "Rather than constant DOC, follows actual stock contour",
        "Reduces air cuts on near-net stock (forgings, castings)",
        "Emulates Fanuc G71 type II behavior in CAM-generated G-code"
      ],
      "best_practices": [
        "Provide accurate stock_curve for forgings/castings or air time wastes cycle",
        "Cap max_passes to prevent runaway loops on degenerate geometry",
        "Verify rough vs finish profile leave-stock matches downstream finishing offset"
      ]
    }
  ]
}