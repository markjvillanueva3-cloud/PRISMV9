  "training_topics": [
    {
      "topic": "iMachining Level Selection",
      "key_concepts": ["aggressiveness_levels_1_to_8", "level_4_default", "rigidity_dependence", "material_dependence"],
      "best_practices": [
        "Start at level 4 for unknown setups",
        "Reduce to 2-3 for low-rigidity machines or thin walls",
        "Push to 6-7 only when machine + tool + fixture are all rigid",
        "Level 8 is for benchmark conditions only — verify chip load math first"
      ]
    },
    {
      "topic": "Technology Wizard Inputs",
      "key_concepts": ["material_iso_group", "tool_substrate_coating", "machine_rigidity", "feature_type"],
      "best_practices": [
        "Always supply hardness if known — defaults assume mid-range",
        "Match machine rigidity honestly — overestimating causes chatter",
        "Use feature_type=thin_wall for parts with walls < 5x tool diameter",
        "Re-run wizard whenever tool substrate or coating changes"
      ]
    },
    {
      "topic": "iMachining 3D vs 2D",
      "key_concepts": ["constant_z_vs_morphing_z", "scallop_height_3d", "z_step_strategy"],
      "best_practices": [
        "Use 2D for prismatic features with vertical walls",
        "Use 3D for any part with non-vertical walls or ramped floors",
        "Tighten scallop_height_mm only on visible surfaces — wastes time elsewhere",
        "Adaptive Z handles undercuts; constant Z is faster on flat-topology parts"
      ]
    },
    {
      "topic": "Tool Database Discipline",
      "key_concepts": ["tool_id_uniqueness", "stickout_per_assembly", "balanced_grade", "max_rpm_safety"],
      "best_practices": [
        "Each physical tool/holder assembly gets a unique tool_assembly_id after preset",
        "Always record stickout — it controls deflection model",
        "Carbide tools below 6mm need G2.5 balance for >15k RPM",
        "max_rpm = min(spindle_max, tool_max, balance_grade_max)"
      ]
    },
    {
      "topic": "Chip Load and Engagement",
      "key_concepts": ["chip_thinning_correction", "max_radial_engagement", "constant_chip_thickness"],
      "best_practices": [
        "iMachining auto-corrects for chip thinning at low engagement",
        "Below 30% radial, chip load can rise above table values without breakage",
        "Constant chip thickness = constant tool wear = predictable life",
        "Always check that calculated MRR fits within spindle power budget"
      ]
    }
  ]
}
