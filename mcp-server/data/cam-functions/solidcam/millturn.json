  "training_topics": [
    {
      "topic": "C-Axis Indexing vs C-Axis Live Interpolation",
      "key_concepts": [
        "Indexed: spindle is treated as a C rotary, clamped at angles for drilling/milling",
        "Live: spindle interpolates angularly while machining (G12.1 polar, full XYC moves)",
        "Live mode requires C-axis brake released and tighter dynamic tuning"
      ],
      "best_practices": [
        "Use indexed mode for hole patterns (faster, more rigid)",
        "Use live mode for polar contours, slots that span >90°, or tangent feature transitions",
        "Always re-engage C-clamp before high-load axial cuts to protect the C-axis motor"
      ]
    },
    {
      "topic": "Sub-Spindle Pickup Pressure",
      "key_concepts": [
        "Too low: part slips during transfer → scrap and possible crash",
        "Too high: part marking, deformation, or chuck damage on thin walls",
        "Pressure should match part rigidity (low for thin tubes, high for solid stock)"
      ],
      "best_practices": [
        "Always enable force monitoring + abort_on_overforce — prevents driving sub into main",
        "Verify chuck open status before commanding sync RPM",
        "Use synchronized pickup (rigid_sync=true) for threading or precision second ops"
      ]
    },
    {
      "topic": "Wait Codes & Multi-Channel Sync",
      "key_concepts": [
        "M400/M401/M402 (Fanuc) are arbitrary barrier codes — both channels must reach to proceed",
        "Mitsubishi uses !L codes; Okuma uses WAIT/WAITS macros",
        "Deadlock if one channel exits before reaching its matching barrier"
      ],
      "best_practices": [
        "Pair every wait code on main with the same code on sub — count them in code review",
        "Always set wait_timeout_sec to recover from operator-aborted single-channel runs",
        "Diagram channel sync points before writing code — flowchart prevents deadlocks"
      ]
    },
    {
      "topic": "Y-Axis vs Polar Interpolation",
      "key_concepts": [
        "True Y-axis: physical linear axis, full feedrate, tight tolerances (±0.005mm)",
        "Polar (G12.1): synthesized via X+C, slower, looser at low radii, fails at center",
        "Polar feed correction (G12.1 modal) keeps surface speed near center"
      ],
      "best_practices": [
        "Prefer true Y for any feature off-center where tolerance matters",
        "Polar OK for shallow milling, slot-pocket hybrids that don't cross center",
        "If polar must approach center: enable feed correction + set x_min_radius_mm > 0"
      ]
    },
    {
      "topic": "Swiss-Type Guide Bushing Clearance",
      "key_concepts": [
        "Standard clearance 0.01-0.03mm (per side) keeps stock concentric without binding",
        "Too tight: galling, bar bind, broken stock",
        "Too loose: chatter, surface finish degradation, loss of tolerance",
        "Guideless mode supports certain Citizen/Tornos machines for short parts"
      ],
      "best_practices": [
        "Match guide bushing diameter to ground stock (h7 typical)",
        "Use polished bushing for stainless and titanium to prevent galling",
        "For parts <2×D in length, guideless mode + face support gives best tolerance"
      ]
    },
    {
      "topic": "Balanced Turning Deflection Reduction",
      "key_concepts": [
        "Two tools cutting opposing sides cancel radial force → deflection ~50% lower",
        "L/D >8 shafts benefit dramatically (deflection scales with L^3)",
        "Requires precise z-offset to avoid one tool finishing what the other is roughing"
      ],
      "best_practices": [
        "Set z_offset_between_tools_mm so each tool stays in its own zone",
        "Use deflection_compensation to bias tool position based on predicted deflection",
        "Below L/D=4, balanced turning adds complexity without measurable benefit"
      ]
    },
    {
      "topic": "Bar Feeder Remnant Management",
      "key_concepts": [
        "Each cycle removes part_length + cut-off width from bar",
        "When remnant < threshold, machine should stop and call for new bar",
        "Magazine feeders cycle automatically; short-bar feeders need manual reload"
      ],
      "best_practices": [
        "Set verify_remnant_threshold_mm to part_length × 1.5 + grip_length",
        "Always verify_bar_present before each cycle — prevents air-cuts and crashes",
        "For high-mix work, log remnant lengths to optimize stock allocation across jobs"
      ]
    }
  ]
}