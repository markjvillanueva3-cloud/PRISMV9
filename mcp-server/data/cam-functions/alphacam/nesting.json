    "wood_grain_nest": {
      "display_name": "Wood-Grain Auto-Nest",
      "category": "wood_grain_nest",
      "description": "Alphacam flagship — auto-nest with wood-grain orientation lock. Honors customer-specified grain direction (with/across) per part.",
      "dialog_tabs": ["Sheet", "Parts", "Algorithm", "Grain"],
      "parameter_count": 18,
      "parameters": {
        "sheet": {
          "sheetWidth": { "type": "number", "unit": "mm", "tab": "Sheet", "required": true },
          "sheetHeight": { "type": "number", "unit": "mm", "tab": "Sheet", "required": true },
          "grainDirection": { "type": "enum", "values": ["+X", "+Y", "noGrain"], "default": "+X", "tab": "Sheet", "required": true },
          "sheetMargin": { "type": "number", "unit": "mm", "default": 8, "tab": "Sheet" },
          "thickness": { "type": "number", "unit": "mm", "default": 19, "tab": "Sheet" }
        },
        "parts": {
          "partList": { "type": "selection", "tab": "Parts", "required": true },
          "partSpacing": { "type": "number", "unit": "mm", "default": 5, "description": "Allow router pass + small kerf", "tab": "Parts" },
          "respectGrain": { "type": "boolean", "default": true, "description": "Lock part rotation to grain rules", "tab": "Parts" },
          "edgeBandedSides": { "type": "string", "default": "[long_edges]", "tab": "Parts" }
        },
        "algorithm": {
          "algorithm": { "type": "enum", "values": ["geneticAlgorithm", "boundingBoxFFD", "noFitPolygon", "guillotine"], "default": "geneticAlgorithm", "tab": "Algorithm" },
          "iterations": { "type": "integer", "default": 250, "range": [50, 5000], "tab": "Algorithm" },
          "populationSize": { "type": "integer", "default": 50, "range": [10, 500], "tab": "Algorithm" },
          "convergenceTol": { "type": "number", "default": 0.005, "tab": "Algorithm" },
          "yieldThresholdAbort": { "type": "number", "unit": "percent", "default": 50, "description": "Abort if cannot beat this yield", "tab": "Algorithm" }
        },
        "grain": {
          "withGrainAllowed": { "type": "boolean", "default": true, "tab": "Grain" },
          "acrossGrainAllowed": { "type": "boolean", "default": false, "description": "Default: never rotate parts that have grain-aligned cosmetic faces", "tab": "Grain" },
          "perpendicularAllowed": { "type": "boolean", "default": false, "tab": "Grain" },
          "anyAllowed": { "type": "boolean", "default": false, "description": "Override: ignore grain constraint", "tab": "Grain" }
        }
      }
    },
    "common_line_woodwork": {
      "display_name": "Common-Line Cutting (Woodwork)",
      "category": "common_line",
      "description": "Two parts share a router cut. Saves cycle time on dense furniture nests but requires straight shared edges.",
      "dialog_tabs": ["Detection", "Strategy", "Cuts", "Output"],
      "parameter_count": 14,
      "parameters": {
        "detection": {
          "minSharedEdgeLength": { "type": "number", "unit": "mm", "default": 80, "description": "Below this, common-line is not worth setup overhead", "tab": "Detection" },
          "maxAngleDeviation": { "type": "number", "unit": "deg", "default": 0.5, "tab": "Detection" },
          "candidateLayer": { "type": "string", "default": "common_line_candidates", "tab": "Detection" }
        },
        "strategy": {
          "approachMode": { "type": "enum", "values": ["fromOutside", "fromInside", "alongEdge", "auto"], "default": "auto", "tab": "Strategy" },
          "kerfSplit": { "type": "enum", "values": ["even", "favorPartA", "favorPartB"], "default": "even", "tab": "Strategy" },
          "leadInLength": { "type": "number", "unit": "mm", "default": 8, "tab": "Strategy" }
        },
        "cuts": {
          "depthOfCut": { "type": "number", "unit": "mm", "default": 6, "tab": "Cuts" },
          "passCount": { "type": "integer", "default": 4, "tab": "Cuts" },
          "feedReductionShared": { "type": "number", "unit": "percent", "default": 15, "description": "Slow down on shared cuts to handle dual-side load", "tab": "Cuts" }
        },
        "output": {
          "writeReport": { "type": "boolean", "default": true, "tab": "Output" },
          "highlightShared": { "type": "boolean", "default": true, "tab": "Output" },
          "warnOnDegradation": { "type": "boolean", "default": true, "tab": "Output" },
          "exportLayer": { "type": "string", "default": "common_line_cuts", "tab": "Output" }
        }
      }
    },
    "batch_nest": {
      "display_name": "Batch Nesting",
      "category": "batch_nest",
      "description": "Multi-sheet batch nesting for production runs. Handles material substitution and minimum-quantity constraints.",
      "dialog_tabs": ["Batch", "Materials", "Strategy", "Output"],
      "parameter_count": 16,
      "parameters": {
        "batch": {
