          "warnIfNoMatch": { "type": "boolean", "default": false, "tab": "Use" }
        },
        "strategy": {
          "fitMethod": { "type": "enum", "values": ["bestFit", "smallestSuitable", "manualSelect"], "default": "bestFit", "tab": "Strategy" },
          "rotationAllowed": { "type": "enum", "values": ["any", "0_90", "0_only"], "default": "0_90", "tab": "Strategy" },
          "respectGrainOnOffCut": { "type": "boolean", "default": true, "tab": "Strategy" },
          "yieldImprovementThresh": { "type": "number", "unit": "percent", "default": 5, "description": "Use off-cut only if yield ≥5% better than fresh sheet", "tab": "Strategy" }
        },
        "output": {
          "writeOffCutInventory": { "type": "boolean", "default": true, "tab": "Output" },
          "exportOffCutCSV": { "type": "boolean", "default": false, "tab": "Output" },
          "warnIfInventoryOverflow": { "type": "boolean", "default": true, "tab": "Output" },
          "exportSavingsReport": { "type": "boolean", "default": true, "description": "Track $ saved by off-cut reuse", "tab": "Output" }
        }
      }
    }
