          "allowSubstitution": { "type": "boolean", "default": false, "tab": "Materials" },
          "thicknessTolerance": { "type": "number", "unit": "mm", "default": 0.5, "tab": "Materials" },
          "preferGroupBatching": { "type": "boolean", "default": true, "description": "Batch like-materials together to minimize stops", "tab": "Materials" }
        },
        "strategy": {
          "globalAlgorithm": { "type": "enum", "values": ["genetic", "bestFit", "firstFit", "leastWaste"], "default": "genetic", "tab": "Strategy" },
          "iterationsPerSheet": { "type": "integer", "default": 100, "tab": "Strategy" },
          "yieldThresholdSwitch": { "type": "number", "unit": "percent", "default": 70, "description": "Below this, switch to next algorithm", "tab": "Strategy" }
        },
        "output": {
          "writeJobReport": { "type": "boolean", "default": true, "tab": "Output" },
          "exportSheetDiagrams": { "type": "boolean", "default": true, "tab": "Output" },
          "writePartLocations": { "type": "boolean", "default": true, "tab": "Output" },
          "exportToCSV": { "type": "boolean", "default": false, "tab": "Output" },
          "exportLabels": { "type": "boolean", "default": true, "description": "Generate part labels for QR / barcode", "tab": "Output" }
        }
      }
    },
    "off_cut_optimize": {
      "display_name": "Off-Cut Optimization",
      "category": "off_cut_optimize",
      "description": "Track off-cuts (remnants) into inventory. Future jobs prefer off-cuts before consuming new sheets.",
      "dialog_tabs": ["Track", "Use", "Strategy", "Output"],
      "parameter_count": 16,
      "parameters": {
        "track": {
          "trackOffCuts": { "type": "boolean", "default": true, "tab": "Track" },
          "minOffCutSize": { "type": "number", "unit": "mm", "default": 200, "description": "Below this, scrap not stored", "tab": "Track" },
          "minOffCutArea": { "type": "number", "unit": "mm2", "default": 100000, "tab": "Track" },
          "saveLocation": { "type": "string", "default": "inventory/off_cuts", "tab": "Track" },
          "labelOffCuts": { "type": "boolean", "default": true, "description": "Print barcode label for off-cut", "tab": "Track" }
        },
        "use": {
          "preferOffCutsFirst": { "type": "boolean", "default": true, "tab": "Use" },
