    "laser_sheet_cut": {
      "display_name": "Laser Sheet Cut",
      "category": "laser_sheet",
      "description": "Sheet metal/composite laser cutting. Supports CO2, fiber, Nd:YAG. Auto-piercing strategies and adaptive lead-in.",
      "dialog_tabs": ["Material", "Process", "LeadIn", "Output"],
      "parameter_count": 16,
      "parameters": {
        "material": {
          "materialType": { "type": "enum", "values": ["mildSteel", "stainless", "aluminum", "copper", "brass", "plywood", "MDF", "acrylic", "carbonFiber"], "default": "mildSteel", "tab": "Material", "required": true },
          "thickness": { "type": "number", "unit": "mm", "default": 3.0, "tab": "Material", "required": true },
          "kerf": { "type": "number", "unit": "mm", "default": 0.15, "description": "Auto-computed; override if needed", "tab": "Material" }
        },
        "process": {
          "laserType": { "type": "enum", "values": ["CO2", "fiber", "Nd_YAG", "diode"], "default": "fiber", "tab": "Process" },
          "powerW": { "type": "number", "unit": "W", "default": 4000, "tab": "Process" },
          "feedrate": { "type": "number", "unit": "mm_per_min", "default": 4000, "tab": "Process" },
          "frequency": { "type": "number", "unit": "Hz", "default": 5000, "tab": "Process" },
          "assistGas": { "type": "enum", "values": ["O2", "N2", "air", "argon", "none"], "default": "N2", "tab": "Process" },
          "gasPressure": { "type": "number", "unit": "bar", "default": 18, "tab": "Process" }
        },
        "leadIn": {
          "pierceMode": { "type": "enum", "values": ["fixedDelay", "powerRamp", "edgePierce", "preDrilled"], "default": "powerRamp", "tab": "LeadIn" },
          "pierceDelay": { "type": "number", "unit": "s", "default": 0.5, "tab": "LeadIn" },
          "leadInType": { "type": "enum", "values": ["arc", "tangent", "perpendicular", "loop"], "default": "arc", "tab": "LeadIn" },
          "leadInLength": { "type": "number", "unit": "mm", "default": 5.0, "tab": "LeadIn" }
        },
        "output": {
          "kerfCompensation": { "type": "enum", "values": ["computer", "control", "off"], "default": "computer", "tab": "Output" },
          "warnIfThicknessOut": { "type": "boolean", "default": true, "tab": "Output" }
        }
      }
    },
    "plasma_sheet_cut": {
