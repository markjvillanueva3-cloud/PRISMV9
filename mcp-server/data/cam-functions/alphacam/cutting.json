  "training_topics": [
    {
      "topic": "Alphacam cutting discipline",
      "key_concepts": ["laser N2 vs O2 (assist gas selection)", "plasma THC voltage control", "waterjet quality levels Q1-Q5"],
      "best_practices": [
        "Use N2 assist gas for stainless and aluminum to prevent oxidation; O2 with mild steel for fast burn-cut",
        "Plasma without THC (torch height control) burns consumables in 30 minutes — always enable thcEnabled",
        "Waterjet Q5 (finest) is ~6x slower than Q1 (separation) — use Q3 for most production work"
