      "dialog_tabs": ["Material", "Plasma", "Height", "Output"],
      "parameter_count": 14,
      "parameters": {
        "material": {
          "materialType": { "type": "enum", "values": ["mildSteel", "stainless", "aluminum"], "default": "mildSteel", "tab": "Material", "required": true },
          "thickness": { "type": "number", "unit": "mm", "default": 12, "tab": "Material", "required": true },
          "kerf": { "type": "number", "unit": "mm", "default": 2.0, "tab": "Material" }
        },
        "plasma": {
