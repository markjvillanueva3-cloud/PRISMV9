          "cutHeight": { "type": "number", "unit": "mm", "default": 1.5, "tab": "Height" }
        },
        "output": {
          "exportSetupSheet": { "type": "boolean", "default": true, "tab": "Output" },
          "warnOnConsumableLife": { "type": "boolean", "default": true, "tab": "Output" }
        }
      }
    },
