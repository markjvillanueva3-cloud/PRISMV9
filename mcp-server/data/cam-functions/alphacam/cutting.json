          "warnIfTooThin": { "type": "boolean", "default": true, "description": "Oxy-fuel struggles below 6mm", "tab": "Output" },
          "writeKerfDiagram": { "type": "boolean", "default": false, "tab": "Output" },
          "halfSpeedAtCorners": { "type": "boolean", "default": true, "tab": "Output" },
          "preheatPosition": { "type": "string", "default": "atPiercePoint", "tab": "Output" }
        }
