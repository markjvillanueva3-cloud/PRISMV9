          "fuelPressure": { "type": "number", "unit": "bar", "default": 0.5, "tab": "Gas" },
          "oxygenPressure": { "type": "number", "unit": "bar", "default": 4.5, "tab": "Gas" },
          "tipSize": { "type": "string", "default": "size_2", "tab": "Gas" }
        },
        "strategy": {
          "feedrate": { "type": "number", "unit": "mm_per_min", "default": 350, "description": "Slow due to thick plate", "tab": "Strategy" },
          "preheatTimeS": { "type": "number", "unit": "s", "default": 6, "tab": "Strategy" },
          "pierceTimeS": { "type": "number", "unit": "s", "default": 4, "tab": "Strategy" },
          "drag": { "type": "number", "unit": "deg", "default": 1.5, "description": "Backward kerf-tilt", "tab": "Strategy" }
