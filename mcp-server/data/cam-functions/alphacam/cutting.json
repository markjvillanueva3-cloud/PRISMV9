        },
        "output": {
          "writeStartHole": { "type": "boolean", "default": false, "description": "Glass/granite require pre-drilled start hole", "tab": "Output" },
          "exportSetupSheet": { "type": "boolean", "default": true, "tab": "Output" }
        }
      }
    },
    "oxy_fuel": {
      "display_name": "Oxy-Fuel Cut",
      "category": "oxy_fuel",
      "description": "Oxy-fuel for thick steel (>25mm). Acetylene/propane/natural gas. Slow but cuts very thick plate.",
      "dialog_tabs": ["Material", "Gas", "Strategy", "Output"],
      "parameter_count": 16,
      "parameters": {
