  "training_topics": [
    {
      "topic": "Alphacam wood routing discipline",
      "key_concepts": ["climb cut for chip evacuation in wood", "micro-tabs vs vacuum hold-down", "grain compensation for tearout"],
      "best_practices": [
        "Climb cuts (cutter spinning into the grain on the downstream side) prevent chip-pull-out in MDF and softwoods",
        "Micro-tabs at 4 positions per part holds the part during the final pass; remove tabs by hand after cycle",
        "Grain compensation slows feed by ~30% across-grain to prevent tearout in oak/walnut/birch"
      ]
