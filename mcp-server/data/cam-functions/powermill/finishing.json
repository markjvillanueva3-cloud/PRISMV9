  "training_topics": [
    {
      "topic": "Steep vs Shallow Threshold Angle",
      "key_concepts": [
        "Canonical threshold = 30° — steep above, shallow below",
        "overlap_angle of 1-3° prevents a visible witness line at the boundary",
        "Steep gets waterline (constant Z); shallow gets 3D offset or raster"
      ],
      "best_practices": [
        "Use Steep & Shallow as the single-shot finish for mixed geometry",
        "Lower threshold (e.g. 25°) when raster pattern shows on shallow regions",
        "Raise threshold (e.g. 35°) when waterline scallops show on steep regions"
      ]
    },
    {
      "topic": "Constant Z Stepdown for Hard Materials",
      "key_concepts": [
        "Stepdown drives cusp height on steep walls: cusp ≈ stepdown · sin(angle)",
        "Hard materials (≥ 50 HRC) need stepdown ≤ 0.10mm to control tool wear",
        "Optimised Constant Z auto-tightens stepdown on shallow regions"
      ],
      "best_practices": [
        "Hardened steel: 0.05-0.10mm stepdown, ball end mill, climb only",
        "Aluminum: 0.20-0.40mm stepdown, single pass acceptable",
        "Use Constant Z Rest after the bigger tool's pass to clean up corners"
      ]
    },
    {
      "topic": "3D Offset vs Raster — Surface Quality Tradeoffs",
      "key_concepts": [
        "3D Offset = uniform cusp height across all surface angles",
        "Raster = directional cusp height varies with surface slope",
        "3D Offset cycle time is 10-30% longer than raster on same surface"
