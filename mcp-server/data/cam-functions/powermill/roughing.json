  "training_topics": [
    {
      "topic": "Vortex Engagement Discipline",
      "key_concepts": [
        "Canonical envelope: max_radial_engagement_pct ≤ 12% AND axial_doc_to_dia_ratio ≤ 2.5",
        "feed_per_tooth scales up by 30-40% vs traditional roughing",
        "tool_loc_to_dia_ratio ≥ 3 to take advantage of deep axial DOC"
      ],
      "best_practices": [
        "Start with 8% radial / 1.5×D axial / 0.10 mm fpt — tighten as confidence grows",
        "Always set smooth_path=true — sharp corners cause spike loads",
        "Use a long-flute (≥3×D LOC) end mill to fully exploit axial DOC"
      ]
    },
    {
      "topic": "MAC vs OAC vs Profile vs Slice — When to Pick Which",
      "key_concepts": [
        "MAC = full cavity clearance with offset/raster fill",
        "OAC = offset-only fill (smoother, more constant chip load than zigzag)",
        "PAC = profile-only (no fill) — pair with another op for the fill",
        "Slice = waterline slice at each Z level — single horizontal pass per slice"
      ],
      "best_practices": [
