  "training_topics": [
    {
      "topic": "Swarf vs Tilted-Tool Axis on Ruled Surfaces",
      "key_concepts": [
        "Swarf = full-flute side-cut on ruled surface; one pass per V step",
        "Tilted tool axis = tip cuts with controlled lead/lag; multi-pass",
        "Swarf is faster but requires the surface to be truly ruled"
