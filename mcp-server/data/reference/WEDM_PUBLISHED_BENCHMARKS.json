    "fanuc_simple_bore": {
      "controller": "fanuc",
      "program": [
        "S100 H021",
        "G22 H1000",
        "S200 H022",
        "G22 H1000",
        "N1000 (0.103 BORE)",
        "G01 G41 X0.0515",
        "G03 X-0.0515 I-0.0515 J0",
        "G03 X0.0515 I0.0515 J0",
        "G01 G40 X0",
        "M99"
      ],
      "notes": "S100/S200 = rough/skim conditions, H021/H022 = offsets",
      "source": "HelmanCNC"
    }
