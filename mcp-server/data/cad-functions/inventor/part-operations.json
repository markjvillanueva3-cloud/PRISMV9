            {"name": "Tolerance", "type": "numeric", "unit": "mm", "description": "Approximation tolerance for never_too_*"}
          ]
        }
      }
    },
    "DRAFT": {
      "description": "Apply taper angle to faces relative to a pull direction. Two modes: Fixed-Edge (drafts hinge on a selected edge chain) and Fixed-Plane (drafts hinge on a parting plane). Used for moldability.",
      "category": "Part_Modify_Draft",
      "python_api": "ComponentDefinition.Features.FaceDraftFeatures.AddUsingFixedEdge / AddUsingFixedPlane",
      "parameterCount": 7,
      "tabs": {
        "Geometry": {
          "parameters": [
            {"name": "Mode", "type": "dropdown", "options": ["fixed_edge", "fixed_plane"], "default": "fixed_edge"},
            {"name": "Pull Direction", "type": "selection", "description": "Reference axis / face / edge defining demold direction", "required": true},
            {"name": "Fixed Edge", "type": "selection_list", "description": "Edge chain (fixed_edge mode)"},
            {"name": "Fixed Plane", "type": "selection", "description": "Parting plane (fixed_plane mode)"},
            {"name": "Faces to Draft", "type": "selection_list", "required": true},
            {"name": "Angle", "type": "numeric", "unit": "deg", "description": "Draft angle (positive widens toward pull direction)", "required": true},
