      "description": "Polar-array replication about an axis. Count + total/incremental angle determine layout. Orient-to-axis option keeps each instance rotated to its local position vs identical to source.",
      "category": "Part_Pattern_Circular",
      "python_api": "ComponentDefinition.Features.CircularPatternFeatures.Add",
      "parameterCount": 8,
      "tabs": {
        "Geometry": {
          "parameters": [
