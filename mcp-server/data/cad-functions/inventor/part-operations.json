    },
    "COMBINE": {
      "description": "Boolean operation between solid bodies in a multi-body part. Three modes: Join (union), Cut (subtract), Intersect (common volume). Tool body is consumed by default; optional Keep-Tool checkbox preserves it.",
      "category": "Part_Boolean_Combine",
      "python_api": "ComponentDefinition.Features.CombineFeatures.Add",
      "parameterCount": 5,
      "tabs": {
        "Geometry": {
          "parameters": [
            {"name": "Base Body", "type": "selection", "required": true},
