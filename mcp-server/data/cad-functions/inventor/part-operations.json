{
  "schemaVersion": "1.0.0",
  "metadata": {
    "title": "Autodesk Inventor Part Operations — 3D Solid Features (Part Environment)",
    "description": "Parameter catalog for the Inventor Part Modeling environment — the 3D feature set that consumes sketches into parametric solid bodies. Catalog covers 6 sweep features (Extrude / Revolve / Sweep / Loft / Coil / Rib), 2 hole/thread cycles (Hole / Thread), 4 modify features (Fillet / Chamfer / Shell / Draft), 1 boolean (Combine), 5 pattern families (Rectangular / Circular / Mirror / Sketch-Driven / Path), 1 derive op (Derive Component), and 7 utility / direct-edit features (Thicken-Offset / Delete Face / Split Body / Copy Object / Move Body / Emboss). All bindings reference real Inventor COM API (PartDocument.ComponentDefinition.Features.*).",
    "version": "2025.0",
    "extractedDate": "2026-05-01",
    "milestone": "U-CAD-FIDX-INV-02",
    "source": "Autodesk Inventor 2025 Help — Part Modeling Reference; Inventor API Reference — PartFeatures collection (ExtrudeFeatures, RevolveFeatures, SweepFeatures, LoftFeatures, CoilFeatures, RibFeatures, HoleFeatures, ThreadFeatures, FilletFeatures, ChamferFeatures, ShellFeatures, FaceDraftFeatures, CombineFeatures, RectangularPatternFeatures, CircularPatternFeatures, MirrorFeatures, SketchDrivenPatternFeatures, PathPatternFeatures, DerivedComponents, ThickenFeatures, DeleteFaceFeatures, SplitFeatures, CopyObjectFeatures, MoveBodyFeatures, EmbossFeatures)",
    "totalParameters": 178,
    "operationCount": 25,
    "cad_concepts_used": [
      "PARAMETRIC_FEATURE",
      "FEATURE_TREE",
      "TERMINATION_CONDITION",
      "TAPER_DRAFT",
      "BOOLEAN_OPERATION",
      "PATTERN_OCCURRENCE",
      "DIRECT_EDIT",
      "FEATURE_SUPPRESSION",
      "BODY_OPERATION_SCOPE"
    ]
  },
  "commonTabs": {
    "description": "Standard parameter tabs across Inventor part features",
    "tabs": ["Geometry", "Operation", "Properties"]
  },
  "operations": {
    "EXTRUDE": {
      "description": "Linear sweep of a profile along its sketch normal. Inventor supports 5 termination types (Distance, To, To-Next, Through-All, Between), 4 boolean operations (Join, Cut, Intersect, New-Solid), and 3 directions (Default, Symmetric, Two-Sides). Optional taper angle and thin-feature wall thickness for sheet-like extrusions.",
      "category": "Part_Sweep_Extrude",
      "python_api": "ComponentDefinition.Features.ExtrudeFeatures.AddByDistanceExtent / AddByToExtent / AddByThroughAllExtent / AddByBetweenExtents",
      "parameterCount": 10,
      "tabs": {
        "Geometry": {
          "parameters": [
            {"name": "Profile", "type": "selection", "description": "Closed sketch profile (or surface for thin-feature extrusion)", "required": true},
            {"name": "Termination", "type": "dropdown", "options": ["distance", "to", "to_next", "through_all", "between"], "default": "distance", "required": true},
            {"name": "Distance", "type": "numeric", "unit": "mm", "description": "Extent length (distance termination)"},
            {"name": "To Face", "type": "selection", "description": "Terminating face / work-plane (to / between modes)"},
            {"name": "Direction", "type": "dropdown", "options": ["default", "flip", "symmetric", "two_sides"], "default": "default"},
            {"name": "Taper Angle", "type": "numeric", "unit": "deg", "description": "Per-direction taper (positive = outward)", "default": 0},
            {"name": "Thin Feature", "type": "checkbox", "description": "Treat profile as wall + extrude with thickness", "default": false},
            {"name": "Wall Thickness", "type": "numeric", "unit": "mm", "description": "Thin-feature wall thickness", "min": 0.001}
          ]
        },
        "Operation": {
          "parameters": [
            {"name": "Boolean Op", "type": "dropdown", "options": ["join", "cut", "intersect", "new_solid"], "default": "join", "required": true},
            {"name": "Output", "type": "dropdown", "options": ["solid", "surface"], "default": "solid"}
          ]
        }
      }
    },
    "REVOLVE": {
      "description": "Rotational sweep of a profile about an axis. Inventor supports Full / By-Angle / To-Next / Two-Sides termination, and the 4 standard boolean operations. Profile may live on either side of the axis.",
      "category": "Part_Sweep_Revolve",
      "python_api": "ComponentDefinition.Features.RevolveFeatures.AddFull / AddByAngle",
      "parameterCount": 7,
      "tabs": {
        "Geometry": {
          "parameters": [
            {"name": "Profile", "type": "selection", "required": true},
            {"name": "Axis", "type": "selection", "description": "Sketch line, edge, or work-axis", "required": true},
            {"name": "Termination", "type": "dropdown", "options": ["full", "by_angle", "to", "to_next", "two_sides"], "default": "full"},
            {"name": "Angle", "type": "numeric", "unit": "deg", "description": "Sweep angle (by_angle / two_sides)", "default": 360},
            {"name": "Direction", "type": "dropdown", "options": ["default", "flip", "symmetric"], "default": "default"}
          ]
        },
        "Operation": {
          "parameters": [
            {"name": "Boolean Op", "type": "dropdown", "options": ["join", "cut", "intersect", "new_solid"], "default": "join"},
            {"name": "Output", "type": "dropdown", "options": ["solid", "surface"], "default": "solid"}
          ]
        }
      }
    },
    "SWEEP": {
      "description": "Sweep a profile along an arbitrary 2D/3D path. Three modes: Path-Only (orientation locked to path), Path-and-Guide (twist follows guide rail), Path-and-Surface (profile follows surface normal). Optional taper and twist angle per unit length.",
      "category": "Part_Sweep_Sweep",
      "python_api": "ComponentDefinition.Features.SweepFeatures.AddUsingPath / AddUsingPathAndGuideRail / AddUsingPathAndGuideSurface",
      "parameterCount": 8,
      "tabs": {
        "Geometry": {
          "parameters": [
            {"name": "Profile", "type": "selection", "required": true},
            {"name": "Path", "type": "selection", "description": "2D/3D sketch path or model edge chain", "required": true},
            {"name": "Mode", "type": "dropdown", "options": ["path_only", "path_and_guide", "path_and_surface"], "default": "path_only"},
            {"name": "Guide Rail", "type": "selection", "description": "Required for path_and_guide mode"},
            {"name": "Guide Surface", "type": "selection", "description": "Required for path_and_surface mode"},
            {"name": "Orientation", "type": "dropdown", "options": ["path", "parallel"], "default": "path"},
            {"name": "Taper Angle", "type": "numeric", "unit": "deg", "default": 0},
            {"name": "Twist Angle", "type": "numeric", "unit": "deg", "default": 0}
          ]
        }
      }
    },
    "LOFT": {
      "description": "Blend between 2+ profile sections, optionally constrained by rails or centerline. Supports tangent/normal/smooth conditions per section, closed-loop loft for swept solids, and ship-curve sections for hull-like shapes.",
      "category": "Part_Sweep_Loft",
      "python_api": "ComponentDefinition.Features.LoftFeatures.AddByLoftedSurface / AddByLoftedSolid",
      "parameterCount": 8,
      "tabs": {
        "Geometry": {
          "parameters": [
            {"name": "Sections", "type": "selection_list", "description": "Ordered list of profile sections (≥2)", "required": true, "min": 2},
            {"name": "Rails", "type": "selection_list", "description": "Optional guide rails for loft"},
            {"name": "Centerline", "type": "selection", "description": "Centerline-driven loft (mutually exclusive with rails)"},
            {"name": "Closed Loop", "type": "checkbox", "default": false},
            {"name": "Start Condition", "type": "dropdown", "options": ["free", "tangent", "smooth", "direction", "tangent_to_plane"], "default": "free"},
            {"name": "End Condition", "type": "dropdown", "options": ["free", "tangent", "smooth", "direction", "tangent_to_plane"], "default": "free"},
            {"name": "Output", "type": "dropdown", "options": ["solid", "surface"], "default": "solid"}
          ]
        },
        "Operation": {
          "parameters": [
            {"name": "Boolean Op", "type": "dropdown", "options": ["join", "cut", "intersect", "new_solid"], "default": "join"}
          ]
        }
      }
    },
    "COIL": {
      "description": "Helical sweep of a profile about an axis. Three solve modes: Pitch-and-Revolution, Revolution-and-Height, and Spiral (flat). Supports right-hand/left-hand winding, taper angle, and flat-end conditions (none / both / start / end) for square-cut spring ends.",
      "category": "Part_Sweep_Coil",
      "python_api": "ComponentDefinition.Features.CoilFeatures.AddByPitchAndRevolution / AddByRevolutionAndHeight / AddBySpiral",
      "parameterCount": 9,
      "tabs": {
        "Geometry": {
          "parameters": [
            {"name": "Profile", "type": "selection", "required": true},
            {"name": "Axis", "type": "selection", "required": true},
            {"name": "Solve Mode", "type": "dropdown", "options": ["pitch_revolution", "revolution_height", "spiral"], "default": "pitch_revolution"},
            {"name": "Pitch", "type": "numeric", "unit": "mm", "description": "Distance per revolution"},
            {"name": "Revolution", "type": "numeric", "description": "Number of turns (decimal allowed)"},
            {"name": "Height", "type": "numeric", "unit": "mm", "description": "Total coil height (revolution_height mode)"},
            {"name": "Rotation", "type": "dropdown", "options": ["right_hand", "left_hand"], "default": "right_hand"},
            {"name": "Taper", "type": "numeric", "unit": "deg", "description": "Per-revolution taper", "default": 0},
            {"name": "Flat Ends", "type": "dropdown", "options": ["none", "start", "end", "both"], "default": "none"}
          ]
        }
      }
    },
    "RIB": {
      "description": "Web-style stiffening rib swept from an open profile to a target body. Two solve modes: Normal-to-Sketch (extrude perpendicular) and Parallel-to-Sketch (extrude in plane). Optional draft for moldability.",
      "category": "Part_Sweep_Rib",
      "python_api": "ComponentDefinition.Features.RibFeatures.AddByNormalToSketch / AddByParallelToSketch",
      "parameterCount": 7,
      "tabs": {
        "Geometry": {
          "parameters": [
            {"name": "Profile", "type": "selection", "description": "Open sketch profile (network of curves)", "required": true},
            {"name": "Direction", "type": "dropdown", "options": ["normal_to_sketch", "parallel_to_sketch"], "default": "normal_to_sketch"},
            {"name": "Thickness", "type": "numeric", "unit": "mm", "required": true, "min": 0.001},
            {"name": "Symmetric", "type": "checkbox", "description": "Apply thickness symmetric about profile", "default": true},
            {"name": "Extents", "type": "dropdown", "options": ["to_next", "finite", "between"], "default": "to_next"},
            {"name": "Draft Angle", "type": "numeric", "unit": "deg", "default": 0},
            {"name": "Boss Toggle", "type": "checkbox", "description": "Generate boss (cylindrical reinforcement) at rib intersections", "default": false}
          ]
        }
      }
    },
    "HOLE": {
      "description": "Parametric hole feature with 5 head types (Drilled, Counterbore, Countersink, Counter-drill, Spotface), 4 termination types (Distance, Through-All, To, To-Next), and 5 thread standards (None, ANSI Inch UN, ANSI Metric, ISO Metric, GB Metric, BSP). Drives downstream Hole-Table emission in drawings + tap-cycle assignment for CAM. Drill-tip angle controls bottom geometry for Distance termination.",
      "category": "Part_Hole_Drill",
      "python_api": "ComponentDefinition.Features.HoleFeatures.AddDrilledByDistanceExtent / AddCounterboreByThroughAllExtent / etc.",
      "parameterCount": 11,
      "tabs": {
        "Geometry": {
          "parameters": [
            {"name": "Placement", "type": "selection", "description": "Sketch hole-center point(s) or face for from-face placement", "required": true},
            {"name": "Head Type", "type": "dropdown", "options": ["drilled", "counterbore", "countersink", "counter_drill", "spotface"], "default": "drilled"},
            {"name": "Termination", "type": "dropdown", "options": ["distance", "through_all", "to", "to_next"], "default": "distance"},
            {"name": "Diameter", "type": "numeric", "unit": "mm", "description": "Hole bore diameter", "required": true, "min": 0.001},
            {"name": "Depth", "type": "numeric", "unit": "mm", "description": "Drill depth (distance termination)"},
            {"name": "Drill Tip Angle", "type": "numeric", "unit": "deg", "description": "Standard 118° / 135°", "default": 118},
            {"name": "Counterbore Diameter", "type": "numeric", "unit": "mm", "description": "Counterbore / Spotface OD"},
            {"name": "Counterbore Depth", "type": "numeric", "unit": "mm"},
            {"name": "Countersink Angle", "type": "numeric", "unit": "deg", "default": 90},
            {"name": "Thread Type", "type": "dropdown", "options": ["none", "ansi_un", "ansi_metric", "iso_metric", "gb_metric", "bsp"], "default": "none"},
            {"name": "Thread Designation", "type": "string", "description": "Thread spec (e.g. M6x1.0, 1/4-20 UNC) — required when Thread Type ≠ none"}
          ]
        }
      }
    },
    "THREAD": {
      "description": "Cosmetic or modeled thread on cylindrical face. Supports ANSI Imperial UN/UNF/UNJ, ANSI Metric, ISO Metric Profile, BSP, and NPT pipe-thread standards. Optional full-length toggle (default true) or finite-length offset/length pair.",
      "category": "Part_Hole_Thread",
      "python_api": "ComponentDefinition.Features.ThreadFeatures.Add",
      "parameterCount": 8,
      "tabs": {
        "Geometry": {
          "parameters": [
            {"name": "Face", "type": "selection", "description": "Cylindrical face (hole or external)", "required": true},
            {"name": "Standard", "type": "dropdown", "options": ["ansi_un", "ansi_unf", "ansi_unj", "ansi_metric", "iso_metric_profile", "bsp_parallel", "bsp_tapered", "npt"], "default": "ansi_metric"},
            {"name": "Designation", "type": "string", "description": "Thread spec (e.g. M6x1.0, 1/4-20 UNC, 1/8 NPT)", "required": true},
            {"name": "Class", "type": "string", "description": "Fit class (e.g. 6g, 2A)", "default": "6g"},
            {"name": "Direction", "type": "dropdown", "options": ["right_hand", "left_hand"], "default": "right_hand"},
            {"name": "Full Length", "type": "checkbox", "default": true},
            {"name": "Offset", "type": "numeric", "unit": "mm", "description": "Distance from face start (when not full-length)"},
            {"name": "Length", "type": "numeric", "unit": "mm", "description": "Threaded length (when not full-length)"}
          ]
        }
      }
    },
    "FILLET": {
      "description": "Round edge transition between adjacent faces. Inventor supports Equal-Radius (constant), Variable-Radius (per-vertex), Setback (smooth blend at corner intersections), and Full-Round (3-face tangent). Rolling-ball model is default; smooth radius transitions handle continuity blending.",
      "category": "Part_Modify_Fillet",
      "python_api": "ComponentDefinition.Features.FilletFeatures.AddSimple / AddVariable / AddFullRound / AddSetback",
      "parameterCount": 8,
      "tabs": {
        "Geometry": {
          "parameters": [
            {"name": "Mode", "type": "dropdown", "options": ["equal_radius", "variable_radius", "setback", "full_round"], "default": "equal_radius"},
            {"name": "Edges", "type": "selection_list", "description": "Edges or chains to fillet", "required": true},
            {"name": "Radius", "type": "numeric", "unit": "mm", "description": "Equal-radius value (drives dimension)", "min": 0.001},
            {"name": "Variable Radius Points", "type": "object_list", "description": "List of {vertex, radius} for variable-radius mode"},
            {"name": "Setback Distance", "type": "numeric", "unit": "mm", "description": "Setback at vertex intersections"},
            {"name": "Side Faces", "type": "selection_list", "description": "Side faces for full_round (3-face mode)"},
            {"name": "Continuity", "type": "dropdown", "options": ["tangent_g1", "smooth_g2"], "default": "tangent_g1"},
            {"name": "Roll Along Sharp Edges", "type": "checkbox", "default": true}
          ]
        }
      }
    },
    "CHAMFER": {
      "description": "Beveled edge transition. Three modes: Equal-Distance (45° of equal setbacks), Two-Distance (independent setback per face), and Distance-Angle (one setback + bevel angle). Supports edge-chain selection.",
      "category": "Part_Modify_Chamfer",
      "python_api": "ComponentDefinition.Features.ChamferFeatures.AddUsingDistance / AddUsingTwoDistances / AddUsingDistanceAndAngle",
      "parameterCount": 7,
      "tabs": {
        "Geometry": {
          "parameters": [
            {"name": "Mode", "type": "dropdown", "options": ["equal_distance", "two_distance", "distance_angle"], "default": "equal_distance"},
            {"name": "Edges", "type": "selection_list", "required": true},
            {"name": "Distance 1", "type": "numeric", "unit": "mm", "required": true, "min": 0.001},
            {"name": "Distance 2", "type": "numeric", "unit": "mm", "description": "Required for two_distance"},
            {"name": "Angle", "type": "numeric", "unit": "deg", "description": "Required for distance_angle"},
            {"name": "Reference Face", "type": "selection", "description": "Determines orientation for two_distance / distance_angle"},
            {"name": "Setback Mode", "type": "dropdown", "options": ["no_setback", "smooth"], "default": "no_setback"}
          ]
        }
      }
    },
    "SHELL": {
      "description": "Hollow a solid by removing selected faces and applying wall thickness to the remaining faces. Supports Inside/Outside/Both directions and per-face thickness override for non-uniform walls.",
      "category": "Part_Modify_Shell",
      "python_api": "ComponentDefinition.Features.ShellFeatures.Add",
      "parameterCount": 6,
      "tabs": {
        "Geometry": {
          "parameters": [
            {"name": "Faces to Remove", "type": "selection_list", "description": "Open faces (becomes wall opening); leave empty for closed shell", "required": false},
