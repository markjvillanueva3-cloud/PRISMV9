{
  "schemaVersion": "1.0.0",
  "metadata": {
    "title": "Autodesk Inventor Sheet Metal Operations — Sheet Metal Environment (Inventor strength)",
    "description": "Parameter catalog for the Inventor Sheet Metal environment — Inventor's signature workspace with no Fusion 360 / hyperCAD-S equivalent of comparable depth. The sheet metal toolset is rule-driven: a 'Sheet Metal Rule' (Style) carries thickness, K-factor, default bend radius, gap, and unfold method (Linear / Bend Compensation / Bend Table / Custom Equation), and most features inherit from this rule rather than re-declaring it per-feature. Catalog covers ~20 operations across base creation (Face, Contour Flange, Contour Roll, Lofted Flange), edge features (Flange, Hem, Bend, Fold, Jog), corner treatments (Corner Seam, Corner Chamfer, Corner Round, Rip), special features (Cut, Punch from iFeature library, Emboss), unfold/refold workflow, and Flat Pattern emission for downstream CAM/nesting + the Sheet Metal Rule itself.",
    "version": "2025.0",
    "extractedDate": "2026-05-01",
    "milestone": "U-CAD-FIDX-INV-04",
    "source": "Autodesk Inventor 2025 Help — Sheet Metal Reference; Inventor API Reference — SheetMetalFeatures collection (FaceFeatures, ContourFlangeFeatures, ContourRollFeatures, LoftedFlangeFeatures, FlangeFeatures, HemFeatures, BendFeatures, FoldFeatures, CutFeatures, CornerSeamFeatures, CornerChamferFeatures, CornerRoundFeatures, PunchToolFeatures, RipFeatures, UnfoldFeatures, RefoldFeatures, FlatPattern, JogFeatures, EmbossFeatures); SheetMetalStyles + SheetMetalRule",
    "totalParameters": 151,
    "operationCount": 21,
    "cad_concepts_used": [
      "SHEET_METAL_RULE",
      "BEND_ALLOWANCE",
      "K_FACTOR",
      "BEND_DEDUCTION",
      "FLAT_PATTERN_EMISSION",
      "BEND_TABLE",
      "UNFOLD_METHOD",
      "GRAIN_DIRECTION",
      "RELIEF_GEOMETRY"
    ]
  },
