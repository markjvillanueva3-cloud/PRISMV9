    "tabs": ["Shape", "Bend", "Corner", "Unfold"]
  },
  "operations": {
    "FACE": {
      "description": "Base sheet metal face from a closed profile sketch. Sets the active sheet metal rule's thickness as the face thickness; offset direction (Inside / Outside / Both) determines which side of the sketch plane the material grows on.",
      "category": "SheetMetal_Base_Face",
      "python_api": "ComponentDefinition.Features.FaceFeatures.Add",
      "parameterCount": 6,
      "tabs": {
        "Shape": {
          "parameters": [
            {"name": "Profile", "type": "selection", "description": "Closed sketch profile", "required": true},
            {"name": "Offset Direction", "type": "dropdown", "options": ["inside", "outside", "both"], "default": "outside"},
            {"name": "Sheet Metal Rule Override", "type": "string", "description": "Rule name override (otherwise active rule)"},
            {"name": "Thickness Override", "type": "numeric", "unit": "mm", "description": "Per-feature thickness override (rare)"},
            {"name": "Edge Treatment", "type": "dropdown", "options": ["square_edge", "exterior_bend_extent", "interior_bend_extent"], "default": "square_edge"},
            {"name": "Consume Sketch", "type": "checkbox", "description": "Mark source sketch as consumed", "default": true}
          ]
        }
      }
    },
    "CONTOUR_FLANGE": {
