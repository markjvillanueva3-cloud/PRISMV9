{
  "schemaVersion": "1.0.0",
  "metadata": {
    "title": "SolidWorks CAD Surface Operations — Surface modeling layer",
    "description": "Parameter catalog for the SolidWorks CAD surface modeling layer. Surfaces are constructed via 7 sweep families (extrude / revolve / sweep / loft / boundary / ruled / radiated), filled patches (fill / planar / extracted), modified through trim / untrim / extend / offset / replace_face / move_face / delete_face / delete_hole, joined via knit (with optional close-to-solid), and converted to solid bodies via thicken or sewing-to-solid. Catalog covers 20 operations / 150 parameters. Bindings target the SolidWorks API IFeatureManager surface methods (FeatureExtruRefSurface3 / FeatureRevolveSurface2 / FeatureSurfaceLoft / FeatureBoundarySurface / InsertFilledSurfaceFeature2 / InsertOffsetSurface2 / InsertRuledSurface2 / RadiatedSurfaceFeature / InsertPlanarSurface / InsertSurfaceFromBody / InsertSewingFeature / InsertSurfaceTrim2 / FeatureUntrimSurface / InsertExtendSurfaceFeature / InsertReplaceFace2 / InsertMoveFace2 / InsertDeleteFace / DeleteHoleFeature / InsertThickenFeature) and IModelDoc2 surface body management.",
    "version": "2024.0",
    "extractedDate": "2026-05-02",
    "milestone": "U-CAD-FIDX-SW-03",
    "source": "SolidWorks 2024 API Help — Features (Surface); SolidWorks API Reference — IFeatureManager (Surface methods); SolidWorks 2024 Reference — Surfaces toolbar / Insert > Surface menu",
    "totalParameters": 150,
    "operationCount": 20,
    "cad_concepts_used": [
      "SURFACE_PARAMETRIC_SWEEP",
      "BOUNDARY_SURFACE_DIRECTION_PAIR",
      "SURFACE_CONTINUITY_C0_C1_C2_C3",
      "RULED_SURFACE_GENERATION",
      "FILLED_SURFACE_BOUNDARY_PATCH",
      "RADIATED_SURFACE_DRAFT",
      "SURFACE_OFFSET_NORMAL",
      "STITCH_TOLERANCE",
      "SURFACE_TRIM_BOUNDARY",
      "MANIFOLD_SURFACE_VALIDATION",
      "SURFACE_TO_SOLID_CLOSURE",
      "FACE_LEVEL_EDIT",
      "DIRECT_EDITING_DELETE_FACE_FILL"
    ]
  },
  "commonTabs": {
    "description": "Standard parameter tabs across SolidWorks surface operations",
    "tabs": ["Surface", "Continuity", "Options"]
  },
  "operations": {
    "SURFACE_EXTRUDE": {
      "description": "Extrude a profile sketch (or 3D curve) into a surface. Direction 1 / Direction 2 each support End Condition: blind / through_all / up_to_next / up_to_vertex / up_to_surface / offset_from_surface / up_to_body / mid_plane. Draft Angle adds taper. Cap Ends optionally closes the extrude into a closed surface set.",
      "category": "Surface_Sweep_Extrude",
      "solidworks_command": "Insert > Surface > Extrude",
      "solidworks_api": "IFeatureManager.FeatureExtruRefSurface3",
      "parameterCount": 9,
      "tabs": {
        "Surface": {
          "parameters": [
            {"name": "Profile", "type": "selection", "description": "Sketch or 3D curve to extrude", "required": true},
            {"name": "Sketch Plane", "type": "selection"},
            {"name": "Direction 1 End Condition", "type": "dropdown", "options": ["blind", "through_all", "up_to_next", "up_to_vertex", "up_to_surface", "offset_from_surface", "up_to_body", "mid_plane"], "default": "blind"},
            {"name": "Direction 1 Depth", "type": "numeric", "unit": "mm", "default": 10, "min": 0.001},
            {"name": "Direction 1 Draft Angle", "type": "numeric", "unit": "deg", "default": 0, "min": -89, "max": 89},
            {"name": "Direction 1 Draft Outward", "type": "checkbox", "default": false},
            {"name": "Direction 2 Enabled", "type": "checkbox", "default": false},
            {"name": "Direction 2 End Condition", "type": "dropdown", "options": ["blind", "through_all", "up_to_next", "up_to_vertex", "up_to_surface", "offset_from_surface", "up_to_body"], "default": "blind"},
            {"name": "Cap Ends", "type": "checkbox", "description": "Close to a closed surface set", "default": false}
          ]
        }
      }
    },
    "SURFACE_REVOLVE": {
      "description": "Revolve a profile sketch about an axis to create a surface of revolution. Revolve Type controls one_direction / mid_plane / two_direction. Closed Surface caps the open ends when angle < 360.",
      "category": "Surface_Sweep_Revolve",
      "solidworks_command": "Insert > Surface > Revolve",
      "solidworks_api": "IFeatureManager.FeatureRevolveSurface2",
      "parameterCount": 7,
      "tabs": {
        "Surface": {
          "parameters": [
            {"name": "Profile", "type": "selection", "required": true},
            {"name": "Axis", "type": "selection", "description": "Axis / linear edge / construction line", "required": true},
            {"name": "Revolve Type", "type": "dropdown", "options": ["one_direction", "mid_plane", "two_direction"], "default": "one_direction"},
            {"name": "Angle 1", "type": "numeric", "unit": "deg", "default": 360, "min": 0.001, "max": 360},
            {"name": "Angle 2", "type": "numeric", "unit": "deg", "default": 0, "min": 0, "max": 360},
            {"name": "Reverse Direction", "type": "checkbox", "default": false},
            {"name": "Closed Surface", "type": "checkbox", "description": "Cap ends if angle < 360", "default": false}
          ]
        }
      }
    },
    "SURFACE_SWEEP": {
      "description": "Sweep a profile along a path to create a surface. Profile Type selects sketch_profile / circular_profile / solid_profile. Twist Type controls follow_path / keep_normal_constant / direction_vector / twist_with_n_turns / twist_with_angle. Guide Curves shape the cross-section interpolation between endpoints.",
      "category": "Surface_Sweep_Sweep",
      "solidworks_command": "Insert > Surface > Sweep",
      "solidworks_api": "IFeatureManager.FeatureSurfaceSweep",
      "parameterCount": 10,
      "tabs": {
        "Surface": {
          "parameters": [
            {"name": "Profile", "type": "selection", "required": true},
            {"name": "Path", "type": "selection", "required": true},
            {"name": "Profile Type", "type": "dropdown", "options": ["sketch_profile", "circular_profile", "solid_profile"], "default": "sketch_profile"},
            {"name": "Profile Diameter", "type": "numeric", "unit": "mm", "description": "Required when Profile Type = circular_profile", "min": 0.001},
            {"name": "Twist Type", "type": "dropdown", "options": ["follow_path", "keep_normal_constant", "direction_vector", "twist_with_n_turns", "twist_with_angle"], "default": "follow_path"},
            {"name": "Twist Angle", "type": "numeric", "unit": "deg", "default": 0},
            {"name": "Guide Curves", "type": "selection"},
            {"name": "Path Alignment", "type": "dropdown", "options": ["none", "minimum_twist", "direction_vector", "all_faces"], "default": "minimum_twist"},
            {"name": "Merge Tangent Faces", "type": "checkbox", "default": false},
            {"name": "Show Preview", "type": "checkbox", "default": true}
          ]
        }
      }
    },
    "SURFACE_LOFT": {
      "description": "Loft a surface through 2+ profiles. Guide Curves shape interpolation between profiles. Centerline shapes the loft cross-section path. Start/End Constraints control tangency (none / normal_to_profile / direction_vector / tangent_to_face / curvature_to_face). Close Loft loops back to the first profile.",
      "category": "Surface_Sweep_Loft",
      "solidworks_command": "Insert > Surface > Loft",
      "solidworks_api": "IFeatureManager.FeatureSurfaceLoft",
      "parameterCount": 11,
      "tabs": {
        "Surface": {
          "parameters": [
            {"name": "Profiles", "type": "selection", "description": "Ordered profile sequence (2+ profiles)", "required": true},
            {"name": "Guide Curves", "type": "selection"},
            {"name": "Centerline", "type": "selection", "description": "Shape-driving spine"},
            {"name": "Start Constraint", "type": "dropdown", "options": ["none", "normal_to_profile", "direction_vector", "tangent_to_face", "curvature_to_face"], "default": "none"},
            {"name": "End Constraint", "type": "dropdown", "options": ["none", "normal_to_profile", "direction_vector", "tangent_to_face", "curvature_to_face"], "default": "none"},
            {"name": "Start Tangent Length", "type": "numeric", "default": 1, "min": 0.01, "max": 10},
            {"name": "End Tangent Length", "type": "numeric", "default": 1, "min": 0.01, "max": 10},
            {"name": "Close Loft", "type": "checkbox", "default": false},
            {"name": "Merge Tangent Faces", "type": "checkbox", "default": false},
            {"name": "Show Preview", "type": "checkbox", "default": true},
            {"name": "Refit", "type": "checkbox", "description": "Fit a single NURBS sheet across the loft", "default": false}
          ]
        }
      }
    },
    "SURFACE_BOUNDARY": {
