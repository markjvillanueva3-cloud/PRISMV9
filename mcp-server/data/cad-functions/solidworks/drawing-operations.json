            {"name": "Target Entities", "type": "string", "description": "Comma-separated list of target entities", "required": true},
            {"name": "Direction", "type": "dropdown", "options": ["horizontal", "vertical", "aligned"], "required": true, "default": "horizontal"},
            {"name": "Stack Distance", "type": "numeric", "unit": "mm", "description": "Spacing between successive dimensions", "default": 10, "min": 0.001},
            {"name": "Tolerance Type", "type": "dropdown", "options": ["none", "basic", "bilateral", "limit"], "default": "none"}
          ]
