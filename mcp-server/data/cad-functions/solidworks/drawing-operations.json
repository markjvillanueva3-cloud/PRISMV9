            {"name": "Projection Direction", "type": "dropdown", "options": ["left", "right", "top", "bottom"], "required": true, "default": "right"},
            {"name": "Inherit Display Style", "type": "checkbox", "default": true},
            {"name": "Inherit Scale", "type": "checkbox", "default": true},
            {"name": "Override Scale", "type": "string", "description": "Used when Inherit Scale = false"},
            {"name": "Position", "type": "selection"}
          ]
        }
      }
    },
    "VIEW_AUXILIARY": {
      "description": "Auxiliary view projected perpendicular to a selected inclined edge (true-shape view of inclined surface). Projection direction is normal to the selected reference edge.",
      "category": "Drawing_View",
      "solidworks_command": "Insert > Drawing View > Auxiliary",
      "solidworks_api": "IDrawingDoc.CreateAuxiliaryView2",
      "parameterCount": 6,
      "tabs": {
        "View": {
          "parameters": [
            {"name": "Reference Edge", "type": "selection", "description": "Inclined edge on parent view defining the projection plane", "required": true},
            {"name": "Parent View Name", "type": "string", "required": true},
            {"name": "Direction Label", "type": "string", "description": "Auxiliary view label (default: auto-incrementing letter)"},
            {"name": "Show Arrow", "type": "checkbox", "default": true},
            {"name": "Flip Direction", "type": "checkbox", "default": false},
            {"name": "Position", "type": "selection"}
          ]
        }
      }
    },
    "VIEW_SECTION": {
      "description": "Section view created by cutting along a section line. Section Type controls planar / aligned / offset / unfolded behavior. Cutting Line Style governs the cutting-line appearance (per ASME Y14.3 conventions).",
      "category": "Drawing_View",
      "solidworks_command": "Insert > Drawing View > Section",
      "solidworks_api": "IDrawingDoc.CreateSectionView5",
      "parameterCount": 9,
      "tabs": {
        "View": {
          "parameters": [
            {"name": "Parent View Name", "type": "string", "required": true},
            {"name": "Section Line Geometry", "type": "selection", "description": "Sketch line(s) defining the cutting plane", "required": true},
            {"name": "Section Type", "type": "dropdown", "options": ["planar", "aligned", "offset", "unfolded"], "required": true, "default": "planar"},
            {"name": "Section Label", "type": "string", "description": "Label letter (default: auto)"},
            {"name": "Reverse Direction", "type": "checkbox", "default": false},
            {"name": "Cutting Line Style", "type": "dropdown", "options": ["chain_thick", "chain_thin", "phantom"], "default": "chain_thick"},
            {"name": "Hatch Pattern", "type": "string", "description": "Section hatch pattern name (default: ANSI31)", "default": "ANSI31"},
            {"name": "Hatch Scale", "type": "numeric", "default": 1, "min": 0.01, "max": 100},
            {"name": "Position", "type": "selection"}
          ]
        }
      }
    },
    "VIEW_DETAIL": {
      "description": "Detail view (zoomed-in view of a region of an existing view). Boundary Type selects circular (default per ASME Y14.3) / closed_profile. Scale is independent of parent.",
      "category": "Drawing_View",
      "solidworks_command": "Insert > Drawing View > Detail",
      "solidworks_api": "IDrawingDoc.CreateDetailViewAt4",
      "parameterCount": 8,
      "tabs": {
        "View": {
          "parameters": [
            {"name": "Parent View Name", "type": "string", "required": true},
            {"name": "Boundary Type", "type": "dropdown", "options": ["circle", "closed_profile"], "required": true, "default": "circle"},
            {"name": "Center X", "type": "numeric", "unit": "mm", "description": "Detail circle / region center X", "required": true},
            {"name": "Center Y", "type": "numeric", "unit": "mm", "required": true},
            {"name": "Radius", "type": "numeric", "unit": "mm", "description": "Required when Boundary Type = circle", "default": 25, "min": 0.001},
            {"name": "Detail Label", "type": "string", "description": "Label letter (default: auto)"},
            {"name": "Scale", "type": "string", "default": "2:1"},
            {"name": "Position", "type": "selection"}
          ]
        }
      }
    },
    "VIEW_BROKEN": {
      "description": "Broken view (compress a long uniform-section view by inserting visual breaks). Used for shafts / extrusions where intermediate detail is unnecessary. Break Type selects gap geometry style.",
      "category": "Drawing_View",
      "solidworks_command": "Insert > Drawing View > Broken View",
      "solidworks_api": "IDrawingDoc.CreateBrokenView",
      "parameterCount": 7,
      "tabs": {
        "View": {
          "parameters": [
            {"name": "Source View Name", "type": "string", "required": true},
            {"name": "Break Direction", "type": "dropdown", "options": ["vertical", "horizontal"], "required": true, "default": "vertical"},
            {"name": "Break Type", "type": "dropdown", "options": ["zigzag", "straight", "small_zigzag", "curved", "structural"], "default": "zigzag"},
            {"name": "Break Position 1", "type": "numeric", "unit": "mm", "required": true},
            {"name": "Break Position 2", "type": "numeric", "unit": "mm", "required": true},
            {"name": "Gap Distance", "type": "numeric", "unit": "mm", "default": 10, "min": 0.001},
            {"name": "Show Break Lines", "type": "checkbox", "default": true}
