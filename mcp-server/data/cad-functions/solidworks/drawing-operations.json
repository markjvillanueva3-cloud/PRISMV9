    "WELD_SYMBOL": {
      "description": "AWS A2.4 weld symbol with arrow side / other side weld specifications. Weld Type selects from 12 standard weld categories. All-Around and Field Weld modifiers attach to the symbol root.",
      "category": "Drawing_Symbol",
      "solidworks_command": "Insert > Annotations > Weld Symbol",
      "solidworks_api": "IModelDocExtension.InsertWeldSymbol",
      "parameterCount": 9,
      "tabs": {
        "Symbol": {
          "parameters": [
            {"name": "Attached Entity", "type": "selection", "description": "Edge / vertex on a joint location", "required": true},
            {"name": "Weld Type", "type": "dropdown", "options": [
              "fillet", "groove_v", "groove_bevel", "groove_u", "groove_j",
              "plug_slot", "spot", "seam", "stud", "edge", "back", "surfacing"
            ], "required": true, "default": "fillet"},
            {"name": "Arrow Side Size", "type": "numeric", "unit": "mm", "default": 5, "min": 0.001},
            {"name": "Other Side Size", "type": "numeric", "unit": "mm", "description": "0 = no other-side weld", "default": 0, "min": 0},
