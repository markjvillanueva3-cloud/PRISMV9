    "VIEW_BREAK_OUT": {
      "description": "Break-out section (cut-away revealing internal geometry) on an existing view. Boundary is a closed sketch profile; Depth Mode selects how far into the model the cut goes.",
      "category": "Drawing_View",
      "solidworks_command": "Insert > Drawing View > Break Out Section",
      "solidworks_api": "IDrawingDoc.CreateBreakOutSection",
      "parameterCount": 7,
      "tabs": {
        "View": {
          "parameters": [
            {"name": "Parent View Name", "type": "string", "required": true},
            {"name": "Boundary Sketch", "type": "selection", "description": "Closed 2D sketch defining the cut region", "required": true},
            {"name": "Depth Mode", "type": "dropdown", "options": ["depth_value", "up_to_geometry"], "required": true, "default": "depth_value"},
            {"name": "Depth Value", "type": "numeric", "unit": "mm", "description": "Required when Depth Mode = depth_value", "default": 10, "min": 0.001},
            {"name": "Reference Geometry", "type": "selection", "description": "Required when Depth Mode = up_to_geometry"},
            {"name": "Hatch Pattern", "type": "string", "default": "ANSI31"},
            {"name": "Hatch Scale", "type": "numeric", "default": 1, "min": 0.01, "max": 100}
          ]
