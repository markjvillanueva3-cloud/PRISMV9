          "parameters": [
            {"name": "Parent View Name", "type": "string", "required": true},
            {"name": "Boundary Sketch", "type": "selection", "description": "Closed 2D sketch defining the visible region", "required": true},
            {"name": "Show Crop Boundary", "type": "checkbox", "default": false},
            {"name": "Auto-Center", "type": "checkbox", "description": "Re-center view in cropped boundary", "default": true}
          ]
        }
      }
    },
    "DIMENSION_SMART": {
      "description": "Smart dimension — auto-detects geometry type (linear / angular / radial / diametral / arc-length) from the selected entities and emits the appropriate dimension. Dimensioning Mode forces a specific dimension type when auto-detection is ambiguous.",
      "category": "Drawing_Dimension",
      "solidworks_command": "Tools > Dimensions > Smart",
      "solidworks_api": "IModelDoc2.AddDimension2",
      "parameterCount": 8,
      "tabs": {
        "Dimension": {
          "parameters": [
            {"name": "Entity 1", "type": "selection", "description": "First entity (vertex / edge / face / arc)", "required": true},
            {"name": "Entity 2", "type": "selection", "description": "Optional second entity for relative dimensions"},
            {"name": "Dimensioning Mode", "type": "dropdown", "options": ["smart", "horizontal", "vertical", "aligned", "angular", "radial", "diametral", "arc_length", "baseline", "ordinate"], "default": "smart"},
            {"name": "Position X", "type": "numeric", "unit": "mm", "description": "Dimension text drop point", "required": true},
            {"name": "Position Y", "type": "numeric", "unit": "mm", "required": true},
            {"name": "Tolerance Type", "type": "dropdown", "options": ["none", "basic", "bilateral", "limit", "symmetric", "min", "max", "fit"], "default": "none"},
            {"name": "Upper Tolerance", "type": "numeric", "unit": "mm", "description": "Used with bilateral / limit / symmetric"},
            {"name": "Lower Tolerance", "type": "numeric", "unit": "mm", "description": "Used with bilateral / limit"}
          ]
        }
      }
    },
    "DIMENSION_BASELINE": {
      "description": "Baseline dimension chain — multiple dimensions sharing a common reference point. Per ASME Y14.5 reduces accumulated tolerance compared to chain dimensioning.",
      "category": "Drawing_Dimension",
      "solidworks_command": "Tools > Dimensions > Baseline",
      "solidworks_api": "IDrawingDoc.AutoBaselineDimension",
      "parameterCount": 5,
      "tabs": {
