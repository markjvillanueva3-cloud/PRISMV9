      "category": "Drawing_Dimension",
      "solidworks_command": "Tools > Dimensions > Ordinate",
      "solidworks_api": "IDrawingDoc.InsertOrdinateDimension",
      "parameterCount": 6,
      "tabs": {
        "Dimension": {
          "parameters": [
            {"name": "Origin", "type": "selection", "description": "Datum-zero point (vertex / endpoint)", "required": true},
            {"name": "Target Entities", "type": "string", "required": true},
            {"name": "Direction", "type": "dropdown", "options": ["horizontal", "vertical"], "required": true, "default": "horizontal"},
            {"name": "Show Origin Marker", "type": "checkbox", "default": true},
            {"name": "Jog Lines", "type": "checkbox", "description": "Allow text jog to avoid overlap", "default": true},
            {"name": "Text Rotation", "type": "dropdown", "options": ["upright", "perpendicular_to_extension"], "default": "upright"}
          ]
        }
      }
    },
    "GDT_ADD": {
      "description": "Add a Geometric Dimensioning & Tolerancing feature control frame per ASME Y14.5-2018. Symbol selects from the 14 geometric characteristics. Material Condition modifier (MMC / LMC / RFS) applies to the tolerance value. Up to 3 datum references (primary / secondary / tertiary) per the Datum Reference Frame 3-2-1 alignment.",
      "category": "Drawing_GDT",
      "solidworks_command": "Insert > Annotations > Geometric Tolerance",
      "solidworks_api": "IModelDocExtension.InsertGtol / IGtol.SetGtolValues",
      "parameterCount": 11,
      "tabs": {
        "GD&T": {
          "parameters": [
            {"name": "Attached Entity", "type": "selection", "description": "Feature being toleranced (face / edge / dimension)", "required": true},
            {"name": "Symbol", "type": "dropdown", "options": [
              "straightness", "flatness", "circularity", "cylindricity",
              "profile_of_a_line", "profile_of_a_surface",
              "perpendicularity", "parallelism", "angularity",
              "position", "concentricity", "symmetry",
              "circular_runout", "total_runout"
            ], "required": true, "default": "position"},
            {"name": "Tolerance Value", "type": "numeric", "unit": "mm", "required": true, "default": 0.1, "min": 0},
            {"name": "Material Condition", "type": "dropdown", "options": ["RFS", "MMC", "LMC"], "default": "RFS"},
            {"name": "Tolerance Zone Modifier", "type": "dropdown", "options": ["none", "diameter", "spherical_diameter", "projected", "tangent_plane", "free_state", "statistical"], "default": "none"},
            {"name": "Primary Datum", "type": "string", "description": "Datum letter (A-Z, optional double-letter)"},
            {"name": "Primary Datum Modifier", "type": "dropdown", "options": ["RFS", "MMC", "LMC"], "default": "RFS"},
            {"name": "Secondary Datum", "type": "string"},
            {"name": "Secondary Datum Modifier", "type": "dropdown", "options": ["RFS", "MMC", "LMC"], "default": "RFS"},
            {"name": "Tertiary Datum", "type": "string"},
            {"name": "Tertiary Datum Modifier", "type": "dropdown", "options": ["RFS", "MMC", "LMC"], "default": "RFS"}
          ]
        }
      }
    },
