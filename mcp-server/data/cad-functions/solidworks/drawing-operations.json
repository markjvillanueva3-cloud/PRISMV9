    "VIEW_CROP": {
      "description": "Crop a view to a sketched closed boundary (analogous to a viewport mask). The cropped region remains visible; the rest is hidden. Inverse of break-out section: crop hides exterior, break-out hides interior.",
      "category": "Drawing_View",
      "solidworks_command": "Insert > Drawing View > Crop View",
      "solidworks_api": "IDrawingDoc.CreateCropView",
      "parameterCount": 4,
      "tabs": {
