{
  "schemaVersion": "1.0.0",
  "metadata": {
    "title": "SolidWorks CAD Drawing Operations — 2D drawing authoring layer",
    "description": "Parameter catalog for the SolidWorks CAD 2D drawing authoring layer. Covers the full IDrawingDoc / IDrawingView / IDimension / IAnnotation / IBomTable / IRevisionTable surface: sheet + title block management, 9 SolidWorks view types (model / projected / auxiliary / section / detail / broken / break_out / crop / relative-to-model), 6 dimension types (smart / horizontal / vertical / aligned / angular / radial), GD&T per ASME Y14.5 (14 geometric characteristic symbols), surface finish + weld symbols + center marks + centerlines, datum feature + datum target placement, BOM (bill of materials) + revision table + general/hole table authoring, design table integration, and sheet format authoring. Catalog covers 24 operations / 165 parameters. Bindings target SolidWorks API IModelDoc2.NewDocument / IDrawingDoc.Create3rdAngleViews2 / IDrawingDoc.CreateAuxiliaryView2 / IDrawingDoc.CreateSectionView5 / IDrawingDoc.CreateDetailViewAt4 / IDrawingDoc.CreateBrokenView / IDrawingDoc.CreateBreakOutSection / IDrawingDoc.SetupSheet5 / IModelDoc2.AddDimension2 / IAnnotation.SetGtolValues / IBomTable interface / IRevisionTable interface — the canonical SolidWorks 2024 drawing authoring API.",
    "version": "2024.0",
    "extractedDate": "2026-05-02",
    "milestone": "U-CAD-FIDX-SW-05",
    "source": "SolidWorks 2024 API Help — Drawings; SolidWorks API Reference — IDrawingDoc / IDrawingView / IDimension / IGtol / ISFSymbol / IWeldSymbol / IBomTable / IRevisionTable; ASME Y14.5-2018 Dimensioning and Tolerancing; ASME Y14.100; ASME Y14.36 Surface Texture Symbols; AWS A2.4 Welding Symbols",
    "totalParameters": 165,
    "operationCount": 24,
    "cad_concepts_used": [
      "ORTHOGRAPHIC_PROJECTION",
      "FIRST_ANGLE_VS_THIRD_ANGLE_PROJECTION",
      "AUXILIARY_VIEW_INCLINED_PLANE",
      "FULL_HALF_OFFSET_REVOLVED_BROKEN_OUT_SECTION",
      "DETAIL_CIRCLE_BOUNDARY_TYPE",
      "BROKEN_VIEW_GAP_DISCONTINUITY",
      "ASME_Y14_5_GDT_FEATURE_CONTROL_FRAME",
      "DATUM_REFERENCE_FRAME_3_2_1",
      "GDT_MATERIAL_CONDITION_MMC_LMC_RFS",
      "SURFACE_TEXTURE_RA_RZ_LAY",
      "WELD_SYMBOL_AWS_A24",
      "BOM_PARENT_CHILD_SUBASSEMBLY_INDENT",
      "REVISION_TABLE_HISTORICAL_AUDIT",
      "DESIGN_TABLE_PARAMETRIC_VARIANT",
      "TITLE_BLOCK_SHEET_FORMAT_TEMPLATE"
    ]
  },
  "commonTabs": {
    "description": "Standard parameter tabs across SolidWorks drawing operations",
    "tabs": ["Sheet", "View", "Dimension", "GD&T", "Symbol", "Table", "Format"]
  },
  "operations": {
    "DRAWING_NEW": {
      "description": "Create a new drawing document. Template selects from standard SolidWorks templates (A_Landscape / A_Portrait / B / C / D / E / Custom). Sheet Format applies a title-block format file (.slddrt). Projection sets first-angle (ISO/EU/JIS) vs third-angle (ANSI/US) view orientation.",
      "category": "Drawing_Document",
      "solidworks_command": "File > New > Drawing",
      "solidworks_api": "ISldWorks.NewDocument (DocumentType=swDocDRAWING)",
      "parameterCount": 7,
      "tabs": {
        "Sheet": {
          "parameters": [
            {"name": "Template Path", "type": "string", "description": "Path to .drwdot template (default: ANSI A landscape)"},
            {"name": "Paper Size", "type": "dropdown", "options": ["A_Landscape", "A_Portrait", "B", "C", "D", "E", "A4_Landscape", "A4_Portrait", "A3", "A2", "A1", "A0", "Custom"], "default": "A_Landscape"},
            {"name": "Sheet Format Path", "type": "string", "description": "Path to .slddrt sheet format (title block)"},
            {"name": "Projection", "type": "dropdown", "options": ["first_angle", "third_angle"], "required": true, "default": "third_angle"},
            {"name": "Custom Width", "type": "numeric", "unit": "mm", "description": "Required when Paper Size = Custom", "min": 50, "max": 2000},
            {"name": "Custom Height", "type": "numeric", "unit": "mm", "description": "Required when Paper Size = Custom", "min": 50, "max": 2000},
            {"name": "Scale", "type": "string", "description": "Sheet scale ratio (e.g. '1:2', '2:1')", "default": "1:1"}
          ]
        }
      }
    },
    "SHEET_ADD": {
      "description": "Add an additional sheet to an existing drawing. Inherits or overrides the sheet format / paper size / scale of the active sheet.",
      "category": "Drawing_Document",
      "solidworks_command": "Insert > Sheet",
      "solidworks_api": "IDrawingDoc.NewSheet4",
      "parameterCount": 6,
      "tabs": {
        "Sheet": {
          "parameters": [
            {"name": "Sheet Name", "type": "string", "required": true},
            {"name": "Paper Size", "type": "dropdown", "options": ["A_Landscape", "A_Portrait", "B", "C", "D", "E", "A4_Landscape", "A4_Portrait", "A3", "A2", "A1", "A0", "use_active"], "default": "use_active"},
            {"name": "Scale", "type": "string", "default": "1:1"},
            {"name": "Sheet Format Path", "type": "string"},
            {"name": "Position Index", "type": "numeric", "description": "Insert at this position (-1 = append)", "default": -1, "min": -1, "max": 999},
            {"name": "Use Custom Property Values From Reference", "type": "checkbox", "default": false}
          ]
        }
      }
    },
    "SHEET_FORMAT_EDIT": {
      "description": "Edit sheet format (title block underlay). Title block fields are populated from the model's custom properties via $PRP and $PRPSHEET tags.",
      "category": "Drawing_Document",
      "solidworks_command": "Edit Sheet Format",
      "solidworks_api": "IDrawingDoc.EditTemplate",
      "parameterCount": 5,
      "tabs": {
        "Format": {
          "parameters": [
            {"name": "Sheet Name", "type": "string", "required": true},
            {"name": "Format Path", "type": "string", "description": "New .slddrt path"},
            {"name": "Update Anchored Notes", "type": "checkbox", "description": "Re-evaluate $PRP / $PRPSHEET tags", "default": true},
            {"name": "Reload From Template", "type": "checkbox", "default": false},
            {"name": "Auto-Resize", "type": "checkbox", "description": "Stretch format to current paper size", "default": false}
          ]
        }
      }
    },
    "VIEW_MODEL": {
      "description": "Insert a model view (the first/anchor view that brings a part / assembly into the drawing). Sets Display Style (wireframe / hidden_lines_visible / hidden_lines_removed / shaded_with_edges / shaded). Tangent Edges control sets visibility of fillet boundaries (visible / phantom / hide).",
      "category": "Drawing_View",
      "solidworks_command": "Insert > Drawing View > Model",
      "solidworks_api": "IDrawingDoc.CreateModelView",
      "parameterCount": 9,
      "tabs": {
        "View": {
          "parameters": [
            {"name": "Model Path", "type": "string", "description": "Path to .sldprt or .sldasm to anchor", "required": true},
            {"name": "Configuration", "type": "string", "description": "Configuration to project (default: active)"},
            {"name": "Display State", "type": "string"},
            {"name": "Orientation", "type": "dropdown", "options": ["front", "back", "top", "bottom", "left", "right", "isometric", "trimetric", "dimetric", "current_model_view", "named_view"], "default": "front"},
            {"name": "Display Style", "type": "dropdown", "options": ["wireframe", "hidden_lines_visible", "hidden_lines_removed", "shaded_with_edges", "shaded"], "default": "hidden_lines_removed"},
            {"name": "Scale Mode", "type": "dropdown", "options": ["use_sheet_scale", "use_custom_scale"], "default": "use_sheet_scale"},
            {"name": "Custom Scale", "type": "string", "description": "Required when Scale Mode = use_custom_scale (e.g. '1:2')", "default": "1:1"},
            {"name": "Tangent Edges", "type": "dropdown", "options": ["visible", "phantom", "hide"], "default": "visible"},
            {"name": "Position", "type": "selection", "description": "Drop point on sheet (X, Y)"}
          ]
        }
      }
    },
    "VIEW_PROJECTED": {
      "description": "Project a new view from an existing parent view (orthogonal projection — left / right / top / bottom). Inherits parent's display style and scale by default.",
      "category": "Drawing_View",
