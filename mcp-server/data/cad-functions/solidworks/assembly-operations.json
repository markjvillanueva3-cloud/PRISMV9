{
  "schemaVersion": "1.0.0",
  "metadata": {
    "title": "SolidWorks CAD Assembly Operations — Assembly authoring layer",
    "description": "Parameter catalog for the SolidWorks CAD assembly authoring layer. Covers the full IAssemblyDoc / IFeatureManager / IComponent2 surface: mate authoring (26 mate types: 10 standard + 8 advanced + 8 mechanical), mate lifecycle (delete / edit / flip-alignment / suppress), component management (insert / delete / replace / fix-float / suppress-resolve-lightweight / smart-fasteners), component patterns (linear / circular / pattern-driven / mirror), sub-assembly authoring (insert sub / insert in-context / dissolve / flexible toggle), configurations (add / switch), exploded view + step (create view / add step / smart explode lines), and interference / clearance verification. Catalog covers 26 operations / 180 parameters. Bindings target SolidWorks API IAssemblyDoc.AddMate3 / AddComponent5 / FeatureLinearComponentPattern / FeatureCircularComponentPattern / FeatureMirrorComponent / EditAssembly / EditPart / FeatureManager.InsertExplodedView2 / InterferenceDetectionMgr.GetInterferences / ClearanceVerification.* — the canonical SolidWorks 2024 assembly authoring API.",
    "version": "2024.0",
    "extractedDate": "2026-05-02",
    "milestone": "U-CAD-FIDX-SW-04",
    "source": "SolidWorks 2024 API Help — Assemblies; SolidWorks API Reference — IAssemblyDoc / IComponent2 / IMate2 / IFeatureManager.InsertExplodedView2; SolidWorks 2024 Reference Manual — Assemblies / Mates / Patterns / Configurations / Exploded Views / Interference Detection",
    "totalParameters": 172,
    "operationCount": 26,
    "cad_concepts_used": [
      "MATE_DRIVEN_ASSEMBLY",
      "STANDARD_MATE_KINEMATIC_PAIR",
      "ADVANCED_MATE_LIMIT_AND_PATH",
      "MECHANICAL_MATE_GEAR_CAM_SCREW",
      "COMPONENT_PATTERN_PROPAGATION",
      "MIRROR_COMPONENT_LEFT_RIGHT_PARITY",
      "SUB_ASSEMBLY_RIGID_VS_FLEXIBLE",
      "IN_CONTEXT_TOP_DOWN_REFERENCE",
      "LIGHTWEIGHT_VS_RESOLVED_LOAD",
      "SUPPRESSION_STATE_PROPAGATION",
      "CONFIGURATION_DRIVEN_VARIANTS",
      "EXPLODED_VIEW_TIMELINE_STEPS",
      "SMART_FASTENER_HOLE_BASED_INFERENCE",
      "INTERFERENCE_VOLUME_DETECTION",
      "CLEARANCE_DISTANCE_VERIFICATION",
      "MATE_OVER_DEFINED_REDUNDANCY"
    ]
  },
  "commonTabs": {
    "description": "Standard parameter tabs across SolidWorks assembly operations",
    "tabs": ["Selections", "Mate", "Standard Mates", "Advanced Mates", "Mechanical Mates", "Pattern", "Configuration", "Options"]
