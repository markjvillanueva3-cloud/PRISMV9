  "operations": {
    "MATE_ADD": {
      "description": "Add a mate between two component faces / edges / planes / axes / points. Mate Type selects from 26 SolidWorks mate types across 3 categories — Standard (10), Advanced (8), Mechanical (8). Each category exposes its specific options through dedicated tabs (Standard Mates / Advanced Mates / Mechanical Mates). Distance / Angle drive dimensional mates; Flip Alignment swaps the mate's directional sense; Lock Rotation suppresses any residual DOF; Use For Positioning Only sets the mate as a position-only constraint that does not solve at assembly resolution time.",
      "category": "Assembly_Mate_Add",
      "solidworks_command": "Insert > Mate",
      "solidworks_api": "IAssemblyDoc.AddMate3",
      "parameterCount": 25,
      "tabs": {
        "Selections": {
          "parameters": [
            {"name": "Entity 1", "type": "selection", "description": "Face / edge / plane / axis / point on first component", "required": true},
            {"name": "Entity 2", "type": "selection", "description": "Face / edge / plane / axis / point on second component", "required": true},
            {"name": "Mate Type", "type": "dropdown", "options": [
              "coincident", "concentric", "parallel", "perpendicular", "tangent",
              "distance", "angle", "lock", "lock_distance", "profile_center",
              "symmetric", "width", "path", "linear_coupler", "distance_limit",
              "angle_limit", "hinge", "slot",
              "cam", "gear", "screw", "universal_joint", "rack_pinion",
              "belt_chain", "hinge_advanced", "slot_advanced"
            ], "required": true, "default": "coincident"},
            {"name": "Flip Alignment", "type": "checkbox", "default": false},
            {"name": "Lock Rotation", "type": "checkbox", "default": false},
            {"name": "Use For Positioning Only", "type": "checkbox", "default": false}
          ]
        },
        "Standard Mates": {
          "parameters": [
            {"name": "Distance", "type": "numeric", "unit": "mm", "description": "Required when Mate Type = distance / lock_distance", "default": 0, "min": 0},
            {"name": "Angle", "type": "numeric", "unit": "deg", "description": "Required when Mate Type = angle", "default": 0, "min": -360, "max": 360},
            {"name": "Profile Center Mode", "type": "dropdown", "options": ["centered", "offset"], "description": "profile_center alignment", "default": "centered"}
          ]
        },
        "Advanced Mates": {
          "parameters": [
            {"name": "Symmetric About", "type": "selection", "description": "Plane / axis used for symmetric mate"},
            {"name": "Width Constraint", "type": "dropdown", "options": ["centered", "free", "dimension", "percent"], "description": "width mate constraint mode", "default": "centered"},
            {"name": "Path Constraint", "type": "dropdown", "options": ["free", "distance_along_path", "percent_along_path"], "description": "path mate constraint mode", "default": "free"},
            {"name": "Linear Coupler Ratio", "type": "numeric", "description": "Numerator/denominator ratio for linear_coupler", "default": 1, "min": 0.001},
            {"name": "Distance Limit Min", "type": "numeric", "unit": "mm", "description": "Lower limit for distance_limit mate", "default": 0},
            {"name": "Distance Limit Max", "type": "numeric", "unit": "mm", "description": "Upper limit for distance_limit mate", "default": 100},
            {"name": "Angle Limit Min", "type": "numeric", "unit": "deg", "default": -360, "min": -360, "max": 360},
            {"name": "Angle Limit Max", "type": "numeric", "unit": "deg", "default": 360, "min": -360, "max": 360}
          ]
        },
        "Mechanical Mates": {
          "parameters": [
            {"name": "Cam Path", "type": "selection", "description": "Required when Mate Type = cam"},
            {"name": "Gear Ratio Numerator", "type": "numeric", "description": "Tooth-count or radius numerator", "default": 1, "min": 0.001},
            {"name": "Gear Ratio Denominator", "type": "numeric", "description": "Tooth-count or radius denominator", "default": 1, "min": 0.001},
            {"name": "Reverse Gear Direction", "type": "checkbox", "default": false},
            {"name": "Screw Pitch", "type": "numeric", "unit": "mm", "description": "Lead per revolution for screw mate", "default": 1, "min": 0.001},
            {"name": "Universal Joint Yoke Direction", "type": "selection", "description": "Reference direction for universal_joint mate"},
            {"name": "Belt Chain Length", "type": "numeric", "unit": "mm", "description": "Driven by component spacing if 0 (auto)", "default": 0, "min": 0},
            {"name": "Belt Chain Driver Direction", "type": "dropdown", "options": ["clockwise", "counter_clockwise"], "default": "clockwise"}
          ]
        }
      }
    },
