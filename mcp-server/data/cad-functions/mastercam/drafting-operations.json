{
  "schemaVersion": "1.0.0",
  "metadata": {
    "title": "Mastercam CAD Drafting Operations — 2D drawing output",
    "description": "Parameter catalog for the Mastercam CAD drafting layer. The drafting workspace produces 2D engineering drawings from 3D solid / surface bodies via 7 view types (Base / Projected / Section in 6 methods / Detail / Auxiliary / Break + sheet-internal Crop), dimensioning (8 subtypes + 7 ASME tolerance forms + inspection frame), GD&T (14 ASME Y14.5 geometric characteristics + datum reference), annotations (Leader, Note, Hatch, Surface Finish per ASME Y14.36 / ISO 1302, 2D Centerline), tables (Parts List BOM), and Title Block configuration. Bindings target Mastercam .NET-Hook API (Mastercam.Drawings namespace) and C-Hook ChooseAndPick.",
    "version": "2024.0",
    "extractedDate": "2026-05-02",
    "milestone": "U-CAD-FIDX-MC-04",
    "source": "Mastercam 2024 Reference — Drafting ribbon; Mastercam .NET-Hook API Reference (Mastercam.Drawings); ASME Y14.5-2018 (GD&T); ASME Y14.36-2018 (Surface Texture); ISO 1302:2002",
    "totalParameters": 124,
    "operationCount": 16,
    "cad_concepts_used": [
      "ORTHOGRAPHIC_PROJECTION",
      "SECTION_HATCHING",
      "DIMENSION_TOLERANCE",
      "GEOMETRIC_TOLERANCE",
      "DATUM_REFERENCE_FRAME",
      "SURFACE_FINISH_SYMBOL",
      "TITLE_BLOCK_FIELDS",
      "HOLE_CALLOUT",
      "PARTS_LIST_BOM",
      "REVISION_LETTER_SEQUENCE"
    ]
  },
  "commonTabs": {
    "description": "Standard parameter tabs across Mastercam drafting operations",
    "tabs": ["Shape", "View", "Annotation", "Tolerance", "Output"]
  },
  "operations": {
    "SHEET": {
      "description": "Create or configure a drawing sheet. Format selects ANSI A..E or ISO A0..A4 with optional custom override. Title block template binds the sheet to a downstream title-block configuration.",
      "category": "Drafting_Sheet",
      "mastercam_command": "DraftingSheet",
      "mastercam_api": "Mastercam.Drawings.DrawingSheet.Create",
      "parameterCount": 9,
      "tabs": {
        "Shape": {
          "parameters": [
            {"name": "Format", "type": "dropdown", "options": ["ANSI_A", "ANSI_B", "ANSI_C", "ANSI_D", "ANSI_E", "ISO_A0", "ISO_A1", "ISO_A2", "ISO_A3", "ISO_A4", "custom"], "default": "ANSI_B"},
            {"name": "Size Override", "type": "string", "description": "Custom WxH (e.g., '300x200mm') used with format=custom"},
            {"name": "Scale", "type": "numeric", "default": 1, "min": 0.0001},
            {"name": "Title", "type": "string"},
            {"name": "Sheet Number", "type": "string", "default": "1"},
            {"name": "Total Sheets", "type": "integer", "default": 1, "min": 1},
            {"name": "Orientation", "type": "dropdown", "options": ["landscape", "portrait"], "default": "landscape"},
            {"name": "Border Style", "type": "dropdown", "options": ["standard", "minimal", "none"], "default": "standard"},
            {"name": "Title Block Template", "type": "string", "description": "Template name (e.g., 'ANSI_Standard')"}
          ]
        }
      }
    },
    "VIEW_BASE": {
      "description": "Project a base orthographic view from a 3D source model onto the active sheet.",
      "category": "Drafting_View_Base",
      "mastercam_command": "DraftingViewBase",
      "mastercam_api": "Mastercam.Drawings.View.AddBase",
      "parameterCount": 9,
      "tabs": {
        "View": {
          "parameters": [
            {"name": "Source Model", "type": "selection", "required": true},
            {"name": "Orientation", "type": "dropdown", "options": ["front", "top", "right", "back", "bottom", "left", "iso_top_left", "iso_top_right", "iso_bottom_left", "iso_bottom_right", "named_view"], "default": "front"},
            {"name": "Scale", "type": "numeric", "description": "Override sheet scale"},
            {"name": "Display Style", "type": "dropdown", "options": ["shaded", "shaded_with_visible_edges", "visible_lines", "visible_and_hidden_lines", "wireframe"], "default": "visible_lines"},
            {"name": "Edge Visibility", "type": "dropdown", "options": ["all", "visible_only", "hidden_dashed"], "default": "visible_only"},
            {"name": "Hidden Lines", "type": "checkbox", "default": false},
            {"name": "Tangent Edges", "type": "dropdown", "options": ["on", "off", "with_foreshortening"], "default": "off"},
            {"name": "Position", "type": "selection", "description": "View origin on sheet"},
            {"name": "Boundary Box", "type": "checkbox", "default": false}
          ]
        }
      }
    },
    "VIEW_PROJECTED": {
      "description": "Project a derived view from an existing view (orthographic or isometric).",
      "category": "Drafting_View_Projected",
      "mastercam_command": "DraftingViewProjected",
      "mastercam_api": "Mastercam.Drawings.View.AddProjected",
      "parameterCount": 6,
      "tabs": {
