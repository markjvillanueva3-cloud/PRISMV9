            {"name": "Tolerance Value", "type": "numeric", "unit": "mm", "required": true, "min": 0},
            {"name": "Tolerance Modifier", "type": "dropdown", "options": ["none", "MMC_circle_M", "LMC_circle_L", "RFS_circle_S", "tangent_plane", "free_state"], "default": "none"},
            {"name": "Diameter Indicator", "type": "checkbox", "default": false},
            {"name": "Datum A", "type": "string"},
            {"name": "Datum A Modifier", "type": "dropdown", "options": ["none", "MMC", "LMC", "RFS"], "default": "none"},
            {"name": "Datum B", "type": "string"},
            {"name": "Datum C", "type": "string"},
            {"name": "Composite Frame", "type": "checkbox", "default": false},
            {"name": "All-Around Symbol", "type": "checkbox", "default": false},
            {"name": "Reference Geometry", "type": "selection", "required": true}
