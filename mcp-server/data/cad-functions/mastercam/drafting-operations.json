    "VIEW_SECTION": {
      "description": "Cut-plane section view from a parent view. Section method controls full / half / aligned / offset / broken-out / revolved behavior. Hatch pattern auto-selects per material with manual override.",
      "category": "Drafting_View_Section",
      "mastercam_command": "DraftingViewSection",
      "mastercam_api": "Mastercam.Drawings.View.AddSection",
      "parameterCount": 10,
      "tabs": {
        "View": {
          "parameters": [
            {"name": "Source View", "type": "selection", "required": true},
