{
  "schemaVersion": "1.0.0",
  "metadata": {
    "title": "Mastercam CAD Solid Operations — Solid modeling layer",
    "description": "Parameter catalog for the Mastercam CAD solid modeling layer. Solids are built from wireframe profiles via sweep features (extrude / revolve / sweep / loft) with corresponding cut variants, then modified with fillet / chamfer / shell / draft, combined via boolean operations, populated with hole features, and patterned linearly or circularly. Catalog covers 18 operations / 140 parameters spanning create-by-sweep (4), cut-by-sweep (4), boolean (1), modify (4: fillet/chamfer/shell/draft), surface→solid conversion (1: thicken), primitive bodies (1: box/cylinder/cone/sphere/torus), hole features (1 with 5 hole types), and patterns (2: linear + circular). Bindings target Mastercam .NET-Hook API (Mastercam.Solids namespace) and the C-Hook ChooseAndPick surface.",
    "version": "2024.0",
    "extractedDate": "2026-05-02",
    "milestone": "U-CAD-FIDX-MC-02",
    "source": "Mastercam 2024 Reference — Solids ribbon; Mastercam .NET-Hook API Reference (Mastercam.Solids / Mastercam.Operations.Solid)",
    "totalParameters": 140,
    "operationCount": 18,
    "cad_concepts_used": [
      "PARAMETRIC_SWEEP",
      "PROFILE_CONSUMPTION",
      "BOOLEAN_OPERATION",
      "FILLET_CONTINUITY",
      "DRAFT_ANGLE",
      "SHELL_THICKNESS",
      "HOLE_TYPE_VARIANT",
      "PATTERN_DISTRIBUTION",
      "TAPER_ANGLE",
      "CONSTRUCTION_PLANE"
    ]
  },
  "commonTabs": {
    "description": "Standard parameter tabs across Mastercam solid operations",
    "tabs": ["Shape", "Operation"]
  },
  "operations": {
    "EXTRUDE_SOLID": {
      "description": "Extrude a closed wireframe profile to create a solid body. Operation mode controls create-new / add-to-existing / cut-existing. Draft angle applies side-wall draft (positive = outward). Symmetric or both-directions extrudes from the profile plane in two directions.",
      "category": "Solid_Sweep_Extrude",
      "mastercam_command": "SolidExtrude",
      "mastercam_api": "Mastercam.Solids.SolidExtruder.Extrude",
      "parameterCount": 9,
      "tabs": {
        "Shape": {
          "parameters": [
            {"name": "Profile", "type": "selection", "description": "Closed wireframe chain or face", "required": true},
            {"name": "Direction", "type": "selection", "description": "Optional override (default: profile normal)"},
            {"name": "Distance", "type": "numeric", "unit": "mm", "required": true, "min": 0.001},
            {"name": "Operation", "type": "dropdown", "options": ["create_new", "add_to_existing", "cut_existing"], "default": "create_new"},
            {"name": "Draft Angle", "type": "numeric", "unit": "deg", "default": 0, "min": -89, "max": 89},
            {"name": "Symmetric", "type": "checkbox", "default": false},
            {"name": "Both Directions", "type": "checkbox", "description": "Extrude in both directions (independent distances)", "default": false},
            {"name": "Use Construction Plane", "type": "checkbox", "default": true},
            {"name": "Auto-Update", "type": "checkbox", "description": "Re-extrude on profile edit", "default": true}
          ]
        }
      }
    },
    "REVOLVE_SOLID": {
