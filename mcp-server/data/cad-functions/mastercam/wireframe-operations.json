{
  "schemaVersion": "1.0.0",
  "metadata": {
    "title": "Mastercam CAD Wireframe Operations — Wireframe authoring layer",
    "description": "Parameter catalog for the Mastercam CAD wireframe layer. Mastercam's CAD authoring is wireframe-first (lines / arcs / circles / splines / points) with optional solid + surface workflows layered on top. Wireframe is the foundation that drives Mastercam's CAM toolpath chain pickers — every toolpath chains across wireframe entities, so wireframe authoring is critical for CAM downstream. Catalog covers 24 operations spanning point creation (8 modes), 5 line variants, 5 circle variants, 3 arc variants, ellipse, polygon, rectangle, shape (oval/slot/hexagon/diamond), 2 spline variants (parametric + NURBS), curve derivation from solids, wireframe text on path, helix, and spiral. Bindings target Mastercam .NET-Hook API (Mastercam.Curves namespace) and the C-Hook ChooseAndPick surface for ops not yet exposed in .NET.",
    "version": "2024.0",
    "extractedDate": "2026-05-02",
    "milestone": "U-CAD-FIDX-MC-01",
    "source": "Mastercam 2024 Reference — Wireframe ribbon; Mastercam .NET-Hook API Reference (Mastercam.Curves / Mastercam.Geometry); Mastercam C-Hook ChooseAndPick API",
    "totalParameters": 153,
    "operationCount": 24,
    "cad_concepts_used": [
      "WIREFRAME_GEOMETRY",
      "PARAMETRIC_POINT",
      "TANGENT_CONSTRUCTION",
      "PERPENDICULAR_CONSTRUCTION",
      "PARALLEL_CONSTRUCTION",
      "NURBS_SPLINE",
      "PARAMETRIC_SPLINE",
      "HELIX_GENERATION",
      "SPIRAL_GENERATION",
      "CURVE_DERIVATION"
    ]
  },
  "commonTabs": {
    "description": "Standard parameter tabs across Mastercam wireframe operations",
    "tabs": ["Shape", "Geometry", "Style"]
  },
