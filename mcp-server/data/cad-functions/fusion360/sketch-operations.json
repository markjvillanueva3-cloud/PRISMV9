            {"name": "Side Count", "type": "integer", "min": 3, "max": 64, "default": 6},
            {"name": "Center", "type": "point2d", "description": "Required for inscribed/circumscribed", "required": false},
            {"name": "Reference Radius", "type": "numeric", "unit": "mm", "min": 0.001, "description": "Inscribed/circumscribed reference"},
            {"name": "Edge Start", "type": "point2d", "description": "Required for edge_defined variant"},
            {"name": "Edge End", "type": "point2d", "description": "Required for edge_defined variant"}
          ]
        }
      }
