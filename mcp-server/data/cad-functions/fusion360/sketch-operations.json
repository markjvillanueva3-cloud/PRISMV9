  "operations": {
    "LINE": {
      "description": "Two-point straight line. Continuous chain mode supports multiple connected segments. Snap-to-existing-geometry triggers automatic Coincident constraints.",
      "category": "Sketch_Primitive",
      "fusion_command": "SketchLines",
      "python_api": "sketch.sketchCurves.sketchLines.addByTwoPoints",
      "parameterCount": 6,
      "tabs": {
        "Plane": {
          "parameters": [
            {"name": "Sketch Plane", "type": "selection", "description": "XY/XZ/YZ origin plane, planar face, or construction plane", "required": true},
            {"name": "Origin Reference", "type": "selection", "description": "Optional sketch origin override", "required": false}
          ]
        },
        "Geometry": {
          "parameters": [
            {"name": "Start Point", "type": "point2d", "description": "First endpoint in sketch coordinates", "required": true},
            {"name": "End Point", "type": "point2d", "description": "Second endpoint in sketch coordinates", "required": true},
            {"name": "Continuous Chain", "type": "checkbox", "description": "Keep line tool active to chain segments", "default": true}
          ]
        },
        "Properties": {
          "parameters": [
            {"name": "Construction Geometry", "type": "checkbox", "description": "Mark as construction (excluded from feature consumption)", "default": false}
          ]
        }
      }
    },
    "RECTANGLE": {
      "description": "Four-sided closed rectangle aligned to sketch axes (or rotated for three-point variant). Auto-generates Horizontal/Vertical/Perpendicular constraints.",
      "category": "Sketch_Primitive",
      "fusion_command": "SketchRectangles",
      "python_api": "sketch.sketchCurves.sketchLines.addTwoPointRectangle | addThreePointRectangle | addCenterPointRectangle",
      "parameterCount": 8,
      "tabs": {
        "Plane": {
          "parameters": [
            {"name": "Sketch Plane", "type": "selection", "required": true}
          ]
        },
        "Geometry": {
          "parameters": [
            {"name": "Variant", "type": "dropdown", "description": "Rectangle construction method", "options": ["two_point", "three_point", "center_point"], "default": "two_point"},
            {"name": "Corner 1 / Center", "type": "point2d", "description": "First corner (two_point) or center (center_point)", "required": true},
            {"name": "Corner 2 / Width Reference", "type": "point2d", "description": "Opposite corner or width-direction reference", "required": true},
            {"name": "Third Point", "type": "point2d", "description": "Required for three_point variant", "required": false},
            {"name": "Width", "type": "numeric", "description": "Rectangle width — overrides geometry if dimensional", "unit": "mm", "min": 0.001},
            {"name": "Height", "type": "numeric", "description": "Rectangle height — overrides geometry if dimensional", "unit": "mm", "min": 0.001}
          ]
        },
        "Properties": {
          "parameters": [
            {"name": "Construction Geometry", "type": "checkbox", "default": false}
          ]
        }
      }
    },
    "CIRCLE": {
      "description": "Closed circular curve. Five construction variants cover most workflows: center+diameter, center+radius, three points on circumference, two-tangent (with radius), three-tangent (radius derived).",
      "category": "Sketch_Primitive",
      "fusion_command": "SketchCircles",
      "python_api": "sketch.sketchCurves.sketchCircles.addByCenterRadius | addByThreePoints | addByTwoTangents | addByThreeTangents",
      "parameterCount": 9,
      "tabs": {
        "Plane": {
          "parameters": [{"name": "Sketch Plane", "type": "selection", "required": true}]
        },
        "Geometry": {
          "parameters": [
            {"name": "Variant", "type": "dropdown", "options": ["center_diameter", "center_radius", "three_point", "two_tangent", "three_tangent"], "default": "center_diameter"},
            {"name": "Center", "type": "point2d", "description": "Required for center_diameter and center_radius variants"},
            {"name": "Radius", "type": "numeric", "unit": "mm", "min": 0.001, "description": "Used by center_radius and tangent variants"},
            {"name": "Diameter", "type": "numeric", "unit": "mm", "min": 0.002, "description": "Used by center_diameter variant — overrides radius"},
            {"name": "Point 1 / Tangent Curve 1", "type": "selection", "description": "First circumference point or first tangent reference", "required": false},
            {"name": "Point 2 / Tangent Curve 2", "type": "selection", "required": false},
            {"name": "Point 3 / Tangent Curve 3", "type": "selection", "required": false}
          ]
        },
        "Properties": {
          "parameters": [{"name": "Construction Geometry", "type": "checkbox", "default": false}]
        }
      }
    },
    "ARC": {
      "description": "Open circular arc segment. Center-point variant defines via center + start + sweep; three-point via 3 circumference points; tangent variant matches tangency to existing curve.",
      "category": "Sketch_Primitive",
      "fusion_command": "SketchArcs",
      "python_api": "sketch.sketchCurves.sketchArcs.addByCenterStartSweep | addByThreePoints | addFillet",
      "parameterCount": 8,
      "tabs": {
        "Plane": {"parameters": [{"name": "Sketch Plane", "type": "selection", "required": true}]},
        "Geometry": {
          "parameters": [
            {"name": "Variant", "type": "dropdown", "options": ["center_point", "three_point", "tangent"], "default": "center_point"},
            {"name": "Center", "type": "point2d", "description": "Required for center_point variant"},
            {"name": "Start Point", "type": "point2d", "required": true},
            {"name": "End Point", "type": "point2d", "description": "Required for three_point and tangent variants"},
            {"name": "Mid Point", "type": "point2d", "description": "Required for three_point variant"},
            {"name": "Sweep Angle", "type": "numeric", "unit": "deg", "min": -360, "max": 360, "description": "Arc sweep — used by center_point variant"},
            {"name": "Tangent Reference", "type": "selection", "description": "Existing curve for tangent variant"}
          ]
        }
      }
    },
    "POLYGON": {
      "description": "Regular n-gon. Inscribed (vertices on radius circle), circumscribed (edge midpoints on radius circle), edge-defined (specify one edge).",
      "category": "Sketch_Primitive",
