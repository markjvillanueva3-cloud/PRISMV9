    "SLOT": {
      "description": "Closed obround / arc-ended slot. Four construction variants: center-to-center (two arcs at endpoints), three-point (start, end, width), center-point, overall-length-and-width.",
      "category": "Sketch_Primitive",
      "fusion_command": "SketchSlots",
      "python_api": "sketch.sketchCurves.sketchLines.addCenterToCenterSlot | addThreePointSlot | addCenterPointSlot | addOverallSlot",
      "parameterCount": 9,
      "tabs": {
