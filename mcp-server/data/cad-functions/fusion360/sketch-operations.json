            {"name": "Points", "type": "point2d_array", "description": "Sequence of fit or control points", "required": true},
            {"name": "Closed Curve", "type": "checkbox", "default": false},
            {"name": "Degree", "type": "integer", "description": "Curve degree (control_point only)", "min": 1, "max": 7, "default": 3},
