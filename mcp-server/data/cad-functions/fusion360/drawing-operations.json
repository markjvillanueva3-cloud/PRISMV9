{
  "schemaVersion": "1.0.0",
  "metadata": {
    "title": "Fusion 360 CAD Drawing Operations — Drawing workspace",
    "description": "Parameter catalog for the Fusion 360 Drawing workspace, the 2D-output workspace that consumes Design / Sheet Metal / Assembly bodies and emits drawings (PDF / DWG / DXF / PNG / SVG). Catalog covers 18 operations across sheet creation (size + scale + title block), 7 view types (Base / Projected / Section / Detail / Auxiliary / Break / Crop-via-BASE), dimensioning (8 dimension subtypes + tolerancing), GD&T (14 geometric characteristics + datum features per ASME Y14.5), annotation (centerline / centermark / text), tables (parts list / hole table / revision), title block fields, and multi-format export. Bindings target the Fusion 360 Python API surface for drawings (rootComp.drawings.add) and the UI command system for ops not yet exposed in Python.",
    "version": "2026.04",
    "extractedDate": "2026-05-01",
    "milestone": "U-CAD-FIDX-FUS-08",
    "source": "Autodesk Fusion 360 Help — Drawing workspace; Fusion 360 Python API Reference — Drawings module; ASME Y14.5-2018 (Geometric Dimensioning and Tolerancing); ASME Y14.35-2014 (Revisions of Engineering Drawings)",
    "totalParameters": 155,
    "operationCount": 18,
    "cad_concepts_used": [
      "ORTHOGRAPHIC_PROJECTION",
      "SECTION_HATCHING",
      "GEOMETRIC_TOLERANCE",
      "DATUM_REFERENCE_FRAME",
      "DIMENSION_TOLERANCE",
      "TITLE_BLOCK_FIELDS",
      "REVISION_LETTER_SEQUENCE",
      "HOLE_CALLOUT",
      "PARTS_LIST_BOM",
      "EXPORT_FORMAT_DPI"
    ]
  },
  "commonTabs": {
    "description": "Standard parameter tabs across Fusion 360 drawing features",
    "tabs": ["Shape", "View", "Annotation", "Tolerance", "Output"]
  },
  "operations": {
    "SHEET": {
      "description": "Create or configure a drawing sheet. Sheet defines paper size (ANSI A..E or ISO A0..A4), scale, title block selection, and multi-sheet drawing membership. Sheets host all subsequent views and annotations.",
      "category": "Drawing_Sheet",
      "fusion_command": "DrawingSheetCommand",
      "python_api": "drawingDoc.sheets.add",
      "parameterCount": 11,
      "tabs": {
        "Shape": {
          "parameters": [
            {"name": "Format", "type": "dropdown", "options": ["ANSI_A", "ANSI_B", "ANSI_C", "ANSI_D", "ANSI_E", "ISO_A0", "ISO_A1", "ISO_A2", "ISO_A3", "ISO_A4", "custom"], "default": "ANSI_B"},
            {"name": "Custom Width", "type": "numeric", "unit": "mm", "description": "Used with format=custom"},
            {"name": "Custom Height", "type": "numeric", "unit": "mm", "description": "Used with format=custom"},
            {"name": "Scale", "type": "numeric", "description": "Sheet scale (e.g., 1.0 = 1:1, 0.5 = 1:2)", "default": 1, "min": 0.0001},
            {"name": "Title", "type": "string", "description": "Sheet title (defaults to source model name)"},
            {"name": "Sheet Number", "type": "string", "default": "1"},
            {"name": "Total Sheets", "type": "integer", "default": 1, "min": 1},
            {"name": "Default Units", "type": "dropdown", "options": ["mm", "inch", "cm"], "default": "mm"},
            {"name": "Orientation", "type": "dropdown", "options": ["landscape", "portrait"], "default": "landscape"},
            {"name": "Border Style", "type": "dropdown", "options": ["standard", "minimal", "none"], "default": "standard"},
            {"name": "Title Block Template", "type": "string", "description": "Title block template name or path"}
          ]
        }
      }
    },
    "BASE_VIEW": {
      "description": "Project a base orthographic view from the 3D source model onto the active sheet. Origin is the foundation view from which projected/section/detail/auxiliary views can be derived.",
      "category": "Drawing_View_Base",
      "fusion_command": "BaseViewCommand",
      "python_api": "sheet.views.addBaseView",
      "parameterCount": 11,
      "tabs": {
        "View": {
          "parameters": [
            {"name": "Source Model", "type": "selection", "description": "Component / occurrence to project", "required": true},
            {"name": "Orientation", "type": "dropdown", "options": ["front", "top", "right", "back", "bottom", "left", "iso_top_left", "iso_top_right", "iso_bottom_left", "iso_bottom_right", "named_view"], "default": "front"},
            {"name": "Named View Override", "type": "string", "description": "Used when orientation=named_view"},
            {"name": "Scale", "type": "numeric", "description": "View scale (overrides sheet scale)"},
            {"name": "Origin Point", "type": "selection", "description": "View origin on sheet"},
            {"name": "Display Style", "type": "dropdown", "options": ["shaded", "shaded_with_visible_edges", "visible_lines", "visible_and_hidden_lines", "wireframe"], "default": "visible_lines"},
            {"name": "Tangent Edges", "type": "dropdown", "options": ["on", "off", "with_foreshortening"], "default": "off"},
            {"name": "Hidden Lines", "type": "checkbox", "default": false},
            {"name": "Boundary Box", "type": "checkbox", "description": "Show view boundary rectangle", "default": false},
            {"name": "Annotations Inherited", "type": "checkbox", "description": "Pull model annotations into view", "default": true},
            {"name": "Component Filter", "type": "string", "description": "Comma-separated component visibility list"}
          ]
        }
      }
    },
    "PROJECTED_VIEW": {
      "description": "Project a derived view from an existing view (orthographic or isometric). Direction is implied by the projection vector from source view's center.",
