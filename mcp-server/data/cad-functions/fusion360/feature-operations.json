    "EXTRUDE": {
      "description": "Linear sweep of a planar profile along a direction. Supports symmetric/two-side, taper, multiple distance modes (distance/to_object/all/between/symmetric), and Boolean operation against existing bodies (new/join/cut/intersect).",
      "category": "Solid_Sweep",
      "fusion_command": "Extrude",
      "python_api": "rootComp.features.extrudeFeatures.addSimple | createInput",
      "parameterCount": 17,
      "tabs": {
        "Profile": {
          "parameters": [
            {"name": "Profile", "type": "selection", "description": "Closed sketch profile, planar face, or surface region", "required": true},
            {"name": "Multiple Profiles", "type": "boolean", "description": "Allow multiple profile selection for separate features", "default": false}
          ]
        },
        "Direction": {
          "parameters": [
            {"name": "Direction", "type": "dropdown", "description": "Sweep direction relative to profile plane", "options": ["one_side", "two_sides", "symmetric"], "default": "one_side"},
            {"name": "Extent Type", "type": "dropdown", "description": "How depth is determined", "options": ["distance", "to_object", "all", "between", "symmetric"], "default": "distance"},
            {"name": "Distance", "type": "numeric", "unit": "mm", "description": "Linear sweep distance (one_side / symmetric half)", "min": 0.001},
            {"name": "Distance Side 2", "type": "numeric", "unit": "mm", "description": "Optional second-side distance for two_sides mode"},
            {"name": "To Object", "type": "selection", "description": "Face/plane/body terminator for to_object/between modes"},
            {"name": "Taper Angle", "type": "numeric", "unit": "deg", "description": "Side wall draft angle (positive = outward)", "min": -89, "max": 89, "default": 0},
            {"name": "Direction Vector Override", "type": "selection", "description": "Optional non-normal direction (edge/axis)"}
          ]
        },
        "Operation": {
          "parameters": [
            {"name": "Operation", "type": "dropdown", "description": "Boolean against existing bodies", "options": ["new_body", "new_component", "join", "cut", "intersect"], "default": "new_body"},
            {"name": "Target Bodies", "type": "selection", "description": "Bodies to combine with (join/cut/intersect)"},
            {"name": "Start Extent Type", "type": "dropdown", "description": "Where the extrude begins", "options": ["profile_plane", "offset", "from_object"], "default": "profile_plane"},
            {"name": "Start Offset", "type": "numeric", "unit": "mm", "description": "Distance from profile plane when start = offset", "default": 0},
            {"name": "Start Object", "type": "selection", "description": "Reference for from_object start"}
          ]
        },
        "Properties": {
          "parameters": [
            {"name": "Construction Geometry", "type": "checkbox", "description": "Mark resulting body as construction", "default": false},
            {"name": "Suppressed", "type": "checkbox", "description": "Skip during regeneration", "default": false},
            {"name": "Light Bulb On", "type": "checkbox", "description": "Body visibility", "default": true}
          ]
        }
      }
    },
