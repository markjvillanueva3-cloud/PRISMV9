  "operations": {
    "PATCH": {
      "description": "Single-region surface patch fitted to a closed boundary loop. Optionally constrained by interior points and tangent references.",
      "category": "Surface_Create",
      "fusion_command": "n/a (hyperCAD-S macro: SURFACE.CREATE.PATCH)",
      "python_api": "Surface.createPatch",
      "parameterCount": 7,
      "tabs": {
        "Profile": {
          "parameters": [
            {"name": "Boundary Loop", "type": "selection_list", "description": "Closed chain of edges / curves bounding the patch", "required": true},
            {"name": "Interior Points", "type": "selection_list", "description": "Optional 3D points the patch must pass through"},
            {"name": "Tangent References", "type": "selection_list", "description": "Adjacent faces whose tangency the patch should respect"}
          ]
        },
        "Continuity": {
          "parameters": [
            {"name": "Continuity Order", "type": "dropdown", "options": ["g0_position", "g1_tangent", "g2_curvature"], "default": "g1_tangent", "required": true},
            {"name": "Tangent Magnitude", "type": "numeric", "description": "Tangent weight at boundary edges", "default": 1, "min": 0.001}
          ]
        },
        "Geometry": {
          "parameters": [
            {"name": "U Degree", "type": "numeric", "description": "Surface u-direction polynomial degree", "default": 3, "min": 1, "max": 9},
            {"name": "V Degree", "type": "numeric", "description": "Surface v-direction polynomial degree", "default": 3, "min": 1, "max": 9}
          ]
        }
      }
    },
