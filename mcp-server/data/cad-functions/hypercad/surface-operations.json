{
  "schemaVersion": "1.0.0",
  "metadata": {
    "title": "hyperCAD-S Surface Operations - Complete Enumeration",
    "description": "Exhaustive parameter catalog for hyperCAD-S Surface Modeler. Surfaces are hyperCAD's strength: Coons / network / refit are first-class for smoothing imported geometry, and stitching is automatic when continuity matches. Catalog covers: 12 surface-creation ops (Patch / Boundary / Coons / Network / Sweep / Loft / Revolve / Extrude / Plane / Ruled / Tabulated / Helical), 13 modify ops (Trim / Extend / Untrim / Offset / Stitch / Unstitch / Reverse / Match / Blend / Fillet / Chamfer / Replace / Refit), and 3 conversion ops (Surface-to-Solid / Solid-to-Surface / Mesh-to-Surface). Conversion ops feed downstream hyperMILL toolpath generation that requires either watertight solids or trimmed surface sets.",
    "version": "2026.04",
    "extractedDate": "2026-04-29",
    "milestone": "U-CAD-FIDX-HCAD-03",
    "source": "OPEN MIND hyperCAD-S User Manual + Macro Reference, hyperMILL Surface Machining Reference",
    "totalParameters": 148,
    "operationCount": 28,
    "cad_concepts_used": [
      "PARAMETRIC_SURFACE",
      "G0_G1_G2_CONTINUITY",
      "COONS_PATCH",
      "NETWORK_SURFACE",
      "TRIM_BOUNDARY",
      "SURFACE_OFFSET",
      "STITCH_TOLERANCE",
      "UV_PARAMETERIZATION",
      "RULED_SURFACE",
      "REFIT_DEGREE_REDUCTION"
    ]
  },
  "commonTabs": {
    "description": "Standard parameter tabs across hyperCAD-S surface operations",
