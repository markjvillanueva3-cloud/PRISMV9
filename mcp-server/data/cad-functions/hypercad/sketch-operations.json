      "fusion_command": "n/a (hyperCAD-S uses macro: SKETCH.LINE.CREATE)",
      "python_api": "Sketcher.createLine | Sketcher.createLineByMode",
      "parameterCount": 10,
      "tabs": {
        "Plane": {
          "parameters": [
            {"name": "Sketch Plane", "type": "selection", "description": "XY/XZ/YZ origin plane, planar face, or reference plane", "required": true}
          ]
        },
        "Geometry": {
          "parameters": [
            {"name": "Mode", "type": "dropdown", "description": "Line construction method", "options": ["two_point", "ortho", "parallel", "perpendicular", "tangent", "polar", "offset", "free"], "default": "two_point", "required": true},
            {"name": "Start Point", "type": "point2d", "description": "First endpoint (all modes except offset)", "required": true},
            {"name": "End Point", "type": "point2d", "description": "Second endpoint (two_point / free / polar terminator)"},
            {"name": "Reference Entity", "type": "selection", "description": "Existing line / circle / arc for parallel / perpendicular / tangent / offset modes"},
            {"name": "Length", "type": "numeric", "unit": "mm", "description": "Line length (polar / ortho / parallel / perpendicular modes)"},
            {"name": "Angle", "type": "numeric", "unit": "deg", "description": "Polar angle from horizontal (polar mode) or from reference (parallel-rotated)"},
            {"name": "Offset Distance", "type": "numeric", "unit": "mm", "description": "Distance from reference (offset mode, signed)"},
            {"name": "Continuous Chain", "type": "checkbox", "description": "Keep tool active to chain multiple lines", "default": true}
