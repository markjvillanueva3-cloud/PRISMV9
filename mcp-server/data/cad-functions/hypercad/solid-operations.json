{
  "schemaVersion": "1.0.0",
  "metadata": {
    "title": "hyperCAD-S Solid Operations - Complete Enumeration",
    "description": "Exhaustive parameter catalog for hyperCAD-S 3D Solid Modeler. hyperCAD-S blends parametric (history-based) modeling with direct-edit (history-free) workflows because hyperMILL operators frequently work with imported solids that lack history. Catalog covers: 6 primitive solids (Box / Cylinder / Cone / Sphere / Torus / Block), 6 sweep features (Extrude / Revolve / Sweep / Loft / Pipe-Along-Curve / Helix), 5 modify ops (Fillet / Chamfer / Shell / Draft / Thicken), 3 Boolean ops (Union / Subtract / Intersect), 4 pattern ops (Linear / Circular / Mirror / Path), 3 direct-edit ops (Move-Face / Push-Pull / Replace-Face), and 3 hole cycles (Simple / Counterbore / Tapped). Hole cycles align with hyperMILL hole-feature recognition for downstream toolpath generation.",
    "version": "2026.04",
    "extractedDate": "2026-04-29",
    "milestone": "U-CAD-FIDX-HCAD-02",
    "source": "OPEN MIND hyperCAD-S User Manual + Macro Reference, hyperMILL Hole Feature Reference",
    "totalParameters": 214,
    "operationCount": 30,
    "cad_concepts_used": [
      "PARAMETRIC_FEATURE",
      "DIRECT_EDIT",
      "BOOLEAN_OPERATION",
      "FACE_DRAFT_ANGLE",
      "VARIABLE_FILLET",
      "SHELL_THICKNESS",
      "SWEEP_GUIDE_RAIL",
      "LOFT_TANGENCY",
      "HELIX_PITCH",
      "HOLE_FEATURE_TAXONOMY"
    ]
  },
