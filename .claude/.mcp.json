{
  "mcpServers": {
    "prism-mcp-server": {
      "command": "C:\\Program Files\\nodejs\\node.exe",
      "args": [
        "H:/PRISM/mcp-server/dist/index.js"
      ],
      "env": {
        "TRANSPORT": "stdio",
        "LOG_LEVEL": "info",
        "NODE_OPTIONS": "--max-old-space-size=24576"
      }
    },
    "claude-flow": {
      "command": "npx",
      "args": [
        "-y",
        "@anthropic/claude-flow"
      ],
      "env": {
        "LOG_LEVEL": "info"
      }
    }
  }
}
