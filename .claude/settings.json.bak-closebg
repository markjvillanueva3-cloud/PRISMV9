{
  "cleanupPeriodDays": 60,
  "includeCoAuthoredBy": false,
  "spinnerTipsEnabled": false,
  "env": {
    "PATH": "H:/Tools/nodejs/node_modules/.bin;H:/.claude/bin;C:/Program Files/Docker/Docker/resources/bin;C:/Windows/System32;C:/Windows;C:/Windows/System32/Wbem;C:/Windows/System32/WindowsPowerShell/v1.0;C:/Windows/System32/OpenSSH",
    "OLLAMA_MODELS": "H:/Tools/ollama/models",
    "NIM_URL": "http://127.0.0.1:8000/v1",
    "NIM_EMBED_URL": "http://127.0.0.1:8010/v1",
    "VLLM_URL": "http://127.0.0.1:8020/v1",
    "LOCAL_LLM_BACKEND": "auto",
    "NIM_FALLBACK_TO_OLLAMA": "1",
    "CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING": "1",
    "CLAUDE_CODE_DISABLE_1M_CONTEXT": "0",
    "CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS": "1",
    "CLAUDE_CODE_MAX_TOOL_USE_CONCURRENCY": "20",
    "CLAUDE_CODE_RESUME_INTERRUPTED_TURN": "1",
    "CLAUDE_CODE_SUBPROCESS_ENV_SCRUB": "0",
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "1",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "85000",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "90",
    "ENABLE_PROMPT_CACHING_1H": "1",
    "DISABLE_AUTOUPDATER": "1",
    "LINEAR_PROJECT": "PRISM",
    "PRISM_CHAT_BUS_COMPACT": "1",
    "BASH_DEFAULT_TIMEOUT_MS": "300000",
    "BASH_MAX_TIMEOUT_MS": "1800000",
    "MCP_TOOL_TIMEOUT": "600000",
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "PRISM_WORKTREE_ROUTE_ENABLE": "1",
    "PRISM_GIT_ADD_LANE_ENABLE": "1",
    "PRISM_MAINTREE_WRITE_BLOCK_ENABLE": "1",
    "PRISM_GOAL_GATE_AUDIT_BYPASS": "1",
    "PRISM_ALLOW_UNWIRED": "1",
    "PRISM_LS_CAT_ENFORCE_ENABLE": "1",
    "PRISM_RTK_ENFORCE_ENABLE": "1",
    "PRISM_MASTER_INDEX_INJECT": "0",
    "PRISM_MEMORY_INDEX_INJECT": "0",
    "PRISM_WIKI_PRECHECK_INJECT": "0",
    "PRISM_OBSIDIAN_VAULT_PRECHECK_DISABLE": "1",
    "PRISM_GOLF_WRITE_ALLOWLIST_BYPASS": "1",
    "PRISM_BRIEF_INJECT_MODE": "headline",
    "PRISM_SKILL_AUTO_TRIGGER_DISABLE": "0",
    "PRISM_PSN_CHECKLIST_INJECT_DISABLE": "1",
    "PRISM_AI_MEMO_INJECT": "0",
    "PRISM_GOAL_SYNERGY_INJECT": "0",
    "PRISM_KNOWLEDGE_LINK_AUDIT_INJECT": "0",
    "PRISM_NN_GRAPH_INJECT": "0",
    "PRISM_SUBSTRATE_HEALTH_INJECT": "0"
  },
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "enabledMcpjsonServers": [
    "prism",
    "claude-flow"
  ],
  "skillOverrides": {
    "ollama-explain": "user-invocable-only",
    "ollama-summarize": "user-invocable-only",
    "ollama-docstring": "user-invocable-only",
    "ollama-classify": "user-invocable-only",
    "ollama-diff-summary": "user-invocable-only",
    "ollama-error-triage": "user-invocable-only",
    "ollama-extract": "user-invocable-only",
    "ollama-test-stub": "user-invocable-only",
    "ollama-boilerplate": "user-invocable-only"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/stress-harness-emit.mjs\"",
            "timeout": 2000
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/session-id-pin.mjs",
            "timeout": 1500
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/session-start-terminal-pin.mjs",
            "timeout": 5000
          },
          {
            "_comment": "SLOT-RECOVERY-MS0/U-SR02 (slot:golf 2026-05-25): write a session-start event to state/shared/slot-sessions/<slot>.jsonl. Crash-inferred invariant synthesizes a close for the prior session if its tail isn't session-end. Must run AFTER session-start-terminal-pin so the slot binding is in chat-slots.json. Knob: PRISM_SLOT_SESSION_SIDECAR_DISABLE=1.",
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/slot-session-sidecar-sessionstart.mjs",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/settings-mirror-guard.mjs",
            "timeout": 2000
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/portable-node-guard.mjs",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/scripts/verify-hook-refs.mjs",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/portable-python-guard.mjs",
            "timeout": 5000
          },
          {
            "_comment": "HIGH-ROI-TS2 iter4 (2026-05-22): surface TOKEN-SAVINGS-PIVOT sidecar headline at session start — fires/take-rate/top-tool/top-classifier. One line of additionalContext, fail-silent on missing sidecar. Disable: PRISM_ROUTE_SAVINGS_INJECT_DISABLE=1.",
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/route-savings-session-start-inject.mjs",
            "timeout": 2000
          },
          {
            "_comment": "PSN-SAVINGS-AGGREGATE/U-PSA02 (2026-05-24): closes producer→consumer loop on the unified savings aggregator. Reads dashboards/psn-savings-aggregate.json + emits 1-line headline. Disable: PRISM_SAVINGS_HEADLINE_DISABLE=1.",
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/session-start-savings-headline.mjs",
            "timeout": 2000
          },
          {
            "_comment": "PSN-OLLAMA-CHAT-DOWN-SUPPRESS/U-POCS02 (2026-05-24): probe Ollama /api/chat once per session, write state sidecar. Downstream ollama-routing hooks read this to short-circuit. Disable: PRISM_OLLAMA_CHAT_PROBE_DISABLE=1.",
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/session-start-ollama-chat-probe.mjs",
            "timeout": 10000
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/multi-computer-awareness.mjs",
            "timeout": 3000
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/ollama-autostart.mjs",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/nim-autostart.mjs",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/docker-intel-autostart.mjs",
            "timeout": 8000
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/.claude/hooks/plugin-path-fixer.mjs",
            "timeout": 3000
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/git-health-guard.mjs",
            "timeout": 8000
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/git-sync-fetch.mjs",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/dotclaude-junctions-guard.mjs",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/roadmap-resume.mjs",
            "timeout": 3000
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/session-start-goal-inject.mjs",
            "timeout": 3000
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/inventory-check-guard.mjs",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/expert-role-inject.mjs",
            "timeout": 2000
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/ai-command-awareness.mjs",
            "timeout": 3000
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/ai-deep-intelligence.mjs",
            "timeout": 3000
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/claude-brief-inject.mjs",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/build-state-inject.mjs",
            "timeout": 8000
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/awareness-snapshot-inject.mjs",
            "timeout": 4000
          },
          {
            "_comment": "alpha-token-domain-awareness-inject (slot:alpha TOKEN-AWARENESS-SYNERGY-MS0, 2026-05-29): SessionStart inject of the custom token-optimization domain PSN-synergy headline (state/shared/TOKEN-OPTIMIZATION-AWARENESS.md from scripts/token-awareness-snapshot.mjs). Alpha-gated (silent for every other slot). Distinct from token-awareness-inject.mjs (live zone state). Wired in CANONICAL C: settings (mirror C:->H:) to survive the C:->H: clobber-drift. Disable: PRISM_TOKEN_AWARENESS_INJECT_DISABLE=1.",
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/.claude/hooks/alpha-token-domain-awareness-inject.mjs",
            "timeout": 4000
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/knowledge-link-audit-inject.mjs",
            "timeout": 3000
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/wiki-tribal-coverage-inject.mjs",
            "timeout": 3000
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/wiki-tribal-coverage-per-domain-inject.mjs",
            "timeout": 3000
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/prism-ai-memo-coverage-inject.mjs",
            "timeout": 3000
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/goal-synergy-status-inject.mjs",
            "timeout": 3000
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/nn-graph-health-inject.mjs",
            "timeout": 3000
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/substrate-health-inject.mjs",
            "timeout": 10000
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/blueprint-join-index-stale-check.mjs",
            "timeout": 2000
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/gsd-inject.mjs",
            "timeout": 2000
          },
          {
            "type": "command",
            "command": "HOOK_EVENT=SessionStart \"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/linear-roadmap-sync.mjs",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "HOOK_EVENT=SessionStart \"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/supabase-state-sync.mjs",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/tier1-context-pack.mjs",
            "timeout": 3000
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/output-cache-inject.mjs",
            "timeout": 2000
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/settings-baseline-snapshot.mjs",
            "timeout": 2000
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/cognitive-budget-allocator.mjs",
            "timeout": 3000
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/curiosity-explorer.mjs",
            "timeout": 3000
          },
          {
            "type": "command",
            "command": "node H:/prism/.claude/hooks/chat-state-isolator.mjs",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "node \"H:/prism/.claude/hooks/session-handoff-load.mjs\"",
            "timeout": 8000
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/session-start-zombie-reap.mjs",
            "timeout": 8000
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/agent-worktree-stale-unlock.mjs",
            "timeout": 3000
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/coordination-startup-banner.mjs",
            "timeout": 2000
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/golf-slot-reaper-guardian.mjs",
            "timeout": 10000
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/sessionstart-graph-staleness-inject.mjs",
            "timeout": 3000
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/slot-worktree-cwd-advisory.mjs",
            "timeout": 4000
          },
          {
            "_comment": "TOKEN-SAVINGS-PIVOT/U-CAG-CACHE-CONTROL (sierra 2026-05-27): SessionStart anchor of the CAG cold-tier doctrine catalog so the Anthropic prompt-cache can KV-anchor it across the session (akshay_pachaar cold/hot-split pattern). Sibling of cag-soul-cache-block.mjs (which anchors per-slot soul). Pure-read, fail-OPEN. Disable: PRISM_CAG_COLD_ANCHOR_DISABLE=1.",
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/cag-cold-cache-anchor.mjs",
            "timeout": 3000
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/session-start-auto-resume.mjs",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/session-start-auto-resume.mjs",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
