{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "true",
    "MAX_MCP_OUTPUT_TOKENS": "50000",
    "CLAUDE_CODE_SESSIONEND_HOOKS_TIMEOUT_MS": "30000"
  },
  "permissions": {
    "allow": [
      "*"
    ],
    "deny": []
  },
  "enabledMcpjsonServers": [
    "claude-flow"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node \"H:/prism/.claude/hooks/lib/search-router-hook.mjs\"",
            "timeout": 1500,
            "statusMessage": "Checking keyword routes...",
            "continueOnError": true
          },
          {
            "type": "command",
            "command": "node \"H:/prism/.claude/hooks/lib/navigate-first-hook.mjs\"",
            "timeout": 1000,
            "statusMessage": "Checking indexes...",
            "continueOnError": true
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node \"H:/prism/.claude/hooks/lib/large-read-guard-hook.mjs\"",
            "timeout": 1000,
            "statusMessage": "Checking file size...",
            "continueOnError": true
          },
          {
            "type": "command",
            "command": "node \"H:/prism/.claude/hooks/lib/engine-digest-hook.mjs\"",
            "timeout": 1000,
            "statusMessage": "Looking up engine digest...",
            "continueOnError": true
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"H:/prism/.claude/hooks/lib/bash-redirect-hook.mjs\"",
            "timeout": 1000,
            "statusMessage": "Checking tool redirect...",
            "continueOnError": true
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node \"H:/prism/.claude/hooks/lib/agent-spawn-guard-hook.mjs\"",
            "timeout": 1000,
            "statusMessage": "Checking agent frequency...",
            "continueOnError": true
          }
        ]
      },
      {
        "matcher": "Grep|Glob|Read|Search",
        "hooks": [
          {
            "type": "command",
            "command": "python \"H:/prism/.claude/hooks/lib/enforce-post-compact-continue.py\"",
            "timeout": 3000,
            "statusMessage": "Checking auto-continue status...",
            "continueOnError": true
          },
          {
            "type": "command",
            "command": "echo 'Reminder: prefer codebase-memory-mcp search_graph/trace_call_path/get_code_snippet over Grep/Glob/Read/Search for code discovery.' >&2",
            "continueOnError": true
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"H:/prism/.claude/hooks/lib/copilot-dedup-hook.mjs\"",
            "timeout": 3000,
            "statusMessage": "Checking for engine duplication...",
            "continueOnError": true
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"H:/prism/.claude/hooks/lib/enforce-knowledge-consult.py\"",
            "timeout": 5000,
            "statusMessage": "Checking knowledge consultation...",
            "continueOnError": true
          },
          {
            "type": "command",
            "command": "python \"H:/prism/.claude/hooks/lib/enforce-context-retention.py\"",
            "timeout": 5000,
            "statusMessage": "Checking context retention...",
            "continueOnError": true
          },
          {
            "type": "command",
            "command": "python \"H:/prism/.claude/hooks/lib/enforce-plan-before-build.py\"",
            "timeout": 5000,
            "statusMessage": "Checking build plan...",
            "continueOnError": true
          },
          {
            "type": "command",
            "command": "python \"H:/prism/.claude/hooks/lib/enforce-duplicate-check.py\"",
            "timeout": 5000,
            "statusMessage": "Checking for duplicate engines...",
            "continueOnError": true
          },
          {
            "type": "command",
            "command": "python \"H:/prism/.claude/hooks/lib/enforce-knowledge-depth.py\"",
            "timeout": 5000,
            "statusMessage": "Verifying knowledge consultation depth...",
            "continueOnError": true
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "python \"H:/prism/.claude/hooks/lib/enforce-stagnant-check.py\"",
            "timeout": 5000,
            "statusMessage": "Checking stagnant engine ledger...",
            "continueOnError": true
          },
          {
            "type": "command",
            "command": "python \"H:/prism/.claude/hooks/lib/enforce-graph-nav-reminder.py\"",
            "timeout": 3000,
            "statusMessage": "Tracking search patterns...",
            "continueOnError": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"H:/prism/.claude/hooks/lib/enforce-memory-pipeline.py\"",
            "timeout": 3000,
            "statusMessage": "Recording session event...",
            "continueOnError": true
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"H:/prism/.claude/hooks/lib/build-guard-hook.mjs\"",
            "timeout": 3000,
            "statusMessage": "Build guard tracking edit...",
            "continueOnError": true
          },
          {
            "type": "command",
            "command": "python \"H:/prism/.claude/hooks/lib/enforce-stub-detector.py\"",
            "timeout": 5000,
            "statusMessage": "Checking for stub patterns...",
            "continueOnError": true
          },
          {
            "type": "command",
            "command": "python \"H:/prism/.claude/hooks/lib/enforce-test-quality.py\"",
            "timeout": 5000,
            "statusMessage": "Checking test quality...",
            "continueOnError": true
          },
          {
            "type": "command",
            "command": "python \"H:/prism/.claude/hooks/lib/enforce-constants-check.py\"",
            "timeout": 5000,
            "statusMessage": "Checking canonical constants...",
            "continueOnError": true
          },
          {
            "type": "command",
            "command": "python \"H:/prism/.claude/hooks/lib/enforce-instruction-compliance.py\"",
            "timeout": 5000,
            "statusMessage": "Checking engineering rigor...",
            "continueOnError": true
          },
          {
            "type": "command",
            "command": "python \"H:/prism/.claude/hooks/lib/enforce-output-validation.py\"",
            "timeout": 5000,
            "statusMessage": "Validating output structure...",
            "continueOnError": true
          },
          {
            "type": "command",
            "command": "python \"H:/prism/.claude/hooks/lib/enforce-index-auto-update.py\"",
            "timeout": 5000,
            "statusMessage": "Auto-updating engine index...",
            "continueOnError": true
          },
          {
            "type": "command",
            "command": "python \"H:/prism/.claude/hooks/lib/enforce-regression-test.py\"",
            "timeout": 5000,
            "statusMessage": "Checking regression tests...",
            "continueOnError": true
          },
          {
            "type": "command",
            "command": "python \"H:/prism/.claude/hooks/lib/enforce-math-completeness.py\"",
            "timeout": 5000,
            "statusMessage": "Checking mathematical completeness...",
            "continueOnError": true
          },
          {
            "type": "command",
            "command": "python \"H:/prism/.claude/hooks/lib/enforce-unit-counter.py\"",
            "timeout": 5000,
            "statusMessage": "Tracking session quality metrics...",
            "continueOnError": true
          },
          {
            "type": "command",
            "command": "python \"H:/prism/.claude/hooks/lib/enforce-knowledge-consult-mark.py\"",
            "timeout": 5000,
            "statusMessage": "Tracking knowledge consultation...",
            "continueOnError": true
          },
          {
            "type": "command",
            "command": "python \"H:/prism/.claude/hooks/lib/enforce-auto-compact.py\"",
            "timeout": 5000,
            "statusMessage": "Checking compaction status...",
            "continueOnError": true
          },
          {
            "type": "command",
            "command": "python -c \"import json,sys; d=json.loads(sys.stdin.read()); p=d.get('tool_input',{}).get('file_path','').replace('\\\\','/'); print(json.dumps({'continue':True}) if 'src/engines/' not in p or not p.endswith('.ts') or '.test.' in p else json.dumps({'additionalContext':'ENGINE EDIT DETECTED: Run /prism-review for deep physics+wiring review before compacting.'}))\"",
            "timeout": 3000,
            "statusMessage": "Checking if engine review needed...",
            "continueOnError": true
          },
          {
            "type": "command",
            "command": "python -c \"import json,sys,subprocess,os; d=json.loads(sys.stdin.read()); p=d.get('tool_input',{}).get('file_path','').replace('\\\\','/'); is_ts=p.endswith('.ts') and 'mcp-server/src/' in p and '.test.' not in p; result={'continue':True}; exec('') if not is_ts else None; errs=''; proc=subprocess.run(['npx','tsc','--noEmit','--pretty','false'],capture_output=True,text=True,cwd='H:/prism/mcp-server',timeout=30) if is_ts else None; errs=(proc.stderr+proc.stdout).strip()[:500] if is_ts and proc and proc.returncode!=0 else ''; result={'additionalContext':f'TSC ERRORS after edit: {errs}'} if errs else {'continue':True}; print(json.dumps(result))\"",
            "timeout": 35000,
            "statusMessage": "Type-checking after TS edit...",
            "continueOnError": true
          },
          {
            "type": "command",
            "command": "python \"H:/prism/.claude/hooks/lib/enforce-eslint-after-edit.py\"",
            "timeout": 25000,
            "statusMessage": "Linting after TS edit...",
            "continueOnError": true
          },
          {
            "type": "command",
            "command": "python \"H:/prism/.claude/hooks/lib/enforce-smart-test-after-edit.py\"",
            "timeout": 3000,
            "statusMessage": "Tracking test coverage...",
            "continueOnError": true
          },
          {
            "type": "command",
            "command": "python \"H:/prism/.claude/hooks/lib/enforce-formula-accuracy.py\"",
            "timeout": 3000,
            "statusMessage": "Checking formula accuracy flag...",
            "continueOnError": true
          }
        ]
      },
      {
        "matcher": "Read|Write|Edit|Bash|Grep|Glob|Agent|WebSearch|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "node \"H:/prism/.claude/hooks/lib/token-economy-hook.mjs\"",
            "timeout": 2000,
            "statusMessage": "Tracking token economy...",
            "continueOnError": true
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "python \"H:/prism/.claude/hooks/lib/enforce-knowledge-consult-mark.py\"",
            "timeout": 5000,
            "continueOnError": true
          },
          {
            "type": "command",
            "command": "python \"H:/prism/.claude/hooks/lib/enforce-context-retention.py\"",
            "timeout": 5000,
            "continueOnError": true
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "node \"H:/prism/.claude/hooks/lib/context-chain-hook.mjs\"",
            "timeout": 3000,
            "statusMessage": "Context chain: planning compaction...",
            "continueOnError": true
          },
          {
            "type": "command",
            "command": "python \"H:/prism/.claude/hooks/lib/enforce-memory-pipeline.py\"",
            "timeout": 5000,
            "statusMessage": "Running memory pipeline: save events + graph + snapshot + accomplishments...",
            "continueOnError": true
          },
          {
            "type": "command",
            "command": "python \"H:/prism/.claude/hooks/lib/enforce-review-gate.py\"",
            "timeout": 5000,
            "statusMessage": "Running pre-compact quality gate...",
            "continueOnError": true
          },
          {
            "type": "command",
            "command": "python \"H:/prism/.claude/hooks/lib/enforce-forge-triple-output.py\"",
            "timeout": 10000,
            "statusMessage": "Checking forge-triple outputs (hook + MCP action + skill)...",
            "continueOnError": true
          },
          {
            "type": "command",
            "command": "python \"H:/prism/.claude/hooks/lib/enforce-index-sync.py\"",
            "timeout": 5000,
            "statusMessage": "Checking index sync + stagnant engine ledger...",
            "continueOnError": true
          },
          {
            "type": "command",
            "command": "python \"H:/prism/.claude/hooks/lib/enforce-wiring-completeness.py\"",
            "timeout": 5000,
            "statusMessage": "Checking wiring completeness (ALL consumers, not just one)...",
            "continueOnError": true
          },
          {
            "type": "command",
            "command": "python \"H:/prism/.claude/hooks/lib/enforce-precompact-audit.py\"",
            "timeout": 5000,
            "statusMessage": "Running pre-compact session audit...",
            "continueOnError": true
          },
          {
            "type": "command",
            "command": "python \"H:/prism/.claude/hooks/lib/enforce-formula-accuracy-gate.py\"",
            "timeout": 5000,
            "statusMessage": "Checking formula accuracy gate...",
            "continueOnError": true
          },
          {
            "type": "command",
            "command": "python \"H:/prism/.claude/hooks/lib/enforce-quality-snapshot.py\"",
            "timeout": 5000,
            "statusMessage": "Quality dashboard snapshot...",
            "continueOnError": true
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "python \"H:/prism/.claude/hooks/lib/enforce-post-compact-consolidated.py\"",
            "timeout": 5000,
            "statusMessage": "Post-compact: reset trackers + sync HANDOFF + resume...",
            "continueOnError": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"H:/prism/.claude/hooks/lib/chain-recovery-hook.mjs\"",
            "timeout": 3000,
            "statusMessage": "Classifying failure for recovery...",
            "continueOnError": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"H:/prism/.claude/hooks/lib/enforce-stop-handoff.py\"",
            "timeout": 5000,
            "statusMessage": "Auto-saving HANDOFF on stop...",
            "continueOnError": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"H:/prism/.claude/hooks/lib/prompt-classifier-hook.mjs\"",
            "timeout": 2000,
            "statusMessage": "Classifying task...",
            "continueOnError": true
          },
          {
            "type": "command",
            "command": "python \"H:/prism/.claude/hooks/lib/enforce-session-resume.py\"",
            "timeout": 3000,
            "statusMessage": "Checking session resume...",
            "continueOnError": true
          },
          {
            "type": "command",
            "command": "python \"H:/prism/.claude/hooks/lib/enforce-cross-tree-reference.py\"",
            "timeout": 3000,
            "statusMessage": "Checking cross-tree PRISM reference...",
            "continueOnError": true
          }
        ]
      }
    ]
  },
  "worktree": {
    "sparsePaths": [
      "mcp-server/src/engines/",
      "mcp-server/src/tools/dispatchers/",
      "mcp-server/src/physics/",
      "mcp-server/src/registries/",
      "mcp-server/src/__tests__/",
      "cad-engine/src/",
      "cad-engine/primitives/",
      "state/",
      "CLAUDE.md",
      "CAMX-RESTRUCTURED-ROADMAP-v24.md",
      "package.json",
      "tsconfig.json"
    ]
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "serena@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "agent-sdk-dev@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "explanatory-output-style@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "figma@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "Notion@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true
  },
  "effortLevel": "high",
  "autoUpdatesChannel": "latest",
  "autoMemoryDirectory": "H:/prism/state/shared/memory",
  "autoDreamEnabled": true,
  "skipDangerousModePermissionPrompt": true
}
