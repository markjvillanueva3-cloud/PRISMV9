            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/ollama-engine-api-extractor.mjs",
            "timeout": 10000,
            "continueOnError": true
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/file-read-cache.mjs",
            "timeout": 1500,
            "continueOnError": true,
            "_wrapped": "WHY: dedupe Read of same file+mtime+slice within session — token cache"
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/json-read-summarizer.mjs",
            "timeout": 2000,
            "continueOnError": true,
            "_wrapped": "WHY: large-JSON preview on first read (>50KB) — emits structure/counts instead of full content"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/error-block-prewarn.mjs",
            "timeout": 1500,
            "continueOnError": true
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/rtk-auto-suggest.mjs",
            "timeout": 2000,
            "continueOnError": true
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/script-summary-inject.mjs",
            "timeout": 1500,
            "continueOnError": true
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/bash-destructive-guard.mjs",
            "timeout": 2000,
            "continueOnError": false
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/file-claim-commit-guard.mjs",
            "timeout": 3000,
            "continueOnError": false
          },
