            "timeout": 3000,
            "continueOnError": true,
            "_wrapped": "WHY: legacy-module hook via adapter — flags engine deletions when dependents still reference. Advisory"
          }
        ]
      },
      {
        "matcher": "Glob",
        "hooks": [
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/glob-narrow-path.mjs",
            "timeout": 2000,
            "continueOnError": true
          }
        ]
      },
      {
        "matcher": "Grep",
        "hooks": [
