            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/duplication-hard-block.mjs",
            "timeout": 3000,
            "continueOnError": false
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/anti-pattern-detector.mjs",
            "timeout": 3000,
            "continueOnError": false
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/ban-facade-patterns.mjs",
            "timeout": 3000,
            "continueOnError": false
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/test-legitimacy.mjs",
            "timeout": 3000,
            "continueOnError": false
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/ai-duplication-guard.mjs",
            "timeout": 3000,
            "continueOnError": false,
            "_wrapped": "WHY: HARD BLOCK on duplicate engines/hooks/skills/algorithms via Levenshtein + cross-session registry"
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/h-drive-enforcement.mjs",
            "timeout": 2000,
            "continueOnError": false,
            "_wrapped": "WHY: HARD BLOCK file writes to C: drive — all PRISM work must live on H:"
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/critical-file-guard.mjs",
            "timeout": 2000,
            "continueOnError": false,
            "_wrapped": "WHY: HARD BLOCK edits to safety-critical files (Kienzle/Taylor/S(x)/material constants per state/shared/CRITICAL_FILES.json) without CONFIRM_CRITICAL=true env or confirmCritical:true input flag"
          }
        ]
      },
      {
        "matcher": "Bash|Read|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/mcp-route-suggest.mjs",
            "timeout": 1500,
            "continueOnError": true
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/edit-old-string-verify.mjs",
            "timeout": 2000,
            "continueOnError": false
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/iterate-retrieve-suggest.mjs",
            "timeout": 1500,
            "continueOnError": true
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
