{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {},
  "description": "PRISM project settings — mirrors locally-developed hook registrations so the wiring-enforcement stop-hook detects them. Global roadmap hooks live in H:/.claude/settings.json.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/stale-claim-sweeper.mjs",
            "timeout": 5000,
            "continueOnError": true,
            "_wrapped": "WHY: clears stale file-claims/git-locks/workboard entries from chats that died without firing Stop hooks (terminal close, taskkill, PC shutdown). Prevents false CONFLICT spam in current session."
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/mcp-daemon-autostart.mjs",
            "timeout": 40000,
            "continueOnError": true
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/harness-audit-staleness.mjs",
            "timeout": 1500,
            "continueOnError": true
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/chat-state-isolator.mjs",
            "timeout": 3000,
            "continueOnError": true
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/settings-baseline-snapshot.mjs",
            "timeout": 2000,
            "continueOnError": true
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/prism-awareness-cache.mjs",
            "timeout": 2000,
            "continueOnError": true
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/sessionstart-critical-path.mjs",
            "timeout": 2000,
            "continueOnError": true
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/embedder-inject-qdrant.mjs",
            "timeout": 8000,
            "continueOnError": true
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/ollama-autostart.mjs",
            "continueOnError": true
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/awareness-snapshot.mjs",
            "timeout": 3000,
            "continueOnError": true,
            "_wrapped": "WHY: emits PRISM engine/formula/material/tool counts + extraction status as additionalContext"
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/helpers/legacy-module-hook-adapter.mjs H:/prism/.claude/hooks/awareness-bootstrap.mjs SessionStart",
            "timeout": 3000,
            "continueOnError": true,
            "_wrapped": "WHY: legacy-module hook via adapter — bootstraps situational awareness context, emits {inject:{...}} → additionalContext"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/ollama-context-aggregator.mjs",
            "timeout": 6000,
            "continueOnError": true
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/session-reorient-inject.mjs",
            "timeout": 3000,
            "continueOnError": true
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/lathe-p2p-suggest.mjs",
            "timeout": 1500,
            "continueOnError": true
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/chat-bus-inject.mjs",
            "timeout": 2000,
            "continueOnError": true
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/ollama-task-offloader.mjs",
            "continueOnError": true
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/claudemd-ollama-enforcer.mjs",
            "continueOnError": true
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/auto-precompact-watchdog.mjs",
            "continueOnError": true
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/wiki-precheck-inject.mjs",
            "timeout": 1500,
            "continueOnError": true,
            "_wrapped": "WHY: BM25-lite query against knowledge/wiki/index.md; injects top-3 matching entries on keyword overlap so Claude doesn't re-derive what the wiki already documents. Disable via PRISM_WIKI_PRECHECK=0."
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/ollama-obsidian-rag.mjs",
            "timeout": 3000
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/ollama-auto-router.mjs",
            "timeout": 3000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__.*__prism_business|prism_business",
        "hooks": [
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/erp-quote-variance-guard.mjs",
