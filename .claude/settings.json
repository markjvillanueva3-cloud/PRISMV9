          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/file-claim-guard.mjs",
            "timeout": 2500,
            "continueOnError": false
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/unified-local-validation.mjs",
            "timeout": 1500,
            "continueOnError": true
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/code-completeness-gate.mjs",
            "timeout": 3000,
            "continueOnError": false
