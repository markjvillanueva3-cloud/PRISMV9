            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/settings-json-addonly-guard.mjs",
            "timeout": 2000,
            "continueOnError": false
          },
          {
            "type": "command",
            "command": "\"H:/.claude/bin/portable-node\" H:/prism/.claude/hooks/pretool-change-radius.mjs",
