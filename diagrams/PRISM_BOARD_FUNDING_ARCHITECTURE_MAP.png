            parts.push(`G-code=${input.gcode}`);
        if (input.mcode)
            parts.push(`M-code=${input.mcode}`);
        if (input.tags?.length)
            parts.push(`tags=[${input.tags.join(",")}]`);
        if (input.osp_family)
            parts.push(`family=${input.osp_family}`);
