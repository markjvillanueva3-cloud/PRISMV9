            finish_od: "V2",
            finish_id: "V3",
            part_length: "V5",
            stock_face_offset: "V100",
            drill_size: "V20",
            drill_point_angle: "V21",
            peck_depth: "V22",
            od_finish_allowance: "V35",
            id_finish_allowance: "V36",
            axial_finish_allowance: "V37",
            x_clearance: "V60",
            z_clearance: "V61",
            retract_x: "V62",
            retract_z: "V63",
            max_rpm: "V64",
