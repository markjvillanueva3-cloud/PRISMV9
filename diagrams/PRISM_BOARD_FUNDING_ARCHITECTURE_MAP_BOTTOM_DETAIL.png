        const retractZ = input.retract_z ?? 20;
        this._addVar(lines, varMap, "V60", xClear, "X CLEARANCE (ABOVE STOCK)");
        this._addVar(lines, varMap, "V61", zClear, "Z CLEARANCE (OFF FACE)");
