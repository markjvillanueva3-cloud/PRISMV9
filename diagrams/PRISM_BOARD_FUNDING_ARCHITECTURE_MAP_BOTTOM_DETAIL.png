        lines.push("( ===== SPEEDS, FEEDS, DOC PER TOOL ===== )");
        let sfmVarIdx = 45;
        let feedVarIdx = 46;
        let docVarIdx = 40;
        for (const tool of input.tools) {
            const opLabel = tool.operation.toUpperCase().replace(/_/g, " ");
