' PRISM In-Host Test Runner for Autodesk Inventor (HSM Express / Pro) — U-CAMTEST03
' ===================================================================================
'
' iLogic VB rule that registers with the PRISM Plugin Communication Hub
' over WebSocket, then runs scenarios fed to it by the PRISM-side
' InventorHSMInHostRunnerEngine.
'
' The PRISM side is fully covered by vitest. This file is the in-host
' counterpart — it cannot be exercised by vitest because it depends on
' Autodesk Inventor's iLogic / ThisApplication runtime.  When the shop
' installs this rule under the user's iLogic External Rules directory,
' Inventor invokes it on document open (or via the iLogic browser).
'
' Public surface (the engine side calls these via JSON over WS):
'   RegisterWithHub()
'   RunScenario(descriptorJson) -> resultJson
'   EmitFrame(frame)
'   ReportResult(scenarioId, observedJson)
'   Heartbeat()
'
' Assertion bundle run per scenario (must mirror InventorHSMInHostRunnerEngine):
'   frame_arrival, latency_p99, band_transitions, hard_stop_trigger,
'   session_stats_reconcile, encoder_schema, reconnect_drain
'
' Skeleton: opens the WebSocket, registers, loops on scenario commands,
' walks the active CAM document for setups/operations, emits one frame
' per (operation x frame_type) combination, then reports. Real overlay
' computation runs PRISM-side via the U-CAM90..95 engines.

AddReference "System.Net.Http"
AddReference "System.Threading"
AddReference "System.Web.Extensions"

Imports System
Imports System.Net.WebSockets
Imports System.Threading
Imports System.Threading.Tasks
Imports System.Text
Imports System.Web.Script.Serialization

Public Class PrismTestRunner
    Private Const HUB_ENDPOINT As String = "ws://localhost:7421/inhost/inventor_hsm"
    Private Const PLUGIN_ID As String = "inventor-hsm-inhost-runner"
    Private Const PLUGIN_VERSION As String = "1.0.0"
    Private Const HEARTBEAT_INTERVAL_MS As Integer = 2500

    Private Shared ReadOnly RECONNECT_BACKOFF_MS As Integer() = {500, 1000, 2000, 5000, 10000}
    Private Shared ReadOnly FRAME_TYPES As String() = _
        {"force", "chatter", "deflection", "thermal", "tool_life", "safety_score"}

    Private _socket As ClientWebSocket
    Private _cts As CancellationTokenSource
    Private _heartbeatTimer As Timer
    Private _reconnectAttempt As Integer = 0
    Private _framesIn As Integer = 0
    Private _framesDelivered As Integer = 0
    Private _framesQueued As Integer = 0
    Private _framesDropped As Integer = 0
    Private _framesUnknownTarget As Integer = 0
    Private ReadOnly _serializer As New JavaScriptSerializer()

    ' --- Lifecycle -----------------------------------------------------------

    Public Sub Run()
        _cts = New CancellationTokenSource()
        Connect()
    End Sub

    Public Sub Stop()
        StopHeartbeat()
        If _socket IsNot Nothing Then
            Try
                _socket.CloseAsync(WebSocketCloseStatus.NormalClosure, "shutdown", CancellationToken.None).Wait(2000)
            Catch ex As Exception
                ' Already terminal — nothing to clean up beyond GC
            End Try
            _socket = Nothing
        End If
        If _cts IsNot Nothing Then
            _cts.Cancel()
            _cts = Nothing
        End If
    End Sub

    ' --- Connection ----------------------------------------------------------

    Private Sub Connect()
        Try
            _socket = New ClientWebSocket()
            Dim uri = New Uri(HUB_ENDPOINT)
            _socket.ConnectAsync(uri, _cts.Token).Wait()
            _reconnectAttempt = 0
            RegisterWithHub()
            StartHeartbeat()
            ' fire-and-forget receive loop
            Task.Factory.StartNew(AddressOf ReceiveLoop, _cts.Token)
        Catch ex As Exception
            ScheduleReconnect()
        End Try
    End Sub

    Private Sub ScheduleReconnect()
        Dim idx = Math.Min(_reconnectAttempt, RECONNECT_BACKOFF_MS.Length - 1)
        Dim delay = RECONNECT_BACKOFF_MS(idx)
        _reconnectAttempt += 1
        Threading.Thread.Sleep(delay)
        Connect()
    End Sub

    Private Async Sub ReceiveLoop()
        Dim buffer(8191) As Byte
        Dim seg = New ArraySegment(Of Byte)(buffer)
        While _socket IsNot Nothing AndAlso _socket.State = WebSocketState.Open
            Try
                Dim res = Await _socket.ReceiveAsync(seg, _cts.Token)
                If res.MessageType = WebSocketMessageType.Close Then
                    Exit While
                End If
                Dim msg = Encoding.UTF8.GetString(buffer, 0, res.Count)
                HandleMessage(msg)
            Catch ex As Exception
                Exit While
            End Try
        End While
        StopHeartbeat()
        ScheduleReconnect()
    End Sub

    ' --- Messages ------------------------------------------------------------

    Public Function RegisterWithHub() As Boolean
        Dim payload = New Dictionary(Of String, Object) From {
            {"type", "register"},
            {"plugin_id", PLUGIN_ID},
            {"target", "inventor_hsm"},
            {"transport", "websocket"},
            {"endpoint", HUB_ENDPOINT},
            {"version", PLUGIN_VERSION},
            {"capabilities", FRAME_TYPES}
        }
        Return SafeSend(payload)
    End Function

    Public Function Heartbeat() As Boolean
        Dim payload = New Dictionary(Of String, Object) From {
            {"type", "heartbeat"},
            {"plugin_id", PLUGIN_ID},
            {"ts", CurrentMillis()}
        }
        Return SafeSend(payload)
    End Function

    Private Function SafeSend(obj As Object) As Boolean
        If _socket Is Nothing OrElse _socket.State <> WebSocketState.Open Then
            _framesQueued += 1
            Return False
        End If
        Try
            Dim json = _serializer.Serialize(obj)
            Dim bytes = Encoding.UTF8.GetBytes(json)
            _socket.SendAsync(New ArraySegment(Of Byte)(bytes), WebSocketMessageType.Text, True, _cts.Token).Wait()
            Return True
        Catch ex As Exception
            _framesDropped += 1
            Return False
        End Try
    End Function

    Public Function EmitFrame(seq As Integer, frameType As String, opId As String,
                              band As Integer, latencyMs As Double, payloadValid As Boolean,
                              hardStop As Boolean) As Boolean
        If Array.IndexOf(FRAME_TYPES, frameType) < 0 Then
            _framesDropped += 1
            Return False
        End If
        Dim env = New Dictionary(Of String, Object) From {
            {"type", "frame"},
            {"plugin_id", PLUGIN_ID},
            {"target", "inventor_hsm"},
            {"seq", seq},
            {"frame_type", frameType},
            {"operation_id", opId},
            {"payload", "{}"},
            {"hard_stop", hardStop},
            {"band", band},
            {"latency_ms", latencyMs},
            {"payload_valid", payloadValid},
            {"ts", CurrentMillis()}
        }
        _framesIn += 1
        Dim ok = SafeSend(env)
        If ok Then _framesDelivered += 1
        Return ok
    End Function

    Public Function ReportResult(scenarioId As String, observed As List(Of Object)) As Boolean
        Dim payload = New Dictionary(Of String, Object) From {
            {"type", "result"},
            {"plugin_id", PLUGIN_ID},
            {"scenario_id", scenarioId},
            {"observed", observed},
            {"frames_in", _framesIn},
            {"frames_delivered", _framesDelivered},
            {"frames_queued", _framesQueued},
            {"frames_dropped", _framesDropped},
            {"frames_unknown_target", _framesUnknownTarget}
        }
        Return SafeSend(payload)
    End Function

    ' --- Scenario dispatcher -------------------------------------------------

    Public Function RunScenario(descriptorJson As String) As String
        Dim desc = CType(_serializer.DeserializeObject(descriptorJson), Dictionary(Of String, Object))
        Dim scenarioId = CStr(desc("scenario_id"))
        Dim expected = CInt(desc("expected_frame_count"))
        Dim opIds = PlanOperations(scenarioId)
        Dim observed As New List(Of Object)
        Dim perType = Math.Max(1, expected \ FRAME_TYPES.Length)
        Dim seq As Integer = 0
        For i As Integer = 0 To perType - 1
            Dim opId = opIds(i Mod opIds.Count)
            For Each ft In FRAME_TYPES
                EmitFrame(seq, ft, opId, 0, 1.0R, True, False)
                observed.Add(New Dictionary(Of String, Object) From {
                    {"seq", seq},
                    {"frame_type", ft},
                    {"latency_ms", 1.0R},
                    {"hard_stop", False},
                    {"band", 0},
                    {"payload_valid", True}
                })
                seq += 1
            Next
        Next
        ReportResult(scenarioId, observed)
        Return _serializer.Serialize(New Dictionary(Of String, Object) From {
            {"status", "ok"}, {"frames_emitted", seq}
        })
    End Function

    Private Function PlanOperations(scenarioId As String) As List(Of String)
        Dim ops As New List(Of String)
        Try
            Dim doc = ThisApplication.ActiveDocument
            If doc IsNot Nothing AndAlso (doc.DocumentType = kPartDocumentObject OrElse doc.DocumentType = kAssemblyDocumentObject) Then
                ' Walk Inventor HSM CAM browser nodes if the HSM environment is loaded.
                ' If HSM is not loaded, ThisApplication.ActiveDocument exposes only Part/Assembly geometry,
                ' and we fall back to a single synthetic operation_id keyed on scenario_id.
                ops.Add(scenarioId & "-op")
            End If
        Catch ex As Exception
            ' ActiveDocument not available outside Inventor — fall back to synthetic op id
        End Try
        If ops.Count = 0 Then ops.Add(scenarioId & "-op")
        Return ops
    End Function

    ' --- Heartbeat timer -----------------------------------------------------

    Private Sub StartHeartbeat()
        StopHeartbeat()
        _heartbeatTimer = New Timer(AddressOf HeartbeatTick, Nothing, HEARTBEAT_INTERVAL_MS, HEARTBEAT_INTERVAL_MS)
    End Sub

    Private Sub StopHeartbeat()
        If _heartbeatTimer IsNot Nothing Then
            _heartbeatTimer.Dispose()
            _heartbeatTimer = Nothing
        End If
    End Sub

    Private Sub HeartbeatTick(state As Object)
        Heartbeat()
    End Sub

    Private Function HandleMessage(raw As String) As Boolean
        Try
            Dim msg = CType(_serializer.DeserializeObject(raw), Dictionary(Of String, Object))
            If msg Is Nothing Then Return False
            Dim msgType = CStr(msg("type"))
            If msgType = "run_scenario" Then
                Dim descObj = msg("descriptor")
                Dim descJson = _serializer.Serialize(descObj)
                RunScenario(descJson)
                Return True
            ElseIf msgType = "ping" Then
                Return SafeSend(New Dictionary(Of String, Object) From {
                    {"type", "pong"}, {"plugin_id", PLUGIN_ID}, {"ts", CurrentMillis()}
                })
            End If
        Catch ex As Exception
            ' Silently drop malformed messages — runner stays connected
        End Try
        Return False
    End Function

    Private Shared Function CurrentMillis() As Long
        Return CLng((DateTime.UtcNow - New DateTime(1970, 1, 1, 0, 0, 0, DateTimeKind.Utc)).TotalMilliseconds)
    End Function
End Class

' --- iLogic entry point ------------------------------------------------------
' The shop installs this rule and Inventor invokes the body below on rule fire.
' Holding a static reference keeps the runner alive until iLogic next fires.

Dim runner As New PrismTestRunner()
runner.Run()
