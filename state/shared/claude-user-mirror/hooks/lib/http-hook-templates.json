{
  "schemaVersion": "1.0.0",
  "_lastBackfillTs": "2026-05-08T16:41:54.025Z",
  "description": "HTTP hook templates for future use. These require a local telemetry server.",
  "templates": {
    "telemetry_post": {
      "type": "http",
      "url": "http://localhost:9090/api/telemetry",
      "headers": {
        "Content-Type": "application/json",
        "X-Session": "$CLAUDE_SESSION_ID"
      },
      "timeout": 5
    },
    "build_status_webhook": {
      "type": "http",
      "url": "http://localhost:9090/api/build-status",
      "headers": {
        "Content-Type": "application/json"
      },
      "timeout": 5
    },
    "slack_notification": {
      "type": "http",
      "url": "https://hooks.slack.com/services/PLACEHOLDER",
      "headers": {
        "Content-Type": "application/json"
      },
      "timeout": 10
    }
  }
}