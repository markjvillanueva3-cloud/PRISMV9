    {
      "type": "tip",
      "id": "tip_chip-004",
      "props": {
        "title": "Long Stringy Chip Hazard",
        "body": "Long continuous chips are safety hazard (entanglement, cuts). Increase feed for thicker chip that breaks. Use chip breaker insert. Add pecking in deep cuts. Never clear chips by hand while running.",
        "category": "chip_formation",
        "confidence": 0.98,
