      "updated_at": "2026-05-17T01:20:39.679Z"
    },
    {
      "type": "tip",
      "id": "tip_metal-005",
      "props": {
        "title": "Tempering Risk in Hardened Steel",
        "body": "Hardened steel tempers (softens) above 300-400°C. Excessive cutting temperature causes soft spots. Keep speed moderate, use coolant, maintain sharp tools to prevent surface softening.",
        "category": "metallurgy",
        "confidence": 0.95,
        "source": "Heat treatment metallurgy",
        "tags": [
          "tempering",
          "hardness",
          "softening"
        ],
