    },
    {
      "type": "tip",
      "id": "tip_metal-004",
      "props": {
        "title": "Residual Stress from Cutting",
        "body": "Cutting produces tensile residual stress (thermal) in surface, compressive below. Tensile stress reduces fatigue life. Finishing with sharp tool, low feed minimizes thermal damage.",
        "category": "metallurgy",
        "confidence": 0.9,
        "source": "Surface integrity research",
        "tags": [
          "residual_stress",
          "fatigue",
          "surface_integrity"
        ],
        "material_groups": [],
        "iso_groups": [],
        "domain": "lathe"
