    {
      "type": "tip",
      "id": "tip_chem-002",
      "props": {
        "title": "Diffusion Wear in Titanium",
        "body": "Titanium has high chemical affinity for carbon and cobalt. At cutting temperatures, Ti diffuses into WC-Co tools causing dissolution wear. Use low speed (<60 m/min) or PCD tooling.",
        "category": "chemistry",
        "confidence": 0.95,
        "source": "Titanium machining research",
        "tags": [
          "titanium",
          "diffusion",
          "wear"
        ],
        "material_groups": [],
