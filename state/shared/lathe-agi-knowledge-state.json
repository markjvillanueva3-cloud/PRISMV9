    },
    {
      "type": "tip",
      "id": "tip_thermal-001",
      "props": {
        "title": "Cutting Temperature Generation",
        "body": "Nearly all cutting energy converts to heat: Q ≈ Fc × Vc. At 200 m/min in steel, chip temperatures reach 600-800°C. Tool-chip interface can exceed 1000°C in titanium machining.",
        "category": "thermal",
        "confidence": 0.95,
        "source": "Shaw Metal Cutting Principles",
        "tags": [
          "temperature",
          "heat",
          "energy"
        ],
        "material_groups": [],
        "iso_groups": [],
        "domain": "lathe"
      },
      "created_at": "2026-05-17T01:20:39.679Z",
      "updated_at": "2026-05-17T01:20:39.679Z"
    },
    {
      "type": "tip",
      "id": "tip_thermal-002",
      "props": {
        "title": "Heat Partition in Cutting",
        "body": "Heat distribution: chip 60-80% (higher at high speed), tool 10-20%, workpiece 5-20%, coolant variable. At high speeds, chip carries more heat away, protecting workpiece.",
        "category": "thermal",
        "confidence": 0.9,
        "source": "Trent & Wright Metal Cutting",
        "tags": [
          "heat_partition",
          "chip",
          "cooling"
        ],
        "material_groups": [],
        "iso_groups": [],
        "domain": "lathe"
