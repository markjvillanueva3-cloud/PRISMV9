    },
    {
      "type": "tip",
      "id": "tip_chip-001",
      "props": {
        "title": "Shear Plane Angle (Merchant)",
        "body": "Shear plane angle φ = 45° - β/2 + α/2. Where β is friction angle (atan(μ)), α is rake angle. Higher rake → higher shear angle → lower forces. Minimum energy principle.",
        "category": "chip_formation",
        "confidence": 0.95,
        "source": "Merchant (1945) Metal Cutting Theory",
        "tags": [
          "shear_angle",
          "merchant",
          "rake"
