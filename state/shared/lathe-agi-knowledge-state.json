      "updated_at": "2026-05-17T01:20:39.679Z"
    },
    {
      "type": "tip",
      "id": "tip_metal-002",
      "props": {
        "title": "Work Hardening in Stainless",
        "body": "Austenitic stainless (304, 316) work hardens severely. Never rub without cutting - always maintain positive chip load. Use sharp tools, positive rake, adequate DOC (>0.5mm).",
        "category": "metallurgy",
        "confidence": 0.95,
        "source": "Stainless steel machining guides",
        "tags": [
          "work_hardening",
          "stainless",
          "304",
          "316"
        ],
        "material_groups": [],
