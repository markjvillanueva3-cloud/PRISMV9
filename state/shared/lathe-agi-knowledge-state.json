    },
    {
      "type": "tip",
      "id": "tip_chem-001",
      "props": {
        "title": "Coolant-Material Compatibility",
        "body": "Chemical incompatibilities: Al + chlorinated oil = staining, Cu + sulfur = discoloration, Mg + water = fire risk, Ti + chlorine = stress corrosion. Check compatibility before use.",
        "category": "chemistry",
        "confidence": 0.95,
        "source": "Coolant manufacturer guidelines",
        "tags": [
          "coolant",
