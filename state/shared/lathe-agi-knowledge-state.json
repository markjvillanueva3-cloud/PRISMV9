      "updated_at": "2026-05-17T01:20:39.679Z"
    },
    {
      "type": "tip",
      "id": "tip_metal-003",
      "props": {
        "title": "Carbide Distribution in Tool Steel",
        "body": "Tool steels (D2, M2) have hard carbide particles that cause abrasive wear. Larger carbides = more wear. Use CBN or ceramic for >55 HRC. Carbide OK for <55 HRC.",
        "category": "metallurgy",
        "confidence": 0.9,
        "source": "Tool steel handbook",
        "tags": [
          "carbide",
          "tool_steel",
          "abrasion"
        ],
        "material_groups": [],
