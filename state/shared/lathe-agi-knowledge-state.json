    {
      "type": "tip",
      "id": "tip_kienzle-001",
      "props": {
        "title": "Kienzle Force Calculation",
        "body": "Main cutting force Fc = kc1.1 × ap × f^(1-mc). Where kc1.1 is specific cutting force at 1mm chip thickness, ap is depth of cut, f is feed, mc is Kienzle exponent (0.14-0.40).",
        "category": "cutting_force",
        "confidence": 0.98,
        "source": "Kienzle (1952), Altintas Manufacturing Automation",
        "tags": [
          "kienzle",
          "cutting_force",
          "physics"
        ],
        "material_groups": [],
        "iso_groups": [
          "P",
          "M",
          "K",
          "N",
          "S",
          "H"
        ],
        "domain": "lathe"
      },
      "created_at": "2026-05-17T01:20:39.679Z",
      "updated_at": "2026-05-17T01:20:39.679Z"
    },
    {
      "type": "tip",
      "id": "tip_kienzle-002",
      "props": {
        "title": "Power Requirement from Force",
        "body": "Cutting power Pc = Fc × Vc / 60000 [kW]. Motor power must exceed Pc/η where η is machine efficiency (0.7-0.85). Always verify spindle power before heavy roughing.",
        "category": "cutting_force",
        "confidence": 0.95,
        "source": "Sandvik Coromant, Machine Tool Dynamics",
        "tags": [
          "power",
          "motor",
          "roughing"
        ],
        "material_groups": [],
        "iso_groups": [],
        "domain": "lathe"
      },
      "created_at": "2026-05-17T01:20:39.679Z",
      "updated_at": "2026-05-17T01:20:39.679Z"
    },
    {
      "type": "tip",
      "id": "tip_kienzle-003",
      "props": {
        "title": "Torque from Cutting Force",
        "body": "Spindle torque T = Fc × Dc / 2000 [Nm]. At low RPM, torque limits may be reached before power limits. Check machine torque curve for max DOC at given RPM.",
        "category": "cutting_force",
        "confidence": 0.95,
        "source": "Machine tool specifications",
        "tags": [
          "torque",
          "spindle",
          "low_rpm"
        ],
        "material_groups": [],
        "iso_groups": [],
        "domain": "lathe"
      },
      "created_at": "2026-05-17T01:20:39.679Z",
      "updated_at": "2026-05-17T01:20:39.679Z"
    },
    {
      "type": "tip",
      "id": "tip_taylor-001",
      "props": {
        "title": "Taylor Tool Life Equation",
        "body": "Tool life T = (C/Vc)^(1/n) where C is Taylor constant (Vc at T=1min), n is Taylor exponent. Higher n means flatter curve (less speed-sensitive). Double speed roughly halves tool life for n=0.25.",
        "category": "tool_life",
        "confidence": 0.98,
        "source": "Taylor (1907), ISO 3685",
        "tags": [
          "taylor",
          "tool_life",
          "wear"
        ],
        "material_groups": [],
        "iso_groups": [
          "P",
          "M",
          "K",
          "N",
          "S",
          "H"
        ],
        "domain": "lathe"
      },
      "created_at": "2026-05-17T01:20:39.679Z",
      "updated_at": "2026-05-17T01:20:39.679Z"
    },
    {
      "type": "tip",
      "id": "tip_taylor-002",
      "props": {
        "title": "Extended Taylor with Feed and DOC",
        "body": "Extended Taylor: T = C / (Vc^a × f^b × ap^c). Speed has largest effect (a≈0.4), then feed (b≈0.2), then DOC (c≈0.1). Reduce speed before reducing feed for longer tool life.",
        "category": "tool_life",
        "confidence": 0.9,
        "source": "Kronenberg, Manufacturing Science",
        "tags": [
          "taylor",
          "extended",
          "optimization"
        ],
        "material_groups": [],
        "iso_groups": [],
        "domain": "lathe"
      },
      "created_at": "2026-05-17T01:20:39.679Z",
      "updated_at": "2026-05-17T01:20:39.679Z"
    },
    {
      "type": "tip",
      "id": "tip_taylor-003",
      "props": {
        "title": "Flank Wear Progression",
        "body": "Flank wear VB grows in three phases: rapid initial (break-in), steady-state linear, rapid final (failure). Tool life criterion: VB = 0.3mm average or 0.6mm max. Replace at steady-state end.",
        "category": "tool_life",
        "confidence": 0.95,
        "source": "ISO 3685 Tool Life Testing",
        "tags": [
          "flank_wear",
          "vb",
          "tool_change"
        ],
        "material_groups": [],
        "iso_groups": [],
        "domain": "lathe"
      },
