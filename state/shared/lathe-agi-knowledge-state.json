    },
    {
      "type": "tip",
      "id": "tip_chem-004",
      "props": {
        "title": "Coolant pH and Corrosion",
        "body": "Coolant pH should be 8.5-9.5 for corrosion protection. Below 8: rust risk on steel. Above 10: skin irritation, paint damage. Test weekly, adjust with additives.",
        "category": "chemistry",
        "confidence": 0.9,
        "source": "Coolant maintenance guides",
        "tags": [
