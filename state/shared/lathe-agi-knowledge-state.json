      "updated_at": "2026-05-17T01:20:39.679Z"
    },
    {
      "type": "tip",
      "id": "tip_thermal-003",
      "props": {
        "title": "Coating Temperature Limits",
        "body": "Coating breakdown temperatures: Uncoated carbide 600°C, TiN 500°C, TiCN 450°C, TiAlN 800°C, Al2O3 1200°C. Select coating based on expected temperature.",
        "category": "thermal",
        "confidence": 0.95,
        "source": "Coating manufacturer data",
        "tags": [
          "coating",
          "temperature",
          "selection"
        ],
        "material_groups": [],
