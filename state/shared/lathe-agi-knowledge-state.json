      "updated_at": "2026-05-17T01:20:39.679Z"
    },
    {
      "type": "tip",
      "id": "tip_metal-001",
      "props": {
        "title": "White Layer Formation",
        "body": "White layer (untempered martensite) forms when surface exceeds Ac1 temperature then quenches rapidly. Occurs in hardened steel above 200 m/min. Hard but brittle - may cause fatigue failure.",
        "category": "metallurgy",
        "confidence": 0.9,
        "source": "Metallurgical literature",
        "tags": [
          "white_layer",
          "martensite",
          "hard_turning"
        ],
        "material_groups": [],
