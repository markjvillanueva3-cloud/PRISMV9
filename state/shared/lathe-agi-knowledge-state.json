    {
      "type": "tip",
      "id": "tip_chip-003",
      "props": {
        "title": "Segmented Chip Formation",
        "body": "At high speeds, chips become segmented (saw-tooth) due to adiabatic shear bands. Occurs in low thermal conductivity materials (Ti, Ni alloys) and hardened steel. Reduces average force but increases vibration.",
        "category": "chip_formation",
        "confidence": 0.9,
        "source": "Chip formation research",
