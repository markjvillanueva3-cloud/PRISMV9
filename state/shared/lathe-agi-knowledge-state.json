    {
      "type": "tip",
      "id": "tip_chip-002",
      "props": {
        "title": "Chip Breaking Minimum DOC",
        "body": "Chip breakers need minimum DOC to function. Below minimum, chip flows over breaker without breaking. Typical minimum: 0.5-1.5mm depending on insert geometry. Check insert specification.",
        "category": "chip_formation",
        "confidence": 0.9,
        "source": "Insert manufacturer data",
