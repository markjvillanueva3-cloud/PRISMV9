<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<machine xmlns="http://www.hsmworks.com/xml/2009/machine">
  <vendor>Okuma</vendor>
  <model>Multus B250</model>
  <description>Okuma Multus B250 (4-axis, OSP-P300MA) -- WARNING: 5-axis rotary range/pivot OFFSET are datasheet-unverified placeholders; set from the OEM datasheet before 5-axis simulation/collision.</description>
  <control>OSP-P300MA</control>
  <machining additive="no" inspection="no" jet="no" milling="yes" turning="yes"/>
  <dimensions depth="0mm" height="0mm" weight="0kg" width="0mm"/>
  <capacities depth="0mm" height="0mm" weight="0kg" width="0mm"/>
  <coolant options="FLOOD MIST TSC1 TSC2 AIR AIR_THROUGH FLOOD_THROUGH"/>
  <multiAxis adjust="yes" angle="10deg" feedrateMethod="fpm" linearizationTolerance="0.04mm" maximumFeedrate="9999" method="multiaxis" reconfigure="no" safePlungeFeedrate="250mm/min" safeRetractDistance="25mm" safeRetractFeedrate="500mm/min" tolerance="0.04mm" virtualToolTip="no"/>
  <tooling maximumToolDiameter="0mm" maximumToolLength="0mm" maximumToolWeight="0kg" numberOfTools="32" toolChanger="yes" toolPreload="yes"/>
  <machiningTime ratio="1" toolChangeTime="15s"/>
  <capabilities maximumBlockProcessingSpeed="0" maximumFeedrate="0mm/min" workOffsets="100"/>
  <simulation tableAttachPoint="0mm 0mm 0mm" toolAttachPoint="0mm 0mm 0mm" wcs="0mm 0mm 0mm">
    <machineAssembly></machineAssembly>
  </simulation>
  <post>
    <postProcessor>system://OKUMA_MULTUS_B250IIW-Ai-Enhanced-Fixed.cps</postProcessor>
    <postProperties><Parameters/></postProperties>
  </post>

  <axis actuator="linear" coordinate="X" homePosition="0mm" id="X" link="head" maximumFeed="0mm/min" name="" offset="0mm 0mm 0mm" range="0mm 260mm" rapidFeed="0mm/min" resolution="0mm"/>

  <axis actuator="linear" coordinate="Y" homePosition="0mm" id="Y" link="head" maximumFeed="0mm/min" name="" offset="0mm 0mm 0mm" range="0mm 130mm" rapidFeed="0mm/min" resolution="0mm"/>

  <axis actuator="linear" coordinate="Z" homePosition="0mm" id="Z" link="head" maximumFeed="0mm/min" name="" offset="0mm 0mm 0mm" range="-735mm 0mm" rapidFeed="0mm/min" resolution="0mm"/>

  <spindle axis="0 0 1" maximumSpeed="5000rpm" minimumSpeed="0rpm"><description>22 kW</description></spindle>

  <axis actuator="rotational" axis="0 0 1" control="driven" coordinate="C" cyclic="yes" homePosition="0deg" id="C" link="table" maximumFeed="0deg/min" name="" offset="0mm 0mm 0mm" preference="dont care" range="-120deg 120deg" reset="previous" tcp="yes"/>
</machine>
