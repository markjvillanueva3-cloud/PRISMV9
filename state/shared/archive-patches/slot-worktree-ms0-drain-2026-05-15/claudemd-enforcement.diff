-
-    // Optional field validation
-    if (input.edge_radius_um !== undefined && input.edge_radius_um < 0) {
-      errors.push("edge_radius_um cannot be negative");
-    }
-
-    if (input.stepover_mm !== undefined && input.tool_diameter_mm === undefined) {
