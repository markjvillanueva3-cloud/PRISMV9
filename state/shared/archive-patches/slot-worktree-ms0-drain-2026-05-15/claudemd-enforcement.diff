-    }
-
-    if (input.tool_radius_mm === undefined || input.tool_radius_mm === null) {
-      errors.push("tool_radius_mm is required");
-    } else if (input.tool_radius_mm <= 0) {
-      errors.push("tool_radius_mm must be positive");
