    "exactCoverage": {
      "valueCoverage": "Cov_1(d) = tested_values(d) / legal_values(d)",
      "pairwiseCoverage": "Cov_2(d_i,d_j) = tested_pairs(i,j) / legal_pairs(i,j)",
