    "higherOrderCoverage": {
      "baselineT": 3,
      "highRiskT": 4,
      "hotspotT": 5,
      "formula": "Cov_t(stratum) = covered_legal_tuples(stratum) / enumerated_legal_tuples(stratum)",
      "requires": [
        "explicit risk registry",
        "weighting function per stratum",
        "mixed-strength assignment rules",
        "stopping rule"
      ]
    },
    "boundaryCoverage": "Cov_b = tested_boundaries / defined_boundaries",
    "numericCoverage": "Cov_num = within_tolerance_cases / oracle_scored_cases",
    "metamorphicCoverage": "Met_pass = passed_invariants / executed_invariants",
    "wiringCoverage": {
      "sourceCoverage": "Wire_cov_source = wired_source_families / discovered_source_families",
      "consumerCoverage": "Wire_cov_consumer = consumers_using_canonical_truth / target_consumers"
    },
    "ambiguityPenalty": "Penalty = unresolved_legality_edges / total_legality_edges",
    "dashboardScore": "Q_cov = 0.15*Cov_1 + 0.20*Cov_2 + 0.10*Cov_bundle + 0.15*Cov_t + 0.10*Cov_b + 0.15*Cov_num + 0.10*Met_pass + 0.05*Wire_cov_source - Penalty"
