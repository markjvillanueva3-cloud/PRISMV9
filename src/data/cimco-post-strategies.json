  "helix_linearization_algorithm": {
    "description": "Converts helical (arc+Z) moves to linear segments when axis substitution or helix linearization is active",
    "segment_count_formula": "m = round(sweep * sqrt(radius / tolerance / 8) + 1)",
    "per_segment": {
      "angle": "n * (sweep / m) + startAngle",
      "x": "cx + radius * cos(angle)",
      "y": "cy + radius * sin(angle)",
      "z": "lastZ + deltaZ * n"
    },
    "sweep_calculation": "atan2(dot(r2, yVec), dot(r2, r1Vec)) where yVec = perpendicular to r1"
  },
  "axis_substitution": {
    "description": "Wraps Y-axis motion around a cylindrical diameter for rotary axis machining",
    "angle_formula": "360 * (yPosition / (PI * substitutionDiameter))",
    "z_offset": "zValue + substitutionDiameter / 2.0",
    "output": "X, B(angle), Z(offset)"
  },
