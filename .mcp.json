        "GRAFANA_SERVICE_ACCOUNT_TOKEN": ""
      }
    },
    "cqask": {
      "type": "stdio",
      "command": "C:/Users/Admin.DIGITALSTORM-PC/AppData/Local/Programs/Python/Python312/python.exe",
      "args": [
