{
  "mcpServers": {
    "prism": {
      "type": "stdio",
      "command": "node",
      "args": [
        "H:/PRISM/mcp-server/dist/index.js"
      ],
      "env": {
        "TRANSPORT": "stdio",
        "LOG_LEVEL": "info"
      }
    },
    "claude-flow": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "claude-flow",
        "mcp",
        "start"
      ],
      "env": {
        "LOG_LEVEL": "info"
      }
    }
  }
}
