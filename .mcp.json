      "args": [
        "-y",
        "task-master-ai@latest"
      ],
      "env": {
        "TASK_MASTER_TOOLS": "all"
      }
    },
    "cad-converter": {
      "type": "stdio",
      "command": "C:/Users/Admin.DIGITALSTORM-PC/AppData/Local/Programs/Python/Python312/python.exe",
      "args": [
        "C:/PRISM/cad-engine/mcp_cad_converter.py"
      ]
    },
    "grafana": {
