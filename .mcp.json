{
  "mcpServers": {
    "prism": {
      "type": "stdio",
      "command": "node",
      "args": [
        "H:/prism/.claude/helpers/mcp-http-bridge.mjs"
      ],
      "env": {
        "MCP_HTTP_URL": "http://127.0.0.1:3100/mcp",
        "MCP_MAX_CONCURRENT": "3",
        "MCP_TIMEOUT": "120000",
        "LOG_LEVEL": "info",
        "PRISM_MCP_READY_BUDGET_MS": "120000"
      }
    },
    "hermes": {
      "type": "stdio",
      "command": "node",
      "args": [
        "H:/prism/scripts/hermes-mcp-server.mjs"
      ]
    }
  }
}
