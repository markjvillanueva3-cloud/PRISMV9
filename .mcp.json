{
  "mcpServers": {
    "prism": {
      "type": "stdio",
      "command": "node",
      "args": [
        "H:/prism/.claude/helpers/mcp-http-bridge.mjs"
      ],
      "env": {
        "MCP_HTTP_URL": "http://127.0.0.1:3100/mcp",
        "MCP_MAX_CONCURRENT": "6",
        "MCP_TIMEOUT": "120000",
        "LOG_LEVEL": "info"
      }
    },
    "claude-flow": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "claude-flow",
        "mcp",
        "start"
      ],
      "env": {
        "LOG_LEVEL": "info"
      }
    },
    "prism_safe": {
      "type": "stdio",
      "command": "node",
      "args": [
        "H:/prism/mcp-server/dist/index.js"
      ],
      "env": {
        "TRANSPORT": "stdio",
        "LOG_LEVEL": "info"
      }
    }
  }
}
