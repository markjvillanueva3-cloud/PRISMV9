(==========================================================)
(============= AUTO-CALCULATIONS ==========================)
(==========================================================)

(========== CALCULATED RPM ==========)
V70 = [V21 * 3.82] / V20        (SPOT DRILL RPM)
V71 = [V26 * 3.82] / V25        (DRILL 1 RPM)
V158 = [V33 * 3.82] / V32       (DRILL 2 RPM)

(========== DRILL 1 DEPTH CALCULATIONS ==========)
V72 = V25 / 2 / TAN[V29 / 2]    (DRILL 1 POINT DEPTH)
V73 = V5 + V17 + V72 + 0.03     (DRILL 1 TOTAL DEPTH - POSITIVE)
V74 = -V73                      (DRILL 1 Z DEPTH - NEGATIVE)

(========== DRILL 2 DEPTH CALCULATIONS ==========)
V159 = V32 / 2 / TAN[V156 / 2]  (DRILL 2 POINT DEPTH)
V160 = V5 + V17 + V159 + 0.03   (DRILL 2 TOTAL DEPTH - POSITIVE)
V161 = -V160                    (DRILL 2 Z DEPTH - NEGATIVE)

(========== CALCULATED VALUES ==========)
V75 = V2 - [V6 * 2]             (OD CHAMFER START DIA)
V76 = V4 + [V9 * 2]             (ID CHAMFER START DIA)
V77 = V5 + 0.01                 (OD ROUGH DEPTH - 0.01 PAST PART)
V78 = V1 + V61                  (APPROACH DIA - X CLEARANCE)
V79 = V3 - V61                  (BORE APPROACH DIA)
V80 = V1 - [V2 + [V35 * 2]]     (OD STOCK TO REMOVE - DIA)
V81 = V60 + V100                (Z CLEARANCE POSITION)
V82 = 0 - [V44 * 2]             (FACE END X - PAST CENTER)
V83 = V100 - V39                (FACE ROUGH TARGET Z)

(========== BORE DEPTH CALCULATIONS ==========)
V163 = V5 + 0.06                (ID ROUGH DEPTH - 0.06 PAST PART)
V164 = V5 + 0.03                (ID FINISH DEPTH - 0.03 PAST PART)

(========== TURNING RPM CALCULATIONS ==========)
V87 = [V45 * 3.82] / V1         (OD ROUGH INITIAL RPM)
V88 = [V46 * 3.82] / V2         (OD FINISH INITIAL RPM)
V89 = [V48 * 3.82] / V2         (CUTOFF INITIAL RPM)
V162 = [V47 * 3.82] / V4        (ID INITIAL RPM)

(========== CHAMFER ANGLE CORRECTIONS ==========)
(OKUMA ANGLES MEASURED FROM +Z AXIS CCW)
V84 = 180 - V8                  (OD CHAMFER: 45 BECOMES 135)
V85 = 180 + V11                 (ID CHAMFER: 45 BECOMES 225)
V86 = 180 + V15                 (CUTOFF CHAMFER: 45 BECOMES 225)

(========== FACE APPROACH VALUES ==========)
V90 = V39 + 0.0566              (FACE APPROACH Z)
V91 = V2 - 0.05                 (FACE RAPID APPROACH X)
V92 = V2 - [V99 * 4]            (FACE COMP ON X)
V93 = V4 - 0.1                  (FACE END X BEFORE COMP OFF)
V94 = V1 + [V44 * 4]            (FACE ROUGH FEED START X)
V96 = V1 + V44                  (FACE ROUGH COMP ON X)
V97 = 0 - [V44 * 4]             (FACE ROUGH END X - PAST CENTER)
V98 = 0 - V44                   (FACE ROUGH COMP OFF X)

(========== DRILL Z CLEARANCE ==========)
V165 = V81 + V62                (DRILL RETRACT Z - CLEARANCE + EXTRA)

