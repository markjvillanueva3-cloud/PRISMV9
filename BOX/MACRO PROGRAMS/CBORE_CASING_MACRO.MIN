O1001
(T010101 - FACE/OD ROUGH)
(T020202 - FACE/OD FINISH)
(T030303 - SPOT DRILL)
(T050505 - DRILL 1 - PILOT)
(T060606 - DRILL 2 - THRU)
(T070707 - DRILL 3 - 180 DEG - OPTIONAL)
(T080808 - ID ROUGH - COUNTER BORE)
(T090909 - ID FINISH - COUNTER BORE)
(T111111 - CUTOFF)

(==========================================================)
(============= ADJUSTABLE PARAMETERS ======================)
(==========================================================)

(========== STOCK AND MODEL ==========)
V1 = 2.54           (STOCK DIAMETER)
V2 = 2.005          (FINISH OD)
V3 = 0.747         (FINISH THRU HOLE DIA)
V4 = 1.233          (FINISH COUNTER BORE DIA)
V5 = 2.515         (PART LENGTH - OD)
V6 = 1.0            (COUNTER BORE DEPTH)
V100 = 0.015          (STOCK FACE OFFSET - Z ZERO AT PART FACE)

(========== OD CHAMFER ==========)
V7 = 0.03           (CHAMFER Z DEPTH - 0 FOR NONE)
V8 = 45             (CHAMFER ANGLE)
V170 = 0            (CHAMFER MINOR DIA - 0=AUTO CALC, OR ENTER START DIA)

(========== SPOT DRILL PARAMETERS ==========)
V20 = 0.5           (SPOT DRILL DIAMETER)
V21 = 131           (SPOT DRILL SFM)
V22 = 0.1           (SPOT DRILL DEPTH)
V23 = 0             (SPOT DRILL PECK: 0=NO, 1=YES)
V24 = 0.13          (SPOT DRILL PECK DEPTH)
V19 = 0.003         (SPOT DRILL FEED - IPR)

(========== DRILL 1 - PILOT ==========)
V25 = 1.22        (DRILL 1 DIAMETER)
V26 = 85            (DRILL 1 SFM)
V27 = 0.008         (DRILL 1 FEED - IPR)
V28 = 0.13          (DRILL 1 PECK DEPTH)
V29 = 130           (DRILL 1 POINT ANGLE)
V30 = 0             (DRILL 1 PECK: 0=NO, 1=YES)

(========== DRILL 2 - THRU - OPTIONAL ==========)
V45 = 1             (DRILL 2 ENABLE: 0=NO, 1=YES)
V31 = 0.734          (DRILL 2 DIAMETER - THRU DRILL)
V32 = 85            (DRILL 2 SFM)
V33 = 0.007         (DRILL 2 FEED - IPR)
V34 = 0.13          (DRILL 2 PECK DEPTH)
V35 = 130           (DRILL 2 POINT ANGLE)
V36 = 0             (DRILL 2 PECK: 0=NO, 1=YES)

(========== DRILL 3 - 180 DEG - OPTIONAL ==========)
V37 = 1             (DRILL 3 ENABLE: 0=NO, 1=YES)
V38 = 1.218        (DRILL 3 DIAMETER - 180 DEG)
V39 = 90            (DRILL 3 SFM)
V40 = 0.003         (DRILL 3 FEED - IPR)
V41 = 0.957         (DRILL 3 PECK DEPTH)
V42 = 180           (DRILL 3 POINT ANGLE)
V43 = 0             (DRILL 3 PECK: 0=NO, 1=YES)
V44 = .998           (DRILL 3 DEPTH - COUNTER BORE DEPTH)

(========== STOCK ALLOWANCES ==========)
V50 = 0.01          (OD FINISH STOCK - RADIAL)
V51 = 0.002         (OD FINISH STOCK - AXIAL)
V52 = 0.01          (ID FINISH STOCK - RADIAL)
V53 = 0.002           (ID FINISH STOCK - AXIAL)
V54 = 0.015          (FACE STOCK ALLOWANCE - Z)

(========== CUTOFF PARAMETERS ==========)
V130 = 500          (CUTOFF SFM)
V131 = 0.004        (CUTOFF FEED - IPR)
V132 = 0.118        (CUTOFF INSERT WIDTH)
V133 = 2500         (CUTOFF MAX RPM)

(========== ROUGHING PARAMETERS ==========)
V55 = 0.2           (OD DEPTH OF CUT)
V56 = 0.03          (ID ROUGH STEP - DIAMETER INCREMENT)

(========== COUNTER BORE UNDERCUT ==========)
V140 = 4            (UNDERCUT TAPER ANGLE - DEGREES)
V141 = 0.02         (UNDERCUT DIAMETER REDUCTION)
V142 = 0.03         (UNDERCUT STRAIGHT LENGTH)

(========== TOOL NOSE RADIUS ==========)
V57 = 0.031        (TOOL 1 NOSE RADIUS - OD ROUGH)
V58 = 0.015        (TOOL 2 NOSE RADIUS - OD FINISH)

(========== TURNING SPEEDS - SFM ==========)
V60 = 755           (OD ROUGH SFM)
V61 = 825           (OD FINISH SFM)
V62 = 400           (ID ROUGH SFM)
V63 = 500           (ID FINISH SFM)

(========== TURNING FEEDS ==========)
V64 = 0.008         (FACE ROUGH FEED)
V65 = 0.003         (FACE FINISH FEED)
V66 = 0.008         (OD ROUGH FEED)
V67 = 0.003         (OD FINISH FEED)
V68 = 0.007         (ID ROUGH FEED)
V69 = 0.0045        (ID FINISH FEED)

(========== CLEARANCE ==========)
V70 = 0.05          (Z CLEARANCE - OD)
V71 = 0.05           (X CLEARANCE - OD RAPID)
V72 = 0.05           (Z DRILL CLEARANCE - EXTRA)
V73 = 0.01          (ID CLEARANCE - BORING)
V74 = 0.06          (ID RAPID CLEARANCE - FROM DRILL)

(========== MAX SPINDLE SPEEDS ==========)
V75 = 2500          (OD ROUGH MAX RPM)
V76 = 3500          (OD FINISH MAX RPM)
V77 = 2500          (ID ROUGH MAX RPM)
V78 = 1000          (ID FINISH MAX RPM)

(========== ID ROUGHING OPTIONS ==========)
V79 = 0             (SKIP THRU BORE ROUGH: 0=ROUGH FULL, 1=COUNTER BORE ONLY)

(========== OPTIONAL STOPS ==========)
V80 = 0             (OD FINISH TO ID STOP: 0=NO, 1=YES)

(========== MACHINE OPTIONS ==========)
V81 = 0             (INCLUDE G140/G270: 0=NO, 1=YES)

(==========================================================)
(============= AUTO-CALCULATIONS ==========================)
(==========================================================)

(========== CALCULATED RPM ==========)
V90 = [V21 * 3.82] / V20         (SPOT DRILL RPM)
V91 = [V26 * 3.82] / V25         (DRILL 1 RPM)
V92 = [V32 * 3.82] / V31         (DRILL 2 RPM)
V93 = [V39 * 3.82] / V38         (DRILL 3 RPM)

(========== DRILL DEPTH CALCULATIONS ==========)
V94 = V25 / 2 / TAN[V29 / 2]     (DRILL 1 POINT DEPTH)
V95 = V5 + V94 + 0.03            (DRILL 1 FULL THRU DEPTH)
V123 = [V3 / 2] / TAN[V29 / 2]   (DRILL 1 TANGENT DEPTH - TANGENT TO THRU HOLE DIA)

V96 = V31 / 2 / TAN[V35 / 2]     (DRILL 2 POINT DEPTH)
V97 = V5 + V96 + 0.03            (DRILL 2 TOTAL DEPTH)

(========== APPROACH/CLEARANCE VALUES ==========)
V101 = V1 + V71                  (OD APPROACH DIA - STOCK + CLEARANCE)
V102 = V70 + V100                (Z CLEARANCE POSITION)
V103 = V102 + V72                (DRILL RETRACT Z)

(========== OD CHAMFER CALCULATIONS ==========)
V104 = V2 - [V7 * TAN[V8] * 2]   (CHAMFER START DIA - AUTO CALC USING ANGLE)
V105 = 180 - V8                  (CHAMFER ANGLE FOR OKUMA - FROM +Z CCW)
(NOTE: V7 = Z DEPTH, X IS CALCULATED FROM ANGLE)
(NOTE: IF V170 > 0, PROGRAM USES V170 INSTEAD OF V104)

(========== TURNING RPM CALCULATIONS ==========)
V106 = [V60 * 3.82] / V1         (OD ROUGH INITIAL RPM)
V107 = [V61 * 3.82] / V2         (OD FINISH INITIAL RPM)
V108 = [V62 * 3.82] / V4         (ID ROUGH INITIAL RPM)
V109 = [V63 * 3.82] / V4         (ID FINISH INITIAL RPM)
V134 = [V130 * 3.82] / V2        (CUTOFF INITIAL RPM)

(========== FACE ROUGH APPROACH VALUES ==========)
V110 = V54 + V57 + 0.0185        (FACE ROUGH APPROACH Z)
V111 = V1 + V57 + V71            (FACE ROUGH RAPID X - STOCK + TNR + CLEARANCE)
V112 = V1 + V57                  (FACE ROUGH COMP ON X - STOCK + TNR)
V113 = 0 - [V57 * 2]             (FACE ROUGH END X - 2X TNR PAST CENTER)
V114 = 0 - V57                   (FACE ROUGH COMP OFF X - 1X TNR)

(========== FACE FINISH APPROACH VALUES ==========)
V115 = V100 + V58 + 0.0185       (FACE FINISH APPROACH Z)
V116 = V2 + V58 + V71            (FACE FINISH RAPID X - OD + TNR + CLEARANCE)
V117 = V2 + V58                  (FACE FINISH COMP ON X - OD + TNR)
V118 = V4 - 0.1                  (FACE FINISH END X - BEFORE COUNTER BORE)
V135 = V4                        (FACE FINISH COMP OFF X)

(========== OD ROUGH VALUES ==========)
V119 = V5 + 0.01                 (OD ROUGH Z DEPTH)

(========== ID APPROACH CALCULATIONS ==========)
(APPROACH DIA BASED ON PILOT DRILL - ALWAYS SAFE ENTRY)
V120 = V25 - V74                 (ID APPROACH - PILOT DRILL MINUS .06)
V121 = V38 - V74                 (ID APPROACH AFTER 180 - IF USED)
V122 = V31 - V74                 (ID APPROACH AFTER THRU - IF NO 180)

(========== COUNTER BORE UNDERCUT CALCULATIONS ==========)
V143 = V4 - V141                 (UNDERCUT FINISH DIAMETER)
V144 = [V141 / 2] / TAN[V140]    (TAPER Z LENGTH)
V145 = 180 + V140                (OKUMA A WORD FOR ID TAPER)
V146 = V6 - V142 - V144          (TAPER START Z - FROM FACE)
V147 = V6 - V142                 (UNDERCUT START Z - FROM FACE)
V148 = V143 + [V52 * 2]          (UNDERCUT ROUGH DIA WITH STOCK)

(========== ID ROUGHING PASS CALCULATIONS ==========)
(CALCULATE INTERMEDIATE DIAMETERS FOR INCREMENTAL PASSES)
(USING PILOT DRILL AS BASE - ROUGH FROM PILOT TO COUNTER BORE)
V149 = V25 + V56                 (PASS 1 DIA)
V150 = V25 + [V56 * 2]           (PASS 2 DIA)
V151 = V25 + [V56 * 3]           (PASS 3 DIA)
V152 = V25 + [V56 * 4]           (PASS 4 DIA)
V153 = V25 + [V56 * 5]           (PASS 5 DIA)
V154 = V25 + [V56 * 6]           (PASS 6 DIA)
V155 = V4 + [V52 * 2]            (COUNTER BORE ROUGH DIA)

