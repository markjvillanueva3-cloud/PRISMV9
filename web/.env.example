# PRISM Web Frontend Configuration
# Copy to .env and customize

# API server URL (used by Vite proxy in dev, nginx in prod)
VITE_API_URL=http://localhost:3000

# WebSocket URL
VITE_WS_URL=ws://localhost:3000

# Feature flags
VITE_ENABLE_PPG=false
VITE_ENABLE_LEARNING=false
VITE_ENABLE_ERP=false
VITE_ENABLE_VIEWER=false
VITE_ENABLE_WEDM=false
