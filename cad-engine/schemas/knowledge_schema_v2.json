{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PRISM Knowledge Schema v2",
  "description": "Universal knowledge extraction schema covering CAD, CAM, and SHOP domains with cross-domain linking and provenance tracking.",
  "version": "2.0.0",

  "definitions": {

    "provenance": {
      "type": "object",
      "description": "Source tracking for extracted knowledge.",
      "required": ["source_type", "confidence"],
      "properties": {
        "source_type": {
          "type": "string",
          "enum": ["transcript", "vision", "ocr", "inferred", "document"]
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "timestamp_seconds": {
          "type": ["number", "null"],
          "description": "Video timestamp where this knowledge was extracted."
        },
        "frame_path": {
          "type": ["string", "null"],
          "description": "Path to the frame image that supports this extraction."
        },
        "transcript_span": {
          "type": ["string", "null"],
          "description": "Relevant excerpt from transcript."
        },
        "ocr_text": {
          "type": ["string", "null"],
          "description": "OCR text that supports this extraction."
        },
        "page_number": {
          "type": ["integer", "null"],
          "description": "Page number in document where knowledge was extracted."
        },
        "section_title": {
          "type": ["string", "null"],
          "description": "Section/heading title where knowledge was found."
        }
      },
      "additionalProperties": false
    },

    "cross_link": {
      "type": "object",
      "description": "Link between knowledge items across domains.",
      "required": ["target_id", "relationship"],
      "properties": {
        "target_id": {
          "type": "string",
          "description": "ID of the linked knowledge item."
        },
        "relationship": {
          "type": "string",
          "enum": [
            "requires", "produces", "constrains", "optimizes",
            "implements", "validates", "conflicts_with", "alternative_to"
          ]
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },

    "parameter": {
      "type": "object",
      "description": "A named parameter with value and optional unit/range.",
      "required": ["name", "value"],
      "properties": {
        "name": { "type": "string" },
        "value": {},
        "unit": { "type": ["string", "null"] },
        "min": { "type": ["number", "null"] },
        "max": { "type": ["number", "null"] },
        "source": { "$ref": "#/definitions/provenance" }
      },
      "additionalProperties": false
    },

    "cad_feature": {
      "type": "object",
      "description": "A CAD modeling feature or operation.",
      "required": ["id", "name", "feature_type"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "feature_type": {
          "type": "string",
          "enum": [
            "sketch", "extrude", "revolve", "loft", "sweep",
            "fillet", "chamfer", "hole", "pattern", "mirror",
            "shell", "boolean_union", "boolean_subtract", "boolean_intersect",
            "draft", "rib", "assembly_constraint", "reference_geometry",
            "surface", "sheet_metal", "weldment", "other"
          ]
        },
        "parameters": {
          "type": "array",
          "items": { "$ref": "#/definitions/parameter" }
        },
        "parent_feature_id": {
          "type": ["string", "null"],
          "description": "ID of the parent feature in the feature tree."
        },
        "design_intent": {
          "type": ["string", "null"],
          "description": "Why this feature exists (functional purpose)."
        },
        "constraints": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Geometric or dimensional constraints."
        },
        "provenance": { "$ref": "#/definitions/provenance" },
        "cross_links": {
          "type": "array",
          "items": { "$ref": "#/definitions/cross_link" }
        }
      },
      "additionalProperties": false
    },

    "cam_strategy": {
      "type": "object",
      "description": "A CAM machining strategy or operation.",
      "required": ["id", "name", "operation_type"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "operation_type": {
          "type": "string",
          "enum": [
            "face_mill", "pocket_2d", "pocket_3d", "contour", "profile",
            "adaptive", "trochoidal", "slot", "thread_mill",
            "drilling", "boring", "reaming", "tapping",
            "roughing_3d", "finishing_3d", "rest_machining",
            "turning_rough", "turning_finish", "turning_groove", "turning_thread",
            "engraving", "chamfer_mill", "deburr", "other"
          ]
        },
        "sequence_order": {
          "type": ["integer", "null"],
          "description": "Order in the machining sequence."
        },
        "tool": {
          "type": ["object", "null"],
          "properties": {
            "type": { "type": "string" },
            "diameter_mm": { "type": ["number", "null"] },
            "flutes": { "type": ["integer", "null"] },
            "material": { "type": ["string", "null"] },
            "coating": { "type": ["string", "null"] },
            "description": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        },
        "cutting_parameters": {
          "type": "array",
          "items": { "$ref": "#/definitions/parameter" },
          "description": "RPM, feed rate, depth of cut, stepover, etc."
        },
        "strategy_rationale": {
          "type": ["string", "null"],
          "description": "Why this strategy was chosen over alternatives."
        },
        "target_features": {
          "type": "array",
          "items": { "type": "string" },
          "description": "CAD feature IDs this operation machines."
        },
        "workholding": {
          "type": ["string", "null"],
          "description": "Workholding method used for this operation."
        },
        "coolant": {
          "type": ["string", "null"],
          "enum": ["flood", "mist", "air", "none", null]
        },
        "provenance": { "$ref": "#/definitions/provenance" },
        "cross_links": {
          "type": "array",
          "items": { "$ref": "#/definitions/cross_link" }
        }
      },
      "additionalProperties": false
    },

    "shop_practice": {
      "type": "object",
      "description": "A shop floor practice, tip, or procedure.",
      "required": ["id", "title", "practice_type"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "practice_type": {
          "type": "string",
          "enum": [
            "setup_procedure", "workholding_technique", "tool_management",
            "measurement_technique", "cutting_practice", "troubleshooting",
            "material_handling", "machine_operation", "safety_procedure",
            "quality_control", "maintenance", "optimization_tip", "other"
          ]
        },
        "description": {
          "type": "string",
          "description": "Full description of the practice."
        },
        "steps": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Ordered steps for procedures."
        },
        "applicable_materials": {
          "type": "array",
          "items": { "type": "string" }
        },
        "applicable_machines": {
          "type": "array",
          "items": { "type": "string" }
        },
        "applicable_controllers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Safety warnings or common mistakes."
        },
        "provenance": { "$ref": "#/definitions/provenance" },
        "cross_links": {
          "type": "array",
          "items": { "$ref": "#/definitions/cross_link" }
        }
      },
      "additionalProperties": false
    }
  },

  "type": "object",
  "required": ["schema_version", "video_id", "metadata", "domains"],
  "properties": {

    "schema_version": {
      "type": "string",
      "const": "2.0.0"
    },

    "video_id": {
      "type": "string",
      "description": "Unique identifier for the source video."
    },

    "extracted_at": {
      "type": "string",
      "format": "date-time"
    },

    "metadata": {
      "type": "object",
      "required": ["title", "primary_domain"],
      "properties": {
        "title": { "type": "string" },
        "description": { "type": ["string", "null"] },
        "primary_domain": {
          "type": "string",
          "enum": ["cad", "cam", "shop", "multi"]
        },
        "secondary_domain": {
          "type": ["string", "null"],
          "enum": ["cad", "cam", "shop", null]
        },
        "domain_confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "platform": {
          "type": ["string", "null"],
          "description": "Primary software platform (e.g., 'SolidWorks', 'Mastercam')."
        },
        "platform_version": { "type": ["string", "null"] },
        "controller": {
          "type": ["string", "null"],
          "description": "CNC controller if identified (e.g., 'Fanuc', 'Haas')."
        },
        "material": {
          "type": ["string", "null"],
          "description": "Primary workpiece material if identified."
        },
        "duration_seconds": { "type": ["number", "null"] },
        "uploader": { "type": ["string", "null"] },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "source_type": {
          "type": ["string", "null"],
          "enum": ["video", "document", null],
          "description": "Whether knowledge was extracted from a video or document."
        },
        "document_metadata": {
          "type": ["object", "null"],
          "description": "Additional metadata for document-sourced knowledge.",
          "properties": {
            "author": { "type": ["string", "null"] },
            "publication_title": { "type": ["string", "null"] },
            "publication_date": { "type": ["string", "null"] },
            "doi": { "type": ["string", "null"] },
            "page_count": { "type": ["integer", "null"] },
            "format": {
              "type": ["string", "null"],
              "enum": ["pdf", "markdown", "text", "html", null]
            },
            "url": { "type": ["string", "null"] },
            "doc_type": {
              "type": ["string", "null"],
              "enum": ["academic_paper", "technical_manual", "handbook", "blog_article", "notes", "specification", "other", null]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },

    "domains": {
      "type": "object",
      "description": "Extracted knowledge organized by domain.",
      "properties": {
        "cad": {
          "type": "object",
          "properties": {
            "features": {
              "type": "array",
              "items": { "$ref": "#/definitions/cad_feature" }
            },
            "design_intent_summary": { "type": ["string", "null"] },
            "modeling_approach": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        },
        "cam": {
          "type": "object",
          "properties": {
            "strategies": {
              "type": "array",
              "items": { "$ref": "#/definitions/cam_strategy" }
            },
            "machining_summary": { "type": ["string", "null"] },
            "tool_list": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "number": { "type": "integer" },
                  "type": { "type": "string" },
                  "diameter_mm": { "type": ["number", "null"] },
                  "description": { "type": ["string", "null"] }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "shop": {
          "type": "object",
          "properties": {
            "practices": {
              "type": "array",
              "items": { "$ref": "#/definitions/shop_practice" }
            },
            "setup_summary": { "type": ["string", "null"] },
            "key_takeaways": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },

    "cross_domain_links": {
      "type": "array",
      "description": "Top-level cross-domain relationships.",
      "items": {
        "type": "object",
        "required": ["from_id", "to_id", "relationship"],
        "properties": {
          "from_id": { "type": "string" },
          "from_domain": { "type": "string", "enum": ["cad", "cam", "shop"] },
          "to_id": { "type": "string" },
          "to_domain": { "type": "string", "enum": ["cad", "cam", "shop"] },
          "relationship": {
            "type": "string",
            "enum": [
              "requires", "produces", "constrains", "optimizes",
              "implements", "validates", "conflicts_with", "alternative_to"
            ]
          },
          "description": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },

    "extraction_stats": {
      "type": "object",
      "description": "Statistics about the extraction process.",
      "properties": {
        "total_items": { "type": "integer" },
        "cad_features": { "type": "integer" },
        "cam_strategies": { "type": "integer" },
        "shop_practices": { "type": "integer" },
        "cross_links": { "type": "integer" },
        "avg_confidence": { "type": "number" },
        "sources_used": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["transcript", "vision", "ocr"]
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}