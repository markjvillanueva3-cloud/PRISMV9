    {
      "tip_id": "ALU-0005",
      "material": "aluminum",
      "category": "general",
      "tip_text": "6061-T6 is the most common shop aluminum — machines easily with standard parameters",
      "detail": "6061-T6 is widely available, affordable, and machines predictably. 7075-T6 is harder and stronger but machines similarly.",
