    {
      "tip_id": "ALU-0001",
      "material": "aluminum",
      "category": "speeds_feeds",
      "tip_text": "Run high spindle speeds — SFM 800-1500 for wrought alloys, up to 2000 for cast",
      "detail": "Aluminum's low hardness and high thermal conductivity allow aggressive speeds. Higher speed reduces built-up edge formation.",
      "sources": [
        {
          "video_id": "seed-021",
          "channel": "Datron",
          "channel_subscribers": 45000,
          "views": 62000,
          "likes": 2100,
          "confidence": 0.91,
          "timestamp_seconds": null
        }
      ],
