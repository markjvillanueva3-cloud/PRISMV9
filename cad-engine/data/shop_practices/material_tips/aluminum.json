    {
      "tip_id": "ALU-0006",
      "material": "aluminum",
      "category": "general",
      "tip_text": "Fine aluminum chips are a fire hazard — ensure proper chip collection and avoid dry operations with fine chips",
      "detail": "Aluminum powder and fine chips can ignite. Keep shop clean, use proper chip collection, and avoid open flames near chip bins.",
