    },
    {
      "tip_id": "ALU-0004",
      "material": "aluminum",
      "category": "speeds_feeds",
      "tip_text": "Maintain minimum chip load of 0.002 in/tooth to avoid rubbing",
      "detail": "Rubbing instead of cutting causes built-up edge and poor surface finish. Keep feed rate proportional to speed.",
      "sources": [
