        "HSM"
      ]
    },
    {
      "tip_id": "ALU-0002",
      "material": "aluminum",
      "category": "tooling",
      "tip_text": "Use 2-3 flute uncoated or ZrN-coated carbide end mills",
      "detail": "TiAlN coating causes aluminum to stick (BUE). ZrN or polished uncoated gives best results. Fewer flutes improve chip evacuation.",
      "sources": [
        {
          "video_id": "seed-021",
          "channel": "Datron",
          "channel_subscribers": 45000,
          "views": 62000,
          "likes": 2100,
