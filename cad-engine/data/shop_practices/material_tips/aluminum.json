    },
    {
      "tip_id": "ALU-0003",
      "material": "aluminum",
      "category": "coolant",
      "tip_text": "Use flood coolant or MQL — aluminum requires lubrication to prevent sticking",
      "detail": "Without coolant, aluminum welds to cutting edges. MQL is effective for lighter cuts; flood is preferred for heavy roughing.",
      "sources": [
        {
          "video_id": "seed-021",
          "channel": "Datron",
          "channel_subscribers": 45000,
          "views": 62000,
          "likes": 2100,
